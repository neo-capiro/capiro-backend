{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // DOM supplies browser-facing URL declarations. The separate retained
    // server subpaths also use the declared Node types; the browser barrel
    // does not export those implementations.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts"]
}
