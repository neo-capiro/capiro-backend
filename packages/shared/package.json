{
  "name": "@capiro/shared",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core-retained-read-request": ["dist/core-retained-read-request.d.ts"],
      "core-retained-authority-probe": ["dist/core-retained-authority-probe.d.ts"],
      "core-retained-authority-http": ["dist/core-retained-authority-http.d.ts"],
