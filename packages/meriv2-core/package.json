{
  "name": "@capiro/meriv2-core",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assurance": {
      "types": "./dist/assurance/index.d.ts",
      "require": "./dist/assurance/index.js",
      "import": "./dist/assurance/index.js",
      "default": "./dist/assurance/index.js"
    },
    "./grounding/auditor": {
      "types": "./dist/grounding/auditor.d.ts",
      "require": "./dist/grounding/auditor.js",
      "import": "./dist/grounding/auditor.js",
      "default": "./dist/grounding/auditor.js"
    },
    "./grounding/evidence": {
      "types": "./dist/grounding/evidence.d.ts",
      "require": "./dist/grounding/evidence.js",
      "import": "./dist/grounding/evidence.js",
      "default": "./dist/grounding/evidence.js"
    },
    "./context/contract": {
      "types": "./dist/context/contract.d.ts",
      "require": "./dist/context/contract.js",
      "import": "./dist/context/contract.js",
      "default": "./dist/context/contract.js"
    },
    "./context/compiler": {
      "types": "./dist/context/compiler.d.ts",
      "require": "./dist/context/compiler.js",
      "import": "./dist/context/compiler.js",
      "default": "./dist/context/compiler.js"
    },
    "./context/governed-columns": {
      "types": "./dist/context/governed-columns.d.ts",
      "require": "./dist/context/governed-columns.js",
      "import": "./dist/context/governed-columns.js",
      "default": "./dist/context/governed-columns.js"
    },
    "./context/context-release-switch": {
      "types": "./dist/context/context-release-switch.d.ts",
      "require": "./dist/context/context-release-switch.js",
      "import": "./dist/context/context-release-switch.js",
      "default": "./dist/context/context-release-switch.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --detectOpenHandles --forceExit",
    "eval:meriv2": "tsx test/evals/run-evals.ts",
    "parity": "tsx test/parity/parity.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@capiro/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
