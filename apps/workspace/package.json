{
  "name": "@capiro/workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --detectOpenHandles --forceExit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed-workspace.ts",
    "test:coverage": "jest --detectOpenHandles --forceExit --coverage --coverageReporters=json-summary --coverageReporters=text --maxWorkers=4"
  },
  "dependencies": {
    "@capiro/auth": "workspace:*",
    "@capiro/meriv2-core": "workspace:*",
    "@capiro/shared": "workspace:*",
    "@clerk/backend": "^1.13.5",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "docx": "^9.7.2",
    "express": "^4.21.0",
    "pdfkit": "^0.20.2",
    "prisma": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "htmlparser2": "8.0.2",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "@types/sanitize-html": "^2.16.1"
  }
}
