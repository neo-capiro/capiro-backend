# Alpine qualification candidate; the Debian Dockerfile remains unchanged.
# Build context: repository root. Default pin is the Core-qualified amd64 image.
# arm64 requires the explicit NODE_IMAGE override documented in the gate guide.
# Fresh production install preserves pnpm links and musl Prisma without dev tools.
ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22.23.3-alpine3.24@sha256:2c752226d477b4a886378baa95b9af252be59301b725fdb0b7e15208131505a8
FROM ${NODE_IMAGE} AS base
ARG TARGETARCH
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN apk add --no-cache "zlib>=1.3.2-r1"
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /workspace

FROM base AS build
RUN apk add --no-cache openssl ca-certificates python3 make g++
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* tsconfig.base.json ./
COPY apps/workspace/package.json apps/workspace/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/shared/package.json packages/shared/package.json
# @capiro/meriv2-core (Phase 3.1): the workspace generation path reuses its
# post-hoc grounding auditor. Mirrors the apps/api Dockerfile's meriv2-core
# handling exactly — see the runtime-stage node_modules copy note below.
COPY packages/meriv2-core/package.json packages/meriv2-core/package.json
RUN --mount=type=cache,id=pnpm-wave2-alpine-${TARGETARCH},target=/pnpm/store \
    pnpm install --frozen-lockfile --filter=@capiro/workspace... --filter=@capiro/auth... --filter=@capiro/shared... --filter=@capiro/meriv2-core...

COPY packages/shared/src packages/shared/src
COPY packages/shared/tsconfig.json packages/shared/tsconfig.json
COPY packages/auth/src packages/auth/src
COPY packages/auth/tsconfig.json packages/auth/tsconfig.json
COPY packages/meriv2-core/src packages/meriv2-core/src
COPY packages/meriv2-core/tsconfig.json packages/meriv2-core/tsconfig.json
COPY apps/workspace/src apps/workspace/src
COPY apps/workspace/prisma apps/workspace/prisma
COPY apps/workspace/tsconfig.json apps/workspace/tsconfig.build.json apps/workspace/nest-cli.json apps/workspace/

RUN pnpm --filter @capiro/shared build
RUN pnpm --filter @capiro/auth build
RUN pnpm --filter @capiro/meriv2-core build
# Generate the Prisma client (outputs to apps/workspace/generated/prisma-client)
# BEFORE the Nest build, since src imports the generated client.
COPY apps/api/scripts/qualification/prisma-musl-target.cjs apps/api/scripts/qualification/qualification-platform.cjs /qualification/
RUN CAPIRO_QUALIFICATION_ARCH="$(node -p process.arch)" node /qualification/prisma-musl-target.cjs apps/workspace/prisma/schema.prisma
RUN cd apps/workspace && pnpm exec prisma generate
RUN pnpm --filter @capiro/workspace build

FROM build AS qualification
COPY apps/workspace/jest* apps/workspace/
COPY apps/workspace/test apps/workspace/test
COPY apps/workspace/scripts apps/workspace/scripts
COPY scripts/testing/a1-disposable-postgres.cjs scripts/testing/a1-disposable-postgres.cjs
# WS03's disposable-PostgreSQL helper resolves pg/Prisma from apps/api and
# composes the two checked-in schemas. Preserve those prerequisites for PG16.
COPY apps/api/package.json apps/api/package.json
COPY apps/api/prisma apps/api/prisma
COPY packages/defense-domain/package.json packages/defense-domain/package.json
COPY packages/defense-contracts/package.json packages/defense-contracts/package.json
RUN --mount=type=cache,id=pnpm-wave2-alpine-${TARGETARCH},target=/pnpm/store \
    pnpm install --frozen-lockfile --filter=@capiro/workspace... --filter=@capiro/api...
WORKDIR /workspace/apps/workspace
CMD ["pnpm", "exec", "jest", "--runInBand"]

FROM base AS production-dependencies
RUN apk add --no-cache openssl ca-certificates python3 make g++
COPY --from=build /workspace/pnpm-workspace.yaml /workspace/package.json /workspace/pnpm-lock.yaml ./
COPY --from=build /workspace/apps/workspace/package.json apps/workspace/package.json
COPY --from=build /workspace/packages/shared/package.json packages/shared/package.json
COPY --from=build /workspace/packages/auth/package.json packages/auth/package.json
COPY --from=build /workspace/packages/meriv2-core/package.json packages/meriv2-core/package.json
COPY --from=build /workspace/apps/workspace/prisma apps/workspace/prisma
RUN --mount=type=cache,id=pnpm-wave2-alpine-${TARGETARCH},target=/pnpm/store \
    pnpm install --frozen-lockfile --prod --filter=@capiro/workspace... --filter=@capiro/shared... --filter=@capiro/auth... --filter=@capiro/meriv2-core...
RUN pnpm --filter @capiro/workspace exec prisma generate

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
ENV NODE_OPTIONS=--enable-source-maps
# Every entrypoint verb invokes node directly; local Prisma remains installed.
# Package managers are build/test tooling, not part of this runtime contract.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
RUN addgroup -S -g 1001 capiro \
 && adduser -S -D -H -u 1001 -G capiro -s /sbin/nologin capiro \
 && apk add --no-cache wget ca-certificates dumb-init openssl "zlib>=1.3.2-r1"
RUN mkdir -p /app/tmp /tmp \
 && chmod 1777 /tmp \
 && chown capiro:capiro /app/tmp
ENV TMPDIR=/app/tmp
WORKDIR /app

# Copy the entire workspace, pnpm's symlinked node_modules + the compiled
# workspace dist. Larger image (~250MB) but reliable.
COPY --chown=capiro:capiro --from=production-dependencies /workspace/node_modules /app/node_modules
COPY --chown=capiro:capiro --from=build /workspace/packages/shared/dist /app/packages/shared/dist
COPY --chown=capiro:capiro --from=build /workspace/packages/shared/package.json /app/packages/shared/package.json
# @capiro/auth (Option N shared guard): dist + manifest + its OWN node_modules
# — root /app/node_modules/@capiro/auth is a pnpm symlink to here, and
# packages/auth/dist requires @nestjs/common / @clerk/backend from its own
# node_modules (pnpm doesn't hoist). Without these three the workspace crashes
# at boot with "Cannot find module '@capiro/auth'".
COPY --chown=capiro:capiro --from=build /workspace/packages/auth/dist /app/packages/auth/dist
COPY --chown=capiro:capiro --from=build /workspace/packages/auth/package.json /app/packages/auth/package.json
COPY --chown=capiro:capiro --from=production-dependencies /workspace/packages/auth/node_modules /app/packages/auth/node_modules
# @capiro/meriv2-core (Phase 3.1): dist + manifest + its OWN node_modules.
# meriv2-core (unlike leaf @capiro/shared) has workspace deps of its own —
# its dist require()s @capiro/shared + zod, which pnpm links under
# packages/meriv2-core/node_modules (relative symlinks), NOT hoisted to root.
# Copy it or the workspace crashloops at boot with MODULE_NOT_FOUND
# '@capiro/shared' (identical to the apps/api Dockerfile note).
COPY --chown=capiro:capiro --from=build /workspace/packages/meriv2-core/dist /app/packages/meriv2-core/dist
COPY --chown=capiro:capiro --from=build /workspace/packages/meriv2-core/package.json /app/packages/meriv2-core/package.json
COPY --chown=capiro:capiro --from=production-dependencies /workspace/packages/meriv2-core/node_modules /app/packages/meriv2-core/node_modules
COPY --chown=capiro:capiro --from=build /workspace/apps/workspace/dist /app/apps/workspace/dist
COPY --chown=capiro:capiro --from=production-dependencies /workspace/apps/workspace/node_modules /app/apps/workspace/node_modules
COPY --chown=capiro:capiro --from=build /workspace/apps/workspace/package.json /app/apps/workspace/package.json
# Generated Prisma client + schema + migrations (the migrate verb runs
# `prisma migrate deploy` against prisma/migrations at task launch).
COPY --chown=capiro:capiro --from=production-dependencies /workspace/apps/workspace/generated /app/apps/workspace/generated
COPY --chown=capiro:capiro --from=production-dependencies /workspace/apps/workspace/prisma /app/apps/workspace/prisma
COPY --chown=capiro:capiro --from=build /workspace/tsconfig.base.json /app/tsconfig.base.json
COPY --chown=capiro:capiro --from=build /workspace/apps/workspace/tsconfig.json /app/apps/workspace/tsconfig.json
COPY --chown=capiro:capiro apps/workspace/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

COPY scripts/qualification/alpine-service-probe.cjs scripts/qualification/alpine-dependency-compatibility.cjs /qualification/
USER capiro
WORKDIR /app/apps/workspace
# Exercise the actual pruned import graph without constructing providers or DB pools.
RUN --network=none node -e "const assert=require('node:assert/strict'); const sanitize=require('sanitize-html'); assert.equal(sanitize('<strong>safe</strong><script>unsafe</script>'), '<strong>safe</strong>'); require('./dist/versions/versions.service.js');"
EXPOSE 4200
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/bin/sh", "/usr/local/bin/entrypoint.sh"]
CMD ["serve"]

# Preserve service health semantics; liveness is exercised by the local gate.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:4200/health || exit 1
RUN --network=none node /qualification/alpine-service-probe.cjs workspace
