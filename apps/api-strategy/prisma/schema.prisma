// Capiro Strategy API (api-strategy) — Prisma schema.
//
// This service owns the `sp_*` tables in the shared Aurora cluster and is the
// ONLY writer of them. It references apps/api entities (tenants, clients,
// users) by id ONLY — there are no cross-schema foreign keys (mirrors
// apps/workspace's `ws_*` engine). Owner/actor identity is the raw Clerk
// subject string (the service does not own the users table).
//
// Tenant isolation is enforced in application code via PrismaService.withTenant
// (the DMMF-derived query hook injects `where.tenantId`); the RLS policies in
// the migration are defense-in-depth (the runtime `capiro_app` role currently
// bypasses RLS — see the migration header).

generator client {
  provider = "prisma-client-js"
  // Custom output isolates this engine's client from apps/api's @prisma/client
  // in the shared pnpm monorepo. Import via `../generated/prisma-client`.
  // Prisma.dmmf read by the tenant-scope hook MUST come from this client, not
  // from @prisma/client, or the tenant-scoped model set reflects the wrong schema.
  output          = "../generated/prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  // Bookworm slim runtime is OpenSSL 3.x on linux-arm64. `native` covers the
  // build host; the explicit target covers cross-arch buildx builds.
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums --------------------------------------------------------------------

enum SpStrategyType {
  appropriations
  authorization
  regulatory
  coalition
  procurement
  earmark

  @@map("sp_strategy_type")
}

enum SpNodeKind {
  action
  decision
  gate
  milestone
  risk

  @@map("sp_node_kind")
}

enum SpNodeSubject {
  deliverable
  submission
  member
  committee
  ask
  agency
  outcome
  optics

  @@map("sp_node_subject")
}

enum SpNodeStatus {
  draft
  in_progress
  internal_review
  active
  suggested

  @@map("sp_node_status")
}

enum SpAuthorKind {
  person
  meri

  @@map("sp_author_kind")
}

enum SpRefKind {
  congress_milestone
  ppbe_lane_bar
  ppbe_current_phase

  @@map("sp_ref_kind")
}

enum SpArtifactType {
  workspace_draft
  outreach_record

  @@map("sp_artifact_type")
}

// ---- Models -------------------------------------------------------------------

// A strategy. NO status field (handoff §1: removed intentionally — version
// history is the audit trail). Firm-wide collaborative: any org member may
// view/edit; per-strategy ACLs are out of scope.
model SpStrategy {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  clientId           String         @map("client_id") @db.Uuid // apps/api clients.id — no FK
  title              String
  type               SpStrategyType
  goal               String?        @db.Text
  meriContext        String?        @map("meri_context") @db.Text
  // 1-2 sentence Meri plan summary (MRI-2) — set on draft, refreshed after Meri
  // edit-sets; surfaced in the strategy-level rail. Null for manual strategies.
  meriSummary        String?        @map("meri_summary") @db.Text
  // Provenance (SHL-5): true ONLY for a plan Meri drafted from a goal. Distinct
  // from meriSummary, which the assistant path also writes — so the "Meri
  // drafted this" banner must key off this immutable flag, never the summary.
  draftedByMeri      Boolean        @default(false) @map("drafted_by_meri")
  targetDate         DateTime?      @map("target_date") @db.Date
  ownerUserId        String         @map("owner_user_id") // Clerk user id
  createdByUserId    String         @map("created_by_user_id")
  lastEditedByUserId String?        @map("last_edited_by_user_id")
  lastEditedAt       DateTime?      @map("last_edited_at")
  archivedAt         DateTime?      @map("archived_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  nodes     SpNode[]
  versions  SpVersion[]
  artifacts SpNodeArtifact[]

  @@index([tenantId, clientId])
  @@index([tenantId, archivedAt])
  @@map("sp_strategy")
}

// A plan step. True dates are stored; quarter-units are DERIVED render
// coordinates computed from the live fiscal calendar (plan D2).
model SpNode {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  strategyId      String        @map("strategy_id") @db.Uuid
  kind            SpNodeKind
  subject         SpNodeSubject
  title           String
  note            String?       @db.Text
  ownerUserId     String?       @map("owner_user_id")
  status          SpNodeStatus  @default(draft)
  startsOn        DateTime      @map("starts_on") @db.Date
  endsOn          DateTime?     @map("ends_on") @db.Date // null = point event
  openEnded       Boolean       @default(false) @map("open_ended") // ongoing risk ⇒ "Ongoing" label
  meriAuthored    Boolean       @default(false) @map("meri_authored")
  dependsOnIds    String[]      @map("depends_on_ids") @db.Uuid @default([]) // intra-strategy blocker node ids (Phase 2 A1)
  provenance      Json?         @map("provenance") // A9: per-node grounding (cited pack sections/facts)
  targetRef       Json?         @map("target_ref") // ClientTarget snapshot: who this node's outreach/workspace action is for
  createdByUserId String        @map("created_by_user_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  strategy  SpStrategy       @relation(fields: [strategyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  artifacts SpNodeArtifact[]

  @@index([tenantId, strategyId])
  @@map("sp_node")
}

// Full-snapshot version history (WsDocVersion pattern). One version per
// mutation batch; restore replaces current state and itself cuts a version.
model SpVersion {
  id                    String       @id @default(uuid()) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  strategyId            String       @map("strategy_id") @db.Uuid
  snapshot              Json // full strategy meta + nodes[]
  authorKind            SpAuthorKind @map("author_kind")
  authorUserId          String?      @map("author_user_id")
  note                  String
  restoredFromVersionId String?      @map("restored_from_version_id") @db.Uuid
  // True only for coalescible field-edit batches — the versioning policy folds a
  // consecutive same-author field edit into the latest coalescible version;
  // structural events (add/delete/create/restore) and Meri versions are false so
  // they always stand alone in history.
  coalescible           Boolean      @default(false)
  createdAt             DateTime     @default(now()) @map("created_at")

  strategy SpStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, strategyId, createdAt(sort: Desc)])
  @@map("sp_version")
}

// Tenant-wide, ordered firm phases (the config modal edits these). "Firm
// configured" = existence of >=1 row for the tenant.
model SpFirmPhase {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  label           String
  startFy         Int      @map("start_fy") // e.g. 2027
  startQ          Int      @map("start_q") // 1-4 (federal FY quarters)
  endFy           Int      @map("end_fy")
  endQ            Int      @map("end_q") // exclusive end, matching the modal's to-select
  position        Int
  updatedByUserId String   @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId, position])
  @@map("sp_firm_phase")
}

// GLOBAL Capiro-maintained reference baseline (no tenant_id — intentionally
// tenant-scope-exempt). Legislative milestones + PPBE lanes + current phases.
// Seeded at deploy (insert-if-empty) and replaced via the update-strategy-
// reference ops verb.
model SpReferenceEntry {
  id        String    @id @default(uuid()) @db.Uuid
  kind      SpRefKind
  label     String
  fy        Int? // ppbe rows
  startsOn  DateTime? @map("starts_on") @db.Date // null for ppbe_current_phase
  endsOn    DateTime? @map("ends_on") @db.Date
  tone      String? // ink|info|accent|notable|critical|success
  position  Int
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([kind, active, position])
  @@map("sp_reference_entry")
}

// Tenant fork of the reference baseline (fork-on-edit). Renderer prefers tenant
// rows for a kind when >=1 exists, else the global baseline.
model SpReferenceOverride {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  kind            SpRefKind
  label           String
  fy              Int?
  startsOn        DateTime? @map("starts_on") @db.Date
  endsOn          DateTime? @map("ends_on") @db.Date
  tone            String?
  position        Int
  active          Boolean   @default(true)
  updatedByUserId String    @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, kind, position])
  @@map("sp_reference_override")
}

// Node <-> artifact back-links (Workspace draft / Outreach record).
model SpNodeArtifact {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  strategyId      String         @map("strategy_id") @db.Uuid
  nodeId          String         @map("node_id") @db.Uuid
  artifactType    SpArtifactType @map("artifact_type")
  artifactRef     String         @map("artifact_ref") // ws_draft.id / outreach_records.id
  createdByUserId String         @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  node     SpNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  strategy SpStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([nodeId, artifactType, artifactRef])
  @@index([tenantId, strategyId])
  @@map("sp_node_artifact")
}

// Append-only activity log (audit_logs pattern; enforced by a BEFORE
// UPDATE/DELETE trigger in the migration). actorUserId null => system/meri.
model SpActivityLog {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  actorUserId String?      @map("actor_user_id")
  authorKind  SpAuthorKind @map("author_kind")
  action      String // strategy.created, node.updated, firm_phases.updated, reference.forked, version.restored, ...
  entityType  String       @map("entity_type")
  entityId    String       @map("entity_id")
  before      Json?
  after       Json?
  requestId   String?      @map("request_id")
  occurredAt  DateTime     @default(now()) @map("occurred_at")

  @@index([tenantId, entityType, entityId, occurredAt])
  @@map("sp_activity_log")
}

// ---- Phase 2 agent runtime (Stage C) --------------------------------------------
//
// Context Steward / Strategy Watcher / Execution Agent substrate. All tables are
// tenant-scoped (auto-covered by the DMMF tenant-scope hook + RLS in the
// migration). LLM loops live in the orchestrator; these tables hold missions,
// runs, proposals, and the context corpus. Stage C creates the schema + the
// no-LLM run/ChangeSet lifecycle; Stages D-G populate the content.

enum SpContextDocState {
  draft
  active
  superseded
  archived

  @@map("sp_context_doc_state")
}

enum SpContextScope {
  once
  node
  strategy
  client
  firm

  @@map("sp_context_scope")
}

enum SpFactState {
  active
  superseded
  stale
  rejected

  @@map("sp_fact_state")
}

enum SpConflictState {
  open
  resolved
  dismissed

  @@map("sp_conflict_state")
}

enum SpMissionState {
  draft
  active
  paused
  completed
  failed
  canceled

  @@map("sp_mission_state")
}

enum SpRunState {
  queued
  planning
  waiting_for_input
  executing
  ready_for_review
  completed
  failed
  canceled

  @@map("sp_run_state")
}

enum SpRunTrigger {
  manual
  scheduled
  event

  @@map("sp_run_trigger")
}

enum SpChangeSetStatus {
  proposed
  approved
  rejected
  applied
  undone
  stale

  @@map("sp_change_set_status")
}

enum SpChangeSetRisk {
  low
  medium
  high
  critical

  @@map("sp_change_set_risk")
}

// A context-pack markdown document (00-13 templates, Stage D contract).
// clientId null => firm-scoped. scopeRef carries the node/strategy id when
// scope is node/strategy. Supersession keeps history (state=superseded, new
// row points back via supersedesId); checksum dedupes re-uploads.
model SpContextDocument {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  clientId        String?           @map("client_id") @db.Uuid // apps/api clients.id — no FK
  scope           SpContextScope
  scopeRef        String?           @map("scope_ref") @db.Uuid // node/strategy id when scoped
  templateKey     String            @map("template_key") // e.g. "03_engagement_history" (Stage D contract)
  title           String
  state           SpContextDocState @default(draft)
  content         String            @db.Text // raw markdown body
  frontmatter     Json? // parsed + validated front-matter (Stage D validator)
  checksum        String // sha256 of content — dedupe/change detection
  supersedesId    String?           @map("supersedes_id") @db.Uuid
  validUntil      DateTime?         @map("valid_until") @db.Date // staleness horizon
  createdByUserId String            @map("created_by_user_id")
  updatedByUserId String?           @map("updated_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  facts SpContextFact[]

  @@index([tenantId, clientId, state])
  @@index([tenantId, templateKey, state])
  @@map("sp_context_document")
}

// A structured fact the Steward (Stage E) extracts from a context document.
// sourceRef anchors the exact heading/row; SpNode.provenance upgrades to
// `fact:<id>` refs in Stage E. clientId denormalized for eligibility queries.
model SpContextFact {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  documentId String        @map("document_id") @db.Uuid
  clientId   String?       @map("client_id") @db.Uuid
  fact       String        @db.Text
  sourceRef  String        @map("source_ref") // heading / table-row anchor within the document
  authority  String? // who asserted it (e.g. "client CEO", "public filing")
  asOf       DateTime?     @map("as_of") @db.Date
  confidence Float? // 0-1 extraction confidence
  state      SpFactState   @default(active)
  citation   String? // verbatim source snippet
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  document SpContextDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, documentId])
  @@index([tenantId, clientId, state])
  @@map("sp_context_fact")
}

// Two facts in material disagreement (Stage E detection). Blocking semantics:
// an OPEN material conflict blocks Execution-Agent eligibility (Stage G) and
// annotates drafts (Stage A8 health) — it never blocks a human.
model SpContextConflict {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  factAId          String          @map("fact_a_id") @db.Uuid
  factBId          String          @map("fact_b_id") @db.Uuid
  material         Boolean         @default(false)
  state            SpConflictState @default(open)
  resolutionNote   String?         @map("resolution_note")
  resolvedByUserId String?         @map("resolved_by_user_id")
  resolvedAt       DateTime?       @map("resolved_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([tenantId, state])
  @@map("sp_context_conflict")
}

// A standing agent mission ("Keep this strategy on track"). strategyId null =>
// firm-level mission (calendar watch). cadence is a coarse keyword ("daily",
// "weekly") interpreted by the F2 scheduler; nextRunAt is its claim column
// (FOR UPDATE SKIP LOCKED).
model SpAgentMission {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  strategyId      String?        @map("strategy_id") @db.Uuid
  clientId        String?        @map("client_id") @db.Uuid
  name            String
  description     String?        @db.Text
  state           SpMissionState @default(draft)
  cadence         String? // "daily" | "weekly" | null (manual-only)
  nextRunAt       DateTime?      @map("next_run_at")
  createdByUserId String         @map("created_by_user_id")
  updatedByUserId String?        @map("updated_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  runs SpAgentRun[]

  @@index([tenantId, strategyId])
  @@index([state, nextRunAt])
  @@map("sp_agent_mission")
}

// One execution of a mission. Lifecycle (enforced in code, run-state.ts):
// queued -> planning -> waiting_for_input/executing -> ready_for_review ->
// completed | failed | canceled. idempotencyKey dedupes re-triggers (unique per
// tenant); createdByUserId null => system/scheduler-triggered.
model SpAgentRun {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  missionId       String       @map("mission_id") @db.Uuid
  strategyId      String?      @map("strategy_id") @db.Uuid
  state           SpRunState   @default(queued)
  trigger         SpRunTrigger
  idempotencyKey  String       @map("idempotency_key")
  startedAt       DateTime?    @map("started_at")
  finishedAt      DateTime?    @map("finished_at")
  findings        Json? // deterministic-check + (later) LLM-interpretation findings
  waitingReason   String?      @map("waiting_reason") // set when state=waiting_for_input
  error           String?
  createdByUserId String?      @map("created_by_user_id") // null => system
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  mission SpAgentMission @relation(fields: [missionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, missionId, createdAt(sort: Desc)])
  @@map("sp_agent_run")
}

// A proposed edit-set (Watcher output / person-authored proposal). ops reuse
// the Meri assistant edit shape and are re-validated on apply through the SAME
// pipeline (one meri version per applied ChangeSet). strategyVersionId pins the
// head the proposal was computed against — apply on a moved head => stale.
// Undo = restore that pinned version (the existing restore path).
model SpChangeSet {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  strategyId        String            @map("strategy_id") @db.Uuid
  runId             String?           @map("run_id") @db.Uuid
  summary           String
  ops               Json // Meri edit-set shape: [{op, nodeId?, ...fields, dependsOn?}]
  risk              SpChangeSetRisk
  status            SpChangeSetStatus @default(proposed)
  strategyVersionId String            @map("strategy_version_id") @db.Uuid // pinned head at compute time
  appliedVersionId  String?           @map("applied_version_id") @db.Uuid // version the apply cut
  approvedByUserId  String?           @map("approved_by_user_id")
  approvedAt        DateTime?         @map("approved_at")
  approvedOps       Json?             @map("approved_ops") // selective approval subset
  rejectedByUserId  String?           @map("rejected_by_user_id")
  rejectedAt        DateTime?         @map("rejected_at")
  appliedByUserId   String?           @map("applied_by_user_id")
  appliedAt         DateTime?         @map("applied_at")
  undoneByUserId    String?           @map("undone_by_user_id")
  undoneAt          DateTime?         @map("undone_at")
  createdByUserId   String?           @map("created_by_user_id") // null => watcher/system
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([tenantId, strategyId, status])
  @@map("sp_change_set")
}

// Per-tenant agent permission knobs (risk-ladder overrides, caps). Key-value
// so Stage F/G policy grows without migrations.
model SpAgentPermissionPolicy {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  key             String // e.g. "autoApply.maxRisk", "runs.maxConcurrent"
  value           Json
  updatedByUserId String   @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@map("sp_agent_permission_policy")
}

// Transactional outbox: emitted in the SAME tx as every strategy/node mutation
// (via VersioningService.logActivity — the one choke point every bump site
// already flows through). The F2 Watcher consumer polls unconsumed rows and
// marks consumed_at idempotently.
model SpEventOutbox {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  type       String // the activity action, e.g. "node.updated", "version.restored"
  payload    Json // { entityType, entityId, actorUserId, authorKind, ... }
  createdAt  DateTime  @default(now()) @map("created_at")
  consumedAt DateTime? @map("consumed_at")

  @@index([consumedAt, createdAt])
  @@index([tenantId, createdAt])
  @@map("sp_event_outbox")
}
