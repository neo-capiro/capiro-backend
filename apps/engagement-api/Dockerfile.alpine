# Alpine qualification candidate; the Debian Dockerfile remains unchanged.
# Build context: repository root. Default pin is the Core-qualified amd64 image.
# arm64 requires the explicit NODE_IMAGE override documented in the gate guide.
# Fresh production install preserves pnpm links and musl Prisma without dev tools.
ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22.23.3-alpine3.24@sha256:2c752226d477b4a886378baa95b9af252be59301b725fdb0b7e15208131505a8
FROM ${NODE_IMAGE} AS base
ARG TARGETARCH
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN apk add --no-cache "zlib>=1.3.2-r1"
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /workspace

FROM base AS build
RUN apk add --no-cache openssl ca-certificates python3 make g++
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/meriv2-core/package.json packages/meriv2-core/package.json
COPY packages/defense-domain/package.json packages/defense-domain/package.json
COPY packages/defense-contracts/package.json packages/defense-contracts/package.json
RUN --mount=type=cache,id=pnpm-wave2-alpine-${TARGETARCH},target=/pnpm/store \
    pnpm install --frozen-lockfile --filter=@capiro/api... --filter=@capiro/shared... --filter=@capiro/meriv2-core... --filter=@capiro/defense-domain... --filter=@capiro/defense-contracts...

COPY packages/shared/src packages/shared/src
COPY packages/shared/tsconfig.json packages/shared/tsconfig.json
COPY packages/meriv2-core/src packages/meriv2-core/src
COPY packages/meriv2-core/tsconfig.json packages/meriv2-core/tsconfig.json
COPY packages/defense-domain/src packages/defense-domain/src
COPY packages/defense-domain/tsconfig.json packages/defense-domain/tsconfig.json
COPY packages/defense-contracts/src packages/defense-contracts/src
COPY packages/defense-contracts/tsconfig.json packages/defense-contracts/tsconfig.json
COPY apps/api/src apps/api/src
COPY apps/api/tsconfig.json apps/api/tsconfig.build.json apps/api/nest-cli.json apps/api/
COPY apps/api/prisma apps/api/prisma
# Only the DB URL helper is needed by the engagement-api entrypoint.
# Do NOT copy all of apps/api/scripts (no sync-*/diag-* needed).
COPY apps/api/scripts/lib/pe-compose-database-url.js apps/api/scripts/lib/pe-compose-database-url.js

RUN pnpm --filter @capiro/shared build
RUN pnpm --filter @capiro/meriv2-core build
RUN pnpm --filter @capiro/defense-domain build
RUN pnpm --filter @capiro/defense-contracts build
COPY apps/api/scripts/qualification/prisma-musl-target.cjs apps/api/scripts/qualification/qualification-platform.cjs /qualification/
RUN CAPIRO_QUALIFICATION_ARCH="$(node -p process.arch)" node /qualification/prisma-musl-target.cjs apps/api/prisma/schema.prisma
RUN pnpm --filter @capiro/api exec prisma generate
# Same heap ceiling apps/api/Dockerfile already uses for this exact target. The
# default is no longer enough for `nest build` over apps/api, so without this the
# build aborts with a V8 OOM (exit 134) and no engagement-api image can be
# produced at all — here or in CI.
RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm --filter @capiro/api build

FROM build AS qualification
COPY apps/api/jest* apps/api/
COPY apps/api/test apps/api/test
COPY apps/api/scripts apps/api/scripts
WORKDIR /workspace/apps/api
CMD ["pnpm", "exec", "jest", "--runInBand"]

FROM base AS production-dependencies
RUN apk add --no-cache openssl ca-certificates python3 make g++
COPY --from=build /workspace/pnpm-workspace.yaml /workspace/package.json /workspace/pnpm-lock.yaml ./
COPY --from=build /workspace/apps/api/package.json apps/api/package.json
COPY --from=build /workspace/packages/shared/package.json packages/shared/package.json
COPY --from=build /workspace/packages/meriv2-core/package.json packages/meriv2-core/package.json
COPY --from=build /workspace/packages/defense-domain/package.json packages/defense-domain/package.json
COPY --from=build /workspace/packages/defense-contracts/package.json packages/defense-contracts/package.json
COPY --from=build /workspace/apps/api/prisma apps/api/prisma
RUN --mount=type=cache,id=pnpm-wave2-alpine-${TARGETARCH},target=/pnpm/store \
    pnpm install --frozen-lockfile --prod --filter=@capiro/api... --filter=@capiro/shared... --filter=@capiro/meriv2-core... --filter=@capiro/defense-domain... --filter=@capiro/defense-contracts...
RUN pnpm --filter @capiro/api exec prisma generate

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
ENV NODE_OPTIONS=--enable-source-maps
RUN addgroup -S -g 1001 capiro \
 && adduser -S -D -H -u 1001 -G capiro -s /sbin/nologin capiro \
 && apk add --no-cache wget ca-certificates dumb-init openssl "zlib>=1.3.2-r1"
RUN mkdir -p /app/tmp /tmp \
 && chmod 1777 /tmp \
 && chown capiro:capiro /app/tmp
ENV TMPDIR=/app/tmp
WORKDIR /app

# Copy the entire workspace, pnpm's symlinked node_modules + the generated
# Prisma client + the compiled API. Same layout as the main API image.
COPY --chown=capiro:capiro --from=production-dependencies /workspace/node_modules /app/node_modules
COPY --chown=capiro:capiro --from=build /workspace/packages/shared/dist /app/packages/shared/dist
COPY --chown=capiro:capiro --from=build /workspace/packages/shared/package.json /app/packages/shared/package.json
COPY --chown=capiro:capiro --from=build /workspace/packages/meriv2-core/dist /app/packages/meriv2-core/dist
COPY --chown=capiro:capiro --from=build /workspace/packages/meriv2-core/package.json /app/packages/meriv2-core/package.json
# meriv2-core has workspace deps of its own — copy its node_modules or the API
# crashloops at boot with MODULE_NOT_FOUND '@capiro/shared'.
COPY --chown=capiro:capiro --from=production-dependencies /workspace/packages/meriv2-core/node_modules /app/packages/meriv2-core/node_modules
COPY --chown=capiro:capiro --from=build /workspace/packages/defense-domain/dist /app/packages/defense-domain/dist
COPY --chown=capiro:capiro --from=build /workspace/packages/defense-domain/package.json /app/packages/defense-domain/package.json
# defense-domain depends on @capiro/shared like meriv2-core does — same reason,
# same fix: copy its local node_modules symlink or the API crashloops at boot.
COPY --chown=capiro:capiro --from=production-dependencies /workspace/packages/defense-domain/node_modules /app/packages/defense-domain/node_modules
COPY --chown=capiro:capiro --from=build /workspace/packages/defense-contracts/dist /app/packages/defense-contracts/dist
COPY --chown=capiro:capiro --from=build /workspace/packages/defense-contracts/package.json /app/packages/defense-contracts/package.json
COPY --chown=capiro:capiro --from=build /workspace/apps/api/dist /app/apps/api/dist
COPY --chown=capiro:capiro --from=production-dependencies /workspace/apps/api/node_modules /app/apps/api/node_modules
COPY --chown=capiro:capiro --from=production-dependencies /workspace/apps/api/prisma /app/apps/api/prisma
COPY --chown=capiro:capiro --from=build /workspace/apps/api/package.json /app/apps/api/package.json
# The DB URL helper used by the entrypoint.
COPY --chown=capiro:capiro --from=build /workspace/apps/api/scripts/lib/pe-compose-database-url.js /app/apps/api/scripts/lib/pe-compose-database-url.js
# tsx is NOT needed in the engagement-api image (serve-only; no sync-* or
# diag-* scripts). Do NOT copy apps/api/scripts or apps/api/src.

COPY --chown=capiro:capiro apps/engagement-api/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

COPY scripts/qualification/alpine-service-probe.cjs /qualification/alpine-service-probe.cjs
USER capiro
WORKDIR /app/apps/api
EXPOSE 4500
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["serve"]

# Preserve service health semantics; liveness is exercised by the local gate.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:4500/health || exit 1
RUN --network=none node /qualification/alpine-service-probe.cjs engagement-api
