{
  "name": "@capiro/defense-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm prisma:generate && node -e \"try{require('fs').unlinkSync('tsconfig.tsbuildinfo')}catch{}\" && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "bash scripts/entrypoint.sh serve",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "test": "tsx --test src/**/*.spec.ts",
    "verify:boundary": "node ../../scripts/verify-phase8-session2.mjs",
    "verify:session4": "node ../../scripts/verify-phase8-session4.mjs",
    "verify:session6": "node ../../scripts/verify-phase8-session6.mjs --enforce-corpus",
    "verify:session6:db": "node ../../scripts/verify-phase8-session6-db.mjs",
    "prepare:session6:federal-funding": "node ../../scripts/prepare-phase8-session6-federal-funding-corpus.mjs",
    "ingest:session6:federal-funding": "node scripts/ingest-federal-funding.mjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "verify:session4:replay": "node ../../scripts/phase8-session4-fy27-replay.mjs --out docs/defense-budget/phase8-session4-fy27-replay-evidence.json"
  },
  "dependencies": {
    "@capiro/auth": "workspace:*",
    "@capiro/defense-client": "workspace:*",
    "@capiro/defense-contracts": "workspace:*",
    "@capiro/defense-domain": "workspace:*",
    "@capiro/shared": "workspace:*",
    "@clerk/backend": "^1.13.5",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^4.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/node": "^20.16.10",
    "prisma": "^5.20.0",
    "typescript": "^5.5.4",
    "tsx": "^4.19.1"
  }
}
