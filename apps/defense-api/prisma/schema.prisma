/// Tenant-scoped audit log. Session 3 writes here (via withTenant/withTenantActor)
/// for every mutation the frozen contract requires an audit trail for — the same
/// physical table apps/api's AuditLog model writes, never imported as code.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?    @map("before_jsonb")
  after       Json?    @map("after_jsonb")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Bounded read-only cross-domain projections (Congress / SAM / awards).
//
// These models read the SAME physical tables apps/api's Congress/SAM/USAspending
// modules own. Session 3 does not import apps/api's Congress/SAM/USAspending
// service CODE — no TypeScript import crosses that boundary — but a read-only
// Prisma projection onto tables those domains populate is the "bounded read
// adapter" the assignment calls for. No PE<->BLIN identity coercion occurs;
// peCode here is exactly the pre-linked attribution the owning domain already
// stored (bill.peCodes, samOpportunityMatch.peCode, federalAward.peCode).
// ---------------------------------------------------------------------------

model CongressBill {
  id               String    @id
  congress         Int
  billType         String    @map("bill_type")
  billNumber       String    @map("bill_number")
  title            String
  latestActionText String?   @map("latest_action_text")
  latestActionDate DateTime? @map("latest_action_date") @db.Date
  introducedDate   DateTime? @map("introduced_date") @db.Date
  policyArea       String?   @map("policy_area")
  peCodes          String[]  @default([]) @map("pe_codes")
  sponsorName      String?   @map("sponsor_name")
  url              String?

  actions       CongressBillAction[]
  committeeRefs CongressBillCommittee[]

  @@map("congress_bill")
}

model CongressBillAction {
  id      String       @id @default(uuid())
  billId  String       @map("bill_id")
  date    DateTime
  text    String
  type    String?
  chamber String?
  bill    CongressBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("congress_bill_action")
}

model CongressBillCommittee {
  id            String       @id @default(uuid())
  billId        String       @map("bill_id")
  committeeName String       @map("committee_name")
  bill          CongressBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("congress_bill_committee")
}

model BillBudgetLineLink {
  id         String @id @default(uuid()) @db.Uuid
  billId     String @map("bill_id")
  peCode     String @map("pe_code") @db.VarChar(16)
  linkType   String @map("link_type")
  confidence Float
  evidence   Json
  status     String

  @@map("bill_budget_line_link")
}

model BudgetPackageVehicle {
