/// FederalAward: read-only bounded projection of USAspending award rows that
/// carry a PE-code attribution. Session 3 reads this via the defense-api's own
/// Prisma client (no apps/api import) and never resolves peCode<->BLIN — the
/// column here is exactly the pre-computed attribution apps/api's ingestion
/// already stored, not a resolver this service invokes.
model FederalAward {
  id                   String    @id @default(uuid()) @db.Uuid
  contractorName       String?   @map("contractor_name")
  amount               Decimal?  @db.Decimal(18, 2)
  peCode               String?   @map("pe_code") @db.VarChar(16)
  peCodeSource         String?   @map("pe_code_source")
  peCodeConfidence     Float?    @map("pe_code_confidence")
  peCodeCandidateCount Int?      @map("pe_code_candidate_count")
  awardingAgency       String?   @map("awarding_agency")
  awardingSubTier      String?   @map("awarding_sub_tier")
  fundingFy            Int?      @map("funding_fy")
  piid                 String?
  actionDate           DateTime? @map("action_date") @db.Date
  dodAcqProgramCode    String?   @map("dod_acq_program_code")

  @@map("federal_award")
}

