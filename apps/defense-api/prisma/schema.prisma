model SamOpportunityMatch {
  id            String  @id @default(uuid()) @db.Uuid
  opportunityId String  @map("opportunity_id") @db.Uuid
  peCode        String? @map("pe_code") @db.VarChar(16)
  matchBasis    String  @map("match_basis")
  confidence    Float   @default(0.5)
  reviewStatus  String  @default("candidate") @map("review_status")

  opportunity SamOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("sam_opportunity_match")
}

// ---------------------------------------------------------------------------
// Session 3 Workstream E additions.
//
// Every model below already exists physically in the shared schema and is
// modeled here ONLY so defense-api can read what the frozen 49-route contract
// actually serves. All are SELECT-only for capiro_defense_serve except the two
// FK tables a program merge must re-point (person_role,
// program_office_program_link), which need UPDATE. No DDL, no promotion
// surface, no canonical snapshot table.
// ---------------------------------------------------------------------------

/// Normalized congressional budget actions (BL-0 derivation). Read-only.
model BudgetAction {
  id           String   @id @default(uuid()) @db.Uuid
  peCode       String   @map("pe_code") @db.VarChar(16)
  fy           Int
  stage        String   @db.VarChar(12)
  action       String   @db.VarChar(16)
  amount       Decimal? @db.Decimal(14, 2)
  baseline     String   @db.VarChar(12)
  note         String?
  evidenceJson Json     @default("{}") @map("evidence_jsonb")
  billId       String?  @map("bill_id")
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([peCode, fy, stage, action], map: "budget_action_natural_key")
  @@map("budget_action")
}

/// Capability taxonomy + its auditable PE match table. `capability_budget_line_match`
/// is the ONLY sanctioned capability<->budget-line association: an accepted row with
/// a recorded `matchedOn` basis. Nothing here derives one native identity from
/// another.
model Capability {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(32)
  name         String
  aliases      String[] @default([])
  taxonomyPath String   @map("taxonomy_path")
  description  String?

  matches CapabilityBudgetLineMatch[]

  @@map("capability")
}

model CapabilityBudgetLineMatch {
  id           String @id @default(uuid()) @db.Uuid
  capabilityId String @map("capability_id") @db.Uuid
  peCode       String @map("pe_code") @db.VarChar(16)
  confidence   String @db.VarChar(8)
  matchedOn    String @map("matched_on")
  status       String @default("accepted") @db.VarChar(12)

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, peCode], map: "capability_budget_line_match_natural_key")
  @@map("capability_budget_line_match")
}

/// Cached NDAA-conference forecast. The HTTP read path SELECTs a cached row and
/// otherwise computes in memory; it never writes here (GAI-25: a read must not
/// write). No INSERT/UPDATE grant exists for capiro_defense_serve on this table,
/// so the invariant is enforced by the database, not just by code.
model ConferenceProbability {
  peCode       String   @map("pe_code") @db.VarChar(16)
  fy           Int
  predicted    Decimal  @db.Decimal(14, 4)
  ciLow        Decimal  @map("ci_low") @db.Decimal(14, 4)
  ciHigh       Decimal  @map("ci_high") @db.Decimal(14, 4)
  confidence   Decimal  @db.Decimal(6, 4)
  modelVersion String   @map("model_version")
  computedAt   DateTime @map("computed_at") @db.Timestamptz(6)

  @@id([peCode, fy])
  @@map("conference_probability")
}

/// Two FK tables a program merge must re-point from the losing program to the
/// keeper. Modeled with only the columns the merge touches - defense-api never
/// reads personnel PII through them, and never surfaces a person on any route in
/// the frozen contract.
model PersonRole {
  id        String  @id @default(uuid()) @db.Uuid
  programId String? @map("program_id") @db.Uuid

  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([programId], map: "person_role_program_id_idx")
  @@map("person_role")
}

model ProgramOfficeProgramLink {
  id        String @id @default(uuid()) @db.Uuid
  officeId  String @map("office_id") @db.Uuid
  programId String @map("program_id") @db.Uuid

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([officeId, programId], map: "program_office_program_link_office_program_key")
  @@map("program_office_program_link")
}
