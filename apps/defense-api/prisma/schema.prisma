generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma-client"
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), pg_trgm, citext, uuidOssp(map: "uuid-ossp")]
}

/// Curated Session 3 defense client. Only Program Elements, Programs, governed
/// overlays and the active-snapshot pointer are modeled here. Cross-domain
/// Congress, SAM, USAspending and capability data remain behind projection views.
model DefenseBudgetActiveSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  domain       String   @db.VarChar(64)
  environment  String   @db.VarChar(32)
  snapshotId   String   @map("snapshot_id") @db.Uuid
  activationId String   @map("activation_id") @db.Uuid
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([domain, environment], map: "defense_budget_active_snapshot_singleton_unique")
  @@map("defense_budget_active_snapshot")
}

model ProgramElement {
  peCode             String    @id @map("pe_code") @db.VarChar(16)
  title              String
  description        String?
  service            String?
  serviceCode        String?   @map("service_code")
  budgetActivity     String?   @map("budget_activity")
  budgetActivityName String?   @map("budget_activity_name")
  appropriationType  String?   @map("appropriation_type")
  lineNumber         String?   @map("line_number")
  acatLevel          String?   @map("acat_level")
  programOfRecord    String?   @map("program_of_record")
  status             String?
  rDocUrl            String?   @map("r_doc_url")
  pDocUrl            String?   @map("p_doc_url")
  oDocUrl            String?   @map("o_doc_url")
  raw                Json      @default("{}") @map("raw_jsonb")
  source             String
  sourceConfidence   Float?    @map("source_confidence")
  firstSeenFy        Int?      @map("first_seen_fy")
  lastSyncedAt       DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  retiredAt          DateTime? @map("retired_at") @db.Timestamptz(6)
  retiredReason      String?   @map("retired_reason")

  years ProgramElementYear[]

  @@map("program_element")
}

model ProgramElementYear {
  id             String   @id @default(uuid()) @db.Uuid
  peCode         String   @map("pe_code") @db.VarChar(16)
  // Relation back to the catalog row so the detail/intelligence reads can hydrate
  // the COMPLETE budget-year history in one query, as apps/api does.
  fy             Int
  request        Decimal? @db.Decimal(14, 2)
  hascMark       Decimal? @map("hasc_mark") @db.Decimal(14, 2)
  sascMark       Decimal? @map("sasc_mark") @db.Decimal(14, 2)
  hacDMark       Decimal? @map("hac_d_mark") @db.Decimal(14, 2)
  sacDMark       Decimal? @map("sac_d_mark") @db.Decimal(14, 2)
  ndaaConference Decimal? @map("ndaa_conference") @db.Decimal(14, 2)
  conference     Decimal? @db.Decimal(14, 2)
  enacted        Decimal? @db.Decimal(14, 2)

  programElement ProgramElement @relation(fields: [peCode], references: [peCode], onDelete: Cascade)

  @@unique([peCode, fy])
  @@map("program_element_year")
}

/// Page-level PE citations - the proof pack. Provenance is the POINT of this
/// table, so every provenance column apps/api serves is modeled here:
/// exhibitType / publisher / snippet / confidence and the SourceDocument link.
/// A citation without them is not a citation.
model ProgramElementSource {
  id               String  @id @default(uuid()) @db.Uuid
  peCode           String  @map("pe_code") @db.VarChar(16)
  fy               Int?
  docType          String  @map("doc_type") @db.VarChar(8)
  exhibitType      String? @map("exhibit_type") @db.VarChar(16)
  pageNumber       Int?    @map("page_number")
  pageEnd          Int?    @map("page_end")
  snippet          String?
  publisher        String? @db.VarChar(64)
  confidence       Float   @default(0.9)
  sourceUrl        String  @map("source_url")
  sourceDocumentId String? @map("source_document_id") @db.Uuid

  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("program_element_source")
}

model ProgramElementProject {
  id             String  @id @default(uuid()) @db.Uuid
  peCode         String  @map("pe_code") @db.VarChar(16)
  projectCode    String  @map("project_code") @db.VarChar(32)
  title          String
  mission        String?
  budgetActivity String? @map("budget_activity")
  fy             Int?
  sourceUrl      String? @map("source_url")
  pageNumber     Int?    @map("page_number")
  confidence     Float   @default(0.9)

  @@unique([peCode, projectCode])
  @@map("program_element_project")
}

