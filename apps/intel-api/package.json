{
  "name": "@capiro/intel-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --detectOpenHandles --forceExit",
    "hearing-intelligence:start": "node dist/hearing/intelligence/run-hearing-intelligence.js --loop",
    "hearing-intelligence:once": "tsx src/hearing/intelligence/run-hearing-intelligence.ts",
    "hearing-intelligence:drain": "tsx src/hearing/intelligence/run-hearing-intelligence.ts --drain",
    "hearing-intelligence:loop": "tsx src/hearing/intelligence/run-hearing-intelligence.ts --loop",
    "hearing-intelligence:backfill": "tsx src/hearing/intelligence/run-hearing-intelligence.ts --backfill --drain",
    "hearing-intelligence:relevance-backfill": "tsx src/hearing/intelligence/run-hearing-intelligence.ts --relevance-backfill --drain",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1132.0",
    "@aws-sdk/client-ecs": "3.1132.0",
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/client-sesv2": "^3.1132.0",
    "@aws-sdk/client-sns": "3.1132.0",
    "@aws-sdk/s3-request-presigner": "3.1132.0",
    "@capiro/meriv2-core": "workspace:^",
    "@capiro/shared": "workspace:*",
    "@clerk/backend": "^1.13.5",
    "@deepgram/sdk": "^3.9.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-ws": "^10.4.4",
    "@nestjs/websockets": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^4.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.12",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  }
}
