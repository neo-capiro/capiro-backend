// Capiro Intel API schema.
// Scope: the modular intelligence service. Owns ONLY intel_* tables in the
// shared Aurora cluster. Tenant-scoped: every row carries tenant_id NOT NULL
// and is filtered in application code by the TenantGuard-resolved tenantId.
//
// This is a SEPARATE Prisma schema from apps/api and apps/workspace. The intel
// service (@capiro/intel-api) is the only writer of intel_* tables. It does NOT
// define or migrate any apps/api-owned table (tenants, users, clients, bills,
// hearings, etc.); it references them by id only (no cross-schema FKs).
//
// First capability: Live Hearing Intelligence. Future intel capabilities add
// their own intel_* tables to THIS schema.

generator client {
  provider        = "prisma-client-js"
  // Custom output isolates the intel client from apps/api's @prisma/client in
  // the shared pnpm monorepo. Import via `../generated/prisma-client`.
  output          = "../generated/prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- feature gating ---------------------------------------------------------

/// Tenant-scoped feature flag. A feature (e.g. "hearing_watch") is visible to a
/// tenant ONLY when an enabled row exists for (feature, tenantId). Seeded with
/// the Capiro internal tenant only; flip on per-tenant by inserting a row — no
/// redeploy. Backend routes enforce this (authoritative); the UI hides itself
/// cosmetically based on the same lookup.
model FeatureFlag {
  id        String   @id @default(cuid())
  feature   String
  tenantId  String   @map("tenant_id")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([feature, tenantId])
  @@index([feature, enabled])
  @@map("intel_feature_flag")
}

// --- client watchlists (H2) -------------------------------------------------

/// A per-client watchlist: the set of terms that make a hearing moment relevant
/// to that client. Tenant-scoped. The matching engine scores each final
/// transcript segment against a tenant's active watchlist terms.
model Watchlist {
  id         String           @id @default(cuid())
  tenantId   String           @map("tenant_id")
  clientId   String           @map("client_id")
  name       String
  active     Boolean          @default(true)
  createdBy  String           @map("created_by")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  // Bill-tracker unification (Phase 2): enabled issue areas carried from the
  // legacy ClientWatchlist.issue_areas. The ONLY column added to this table.
  issueAreas String[]         @default([]) @map("issue_areas")
  // State Legislation Platform (Phase 0, DD5) — additive, default-preserving:
  // empty = federal-only (today's behavior, zero migration surprise);
  // non-null entries also match the state corpus for those states.
  jurisdictions String[]      @default([]) @map("jurisdictions")
  // LegiWatch Gate B (P1-02): targeting is SHARED across the firm, and the
  // Configure panel autosaves the whole payload 600ms after any keystroke — so
  // two analysts on the same client used to silently overwrite each other.
  // `version` is the optimistic-concurrency token (bumped on every accepted
  // PUT; a stale expectedVersion gets a 409) and `updatedBy` the attribution.
  // Starts at 0 on existing rows so the first versioned PUT sends 0 and matches.
  version    Int              @default(0)
  updatedBy  String?          @map("updated_by")
  terms      WatchlistTerm[]
  topics     WatchlistTopic[]

  @@index([tenantId, clientId])
  @@index([tenantId, active])
  @@map("intel_watchlist")
}

/// LegiWatch Gate B (P1-02): one accepted `putWatchlist` = one revision row, so
/// the Configure panel can answer "who changed this client's targeting, when, and
/// what did they change". Written inside the same transaction as the reconcile, so
/// a rolled-back save leaves no phantom revision. Append-only; never updated.
model IntelWatchlistRevision {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  clientId    String   @map("client_id")
  watchlistId String   @map("watchlist_id")
  version     Int
  changedBy   String?  @map("changed_by")
  /// { topics, terms, issueAreas, jurisdictions, renamed[], deleted[] } — counts +
  /// the label-level diff, never the term values themselves.
  summary     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, clientId, version])
  @@map("intel_watchlist_revision")
}

/// One watchlist term. `termType` categorizes it (bill, agency, committee,
/// legislator, company, competitor, topic, risk_phrase, support_language,
/// opposition_language). `value` is the literal/normalized string to match;
/// `weight` boosts high-priority terms in relevance scoring.
model WatchlistTerm {
  id          String          @id @default(cuid())
  watchlistId String          @map("watchlist_id")
  tenantId    String          @map("tenant_id")
  termType    String          @map("term_type")
  value       String
  weight      Float           @default(1)
  // Bill-tracker unification (Phase 2): null = watchlist-global (hearing-style
  // flat term); non-null = belongs to a bill-tracker topic. Additive column.
  topicId     String?         @map("topic_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  watchlist   Watchlist       @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  topic       WatchlistTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([watchlistId])
  @@index([tenantId, termType])
  @@index([topicId])
  @@map("intel_watchlist_term")
}

/// A watchlist topic = a bill-tracker "tag" (e.g. "data center load"): a themed
/// grouping of terms with a client position + priority. Hearing-style flat terms
/// keep topicId = NULL (watchlist-global); bill-tracker terms hang off a topic.
model WatchlistTopic {
  id          String          @id @default(cuid())
  watchlistId String          @map("watchlist_id")
  tenantId    String          @map("tenant_id")
  label       String
  issueArea   String?         @map("issue_area")
  position    String          @default("monitor") // 'support'|'oppose'|'monitor'
  priority    String          @default("med") //     'low'|'med'|'high'
  createdAt   DateTime        @default(now()) @map("created_at")
  watchlist   Watchlist       @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  terms       WatchlistTerm[]

  // LegiWatch Gate B (P0-03 item 5): `label` is the de-facto topic identity
  // everywhere downstream (the compiler groups terms by label; the mapper dedupes
  // by lower-cased label), so make it the real key. This is what lets putWatchlist
  // upsert per topic instead of delete-all-then-recreate — which minted a fresh
  // cuid for every topic on every autosave, so no topic id was ever stable.
  @@unique([watchlistId, label])
  @@index([watchlistId])
  @@index([tenantId, watchlistId])
  @@map("intel_watchlist_topic")
}

/// A match between a transcript segment and a watchlist term — the atomic unit
/// the alert layer consumes. Carries the score + the segment anchor.
model WatchlistMatch {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  sessionId   String   @map("session_id")
  segmentId   String   @map("segment_id")
  clientId    String   @map("client_id")
  watchlistId String   @map("watchlist_id")
  termId      String   @map("term_id")
  termType    String   @map("term_type")
  termValue   String   @map("term_value")
  score       Float
  startMs     Int      @map("start_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, sessionId])
  @@index([tenantId, clientId])
  @@map("intel_watchlist_match")
}

// --- tracker: curated bills (supersedes apps/api tracked_bill) ---------------

/// A client's curated tracked bill + the lastSeen snapshot used by shadow change
/// detection. billId is the raw congress_bill.id string (e.g. "119-hr-1234").
model TrackedBill {
  id                   String    @id @default(cuid())
  tenantId             String    @map("tenant_id")
  clientId             String    @map("client_id")
  billId               String    @map("bill_id")
  source               String    @default("congress") // 'congress'|'state'
  note                 String?
  // Bill 360 editable client-bill context (Release R1, §1.3). All nullable/
  // additive; analyst-owned (origin=analyst) — NEVER overwrite canonical bill
  // status. `note` above is preserved; `analystNote` is the new deliberate home.
  position             String?   // 'support'|'oppose'|'monitor'
  priority             String?   // 'low'|'med'|'high'
  analystNote          String?   @map("analyst_note")
  expectedMilestoneType String?  @map("expected_milestone_type") // @capiro/shared EXPECTED_MILESTONE_TYPES
  expectedWindowStart  DateTime? @map("expected_window_start")
  expectedWindowEnd    DateTime? @map("expected_window_end")
  expectedConfidence   String?   @map("expected_confidence") // 'low'|'medium'|'high'
  expectedRationale    String?   @map("expected_rationale")
  expectedUpdatedBy    String?   @map("expected_updated_by") // clerk user id
  expectedUpdatedAt    DateTime? @map("expected_updated_at")
  isManual             Boolean   @default(false) @map("is_manual")
  trackedBy            String?   @map("tracked_by")
  trackedAt            DateTime  @default(now()) @map("tracked_at")
  stage                String?
  lastSeenActionText   String?   @map("last_seen_action_text")
  lastSeenActionDate   DateTime? @map("last_seen_action_date")
  lastSeenAt           DateTime? @map("last_seen_at")
  // LegiWatch B watermarks — separate signals the action-text watermark can't
  // see: canonical status transitions (rule_failed/passed_chamber), cosponsor
  // count deltas (momentum), and text-version changes (updateDateIncludingText).
  lastSeenStatus       String?   @map("last_seen_status")
  lastSeenCosponsors   Int?      @map("last_seen_cosponsors")
  lastSeenTextDate     DateTime? @map("last_seen_text_date")
  // Last-alerted CBO estimate id / hearing id — gate B7 fiscal + B3 hearing to
  // fire only on a genuinely new id (else pre-existing rows false-alert on the
  // 2nd sweep and re-fire every 14 days). Baselined on the first B-sweep.
  lastSeenFiscalId     String?   @map("last_seen_fiscal_id")
  lastSeenHearingKey   String?   @map("last_seen_hearing_key")
  unread               Boolean   @default(false)
  // Phase 6 (§9.2 step E): Board "discussed at hearing" badge. Set by the
  // bill-hearing linker; kept SEPARATE from the lastSeenAction* congress watermark
  // (which detect-bill-changes owns — clobbering it corrupts change detection).
  lastHearingSessionId String?   @map("last_hearing_session_id")
  lastHearingAt        DateTime? @map("last_hearing_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([clientId, billId])
  @@index([tenantId, clientId])
  @@index([billId])
  // P1-18: keyset pagination over the board orders by (trackedAt desc, billId
  // desc) — tenant-wide (getTenantBoard) and per-client (getBoard).
  @@index([tenantId, trackedAt])
  @@index([tenantId, clientId, trackedAt])
  @@map("intel_tracked_bill")
}

/// Per-(client,bill) recommendation-match snapshot (LegiWatch B1, new_match).
/// Recommendations were compute-on-read only; this persists which bills have
/// already crossed a client's watchlist fit floor, so the new-match detector
/// can anti-join and fire exactly once per newly-matching bill (dedup = the
/// unique key, not the 14-day window). NOT a tracked bill — a candidate the
/// client has not yet added to the board.
model BillMatch {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  clientId     String   @map("client_id")
  billId       String   @map("bill_id")
  fit          Float
  matchedTags  String[] @map("matched_tags")
  // Nullable (State Legislation Platform, Phase 0) — congress is meaningless
  // for a state-bill match row. jurisdiction carries 'US' | <state code>.
  congress     Int?
  jurisdiction String   @default("US")
  firstSeenAt  DateTime @default(now()) @map("first_seen_at")
  lastFitAt    DateTime @default(now()) @map("last_fit_at")

  @@unique([clientId, billId])
  @@index([tenantId, clientId])
  @@map("intel_bill_match")
}

// --- unified alert (bill + hearing + combined) ------------------------------

/// The unified alert object (§6). sourceType distinguishes bill/hearing/combined;
/// evidence carries the source-specific proof (bill diff/section or transcript
/// timestamp). Shadow phase writes status='new' and never delivers.
model IntelAlert {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  clientId          String    @map("client_id")
  sourceType        String    @map("source_type") //  'bill'|'hearing'|'combined'
  sourceRef         String    @map("source_ref") //   billId | sessionId | composite
  watchlistId       String?   @map("watchlist_id")
  topicId           String?   @map("topic_id")
  termId            String?   @map("term_id")
  kind              String
  changeType        String?   @map("change_type") //  classifyChange() output (bill path)
  severity          String //                         'info'|'notable'|'critical'
  materiality       String //                         'low'|'medium'|'high'
  score             Float     @default(0)
  clientImpact      String?   @map("client_impact") // 'favorable'|'unfavorable'|'monitor'
  urgency           String? //                        'low'|'med'|'high'
  title             String
  whyItMatters      String?   @map("why_it_matters")
  recommendedAction String?   @map("recommended_action")
  evidence          Json      @default("{}")
  status            String    @default("new") //       new|reviewed|sent|dismissed|snoozed|suppressed
  // Phase-6 idempotency key (§9.4/§9.5): 'combined:'+clientId+':'+billId+':'+sessionId
  // or 'hearing:'+clientId+':'+sessionId. Added by the Phase-6 migration; NOT
  // present in the Phase-3/Phase-4 intel_alert — do NOT assume it before Phase 6.
  dedupeKey         String?   @unique @map("dedupe_key")
  createdAt         DateTime  @default(now()) @map("created_at")
  deliveredAt       DateTime? @map("delivered_at")

  @@index([tenantId, clientId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, sourceType, sourceRef])
  // Phase-6 feed (§9.8) score-ordering: keyset pagination on score DESC.
  @@index([tenantId, clientId, score, createdAt])
  // P11 global cross-client roll-up: tenant-wide keyset pagination (no clientId
  // predicate). The per-client indexes above lead with client_id and can't back a
  // tenant-only scan, so the roll-up gets its own leading-tenant indexes.
  @@index([tenantId, createdAt])
  @@index([tenantId, score, createdAt])
  @@map("intel_alert")
}

// --- alert delivery: preferences, notification log, digest queue, feedback --

/// 1:1 carry of the legacy apps/api alert_preference (per user, per client).
model IntelAlertPreference {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  clientId         String   @map("client_id")
  userId           String   @map("user_id")
  triggers         String[] @default([])
  materiality      String   @default("medium")
  emailEnabled     Boolean  @default(false) @map("email_enabled")
  emailAddress     String?  @map("email_address")
  emailCadence     String   @default("realtime") @map("email_cadence")
  smsEnabled       Boolean  @default(false) @map("sms_enabled")
  smsPhone         String?  @map("sms_phone")
  smsPhoneVerified Boolean  @default(false) @map("sms_phone_verified")
  smsCadence       String   @default("realtime") @map("sms_cadence")
  quietHoursStart  String?  @map("quiet_hours_start")
  quietHoursEnd    String?  @map("quiet_hours_end")
  // State Legislation Platform (Phase 0, DD5) — empty = ALL jurisdictions the
  // client's watchlist produces (today's behavior: state alerts are already
  // gated by the watchlist opt-in above, so no one gets state spam by default).
  jurisdictions    String[] @default([]) @map("jurisdictions")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, clientId])
  @@index([tenantId, clientId])
  @@map("intel_alert_preference")
}

/// Send-idempotency log. The unique (alertId, userId, channel) preserves the
/// legacy §6 idempotency contract — a given alert reaches a user/channel once.
model IntelNotificationLog {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  clientId          String   @map("client_id")
  alertId           String   @map("alert_id") // 'tracker:'+clientId+':'+billId+':'+changeType
  userId            String   @map("user_id")
  channel           String //                    'email'|'sms'|'in_app'
  status            String //                    'sent'|'failed'|'suppressed'|'queued'
  providerMessageId String?  @map("provider_message_id")
  error             String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([alertId, userId, channel])
  @@index([tenantId, clientId])
  @@map("intel_notification_log")
}

/// Digest queue for daily/weekly cadences (flushDigests target).
model IntelAlertDigestQueue {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  clientId    String    @map("client_id")
  userId      String    @map("user_id")
  alertId     String    @map("alert_id")
  channel     String //                    'email'|'sms'
  cadence     String //                    'daily'|'weekly'
  flushed     Boolean   @default(false)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId, channel, flushed])
  @@map("intel_alert_digest_queue")
}

/// One-time SMS phone-verification OTP (hashed). Consent record for the SMS
/// channel — the verify step is the opt-in (P1.1 port of the legacy apps/api
/// sms_verification; D2 forbids intel-api writing that table, so the consent
/// ledger moves here with the service that will deliver SMS post-cutover).
model IntelSmsVerification {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  clientId  String?  @map("client_id")
  phone     String //                  E.164
  codeHash  String   @map("code_hash") // SHA-256 of `code:phone`
  expiresAt DateTime @map("expires_at")
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId, phone])
  @@index([tenantId, clientId])
  @@map("intel_sms_verification")
}

/// Single-use, short-TTL ticket authorizing exactly ONE WebSocket upgrade to
/// /intel-api/live.
///
/// A browser cannot set an Authorization header on a WebSocket, so the previous
/// design put the full Clerk JWT in the query string — where it lands in ALB,
/// proxy and browser logs — then RETAINED it on the connection for up to four
/// hours and relayed it to MeriV2 long after it had expired. This replaces that
/// with a credential that is useless after one use and dies in 60 seconds.
///
/// The raw ticket is never stored, only its SHA-256. Mirrors the hashed-OTP
/// shape of IntelSmsVerification above.
///
/// tenant_id is TEXT (not @db.Uuid) like every other intel_* table: the RLS
/// predicate casts current_tenant_id()::text, and a uuid column here would fail
/// at runtime with PG 42883 "operator does not exist: text = uuid".
model IntelWsTicket {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  clerkUserId String    @map("clerk_user_id")
  sessionId   String    @map("session_id")
  /// SHA-256 hex of the raw ticket.
  ticketHash  String    @unique @map("ticket_hash")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId, sessionId])
  @@index([expiresAt])
  @@map("intel_ws_ticket")
}

/// Feedback labels on alerts/bills/hearings/recommendations (§10 training set).
model IntelFeedback {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  clientId   String   @map("client_id")
  userId     String?  @map("user_id")
  alertId    String?  @map("alert_id")
  targetType String   @map("target_type") // 'bill'|'hearing'|'alert'|'recommendation'
  targetRef  String   @map("target_ref")
  signal     String //                       useful|not_useful|wrong_impact|wrong_urgency|false_positive|missed|tracked|dismissed|marked_irrelevant|opened|memo_generated|memo_heavily_edited|outreach_generated|alert_ignored
  // §4.10 (Gate E phase f): a structured reason for a marked_irrelevant
  // dismissal — wrong_issue|wrong_entity|too_broad|already_handled|not_actionable.
  // Null for every other signal and for a pre-phase-f dismissal (no reason
  // picker existed yet).
  reason     String?
  // §4.10 (Gate E phase f): the watchlist topic labels this bill matched AT
  // DISMISSAL TIME (RecommendationBill.matchedTags, already on the client).
  // Forward-only — historical rows before this column existed carry `[]` and
  // contribute nothing to feedbackSignal's aggregation. This is what lets a
  // dismissal be traced back to the TOPIC that over-matched.
  matchedTags String[] @default([]) @map("matched_tags")
  // Gate K (MP-09, c-1): the TOPIC IDS behind matchedTags's topic entries
  // (never issue areas, which have no topic id). This is the id-keyed twin
  // of matchedTags — feedbackSignal prefers this and falls back to
  // matchedTags/label for a row written before this column existed, so a
  // topic rename no longer severs its accumulated dismissal signal.
  // Forward-only, same posture as matchedTags itself.
  matchedTopicIds String[] @default([]) @map("matched_topic_ids")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, clientId])
  @@index([targetRef])
  @@map("intel_feedback")
}

/// Actionable-recommendation state on an alert: the memo↔alert link (kind='memo',
/// carries the apps/api EngagementAttachment id + title so the Feed shows "memo
/// drafted" and can reopen the Document) plus curation items (kind='talking_point'
/// with text, kind='report' flag) and the agentic Tier-2 output (kind='targeting_brief',
/// written cross-realm by apps/api run-intel-workflows, M5.4). memo/report/targeting_brief
/// are singletons per alert (enforced by a partial unique index in the migration);
/// talking_point may be many.
model IntelActionItem {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  clientId             String   @map("client_id")
  alertId              String   @map("alert_id")
  kind                 String //                     'memo' | 'talking_point' | 'report' | 'targeting_brief'
  text                 String?
  documentAttachmentId String?  @map("document_attachment_id")
  title                String?
  createdBy            String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([tenantId, clientId])
  @@index([alertId, kind])
  @@map("intel_action_item")
}

/// P2-04 (Gate D phase e): PER-USER triage state for an alert.
///
/// Deliberately NOT `intel_alert.status`. That column is the shared, firm-wide
/// state of the intelligence EVENT — read by DEFAULT_STATUSES and written by
/// dedupeStateActionAlerts and the emitter — so one analyst dismissing an alert
/// there would hide it from everyone and collide with the suppression sweep.
///
/// Work state is an ADDITIONAL narrowing of the feed, never a widening: a
/// suppressed alert stays excluded regardless of what any user did here.
/// Keyed on (alertId, userId), which is the idempotency contract — a repeated
/// action upserts rather than inserting a duplicate. Deliberately NOT keyed on
/// (clientId, sourceRef, changeType): a recurrence after the 14-day dedup window
/// is a NEW alert row and should correctly arrive un-dismissed.
model IntelAlertWorkState {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  clientId String @map("client_id")
  alertId  String @map("alert_id")
  userId   String @map("user_id")
  /// new | in_review | assigned | actioned | snoozed | dismissed
  state    String @default("new")
  /// A user id from the tenant's own team roster. Required when state='assigned'.
  assignedTo   String?   @map("assigned_to")
  snoozedUntil DateTime? @map("snoozed_until") @db.Timestamptz(6)
  note         String?
  updatedBy    String?   @map("updated_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([alertId, userId], map: "intel_alert_work_state_alert_user_key")
  @@index([tenantId, clientId, userId, state], map: "intel_alert_work_state_scope_idx")
  @@map("intel_alert_work_state")
}

/// Phase 5 parity audit (§8.6). One row per parity-report run per scope. Compares
/// what the legacy apps/api tracker DECIDED to fire (durable `intelligence_change`
/// rows, source='congress_bill' + data.tracker=true) against the shadow
/// `intel_alert` set over a rolling window. Read-only against both alert sources;
/// this row is the ONLY write the parity task performs. `git_sha` attributes a
/// green streak to a specific image.
model IntelParityRun {
  id                         String   @id @default(cuid())
  runAt                      DateTime @default(now()) @map("run_at")
  windowDays                 Int      @map("window_days")
  tenantScope                String   @map("tenant_scope") // 'all' | tenant slug/id
  tenantId                   String?  @map("tenant_id")
  clientCount                Int      @map("client_count")
  legacyCount                Int      @map("legacy_count") //  |L|
  intelCount                 Int      @map("intel_count") //   |I|
  intersection               Int //                            |L ∩ I|
  overlap                    Float //                          Jaccard |∩|/|∪|
  recall                     Float //                          |∩|/|L| (1.0 when |L|=0)
  precision                  Float //                          |∩|/|I| (1.0 when |I|=0)
  missedCriticals            Int      @map("missed_criticals")
  severityCriticalMismatches Int      @map("severity_critical_mismatches")
  maxScoreDelta              Float?   @map("max_score_delta") // null = not recomputed (legacy stores no fit)
  p95ScoreDelta              Float?   @map("p95_score_delta")
  passed                     Boolean
  reason                     String? //                        e.g. NO_DATA, GATE_RED:<metric>
  gitSha                     String?  @map("git_sha")
  createdAt                  DateTime @default(now()) @map("created_at")

  @@index([tenantScope, runAt])
  @@map("intel_parity_run")
}

// --- enums ------------------------------------------------------------------

enum LiveHearingSourceType {
  hearing
  markup
  meeting
  webinar
  agency_session

  @@map("intel_live_hearing_source_type")
}

enum LiveHearingAudioSource {
  browser_mic
  uploaded_audio
  stream_url
  conference_bridge

  @@map("intel_live_hearing_audio_source")
}

enum LiveHearingStatus {
  scheduled
  live
  paused
  ended
  failed

  @@map("intel_live_hearing_status")
}

enum ConsentStatus {
  not_required
  confirmed
  needs_review

  @@map("intel_consent_status")
}

enum RecordingPolicy {
  transcript_only
  audio_and_transcript
  no_storage

  @@map("intel_recording_policy")
}

// --- core: live hearing session ---------------------------------------------

/// A live (or scheduled/ended) hearing capture session. Tenant-scoped; links to
/// apps/api-owned records (client, hearing, committee, bill, PE, agency) BY ID
/// only — no cross-schema FK.
model LiveHearingSession {
  id                 String                 @id @default(cuid())
  tenantId           String                 @map("tenant_id")
  clientId           String?                @map("client_id")
  matterId           String?                @map("matter_id")
  issueIds           String[]               @map("issue_ids")
  hearingId          String?                @map("hearing_id")
  committeeId        String?                @map("committee_id")
  billIds            String[]               @map("bill_ids")
  programElementIds  String[]               @map("program_element_ids")
  agencyIds          String[]               @map("agency_ids")
  title              String
  sourceType         LiveHearingSourceType  @map("source_type")
  audioSource        LiveHearingAudioSource @map("audio_source")
  // Optional source the analyst will PLAY in a browser tab, captured at session
  // creation so the Live Hearing Room can embed or link it instead of the user
  // pasting it by hand. Either direct media (HLS .m3u8 / MP3 / AAC / MP4) or a
  // hearing/event/YouTube reference page — the server never ingests it; the
  // transcript comes from the tab audio the analyst explicitly shares. NULL =
  // enter it in the room.
  sourceUrl          String?                @map("source_url")
  status             LiveHearingStatus      @default(scheduled)
  startedAt          DateTime?              @map("started_at")
  endedAt            DateTime?              @map("ended_at")
  consentStatus      ConsentStatus          @default(needs_review) @map("consent_status")
  // Consent attestation audit (P8/D11): for PRIVATE sessions the operator's full
  // attestation text is a durable compliance artifact — persisted here (not just
  // logged/truncated), with who attested + when. NULL for public proceedings.
  consentAttestation String?                @map("consent_attestation")
  attestedBy         String?                @map("attested_by") // clerk user id
  attestedAt         DateTime?              @map("attested_at")
  recordingPolicy    RecordingPolicy        @default(transcript_only) @map("recording_policy")
  claimMapId         String?                @map("claim_map_id")
  createdBy          String                 @map("created_by") // clerk user id
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  transcriptSegments TranscriptSegment[]
  keyQuotes          KeyQuote[]
  actionItems        LiveActionItem[]
  entityMentions     EntityMention[]
  summaryCards       LiveSummaryCard[]

  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@map("intel_live_hearing_session")
}

// --- transcript segment -----------------------------------------------------

/// A finalized transcript segment from Deepgram. Client-relevant text is stored
/// ENCRYPTED (AES-256-GCM, mirroring meeting_debriefs): textCiphertext + iv +
/// authTag + keyVersion. Non-sensitive public text MAY be stored as textPlain.
/// NEVER both. Interim (non-final) transcripts are NOT persisted.
model TranscriptSegment {
  id                   String   @id @default(cuid())
  sessionId            String   @map("session_id")
  tenantId             String   @map("tenant_id") // denormalized for scope-safe queries
  startMs              Int      @map("start_ms")
  endMs                Int      @map("end_ms")
  speakerLabel         String?  @map("speaker_label")
  resolvedSpeakerId    String?  @map("resolved_speaker_id")
  resolvedSpeakerName  String?  @map("resolved_speaker_name")
  isFinal              Boolean  @default(false) @map("is_final")
  confidence           Float?
  source               String   @default("deepgram")
  // Encrypted text (client-relevant):
  textCiphertext       String?  @map("text_ciphertext")
  iv                   String?
  authTag              String?  @map("auth_tag")
  keyVersion           String?  @map("key_version")
  // Plaintext text (non-client-relevant public hearing content only):
  textPlain            String?  @map("text_plain")
  clientRelevanceScore Float?   @map("client_relevance_score")
  issueTags            String[] @map("issue_tags")
  createdAt            DateTime @default(now()) @map("created_at")

  session   LiveHearingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  keyQuotes KeyQuote[]

  @@unique([sessionId, startMs, endMs])
  @@index([sessionId, startMs])
  @@index([tenantId, sessionId])
  @@map("intel_transcript_segment")
}

// --- derived intelligence (each points back to a segment + timestamp) -------

/// A flagged quote worth saving. Points to a transcript segment + timestamp
/// (satisfies SC5.6). Quote text inherits the segment's encryption posture.
model KeyQuote {
  id             String   @id @default(cuid())
  sessionId      String   @map("session_id")
  tenantId       String   @map("tenant_id")
  segmentId      String   @map("segment_id")
  startMs        Int      @map("start_ms")
  speakerName    String?  @map("speaker_name")
  confidence     Float?
  issueTags      String[] @map("issue_tags")
  // Encrypted quote text:
  textCiphertext String?  @map("text_ciphertext")
  iv             String?
  authTag        String?  @map("auth_tag")
  keyVersion     String?  @map("key_version")
  textPlain      String?  @map("text_plain")
  createdAt      DateTime @default(now()) @map("created_at")

  session LiveHearingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  segment TranscriptSegment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@map("intel_key_quote")
}

/// An action item / follow-up extracted from a hearing statement.
model LiveActionItem {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  tenantId    String   @map("tenant_id")
  segmentId   String?  @map("segment_id")
  startMs     Int?     @map("start_ms")
  description String
  status      String   @default("open")
  createdAt   DateTime @default(now()) @map("created_at")

  session LiveHearingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@map("intel_live_action_item")
}

/// A policy entity detected in a segment (bill/client/PE/agency/office/company).
/// entityRef is the canonical id (bill_id, committee_id, UEI, PE id, etc.).
model EntityMention {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  tenantId    String   @map("tenant_id")
  segmentId   String?  @map("segment_id")
  entityType  String   @map("entity_type")
  entityRef   String?  @map("entity_ref") // canonical id when resolved
  entityLabel String   @map("entity_label")
  confidence  Float?
  createdAt   DateTime @default(now()) @map("created_at")

  session LiveHearingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@index([entityType, entityRef])
  @@map("intel_entity_mention")
}

/// A live summary card pushed to the Live Hearing Room UI.
model LiveSummaryCard {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  tenantId  String   @map("tenant_id")
  cardType  String   @map("card_type")
  title     String
  body      String?
  segmentId String?  @map("segment_id")
  startMs   Int?     @map("start_ms")
  createdAt DateTime @default(now()) @map("created_at")

  session LiveHearingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@map("intel_live_summary_card")
}
