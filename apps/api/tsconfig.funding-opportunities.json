{
  // Narrow script typecheck for the Funding Opportunities producers.
  //
  // apps/api/tsconfig.json EXCLUDES `scripts`, so `tsc --noEmit` does not see
  // any of them. That is not a theoretical gap: PR #651 shipped an uncompilable
  // producer script through a green CI for exactly this reason (2026-07-28), and
  // the same PR's migration named the wrong table.
  //
  // A blanket `include: scripts/**/*` is not the fix — measured on this branch, it
  // surfaces 123 pre-existing errors across ~40 unrelated scripts, so adopting it
  // here would trade one silent gap for a red gate on work this PR does not
  // touch. Instead this follows the tsconfig.pe-phase-a.json precedent: an
  // explicit file list for one feature's scripts, wired into the package's
  // `typecheck` so CI actually runs it.
  //
  // ADD EVERY NEW FUNDING-OPPORTUNITIES SCRIPT TO THIS LIST. A script that is not
  // listed here is not typechecked by anything except a spec that happens to
  // import it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "scripts/generate-sam-opportunity-candidates.ts",
    "scripts/generate-funding-grant-candidates.ts",
    "scripts/generate-funding-grant-candidates.spec.ts",
    "scripts/process-funding-opportunity-lifecycle.ts",
    "scripts/process-funding-opportunity-lifecycle.spec.ts",
    "scripts/generate-sam-opportunity-candidates.spec.ts",
    "scripts/match-contractor-identifiers.ts",
    "scripts/backfill-sam-opportunity-fields.ts",
    "scripts/backfill-sam-opportunity-fields.spec.ts",
    "scripts/backfill-funding-mapping-review.ts",
    "scripts/backfill-funding-mapping-review.spec.ts",
    // Touched by this work: sync-sam-opportunities now promotes four source
    // fields through the backfill's shared extractor, and the grant producer's
    // relevance floor became derived rather than hardcoded.
    "scripts/sync-sam-opportunities.ts",
    "scripts/sync-sam-opportunities.spec.ts",
    "scripts/generate-grant-opportunity-candidates.ts",
    "scripts/generate-report-card-docx.ts",
    "scripts/funding-opportunities-entrypoint.spec.ts",
    // Added by the final remediation. enrich-grant-details is the dependency that
    // populates every field the grant producer scores on (description, eligibility,
    // award ceilings), and it was typechecked by NOTHING: apps/api/tsconfig.json
    // excludes `scripts`, and this list is the only thing that reaches them.
    "scripts/enrich-grant-details.ts",
    "scripts/enrich-grant-details.spec.ts",
    "scripts/repair-set-aside-certifications.ts",
    "scripts/repair-set-aside-certifications.spec.ts",
    // Facility district-code normalization (2026-07-30). Typechecked here for the
    // same reason as everything above: apps/api/tsconfig.json excludes `scripts`.
    "scripts/repair-facility-district-codes.ts",
    "scripts/repair-facility-district-codes.spec.ts",
    // P17: read-only Tango capability/tier probe CLI. Lives in scripts/, same
    // rootDir gap as every entry above.
    "scripts/diag-tango-capabilities.ts",
    "scripts/diag-tango-capabilities.spec.ts",
    // P18: read-only Tango usage/health report CLI.
    "scripts/diag-tango-health.ts",
    "scripts/diag-tango-health.spec.ts",
    // P19: reviewed-UEI entity shadow sync.
    "scripts/sync-tango-entities.ts",
    "scripts/sync-tango-entities.spec.ts",
    // P20: client profile enrichment review workflow.
    "scripts/generate-tango-enrichment-candidates.ts",
    "scripts/generate-tango-enrichment-candidates.spec.ts",
    "scripts/review-tango-enrichment-candidate.ts",
    "scripts/review-tango-enrichment-candidate.spec.ts",
    // P21: read-only Federal Business Profile dump.
    "scripts/diag-federal-business-profile.ts",
    "scripts/diag-federal-business-profile.spec.ts",
    // P22: relevant vehicles and past-performance sync.
    "scripts/sync-tango-vehicles.ts",
    "scripts/sync-tango-vehicles.spec.ts",
    // P24: agency forecast incremental sync.
    "scripts/sync-tango-forecasts.ts",
    "scripts/sync-tango-forecasts.spec.ts",
    // P27: Tango<->SAM shadow sync and the read-only parity report.
    "scripts/sync-tango-opportunity-shadow.ts",
    "scripts/sync-tango-opportunity-shadow.spec.ts",
    "scripts/diag-tango-opportunity-parity.ts",
    "scripts/diag-tango-opportunity-parity.spec.ts",
    // P28: notice-history sync.
    "scripts/sync-tango-opportunity-notices.ts",
    "scripts/sync-tango-opportunity-notices.spec.ts",
    // P29: attachment discovery and secure archive.
    "scripts/sync-tango-opportunity-attachments.ts",
    "scripts/sync-tango-opportunity-attachments.spec.ts",
    // P30: extracted-text status seeding.
    "scripts/sync-tango-opportunity-text.ts",
    "scripts/sync-tango-opportunity-text.spec.ts",
    // P47: webhook alert subscription reconciler. Dry-run by default; the
    // --commit path carries the endpoint/callback interlocks, so a type error
    // reaching an operator's shell here is a genuinely bad outcome.
    "scripts/reconcile-tango-webhook-alerts.ts",
    "scripts/reconcile-tango-webhook-alerts.spec.ts",
    // P48: webhook event drain. Same rootDir gap as every entry above.
    "scripts/process-tango-events.ts",
    "scripts/process-tango-events.spec.ts",
    // P49: read-only canary diagnostic.
    "scripts/diag-funding-opportunities-makegov.ts",
    "scripts/diag-funding-opportunities-makegov.spec.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
