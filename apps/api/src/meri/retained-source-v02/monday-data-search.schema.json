          "type": "number"
        },
        "fusedScore": {
          "type": "number"
        },
        "sourceAuthority": {
          "$ref": "#/$defs/RetrievalAuthority"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetrievalScoringComponent"
          }
        }
      },
      "required": [
        "domain",
        "recordId",
        "baselineRank",
        "currentRank",
        "proposedRank",
        "fusedScore",
        "sourceAuthority",
        "components"
      ],
