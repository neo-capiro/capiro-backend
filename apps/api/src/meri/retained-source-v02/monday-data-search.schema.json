    "SearchCapiroDataResult": {
      "type": "object",
      "description": "The frozen tool envelope: searchCapiroData destructures coverage out of the RetrievalResponse and returns { tool, coverage, ...data }, so the result is exactly tool + records + observability + coverage. No operation, binding, subject, window, status, reasonCode or negativeAssertion envelope is added, because the frozen RetrievalResponse declares none.",
      "properties": {
        "tool": {
          "const": "search_capiro_data"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetrievalRecord"
          }
        },
        "observability": {
          "$ref": "#/$defs/RetrievalObservability"
        },
        "coverage": {
          "$ref": "#/$defs/CoverageManifest"
        }
      },
      "required": [
        "tool",
        "records",
        "observability",
        "coverage"
      ],
      "additionalProperties": false
    },
    "DataSearchRequest": {
      "type": "object",
