          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidateCount": {
          "type": "number"
        },
        "rerankedCount": {
          "type": "number"
        },
        "durationMs": {
          "type": "number"
        },
        "scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetrievalRerankingScore"
          }
        },
        "fallbackReason": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "properties": {
            "promptTokens": {
              "type": "number"
            },
            "totalTokens": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "provider",
        "model",
        "candidateCount",
        "rerankedCount",
        "durationMs",
        "scores"
      ],
      "additionalProperties": false
    },
    "RetrievalScoringComponent": {
      "type": "object",
      "description": "retrieval-v2.types.ts L297-305. Native value establishes ordinal rank only.",
      "properties": {
        "signal": {
          "$ref": "#/$defs/RetrievalScoringSignal"
        },
        "signalClass": {
          "$ref": "#/$defs/RetrievalScoringSignalClass"
        },
        "rawValue": {
          "type": "number"
        },
        "signalRank": {
          "type": "number"
        },
        "contribution": {
          "type": "number"
        }
      },
      "required": [
        "signal",
        "signalClass",
        "rawValue",
        "signalRank",
        "contribution"
      ],
