          "maxItems": 4096,
          "uniqueItems": true
        },
        "removed": {
          "const": false
        },
        "connectionStatus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "readHandle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "internetMessageId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "receivedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "sentAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "effectiveAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "subjectText": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "preview": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "incomplete-preview"
            },
            "text": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 65536
                },
                {
                  "type": "null"
                }
              ]
            },
            "fullSizeKnown": {
              "const": false
            }
          },
          "required": [
            "kind",
            "text",
            "fullSizeKnown"
          ],
          "additionalProperties": false
        },
        "from": {
          "type": "object",
