            "name"
          ],
          "additionalProperties": false
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MailRecipient"
          },
          "maxItems": 8
        },
        "cc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MailRecipient"
          },
          "maxItems": 8
        },
        "toTruncated": {
          "type": "boolean"
        },
        "ccTruncated": {
          "type": "boolean"
        }
