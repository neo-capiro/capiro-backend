{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meri:retrieval:mail:0.2.0",
  "title": "Meri pending mail thread and candidate transport contracts 0.2.0",
  "$defs": {
    "MailThreadInput": {
      "type": "object",
      "properties": {
        "subject": {
          "oneOf": [
            {
              "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/SubjectRequest/oneOf/0"
            },
            {
              "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/SubjectRequest/oneOf/2"
            }
          ]
        },
        "threadId": {
          "type": "string",
          "format": "uuid"
        },
        "messageId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "messageOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 0
        },
        "bodyOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "maxCharacters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000,
          "default": 2000
        }
      },
      "required": [
        "subject",
        "threadId"
      ],
      "additionalProperties": false
    },
    "MailThreadSelection": {
      "type": "object",
      "properties": {
        "subject": {
          "oneOf": [
            {
              "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/SubjectRequest/oneOf/0"
            },
            {
              "$ref": "urn:meri:retrieval:common:0.2.0#/$defs/SubjectRequest/oneOf/2"
            }
          ]
        },
        "threadId": {
          "type": "string",
          "format": "uuid"
        },
        "messageId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "default": null
