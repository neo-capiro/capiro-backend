        "messageOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 0
        },
        "bodyOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "maxCharacters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000,
