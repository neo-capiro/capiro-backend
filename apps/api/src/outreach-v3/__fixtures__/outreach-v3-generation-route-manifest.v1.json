{
  "schemaVersion": 1,
  "runtime": "engagement-api",
  "requiresStateFlag": "OUTREACH_V3_STATE_ENABLED",
  "featureFlag": "OUTREACH_V3_GENERATION_ENABLED",
  "fullGenerationFlag": "OUTREACH_V3_FULL_GENERATION_ENABLED",
  "disabledBehavior": 404,
  "routes": [
    {
      "method": "GET",
      "path": "/api/engagement/outreach-v3/sessions/:sessionId/generation/plan",
      "handler": "plan"
    },
    {
      "method": "GET",
      "path": "/api/engagement/outreach-v3/sessions/:sessionId/generation/approach-approval",
      "handler": "getApproachApproval"
    },
    {
      "method": "POST",
      "path": "/api/engagement/outreach-v3/sessions/:sessionId/generation/approach-approval",
      "handler": "approveApproach",
      "humanDecisionOnly": true
    },
    {
      "method": "POST",
      "path": "/api/engagement/outreach-v3/sessions/:sessionId/generation/review-packet-approval",
      "handler": "approveReviewPacket",
      "humanDecisionOnly": true,
      "acceptsClientFields": false
    },
    {
      "method": "GET",
      "path": "/api/engagement/outreach-v3/sessions/:sessionId/generation/jobs/latest",
      "handler": "getLatestFullGenerationJob"
    },
    {
      "method": "GET",
      "path": "/api/engagement/outreach-v3/sessions/:sessionId/generation/jobs/:jobId",
      "handler": "getFullGenerationJob"
    },
    {
      "method": "POST",
      "path": "/api/engagement/outreach-v3/sessions/:sessionId/generation/jobs/:jobId/cancel",
      "handler": "cancelFullGenerationJob"
    }
  ],
  "authority": {
    "modelCall": false,
    "representativeSamples": false,
    "draftWrite": false,
    "approachApproval": true,
    "reviewPacketApproval": true,
    "fullGeneration": false,
    "fullGenerationAsyncOnly": false,
    "preflight": false,
    "sendIntent": false,
    "mailProviderAction": false,
    "memoryCommit": false
  }
}
