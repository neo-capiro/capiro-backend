{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "rootDir": "."
  },
  "include": [
    // Ambient declarations for untyped dependencies. This narrow project pulls
    // parts of src/engagement in TRANSITIVELY (through import chains from the
    // files listed below) without listing them, so without this entry the
    // hand-written declaration in src/types is invisible and every transitively
    // reached use of an untyped module reports an implicit-any error that has
    // nothing to do with the code under test.
    "src/types/**/*.d.ts",
    "src/defense-budget/promotion/**/*.ts",
    "src/defense-budget/projection-plan/**/*.ts",
    "src/program-element/snapshot/**/*.ts",
    "scripts/persist-defense-budget-projection-plan-v1.ts",
    "scripts/build-defense-budget-phase6-projection-plan-v1.ts",
    "scripts/plan-defense-budget-promotion-v1.ts",
    "scripts/validate-defense-budget-promotion-v1.ts",
    "scripts/execute-defense-budget-promotion-v1.ts",
    "scripts/rollback-defense-budget-snapshot-v1.ts",
    "scripts/compare-defense-budget-canonical-reads-v1.ts",
    "scripts/status-defense-budget-promotion-v1.ts",
    "scripts/resume-defense-budget-promotion-side-effects-v1.ts",
    "scripts/pe-budget-phase7-plan-rehearsal.ts",
    "scripts/pe-budget-phase7-engine-rehearsal.ts",
    "scripts/pe-budget-phase7-read-rehearsal.ts",
    "scripts/pe-budget-phase7-drain-rehearsal.ts",
    "scripts/verify-pe-budget-phase-7-safety.ts",
    "scripts/verify-pe-budget-phase-7-negative-controls.ts",
    "scripts/persist-phase6-audit-projections-v1.ts",
    "scripts/phase6-producer-rehearsal.ts",
    "scripts/authorize-defense-budget-promotion-v1.ts",
    "scripts/pe-budget-phase7-gap3-authorize-rehearsal.ts",
    "scripts/file-defense-budget-promotion-plan-v1.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
