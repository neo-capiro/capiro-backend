generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Focused validation projection only. Campaign state remains in the Phase 2
// tables and this schema intentionally contains no Campaign Spec/state pointer.
model OutreachReasoningConversation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  provider        String   @db.VarChar(32)
  stateMode       String   @map("state_mode") @db.VarChar(32)
  model           String   @db.VarChar(160)
  reasoningEffort String   @map("reasoning_effort") @db.VarChar(16)
  lastResponseId  String?  @map("last_response_id") @db.VarChar(255)
  status          String   @default("active") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt      DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  @@index([tenantId, createdByUserId, sessionId, lastUsedAt(sort: Desc)], map: "outreach_reasoning_conversations_owner_session_used_idx")
  @@map("outreach_reasoning_conversations")
}

model OutreachReasoningTurn {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  conversationId       String   @map("conversation_id") @db.Uuid
  sessionId            String   @map("session_id") @db.Uuid
  actorUserId          String   @map("actor_user_id") @db.Uuid
  stateVersion         Int      @map("state_version")
  userMessageText      String?  @map("user_message_text") @db.Text
  assistantMessageText String?  @map("assistant_message_text") @db.Text
  userMessageHash      String   @map("user_message_hash") @db.Char(64)
  assistantMessageHash String?  @map("assistant_message_hash") @db.Char(64)
  providerResponseId   String?  @map("provider_response_id") @db.VarChar(255)
  toolResultRefsJsonb  Json     @default("[]") @map("tool_result_refs_jsonb")
  proposalIdsJsonb     Json     @default("[]") @map("proposal_ids_jsonb")
  openQuestionsJsonb   Json     @default("[]") @map("open_questions_jsonb")
  usageJsonb           Json     @default("{}") @map("usage_jsonb")
  latencyMs            Int      @map("latency_ms")
  status               String   @db.VarChar(16)
  failureCode          String?  @map("failure_code") @db.VarChar(96)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId, createdAt, id], map: "outreach_reasoning_turns_conversation_created_idx")
  @@index([tenantId, sessionId, createdAt(sort: Desc)], map: "outreach_reasoning_turns_tenant_session_created_idx")
  @@map("outreach_reasoning_turns")
}
