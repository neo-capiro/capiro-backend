/// Persisted Office Recommender ("Suggested by Meri") output for a client's
/// Targets tab. Computing recommendations means resolving tracked bills +
/// scoring every congressional office, which is too slow to run on every page
/// view — so we compute once (lazily, on first view), store the result here, and
/// serve the cache thereafter. A manual "Refresh" recomputes on demand. One row
/// per client (firm-wide, tenant-scoped via RLS). tenant/client FK relations with
/// ON DELETE CASCADE so a deleted client takes its cache with it (mirrors
/// ClientTarget / ActionRecommendation).
model ClientTargetRecommendation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
