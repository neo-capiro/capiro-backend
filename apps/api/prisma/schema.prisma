model ClioMemory {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  // Stored as TEXT in the DB with a CHECK constraint (scope IN
  // ('firm','user_private','client') since G2's 20260713020000). Modeled as
  // String (not a Prisma enum) so the generated client never casts to a
  // "ClioMemoryScope" Postgres type — that type was never created, and the
  // enum decl caused `type "public.ClioMemoryScope" does not exist` (42704)
  // 500s on Clio memory reads. App-level union typing lives in
  // clio/clio-memory.helpers.ts.
  scope       String                 @default("firm")
  ownerUserId String?                @map("owner_user_id") @db.Uuid
  /// G2 client scope: set iff scope='client' (CHECK-enforced). A RELEVANCE
  /// boundary (recalled only in this client's conversations), not per-user
  /// access control — no per-user client ACL exists.
  clientId    String?                @map("client_id") @db.Uuid
  key         String                 @db.VarChar(200)
  value       String                 @db.Text
  source      String                 @default("conversation")
  /// G2 ephemeral/working memory: NULL = durable. Expired rows are excluded
  /// by readers + purged by the daily refresh-memory-graph sweep.
  expiresAt   DateTime?              @map("expires_at") @db.Timestamptz(6)
  embedding   Unsupported("vector")?
  metadata    Json                   @default("{}") @map("metadata_jsonb")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Firm-scope rows (owner_user_id IS NULL) are additionally guarded by a
  // PARTIAL unique index `clio_memory_firm_key_uniq` (tenant_id, scope, key)
  // WHERE owner_user_id IS NULL, created raw in migration 20260705120000 because
  // Prisma cannot express partial indexes. Do NOT let `prisma migrate dev`
  // reconcile it away. The @@unique below still enforces the user_private case.
  @@unique([tenantId, scope, ownerUserId, key], map: "clio_memory_tenant_scope_owner_key_uniq")
  @@index([tenantId, scope, ownerUserId, updatedAt(sort: Desc)], map: "clio_memory_scope_owner_updated_idx")
  @@index([tenantId, scope, updatedAt(sort: Desc)], map: "clio_memory_scope_updated_idx")
  @@map("clio_memory")
}

/// MeriV2 write-tool approval record (Workstream B4 — the ApprovalStore's
/// persistence). When a compliance decision is WARN, the orchestrator's gate
/// holds the write (ApprovalPendingError) until a human approves THIS exact
/// action. The action is identified by a stable `fingerprint` (sha256 over
/// tenant+user+tool+canonicalized input, computed in @capiro/meriv2-core's
/// computeActionFingerprint) — so an approval can never be replayed against a
/// mutated action. One approved row per (tenant, user, fingerprint).
///
/// POLICY not yet decided (needs Neo): approval TTL (rows never expire today),
/// WHO may approve (self-approve today; four-eyes would add an approverUserId
/// distinct from userId), and whether one approval survives a re-run (it does
/// today — the row persists). These are enforced by the service/endpoint on top
/// of this table, not by the table shape. Tenant-cascade.
model MeriActionApproval {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Clerk subject of the user the approval is scoped to (matches MeriContext.userId).
  userId      String   @map("user_id")
  /// sha256 hex from meriv2-core computeActionFingerprint (opaque to apps/api).
  fingerprint String   @db.VarChar(64)
  /// The write tool this approval authorizes (for display/audit; not part of the key).
  tool        String   @db.VarChar(120)
  status      String   @default("approved")
  approvedBy  String   @map("approved_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, fingerprint], map: "meri_action_approval_tenant_user_fp_uniq")
  @@index([tenantId, userId, createdAt(sort: Desc)], map: "meri_action_approval_user_created_idx")
  @@map("meri_action_approval")
}

/// The exact proposed action behind a WARN decision (fix for the "approving
/// never runs the write" bug): the compliance gate's `ApprovalPendingError` is
/// caught at the SAME moment the fingerprint above is computed, and the tool
/// name + exact input are captured here, keyed by that same fingerprint.
///
/// Without this, "approve" only recorded a `MeriActionApproval` row, then the
/// UI re-ran the turn by resending the user's ORIGINAL prompt for the model to
/// re-answer from scratch (`mode: 'regenerate'`) — the model re-derives a
/// fresh, byte-different payload every time (re-researches, rewords), so its
/// new proposal hashes to a DIFFERENT fingerprint that was never approved, and
/// the write WARNs again. Forever. (Confirmed live: `update_client_profile` was
/// approved 8 times over a week and never executed once.)
///
/// The fix: on approval, look up the row by fingerprint and execute the tool
/// DIRECTLY with the cached input — no model round-trip, so nothing can drift.
/// `consumedAt` makes execution idempotent (approve-once-execute-once) even if
/// the same fingerprint reappears (a repeat identical proposal) or approve is
/// double-clicked. Rows are NOT deleted on consumption — kept for audit; a
/// future TTL sweep is a follow-up, not a correctness requirement (an unclaimed
/// row is inert, never auto-executes). Tenant-cascade.
model MeriPendingAction {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// Clerk subject of the user this proposal is scoped to (matches MeriContext.userId).
  userId      String    @map("user_id")
  /// sha256 hex from meriv2-core computeActionFingerprint — the SAME value the
  /// paired MeriActionApproval row is keyed by; this table is the lookup that
  /// turns "fingerprint approved" into "exact action to run".
  fingerprint String    @db.VarChar(64)
  /// The write tool this input is for (dispatched via MeriToolsService.execute).
  tool        String    @db.VarChar(120)
  /// The exact tool-call input the model proposed when it first WARNed —
  /// replayed VERBATIM on approval, never re-derived.
  input       Json      @map("input_jsonb")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set the moment approval successfully claims + executes this row. NULL =
  /// still pending (or never approved). Never re-executed once set.
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, fingerprint], map: "meri_pending_action_tenant_user_fp_uniq")
  @@index([tenantId, userId, createdAt(sort: Desc)], map: "meri_pending_action_user_created_idx")
  @@map("meri_pending_action")
}

/// Immutable, server-created MeriV2 action proposal. Browser approval is by the
/// opaque id only; tool/input/fingerprint/policy/tenant/user are server authority.
model MeriActionProposal {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  actorUserId            String?   @map("actor_user_id") @db.Uuid
  impersonationSessionId String?   @map("impersonation_session_id") @db.VarChar(160)
  conversationId         String?   @map("conversation_id") @db.Uuid
  surface                String    @db.VarChar(40)
  tool                   String    @db.VarChar(120)
  input                  Json      @map("input_jsonb")
  fingerprint            String    @db.VarChar(64)
  policyVersion          String    @map("policy_version") @db.VarChar(80)
  policyPackId           String?   @map("policy_pack_id") @db.Uuid
  policyPackKey          String    @map("policy_pack_key") @db.VarChar(120)
  policyPackVersion      String    @map("policy_pack_version") @db.VarChar(80)
  policyBinding          String    @map("policy_binding") @db.VarChar(280)
  policyDecisionHash     String    @map("policy_decision_hash") @db.VarChar(64)
  policyContextHash      String    @map("policy_context_hash") @db.VarChar(64)
  policySource           String    @map("policy_source") @db.VarChar(24)
  policyMode             String    @map("policy_mode") @db.VarChar(16)
  policyJurisdiction     String    @map("policy_jurisdiction") @db.VarChar(32)
  policyChannel          String    @map("policy_channel") @db.VarChar(24)
  policyRecipientType    String?   @map("policy_recipient_type") @db.VarChar(24)
  policyClientId         String?   @map("policy_client_id") @db.Uuid
  policyEffectiveUserId  String    @map("policy_effective_user_id") @db.Uuid
  policyEffectiveAt      DateTime  @map("policy_effective_at") @db.Timestamptz(6)
  policyRuleId           String?   @map("policy_rule_id") @db.VarChar(160)
  policyDecision         String    @map("policy_decision") @db.VarChar(20)
  policyCode             String?   @map("policy_code") @db.VarChar(120)
  riskTier               String?   @map("risk_tier") @db.VarChar(40)
  preview                Json      @map("preview_jsonb")
  status                 String    @db.VarChar(32)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy             String?   @map("approved_by") @db.Uuid
  executionStartedAt     DateTime? @map("execution_started_at") @db.Timestamptz(6)
  executedAt             DateTime? @map("executed_at") @db.Timestamptz(6)
  attemptCount           Int       @default(0) @map("attempt_count")
  lastErrorCode          String?   @map("last_error_code") @db.VarChar(120)
  lastErrorMessage       String?   @map("last_error_message") @db.VarChar(1000)
  resultSummary          Json?     @map("result_summary_jsonb")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status, createdAt(sort: Desc)], map: "meri_action_proposal_user_status_created_idx")
  @@index([conversationId, status], map: "meri_action_proposal_conversation_status_idx")
  @@index([expiresAt, status], map: "meri_action_proposal_expiry_status_idx")
  @@index([tenantId, fingerprint], map: "meri_action_proposal_tenant_fingerprint_idx")
  @@index([tenantId, policyPackKey, policyPackVersion], map: "meri_action_proposals_policy_pack_idx")
  @@index([tenantId, policyDecisionHash], map: "meri_action_proposals_policy_decision_idx")
  @@map("meri_action_proposals")
}

/// Clio self-scheduled recurring task (W3). A user asks Clio to run something on
/// a cadence (e.g. a weekly research brief). The runner (scripts/run-clio-scheduled-tasks.ts)
/// executes due rows through the Clio tool engine with the task's tool allow-list.
/// Scope mirrors ClioMemory ('firm' shared | 'user_private' owner-only). Tenant-cascade.
model ClioScheduledTask {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  ownerUserId     String    @map("owner_user_id") @db.Uuid
  // 'firm' | 'user_private' (TEXT + app-level union, same rationale as ClioMemory).
  scope           String    @default("user_private")
  name            String    @db.VarChar(200)
  // The instruction Clio runs each tick (a natural-language prompt).
  prompt          String    @db.Text
  // Cadence in minutes between runs (>=60 enforced at the tool layer).
  intervalMinutes Int       @map("interval_minutes")
  // JSON array of tool names this task is allowed to call. Defaults to read-only
  // research tools; side-effecting tools require explicit opt-in + confirm.
  toolAllowList   Json      @default("[]") @map("tool_allow_list")
  enabled         Boolean   @default(true)
  lastRunAt       DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt       DateTime  @map("next_run_at") @db.Timestamptz(6)
  lastStatus      String?   @map("last_status") @db.VarChar(20)
  runCount        Int       @default(0) @map("run_count")
  createdBy       String    @default("clio") @map("created_by") @db.VarChar(40)
  metadata        Json      @default("{}") @map("metadata_jsonb")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerUserId, createdAt(sort: Desc)], map: "clio_scheduled_task_tenant_owner_idx")
  @@index([enabled, nextRunAt], map: "clio_scheduled_task_due_idx")
  @@map("clio_scheduled_task")
}

/// Tenant-configured MCP server (F6a). Bearer tokens for streamable-HTTP
/// servers are AES-256-GCM encrypted at rest (same pattern as
/// IntegrationConnectionToken) and never stored or returned in plaintext.
/// Tools are bridged as mcp__<name>__<tool>; only allowlisted tools register,
/// and every bridged tool is treated as side-effecting unless listed in
/// readOnlyTools.
model ClioMcpServer {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  name                String    @db.VarChar(64)
  /// http (streamable HTTP) | stdio (ops-managed local child process)
  transport           String    @db.VarChar(10)
  endpoint            String?   @db.VarChar(500)
  command             String?   @db.VarChar(500)
  args                Json      @default("[]")
  envJson             Json      @default("{}") @map("env_jsonb")
  // Connector library (connector-library v1):
  //   scope = 'tenant' (firm-wide, admin-managed) | 'user' (personal, owned by
  //   ownerUserId). Personal connections act as the person who authorized them
  //   and are private to that user. ownerUserId is NULL for firm-wide rows.
  //   catalogId links a row added from the curated library to its catalog entry.
  scope               String    @default("tenant") @db.VarChar(10)
  ownerUserId         String?   @map("owner_user_id") @db.Uuid
  catalogId           String?   @map("catalog_id") @db.VarChar(64)
  // 'none' | 'token' (static bearer) | 'oauth' (OAuth 2.1 — credentials live in
  // ClioMcpOAuthCredential). connectionStatus drives the UI status chip:
  // 'connected' | 'pending' (oauth started, not finished) | 'needs_reauth'
  // (token expired / refresh failed) | 'error' | 'disconnected'.
  authType            String    @default("token") @map("auth_type") @db.VarChar(10)
  connectionStatus    String    @default("connected") @map("connection_status") @db.VarChar(16)
  authTokenCiphertext String?   @map("auth_token_ciphertext")
  authTokenIv         String?   @map("auth_token_iv")
  authTokenAuthTag    String?   @map("auth_token_auth_tag")
  authKeyVersion      String?   @map("auth_key_version")
  toolAllowlist       Json      @default("[]") @map("tool_allowlist")
  readOnlyTools       Json      @default("[]") @map("read_only_tools")
  enabled             Boolean   @default(true)
  lastSyncAt          DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastError           String?   @map("last_error")
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  oauthCredential ClioMcpOAuthCredential?

  // Per-user uniqueness: two users can each add "Notion". Firm-wide rows have
  // ownerUserId = NULL; the firm-wide-name-uniqueness gap that NULLs create is
  // enforced in application code (see MeriMcpService.assertNameAvailable).
  @@unique([tenantId, ownerUserId, name], map: "clio_mcp_servers_tenant_owner_name_unique")
  @@index([tenantId, enabled], map: "clio_mcp_servers_tenant_enabled_idx")
  @@index([tenantId, ownerUserId, enabled], map: "clio_mcp_servers_tenant_owner_enabled_idx")
  @@map("clio_mcp_servers")
}

/// OAuth 2.1 credentials for an `authType = 'oauth'` ClioMcpServer (1:1).
/// Split out from the server row so the token/secret material lives in one
/// tightly-scoped, RLS-isolated table (mirrors integration_connection_token).
/// All secret fields are AES-256-GCM envelopes (ciphertext/iv/authTag), never
/// stored or returned in plaintext. clientId + registrationJson are the
/// non-secret RFC 7591 dynamic-registration result; codeVerifier* is the
/// transient PKCE verifier (cleared after the code exchange).
model ClioMcpOAuthCredential {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  serverId String @unique @map("server_id") @db.Uuid

  // RFC 7591 dynamic client registration (client_id is not secret).
  clientId               String? @map("client_id")
  clientSecretCiphertext String? @map("client_secret_ciphertext")
  clientSecretIv         String? @map("client_secret_iv")
  clientSecretAuthTag    String? @map("client_secret_auth_tag")
  registrationJson       Json?   @map("registration_jsonb")

  // OAuth tokens.
  accessTokenCiphertext  String?   @map("access_token_ciphertext")
  accessTokenIv          String?   @map("access_token_iv")
  accessTokenAuthTag     String?   @map("access_token_auth_tag")
  refreshTokenCiphertext String?   @map("refresh_token_ciphertext")
  refreshTokenIv         String?   @map("refresh_token_iv")
  refreshTokenAuthTag    String?   @map("refresh_token_auth_tag")
  tokenType              String?   @map("token_type")
  scopes                 Json      @default("[]")
  tokenExpiresAt         DateTime? @map("token_expires_at") @db.Timestamptz(6)

  // Transient PKCE verifier (set on start, cleared after exchange).
  codeVerifierCiphertext String? @map("code_verifier_ciphertext")
  codeVerifierIv         String? @map("code_verifier_iv")
  codeVerifierAuthTag    String? @map("code_verifier_auth_tag")

  // Single-use anti-replay nonce for the signed OAuth `state` (set on start,
  // atomically cleared when the callback consumes it).
  stateNonce String? @map("state_nonce")

  keyVersion String?  @map("key_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  server ClioMcpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "clio_mcp_oauth_credentials_tenant_idx")
  @@map("clio_mcp_oauth_credentials")
}

/// Firm-authored Clio skill (F6b). skillJson holds the validated FirmSkill
/// shape (id, name, triggers, systemAddendum, requiredTools, template);
/// versions holds prior skillJson snapshots (newest first) for restore.
/// Built-in skills always win on trigger conflict via the registry safe-merge.
model ClioFirmSkill {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  skillId         String   @map("skill_id") @db.VarChar(48)
  name            String   @db.VarChar(80)
  skillJson       Json     @map("skill_jsonb")
  version         Int      @default(1)
  versions        Json     @default("[]") @map("versions_jsonb")
  enabled         Boolean  @default(true)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, skillId], map: "clio_firm_skills_tenant_skill_unique")
  @@index([tenantId, enabled, updatedAt(sort: Desc)], map: "clio_firm_skills_tenant_enabled_idx")
  @@map("clio_firm_skills")
}

/// One row per AI generation: tenant, workflow, provider/model, token counts
/// and the ESTIMATED cost (computeAiCostUsd, hand-maintained pricing table).
/// usedTenantKey marks generations billed to the tenant's own provider key
/// rather than Capiro's shared key. Metering writes are best-effort — a
/// failed insert never fails the user's generation.
model AiUsageEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  /// Null = a tenant-agnostic (cached-L1) run, metered but excluded from
  /// per-tenant usage/billing reports (M5.0 agentic prerequisite).
  tenantId            String?  @map("tenant_id") @db.Uuid
  userId              String?  @map("user_id") @db.Uuid
  /// 'outreach_campaign' | 'meeting_prep' | 'meeting_debrief' | 'campaign_email' | 'talking_points' | ...
  workflow            String   @db.VarChar(48)
  /// 'openai' | 'anthropic'
  provider            String   @db.VarChar(16)
  model               String   @db.VarChar(80)
  inputTokens         Int      @map("input_tokens")
  outputTokens        Int      @map("output_tokens")
  /// Prompt-cache token counters (W3.3): read = cache hit (discounted), creation
  /// = cache write. Anthropic reports both; OpenAI reports cache reads only.
  cacheReadTokens     Int      @default(0) @map("cache_read_tokens")
  cacheCreationTokens Int      @default(0) @map("cache_creation_tokens")
  costUsd             Decimal  @map("cost_usd") @db.Decimal(12, 6)
  usedTenantKey       Boolean  @default(false) @map("used_tenant_key")
  /// Outreach prompt-assembly spec that produced this generation ('v1'|'v2'); null
  /// for non-outreach workflows (A12 traceability).
  promptSpecVersion   String?  @map("prompt_spec_version") @db.VarChar(8)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt], map: "ai_usage_events_tenant_created_idx")
  @@map("ai_usage_events")
}

/// Agentic Tier-1/Tier-2 run provenance (Phase 1 M5.0, agentic doc §5.1) —
/// modeled on `ProgramElementIngestRun`'s shape-precedent, but a DISTINCT
/// table (that model tracks PE-budget ingest-loader rows/quarantine counts;
/// this tracks one AGENT INVOCATION's full envelope). Every column the
/// proposal's per-output guardrail list demands (schema, source ids,
/// evidence, confidence, model + prompt version, run id, tool calls,
/// validation status, human-review status) as columns, not prose. Written
/// by every Tier-1/Tier-2 caller BEFORE `ai_usage_events` metering (the two
/// are siblings, not the same row — `ai_run` is provenance/QA, `ai_usage_events`
/// is spend). `tenantId = null` marks a tenant-agnostic cached-L1 run (global
/// row, not RLS-isolated to one tenant); tenant-scoped rows are RLS'd like
/// `ai_usage_events`.
model AiRun {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Matches `ai_usage_events.workflow`'s vocabulary, e.g. 'legiwatch_alert_enrichment' | 'intel_targeting' | 'intel_rules_comparison' | 'intel_qa_review'.
  workflow           String    @db.VarChar(48)
  /// 'federal' | 'state'
  rail               String    @db.VarChar(16)
  /// The envelope's subject — e.g. subjectType='bill', subjectKey='119-hr-8800' or 'fl-2026-hb1234'.
  subjectType        String    @map("subject_type") @db.VarChar(32)
  subjectKey         String    @map("subject_key")
  /// Null = tenant-agnostic (cached-generic L1 enrichment); set = a tenant-scoped Tier-2 run.
  tenantId           String?   @map("tenant_id") @db.Uuid
  /// W3.1: the client a tenant-scoped Tier-2 run was FOR (targeting briefs are
  /// per-client — chokepoint.forBill is client-scoped). Null for client-agnostic
  /// runs (L1 enrichment, rules-comparison). Lets the run-intel-workflows
  /// idempotency guard key on (bill, client, tenant), not just (bill, tenant),
  /// so a second client tracking the same bill still gets its own brief.
  clientId           String?   @map("client_id") @db.Uuid
  promptVersion      String    @map("prompt_version") @db.VarChar(32)
  model              String    @db.VarChar(80)
  /// 'openai' | 'anthropic'
  provider           String    @db.VarChar(16)
  usedTenantKey      Boolean   @default(false) @map("used_tenant_key")
  /// Source record ids the run read (bill keys, rule ids, member ids, ...).
  inputRefs          Json      @default("[]") @map("input_refs")
  /// The tool-call trace (name + args + result summary) for audit/replay.
  toolCalls          Json      @default("[]") @map("tool_calls")
  /// The GroundedJson output (or null if the run failed before producing one).
  output             Json?
  confidence         Float?
  /// Per-gate drop counts (W3.1) — how many model-asserted targets each
  /// deterministic layer removed. confidence = kept / (kept + sum of these).
  /// Makes "dropped and logged" (M5-B) inspectable from the row alone.
  droppedByGrounding Int       @default(0) @map("dropped_by_grounding")
  droppedByValidator Int       @default(0) @map("dropped_by_validator")
  droppedOffRoster   Int       @default(0) @map("dropped_off_roster")
  /// 'passed' | 'failed' | 'skipped' — the M5.0 deterministic validator gate's outcome.
  validationStatus   String    @map("validation_status") @db.VarChar(16)
  /// 'approved' | 'pending' | 'warning' | 'human_review' | 'rejected' | 'none' — the interim QA-gating state (§5.4 doc). 'pending' = held for human QA (W3.1: written on any drop or high materiality); 'warning'/'human_review'/'rejected' are the reserved human-review vocabulary.
  qaStatus           String    @default("none") @map("qa_status") @db.VarChar(16)
  humanReviewedBy    String?   @map("human_reviewed_by") @db.Uuid
  humanReviewedAt    DateTime? @map("human_reviewed_at") @db.Timestamptz(6)
  /// 'ok' | 'failed' | 'timeout' | 'fallback'
  status             String    @db.VarChar(16)
  durationMs         Int       @map("duration_ms")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([workflow, createdAt], map: "ai_run_workflow_created_idx")
  @@index([subjectType, subjectKey], map: "ai_run_subject_idx")
  @@index([tenantId, createdAt], map: "ai_run_tenant_created_idx")
  /// W3.1: covers the run-intel-workflows idempotency guard's correlated
  /// subquery (workflow + subject_key + tenant_id + client_id equality, then
  /// created_at range) so it probes an index rather than rescanning recent
  /// intel_targeting rows per candidate alert.
  @@index([workflow, subjectKey, tenantId, clientId, createdAt], map: "ai_run_targeting_guard_idx")
  @@map("ai_run")
}

/// Post-hoc grounding-auditor ledger (v3 hallucination plan Wave 5). One row per
/// audited generation turn: the auditor's verdict + the exact findings, so the
/// SHADOW-mode findings the auditor logs are also queryable/aggregable for the
/// lexicon tuning that must precede any per-surface `enforce` flip. Tenant-scoped
/// + RLS-isolated like ai_run (own-tenant-or-system), FORCE RLS. Findings live in
/// `findings_jsonb` (array of { check, severity, span, detail }) so the check set
/// can evolve without a migration; the scalar columns are what dashboards group by.
model MeriAuditLedger {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// 'chat' | 'research' | 'outreach' | 'memo' | 'alert'
  surface        String   @db.VarChar(16)
  /// 'shadow' | 'annotate' | 'enforce' — the AuditorMode this verdict ran under.
  mode           String   @db.VarChar(16)
  conversationId String?  @map("conversation_id") @db.Uuid
  /// Remediation plan §3.b2 — generic exact-subject correlation, e.g.
  /// 'outreach-draft-version' + an OutreachDraftVersion id. NULL for
  /// surfaces (chat/research/memo/alert) that ledger at the conversation
  /// level and have not adopted per-subject correlation.
  subjectType    String?  @map("subject_type") @db.VarChar(32)
  subjectId      String?  @map("subject_id")
  /// Gate I (CG-01) b-8: scopes the saveEdited L0 recent-hold lookup to ONE
  /// client/alert instead of any hold tenant-wide. NULL on rows written before
  /// this column existed and on surfaces with no single client/alert (chat/
  /// research/outreach) — NULL never matches a scoped lookup, so pre-existing
  /// rows cannot newly start blocking a save.
  clientId       String?  @map("client_id") @db.Uuid
  alertId        String?  @map("alert_id") @db.VarChar(128)
  model          String?  @db.VarChar(80)
  /// 'deliver' | 'deliver_with_flags' | 'repair' | 'hold'
  decision       String   @db.VarChar(24)
  /// 'critical' | 'high' | 'medium' | 'low' | null (clean).
  topSeverity    String?  @map("top_severity") @db.VarChar(12)
  findingCount   Int      @default(0) @map("finding_count")
  findings       Json     @default("[]") @map("findings_jsonb")
  outputChars    Int?     @map("output_chars")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// One FINAL ledger row per exact subject + mode (plan §3.b5) — a re-run
  /// upserts its own prior verdict instead of accumulating duplicates.
  /// Surfaces that leave subjectType/subjectId NULL are unaffected: Postgres
  /// never treats two NULLs as conflicting under a unique index.
  /// Also serves as the tenant/subject lookup index (plan §3.b2): any query
  /// filtering on (tenantId, subjectType, subjectId) uses this index's
  /// leading columns without needing a separate redundant index.
  @@unique([tenantId, subjectType, subjectId, mode], map: "meri_audit_ledger_subject_mode_key")
  @@index([tenantId, createdAt(sort: Desc)], map: "meri_audit_ledger_tenant_created_idx")
  @@index([surface, topSeverity, createdAt(sort: Desc)], map: "meri_audit_ledger_surface_severity_idx")
  @@index([tenantId, clientId, alertId, decision, createdAt(sort: Desc)], map: "meri_audit_ledger_tenant_client_alert_idx")
  @@map("meri_audit_ledger")
}

/// G4 — named-reviewer routing for held deliverables (blueprint §3.3). The
/// memory_candidate lifecycle generalized: pending → approved/rejected with
/// decided stamps, plus a NAMED reviewer (assignedTo). payload carries what
/// approve needs to RELEASE the deliverable (held memo markdown/title/client,
/// held research artifact id). RLS per the meri_audit_ledger template.
model ReviewRequest {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// low | moderate | high | restricted (shared RiskTier)
  riskTier    String    @map("risk_tier") @db.VarChar(16)
  /// 'alert-memo' | 'district-brief' | 'research' | 'outreach'
  surface     String    @db.VarChar(24)
  subjectType String    @map("subject_type") @db.VarChar(32)
  subjectId   String?   @map("subject_id")
  clientId    String?   @map("client_id") @db.Uuid
  title       String    @db.VarChar(300)
  /// Why it was held: the auditor finding summary shown to the reviewer.
  reason      String
  payload     Json      @default("{}") @map("payload_jsonb")
  /// pending | approved | rejected
  status      String    @default("pending") @db.VarChar(16)
  requestedBy String?   @map("requested_by") @db.Uuid
  /// The NAMED reviewer (users.id); NULL until a user_admin assigns.
  assignedTo  String?   @map("assigned_to") @db.Uuid
  decidedBy   String?   @map("decided_by") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outreachDraftVersions  OutreachDraftVersion[]
  alertGenerationRecords AlertGenerationRecord[]

  @@index([tenantId, status, createdAt(sort: Desc)], map: "review_request_tenant_status_idx")
  @@index([tenantId, assignedTo, status], map: "review_request_assigned_idx")
  @@index([tenantId, subjectType, subjectId], map: "review_request_subject_idx")
  @@map("review_request")
}

/// Gate I (CG-01) — a server-owned record of what governance decided about ONE
/// alert-memo/district-brief generation, so filing (saveEdited) can check
/// durable DB state instead of inferring hold status from banner text or a
/// meri_audit_ledger row — both of which are ABSENT for an entailment-only
/// hold when the auditor is off or found nothing (the S1-S4 slip-throughs
/// I_GOVERNANCE.md §1.4 documents). Modeled on OutreachDraftVersion's audit/
/// approval columns. Written pessimistically — filingState defaults to
/// 'blocked_pending_review' for a held generation BEFORE the review_request
/// create is attempted — so a crash between the two writes still leaves a
/// blocking row; filingState only relaxes to 'draft' once createSystem proves
/// a real review row exists. Additive-only; RLS per the meri_audit_ledger
/// template.
model AlertGenerationRecord {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  /// The alert (intel-api id) this generation was produced from. Not an FK —
  /// alerts are not persisted in apps/api.
  alertId         String   @map("alert_id") @db.VarChar(128)
  /// 'alert-memo' | 'district-brief'
  surface         String   @db.VarChar(24)
  /// 'none' | 'entailment' | 'auditor' | 'both'
  holdSource      String   @map("hold_source") @db.VarChar(16)
  holdReason      String?  @map("hold_reason")
  reviewRequestId String?  @map("review_request_id") @db.Uuid
  /// 'draft' | 'filed' | 'blocked_pending_review'
  filingState     String   @map("filing_state") @db.VarChar(32)
  /// sha256 of the generated markdown at write time. The saveEdited lock keys
  /// on the record's existence + filingState, NOT hash equality (Gate I open
  /// decision #2) — an expected edit must not itself invalidate the lock.
  contentHash     String   @map("content_hash") @db.VarChar(80)
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewRequest ReviewRequest? @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId, alertId, createdAt(sort: Desc)], map: "alert_generation_record_tenant_client_alert_idx")
  @@map("alert_generation_record")
}

/// G3 — structured advocacy outcomes (blueprint §3.1 stage 5 + §5.2 flywheel).
/// One row per observed result of the firm's work, loosely linked to its
/// source (outreach/meeting/artifact/campaign/submission) via source_type +
/// source_id (the EngagementTask precedent). Funding outcomes SNAPSHOT their
/// evidence into `evidence` (PE rows are global + superseded — never FK
/// them). RLS per the meri_audit_ledger template.
model OutcomeEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  clientId   String?  @map("client_id") @db.Uuid
  /// response_received | meeting_scheduled | meeting_held | language_included
  /// | funding_changed | filing_completed | commitment_secured | no_action
  kind       String   @db.VarChar(32)
  /// outreach | meeting | artifact | campaign | submission | manual
  sourceType String   @map("source_type") @db.VarChar(24)
  sourceId   String?  @map("source_id")
  /// Snapshotted proof: { peCode?, fiscalYear?, stage?, amountFrom?, amountTo?, billNumber?, ... }
  evidence   Json     @default("{}") @map("evidence_jsonb")
  notes      String?
  /// users.id of whoever recorded it; NULL for system-emitted mirrors.
  recordedBy String?  @map("recorded_by") @db.Uuid
  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, observedAt(sort: Desc)], map: "outcome_event_tenant_observed_idx")
  @@index([tenantId, clientId, observedAt(sort: Desc)], map: "outcome_event_tenant_client_idx")
  @@index([tenantId, sourceType, sourceId], map: "outcome_event_source_idx")
  @@map("outcome_event")
}

/// Context Compiler v1 packet trace (G1, blueprint §4.6.4). One row per compiled
/// steering-context packet: which memory files reached a generation prompt
/// (`items_jsonb`) and which were deliberately withheld and why
/// (`exclusions_jsonb`: revoked | superseded | empty | over-budget |
/// unauthorized). Written FIRE-AND-FORGET by the compiler adapters in apps/api,
/// the orchestrator (shared Prisma client), and apps/workspace (raw INSERT) —
/// a trace failure never blocks generation. The `id` is the compiler-minted
/// packetId (NOT db-defaulted) so the trace row and any downstream reference
/// (audit ledger, provenance panel) share one identifier. RLS like
/// meri_audit_ledger (per-command policies, FORCE, no null-tenant path).
model ContextPacket {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// ContextSurface: 'chat' | 'ga-chat' | 'outreach' | 'memo' |
  /// 'district-brief' | 'research' | 'workspace-gen'
  surface        String   @db.VarChar(24)
  userId         String?  @map("user_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  /// Surface-local anchor: { conversationId? | draftId? | outreachId? | alertId? }
  ref            Json     @default("{}") @map("ref_jsonb")
  /// ContextPacketItem[]: { layer, id, type, slug, chars, rationale }
  items          Json     @default("[]") @map("items_jsonb")
  /// ContextExclusion[]: { layer, id, type, slug, reason }
  exclusions     Json     @default("[]") @map("exclusions_jsonb")
  itemCount      Int      @default(0) @map("item_count")
  exclusionCount Int      @default(0) @map("exclusion_count")
  blockChars     Int      @default(0) @map("block_chars")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ── Phase 1 §3.a — Evidence Packet v2 ──────────────────────────────────────
  // `items`/`exclusions` above are RETAINED unchanged: they remain the steering-
  // memory trace every non-Engagement surface writes fire-and-forget. The fields
  // below are the Engagement generation trust boundary — written SYNCHRONOUSLY
  // and fail-CLOSED under ENGAGEMENT_GENERATION_GATEWAY.
  /// 1 = legacy steering-only trace. 2 = complete Evidence Packet. New writes
  /// default to 2; the migration pins pre-existing rows to 1.
  packetVersion        Int       @default(2) @map("packet_version")
  /// AuthenticatedDirective[] — the ONLY channel rendered as an instruction.
  directives           Json      @default("[]") @map("directives_jsonb")
  /// EvidenceItem[] — refs + BOUNDED excerpts (never whole threads/documents).
  evidence             Json      @default("[]") @map("evidence_jsonb")
  /// SourceFailure[] — every source that failed to load, with severity.
  sourceFailures       Json      @default("[]") @map("source_failures_jsonb")
  /// The resolved GA policy: { jurisdiction, audienceType, version }.
  policy               Json      @default("{}") @map("policy_jsonb")
  /// Pinned generation identity: { provider, model, promptSpecVersion, … }.
  modelPolicy          Json      @default("{}") @map("model_policy_jsonb")
  /// sha256 over the canonical, stable-key-ordered packet JSON.
  packetHash           String?   @map("packet_hash") @db.VarChar(80)
  criticalFailureCount Int       @default(0) @map("critical_failure_count")
  freshestSourceAt     DateTime? @map("freshest_source_at") @db.Timestamptz(6)
  stalestSourceAt      DateTime? @map("stalest_source_at") @db.Timestamptz(6)

  // ── ContextPacket v2 metadata (20260729010000_memory_governance_context_v2) ──
  // `packetVersion` above is shared with (and owned by) the engagement gateway
  // migration; everything here is new. Bodies are never copied into this table.
  //
  // effectiveTenantId is NOT NULL with NO default (the migration backfills it
  // from tenant_id then does ALTER COLUMN ... SET NOT NULL), so it is REQUIRED
  // here — every writer must supply it explicitly.
  //
  // SQL-ONLY (not expressible in Prisma — see the migration):
  //   CHECK context_packet_version_check (packet_version IN (1, 2))
  //   CHECK context_packet_budget_check (non-negative, used <= budget)
  //   PARTIAL INDEX context_packet_v2_trace_idx
  //     (tenant_id, trace_id, created_at DESC) WHERE packet_version = 2
  //   PARTIAL INDEX context_packet_v2_surface_idx
  //     (tenant_id, surface, client_id, created_at DESC) WHERE packet_version = 2
  effectiveTenantId String   @map("effective_tenant_id") @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  traceId           String?  @map("trace_id") @db.VarChar(160)
  promptVersion     String?  @map("prompt_version") @db.VarChar(80)
  policyVersion     String?  @map("policy_version") @db.VarChar(80)
  compilerVersion   String?  @map("compiler_version") @db.VarChar(80)
  requiredLayers    String[] @default([]) @map("required_layers")
  health            Json     @default("{}") @map("health_jsonb")
  totalTokenBudget  Int?     @map("total_token_budget")
  usedTokens        Int      @default(0) @map("used_tokens")
  truncated         Boolean  @default(false)
  incomplete        Boolean  @default(false)

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outreachDraftVersions OutreachDraftVersion[]

  @@index([tenantId, createdAt(sort: Desc)], map: "context_packet_tenant_created_idx")
  @@index([tenantId, surface, createdAt(sort: Desc)], map: "context_packet_tenant_surface_idx")
  @@index([tenantId, packetVersion, createdAt(sort: Desc)], map: "context_packet_tenant_version_created_idx")
  @@map("context_packet")
}

/// Async outreach job (plan W4 / §3.3). One row per generate-or-send request the
/// wizard submits; the claim-sweep worker drives it to completion off the request
/// path (past the ALB idle ceiling). requestKey is the client idempotency token —
/// a duplicate POST with the same (tenant, requestKey) returns the existing job.
model OutreachJob {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  /// 'generate' | 'send'
  kind             String    @db.VarChar(16)
  outreachRecordId String?   @map("outreach_record_id") @db.Uuid
  /// promptSpecVersion, model, provider, templateId, tone, length, direction, contextItems, appendSignature, attachmentIds, testMode …
  params           Json      @default("{}") @map("params_jsonb")
  /// queued | running | partial | complete | failed | canceled
  status           String    @default("queued") @db.VarChar(16)
  /// { queued, succeeded, failed, skipped }
  totals           Json      @default("{}") @map("totals_jsonb")
  requestKey       String    @map("request_key") @db.VarChar(128)
  error            String?
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  OutreachJobItem[]

  // Per-USER idempotency (Phase 0 task c3): two users may legitimately mint the
  // same client-side requestKey and one must never resolve to the other's job.
  // The 20260727010000 migration creates this index in BOTH of its data-shape
  // branches — as a PARTIAL unique (WHERE user_id IS NOT NULL) when legacy
  // ownerless rows exist, which Prisma cannot express. In that branch the old
  // tenant-wide outreach_jobs_tenant_request_key ALSO survives in the database
  // as those rows' guard; it is intentionally not declared here.
  @@unique([tenantId, userId, requestKey], map: "outreach_jobs_tenant_user_request_key")
  @@index([status, createdAt], map: "outreach_jobs_status_created_idx")
  @@index([tenantId, userId, status], map: "outreach_jobs_tenant_user_status_idx")
  @@map("outreach_jobs")
}

/// One recipient's unit of work within an OutreachJob. Claimed atomically
/// (pending → claimed) so exactly one worker processes it; the (jobId,
/// recipientKey) unique index is the server-side dedup + the resume anchor.
model OutreachJobItem {
  id           String    @id @default(uuid()) @db.Uuid
  jobId        String    @map("job_id") @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  recipientKey String    @map("recipient_key") @db.VarChar(256)
  /// recipient snapshot (generate) or the draft to send (send)
  payload      Json      @default("{}") @map("payload_jsonb")
  /// pending | claimed | generating | done | failed | sending | sent | skipped
  status       String    @default("pending") @db.VarChar(16)
  /// { subject, body, contextNote } or { messageId }
  result       Json?     @map("result_jsonb")
  attempt      Int       @default(0)
  error        String?
  claimedAt    DateTime? @map("claimed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  job    OutreachJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([jobId, recipientKey], map: "outreach_job_items_job_recipient")
  @@index([jobId, status], map: "outreach_job_items_job_status_idx")
  @@map("outreach_job_items")
}

/// Engagement Phase 0 — one logical draft "slot" for an outreach record: an
/// individual recipient, one member of a list, or a whole group that shares one
/// email. Identified by the wizard's GenerationTargetKey so a regenerate of the
/// same slot adds a VERSION instead of a second artifact. The row is also the
/// FOR UPDATE lock target that serializes concurrent version creation.
/// Owner-private: reads are scoped by tenant RLS *and* the owning user.
model OutreachDraftArtifact {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  outreachRecordId  String   @map("outreach_record_id") @db.Uuid
  /// individual:<recipientKey> | list:<audienceId>:<recipientKey> | group:<audienceId>
  generationKey     String   @map("generation_key") @db.VarChar(512)
  recipientKey      String   @map("recipient_key") @db.VarChar(256)
  /// 'individual' | 'group'
  audienceKind      String   @map("audience_kind") @db.VarChar(16)
  recipientSnapshot Json     @default("{}") @map("recipient_snapshot_jsonb")
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  currentVersion    Int      @default(0) @map("current_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outreachRecord OutreachRecord         @relation(fields: [outreachRecordId], references: [id], onDelete: Cascade)
  createdBy      User                   @relation("OutreachDraftArtifactAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions       OutreachDraftVersion[]

  @@unique([tenantId, outreachRecordId, generationKey], map: "outreach_draft_artifacts_tenant_record_genkey")
  @@index([tenantId, outreachRecordId], map: "outreach_draft_artifacts_tenant_record_idx")
  @@map("outreach_draft_artifacts")
}

/// Engagement Phase 0 — the IMMUTABLE audited artifact. subject/body/contentHash
/// are written once and never updated: an edit, AI improvement, regenerate or
/// revert creates a NEW version pointing back via sourceVersionId. Only the
/// audit/approval lifecycle columns are mutable, and an approval may never
/// change content. Every real external delivery references one of these rows.
/// Statuses are Strings (not Prisma enums) on purpose so a future status can
/// ship without a PostgreSQL enum migration — see outreach-draft.types.ts for
/// the authoritative literal unions and the sendability policy.
model OutreachDraftVersion {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  artifactId        String   @map("artifact_id") @db.Uuid
  version           Int
  /// The version this one was edited/improved/reverted FROM; null for a fresh generation.
  sourceVersionId   String?  @map("source_version_id") @db.Uuid
  subject           String   @db.Text
  body              String   @db.Text
  /// sha256 of subject+body — what the audit verdict and any approval attach to.
  contentHash       String   @map("content_hash") @db.VarChar(80)
  /// 'generated' | 'manually_authored' | 'generation_failed'
  generationStatus  String   @map("generation_status") @db.VarChar(32)
  /// 'not_required' | 'pending' | 'passed' | 'warning' | 'held' | 'unavailable'
  auditStatus       String   @map("audit_status") @db.VarChar(32)
  /// 'not_required' | 'pending' | 'approved' | 'rejected'
  approvalStatus    String   @map("approval_status") @db.VarChar(32)
  /// The AuditorMode this verdict ran under ('shadow' | 'annotate' | 'enforce').
  auditMode         String?  @map("audit_mode") @db.VarChar(16)
  /// runAuditor decision, or 'audit_unavailable' when a control itself failed.
  auditDecision     String?  @map("audit_decision") @db.VarChar(32)
  auditFindings     Json?    @map("audit_findings_jsonb")
  /// The structured auditor ledger entries this exact text was judged against.
  auditLedger       Json     @default("[]") @map("audit_ledger_jsonb")
  reviewRequestId   String?  @map("review_request_id") @db.Uuid
  contextPacketId   String?  @map("context_packet_id") @db.Uuid
  provider          String?  @db.VarChar(32)
  model             String?  @db.VarChar(160)
  promptSpecVersion String?  @map("prompt_spec_version") @db.VarChar(32)
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artifact        OutreachDraftArtifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  sourceVersion   OutreachDraftVersion?  @relation("OutreachDraftVersionLineage", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  derivedVersions OutreachDraftVersion[] @relation("OutreachDraftVersionLineage")
  reviewRequest   ReviewRequest?         @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)
  contextPacket   ContextPacket?         @relation(fields: [contextPacketId], references: [id], onDelete: SetNull)
  createdBy       User                   @relation("OutreachDraftVersionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliveries      OutreachDelivery[]

  @@unique([artifactId, version], map: "outreach_draft_versions_artifact_version")
  @@index([tenantId, auditStatus, approvalStatus], map: "outreach_draft_versions_tenant_audit_approval_idx")
  @@map("outreach_draft_versions")
}

/// Engagement Phase 0 — the DURABLE send intent. Committed, with all of its
/// delivery rows, BEFORE any provider request is made, so an unrecorded external
/// send is structurally impossible. Accepts draft VERSION ids only, never raw
/// caller subject/body. Idempotent per (tenant, user, requestKey): a retried
/// POST returns the existing intent and sends nothing again.
model OutreachSendIntent {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  outreachRecordId   String    @map("outreach_record_id") @db.Uuid
  senderConnectionId String    @map("sender_connection_id") @db.Uuid
  /// Client idempotency token, minted once per Send click.
  requestKey         String    @map("request_key") @db.VarChar(128)
  /// Remediation plan §3.c5/c6 — sha256 over the canonical request payload
  /// (tenant, user, parent record, mailbox, sorted version ids, sorted
  /// attachment manifest, signature choice, test mode). Lets a REUSED
  /// requestKey be told apart from a genuine retry: same key + same
  /// fingerprint dedupes, same key + a different fingerprint is refused
  /// (OUTREACH_REQUEST_KEY_REUSED) instead of silently returning the old
  /// intent for a materially different request. Historical rows backfill to
  /// `legacy:<id>`, a format a real `sha256:`-prefixed fingerprint can never
  /// collide with.
  requestFingerprint String    @map("request_fingerprint") @db.VarChar(160)
  appendSignature    Boolean   @default(true) @map("append_signature")
  attachmentIds      Json      @default("[]") @map("attachment_ids_jsonb")
  testMode           Boolean   @default(false) @map("test_mode")
  /// queued | running | partial | complete | failed | canceled
  status             String    @default("queued") @db.VarChar(24)
  /// { total, pending, sending, sent, failed, unknown, skipped, held }
  totals             Json      @default("{}") @map("totals_jsonb")
  error              String?
  startedAt          DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User                  @relation("OutreachSendIntentOwner", fields: [userId], references: [id], onDelete: Restrict)
  outreachRecord   OutreachRecord        @relation(fields: [outreachRecordId], references: [id], onDelete: Cascade)
  senderConnection IntegrationConnection @relation(fields: [senderConnectionId], references: [id], onDelete: Restrict)
  deliveries       OutreachDelivery[]

  @@unique([tenantId, userId, requestKey], map: "outreach_send_intents_tenant_user_request_key")
  @@index([status, createdAt], map: "outreach_send_intents_status_created_idx")
  @@index([tenantId, outreachRecordId], map: "outreach_send_intents_tenant_record_idx")
  @@map("outreach_send_intents")
}

/// Engagement Phase 0 — one logical send unit (one recipient, or one whole group
/// sharing a single email). AT-MOST-ONCE: the row is claimed pending → sending
/// in an atomic conditional UPDATE before the provider call, and an ambiguous
/// outcome becomes 'unknown', which is NEVER automatically returned to pending
/// or retried. renderedSubject/renderedBody are the exact text handed to the
/// provider, captured at intent creation so a later signature or body edit
/// cannot mutate an in-flight send.
model OutreachDelivery {
  id                        String    @id @default(uuid()) @db.Uuid
  tenantId                  String    @map("tenant_id") @db.Uuid
  sendIntentId              String    @map("send_intent_id") @db.Uuid
  draftVersionId            String    @map("draft_version_id") @db.Uuid
  generationKey             String    @map("generation_key") @db.VarChar(512)
  recipientKey              String    @map("recipient_key") @db.VarChar(256)
  /// { to: [{email,name}], cc: [...], bcc: [...] } — exactly as submitted.
  recipientEnvelope         Json      @map("recipient_envelope_jsonb")
  /// sha256(tenant + connection + version + envelope + attachment manifest):
  /// the same exact delivery can never be created twice, under ANY request key.
  idempotencyKey            String    @map("idempotency_key") @db.VarChar(160)
  correlationId             String    @default(uuid()) @map("correlation_id") @db.Uuid
  renderedSubject           String    @map("rendered_subject") @db.Text
  renderedBody              String    @map("rendered_body") @db.Text
  attachmentManifest        Json      @default("[]") @map("attachment_manifest_jsonb")
  /// 'microsoft_graph' | 'gmail'
  provider                  String    @db.VarChar(32)
  /// pending | sending | sent | failed | unknown | skipped | held
  status                    String    @default("pending") @db.VarChar(24)
  attempt                   Int       @default(0)
  providerMessageId         String?   @map("provider_message_id")
  providerThreadId          String?   @map("provider_thread_id")
  providerDraftId           String?   @map("provider_draft_id")
  providerInternetMessageId String?   @map("provider_internet_message_id")
  errorCode                 String?   @map("error_code") @db.VarChar(120)
  errorMessage              String?   @map("error_message")
  claimedAt                 DateTime? @map("claimed_at") @db.Timestamptz(6)
  acceptedAt                DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sendIntent   OutreachSendIntent   @relation(fields: [sendIntentId], references: [id], onDelete: Cascade)
  draftVersion OutreachDraftVersion @relation(fields: [draftVersionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey], map: "outreach_deliveries_tenant_idempotency_key")
  @@index([sendIntentId, status], map: "outreach_deliveries_intent_status_idx")
  @@index([tenantId, correlationId], map: "outreach_deliveries_tenant_correlation_idx")
  @@map("outreach_deliveries")
}

/// Per-tenant AI provider key, AES-256-GCM encrypted at rest with
/// AI_CREDENTIAL_ENCRYPTION_KEY (same envelope pattern as
/// engagement_connection_tokens). Write-only through the API: the plaintext
/// key is never returned — only keyLast4 for display. One credential per
/// (tenant, provider); the resolver falls back to the global env key when no
/// active row exists.
model TenantAiCredential {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// 'openai' | 'anthropic'
  provider        String    @db.VarChar(16)
  keyCiphertext   String    @map("key_ciphertext")
  keyIv           String    @map("key_iv")
  keyAuthTag      String    @map("key_auth_tag")
  keyVersion      String    @default("v1") @map("key_version")
  keyLast4        String    @map("key_last4") @db.VarChar(4)
  modelOverride   String?   @map("model_override") @db.VarChar(80)
  /// 'active' | 'invalid' | 'disabled'
  status          String    @default("active") @db.VarChar(16)
  lastValidatedAt DateTime? @map("last_validated_at") @db.Timestamptz(6)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider], map: "tenant_ai_credentials_tenant_provider_key")
  @@map("tenant_ai_credentials")
}

model ClioProactiveAlert {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  clientId    String?   @map("client_id") @db.Uuid
  // GAI-13: the user this alert belongs to. NULL = tenant-broadcast (visible to
  // every user in the tenant, e.g. client_activity / stale_position / campaign
  // recommendations). Non-NULL = a personal alert (scheduled-task digests,
  // per-user meeting briefings) visible only to that user. Enforced by the
  // owner-aware FORCE RLS policy (current_user_id()).
  ownerUserId String?   @map("owner_user_id") @db.Uuid
  alertType   String    @map("alert_type")
  title       String
  body        String    @db.Text
  priority    String    @default("normal")
  status      String    @default("pending")
  sourceType  String?   @map("source_type")
  sourceId    String?   @map("source_id")
  metadata    Json      @default("{}") @map("metadata_jsonb")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, clientId, createdAt(sort: Desc)])
  @@index([tenantId, ownerUserId, status, createdAt(sort: Desc)])
  @@map("clio_proactive_alerts")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?    @map("before_jsonb")
  after       Json?    @map("after_jsonb")
  ip          String?
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt(sort: Desc)], map: "audit_logs_tenant_occurred_idx")
  @@index([tenantId, action], map: "audit_logs_tenant_action_idx")
  @@map("audit_logs")
}

model ClientCapability {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  clientId             String   @map("client_id") @db.Uuid
  name                 String
  type                 String   @default("product")
  description          String?  @db.Text
  sector               String?
  tags                 Json     @default("[]") @map("tags_jsonb")
  issueCodes           Json     @default("[]") @map("issue_codes_jsonb")
  trl                  Int?
  mrl                  Int?
  peNumber             String?  @map("pe_number")
  // Step 2.3 — multi-PE + explicit match keywords (peNumber kept for backcompat).
  peNumbers            String[] @default([]) @map("pe_numbers")
  keywords             String[] @default([])
  appropriationAccount String?  @map("appropriation_account")
  serviceBranch        String?  @map("service_branch")
  targetSubcommittee   String?  @map("target_subcommittee")
  fundingAsk           Int?     @map("funding_ask")
  fundingAskLabel      String?  @map("funding_ask_label")
  justification        String?  @db.Text
  districtNexus        String?  @map("district_nexus") @db.Text
