model ClioMemory {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  // Stored as TEXT in the DB with a CHECK constraint (scope IN ('firm','user_private'))
  // per the 20260525103000_clio_memory_scope_hardening migration. Modeled as String
  // (not a Prisma enum) so the generated client never casts to a "ClioMemoryScope"
  // Postgres type — that type was never created, and the enum decl caused
  // `type "public.ClioMemoryScope" does not exist` (42704) 500s on Clio memory reads.
  // App-level union typing lives in clio/clio-memory.helpers.ts (ClioMemoryScope = 'firm' | 'user_private').
  scope       String                 @default("firm")
  ownerUserId String?                @map("owner_user_id") @db.Uuid
  key         String                 @db.VarChar(200)
  value       String                 @db.Text
  source      String                 @default("conversation")
  embedding   Unsupported("vector")?
  metadata    Json                   @default("{}") @map("metadata_jsonb")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Firm-scope rows (owner_user_id IS NULL) are additionally guarded by a
  // PARTIAL unique index `clio_memory_firm_key_uniq` (tenant_id, scope, key)
  // WHERE owner_user_id IS NULL, created raw in migration 20260705120000 because
  // Prisma cannot express partial indexes. Do NOT let `prisma migrate dev`
  // reconcile it away. The @@unique below still enforces the user_private case.
  @@unique([tenantId, scope, ownerUserId, key], map: "clio_memory_tenant_scope_owner_key_uniq")
  @@index([tenantId, scope, ownerUserId, updatedAt(sort: Desc)], map: "clio_memory_scope_owner_updated_idx")
  @@index([tenantId, scope, updatedAt(sort: Desc)], map: "clio_memory_scope_updated_idx")
  @@map("clio_memory")
}

/// MeriV2 write-tool approval record (Workstream B4 — the ApprovalStore's
/// persistence). When a compliance decision is WARN, the orchestrator's gate
/// holds the write (ApprovalPendingError) until a human approves THIS exact
/// action. The action is identified by a stable `fingerprint` (sha256 over
/// tenant+user+tool+canonicalized input, computed in @capiro/meriv2-core's
/// computeActionFingerprint) — so an approval can never be replayed against a
/// mutated action. One approved row per (tenant, user, fingerprint).
///
/// POLICY not yet decided (needs Neo): approval TTL (rows never expire today),
/// WHO may approve (self-approve today; four-eyes would add an approverUserId
/// distinct from userId), and whether one approval survives a re-run (it does
/// today — the row persists). These are enforced by the service/endpoint on top
/// of this table, not by the table shape. Tenant-cascade.
model MeriActionApproval {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Clerk subject of the user the approval is scoped to (matches MeriContext.userId).
  userId      String   @map("user_id")
  /// sha256 hex from meriv2-core computeActionFingerprint (opaque to apps/api).
  fingerprint String   @db.VarChar(64)
  /// The write tool this approval authorizes (for display/audit; not part of the key).
  tool        String   @db.VarChar(120)
  status      String   @default("approved")
  approvedBy  String   @map("approved_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, fingerprint], map: "meri_action_approval_tenant_user_fp_uniq")
  @@index([tenantId, userId, createdAt(sort: Desc)], map: "meri_action_approval_user_created_idx")
  @@map("meri_action_approval")
}

/// Clio self-scheduled recurring task (W3). A user asks Clio to run something on
/// a cadence (e.g. a weekly research brief). The runner (scripts/run-clio-scheduled-tasks.ts)
/// executes due rows through the Clio tool engine with the task's tool allow-list.
/// Scope mirrors ClioMemory ('firm' shared | 'user_private' owner-only). Tenant-cascade.
model ClioScheduledTask {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  ownerUserId     String    @map("owner_user_id") @db.Uuid
  // 'firm' | 'user_private' (TEXT + app-level union, same rationale as ClioMemory).
  scope           String    @default("user_private")
  name            String    @db.VarChar(200)
  // The instruction Clio runs each tick (a natural-language prompt).
  prompt          String    @db.Text
  // Cadence in minutes between runs (>=60 enforced at the tool layer).
  intervalMinutes Int       @map("interval_minutes")
  // JSON array of tool names this task is allowed to call. Defaults to read-only
  // research tools; side-effecting tools require explicit opt-in + confirm.
  toolAllowList   Json      @default("[]") @map("tool_allow_list")
  enabled         Boolean   @default(true)
  lastRunAt       DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt       DateTime  @map("next_run_at") @db.Timestamptz(6)
  lastStatus      String?   @map("last_status") @db.VarChar(20)
  runCount        Int       @default(0) @map("run_count")
  createdBy       String    @default("clio") @map("created_by") @db.VarChar(40)
  metadata        Json      @default("{}") @map("metadata_jsonb")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerUserId, createdAt(sort: Desc)], map: "clio_scheduled_task_tenant_owner_idx")
  @@index([enabled, nextRunAt], map: "clio_scheduled_task_due_idx")
  @@map("clio_scheduled_task")
}

/// Tenant-configured MCP server (F6a). Bearer tokens for streamable-HTTP
/// servers are AES-256-GCM encrypted at rest (same pattern as
/// IntegrationConnectionToken) and never stored or returned in plaintext.
/// Tools are bridged as mcp__<name>__<tool>; only allowlisted tools register,
/// and every bridged tool is treated as side-effecting unless listed in
/// readOnlyTools.
model ClioMcpServer {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  name                String    @db.VarChar(64)
  /// http (streamable HTTP) | stdio (ops-managed local child process)
  transport           String    @db.VarChar(10)
  endpoint            String?   @db.VarChar(500)
  command             String?   @db.VarChar(500)
  args                Json      @default("[]")
  envJson             Json      @default("{}") @map("env_jsonb")
  // Connector library (connector-library v1):
  //   scope = 'tenant' (firm-wide, admin-managed) | 'user' (personal, owned by
  //   ownerUserId). Personal connections act as the person who authorized them
  //   and are private to that user. ownerUserId is NULL for firm-wide rows.
  //   catalogId links a row added from the curated library to its catalog entry.
  scope               String    @default("tenant") @db.VarChar(10)
  ownerUserId         String?   @map("owner_user_id") @db.Uuid
  catalogId           String?   @map("catalog_id") @db.VarChar(64)
  // 'none' | 'token' (static bearer) | 'oauth' (OAuth 2.1 — credentials live in
  // ClioMcpOAuthCredential). connectionStatus drives the UI status chip:
  // 'connected' | 'pending' (oauth started, not finished) | 'needs_reauth'
  // (token expired / refresh failed) | 'error' | 'disconnected'.
  authType            String    @default("token") @map("auth_type") @db.VarChar(10)
  connectionStatus    String    @default("connected") @map("connection_status") @db.VarChar(16)
  authTokenCiphertext String?   @map("auth_token_ciphertext")
  authTokenIv         String?   @map("auth_token_iv")
  authTokenAuthTag    String?   @map("auth_token_auth_tag")
  authKeyVersion      String?   @map("auth_key_version")
  toolAllowlist       Json      @default("[]") @map("tool_allowlist")
  readOnlyTools       Json      @default("[]") @map("read_only_tools")
  enabled             Boolean   @default(true)
  lastSyncAt          DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastError           String?   @map("last_error")
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  oauthCredential ClioMcpOAuthCredential?

  // Per-user uniqueness: two users can each add "Notion". Firm-wide rows have
  // ownerUserId = NULL; the firm-wide-name-uniqueness gap that NULLs create is
  // enforced in application code (see MeriMcpService.assertNameAvailable).
  @@unique([tenantId, ownerUserId, name], map: "clio_mcp_servers_tenant_owner_name_unique")
  @@index([tenantId, enabled], map: "clio_mcp_servers_tenant_enabled_idx")
  @@index([tenantId, ownerUserId, enabled], map: "clio_mcp_servers_tenant_owner_enabled_idx")
  @@map("clio_mcp_servers")
}

/// OAuth 2.1 credentials for an `authType = 'oauth'` ClioMcpServer (1:1).
/// Split out from the server row so the token/secret material lives in one
/// tightly-scoped, RLS-isolated table (mirrors integration_connection_token).
/// All secret fields are AES-256-GCM envelopes (ciphertext/iv/authTag), never
/// stored or returned in plaintext. clientId + registrationJson are the
/// non-secret RFC 7591 dynamic-registration result; codeVerifier* is the
/// transient PKCE verifier (cleared after the code exchange).
model ClioMcpOAuthCredential {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  serverId String @unique @map("server_id") @db.Uuid

  // RFC 7591 dynamic client registration (client_id is not secret).
  clientId               String? @map("client_id")
  clientSecretCiphertext String? @map("client_secret_ciphertext")
  clientSecretIv         String? @map("client_secret_iv")
  clientSecretAuthTag    String? @map("client_secret_auth_tag")
  registrationJson       Json?   @map("registration_jsonb")

  // OAuth tokens.
  accessTokenCiphertext  String?   @map("access_token_ciphertext")
  accessTokenIv          String?   @map("access_token_iv")
  accessTokenAuthTag     String?   @map("access_token_auth_tag")
  refreshTokenCiphertext String?   @map("refresh_token_ciphertext")
  refreshTokenIv         String?   @map("refresh_token_iv")
  refreshTokenAuthTag    String?   @map("refresh_token_auth_tag")
  tokenType              String?   @map("token_type")
  scopes                 Json      @default("[]")
  tokenExpiresAt         DateTime? @map("token_expires_at") @db.Timestamptz(6)

  // Transient PKCE verifier (set on start, cleared after exchange).
  codeVerifierCiphertext String? @map("code_verifier_ciphertext")
  codeVerifierIv         String? @map("code_verifier_iv")
  codeVerifierAuthTag    String? @map("code_verifier_auth_tag")

  // Single-use anti-replay nonce for the signed OAuth `state` (set on start,
  // atomically cleared when the callback consumes it).
  stateNonce String? @map("state_nonce")

  keyVersion String?  @map("key_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  server ClioMcpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "clio_mcp_oauth_credentials_tenant_idx")
  @@map("clio_mcp_oauth_credentials")
}

/// Firm-authored Clio skill (F6b). skillJson holds the validated FirmSkill
/// shape (id, name, triggers, systemAddendum, requiredTools, template);
/// versions holds prior skillJson snapshots (newest first) for restore.
/// Built-in skills always win on trigger conflict via the registry safe-merge.
model ClioFirmSkill {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  skillId         String   @map("skill_id") @db.VarChar(48)
