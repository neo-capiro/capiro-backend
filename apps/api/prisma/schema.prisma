  sourceAlertId String?  @map("source_alert_id") // alertId it was promoted from, if any
  sourceType    String?  @map("source_type") // 'comment_deadline' | 'change' | 'hearing' | 'manual' | ...
  title         String
  body          String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([clientId])
  @@map("client_brief")
}

// ─────────────────────────────────────────────────────────────────────────
// Tracker tab — per-client watchlist, alert preferences, feedback, and the
// notification delivery ledger. All TENANT-scoped with RLS (mirrors the
// tracked_bill / alert_state isolation convention: tenant_id column + policy,
// no Prisma relation/FK). The board membership table is tracked_bill itself.
// ─────────────────────────────────────────────────────────────────────────

// Per-client targeting config authored on the Tracker → Configure panel. Tunes
// the Recommendations matcher and alert routing. One row per client.
model ClientWatchlist {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  // Capiro-managed issue-area labels the client has switched on.
  issueAreas String[] @default([]) @map("issue_areas")
  // JSON array of watchlist tag objects, each:
  //   { tag, issueArea?, synonyms[], relatedEntities[], riskTerms[],
  //     position?: 'support'|'oppose'|'monitor', priority: 'low'|'med'|'high' }
  tags       Json     @default("[]")
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([clientId])
  @@index([tenantId])
  @@map("client_watchlist")
}

// Per-user-per-client alert delivery preferences (triggers, materiality floor,
// and channel config). SMS is wired but DORMANT until an origination number is
// provisioned (see tracker/sms/sms.service.ts).
model AlertPreference {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  userId           String   @map("user_id") // clerk user id; prefs are per user, per client
  triggers         String[] @default([]) @map("triggers") // enabled trigger keys
  materiality      String   @default("medium") // 'low' | 'medium' | 'high'
  emailEnabled     Boolean  @default(false) @map("email_enabled")
  emailAddress     String?  @map("email_address")
  emailCadence     String   @default("realtime") @map("email_cadence") // realtime | daily | weekly
  smsEnabled       Boolean  @default(false) @map("sms_enabled")
  smsPhone         String?  @map("sms_phone") // E.164
  smsPhoneVerified Boolean  @default(false) @map("sms_phone_verified")
  smsCadence       String   @default("realtime") @map("sms_cadence") // realtime | daily
  quietHoursStart  String?  @map("quiet_hours_start") // "22:00"
  quietHoursEnd    String?  @map("quiet_hours_end") // "07:00"
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, clientId])
  @@index([tenantId])
  @@index([clientId])
  @@map("alert_preference")
}

// Recommendation feedback signal — trains the ranking + lets dismissed bills
// drop out of the feed. 'tracked' | 'dismissed' | 'marked_irrelevant' | 'opened'.
model TrackerFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  userId    String?  @map("user_id")
  billId    String   @map("bill_id")
  signal    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([clientId])
  @@index([billId])
  @@map("tracker_feedback")
}

// Idempotent fan-out ledger: one row per (alert, user, channel) so a re-run of
// the detector never double-sends. Also the deliverability audit trail.
model NotificationLog {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  clientId          String   @map("client_id") @db.Uuid
  userId            String   @map("user_id")
  alertId           String   @map("alert_id")
  channel           String // 'email' | 'sms' | 'in_app'
  status            String // 'sent' | 'failed' | 'suppressed' | 'queued'
  providerMessageId String?  @map("provider_message_id")
  error             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([alertId, userId, channel])
  @@index([tenantId])
  @@index([clientId])
  @@map("notification_log")
}

// Queued alerts awaiting a digest flush (email daily/weekly, sms daily). The
// flush-tracker-digests job drains this per user+channel+cadence.
model AlertDigestQueue {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  userId    String   @map("user_id")
  channel   String // 'email' | 'sms'
  cadence   String // 'daily' | 'weekly'
  alertId   String   @map("alert_id")
  billId    String   @map("bill_id")
  payload   Json     @default("{}")
  flushed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([userId, channel, cadence, flushed])
  @@map("alert_digest_queue")
}

// One-time SMS phone-verification OTP (hashed). Consent record for the SMS
// channel (the verify step is the opt-in).
model SmsVerification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id")
  clientId  String?  @map("client_id") @db.Uuid
  phone     String // E.164
  codeHash  String   @map("code_hash") // hashed OTP
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([tenantId])
  @@map("sms_verification")
}

// ─────────────────────────────────────────────────────────────────────────
// Cross-source change events (synthesis layer)
// GLOBAL table, detected changes from sync scripts.
// ─────────────────────────────────────────────────────────────────────────

model IntelligenceChange {
  id               String   @id @default(uuid()) @db.Uuid
  source           String
  changeType       String   @map("change_type")
  severity         String   @default("info")
  title            String
  description      String   @db.Text
  relatedClientIds String[] @map("related_client_ids") @db.Uuid
  relatedIssues    String[] @map("related_issues")
  relatedPeCodes   String[] @default([]) @map("related_pe_codes")
  data             Json     @default("{}")
  detectedAt       DateTime @default(now()) @map("detected_at") @db.Timestamptz(6)
  consumed         Boolean  @default(false)
  // Freshness-layer idempotency (P1-T4): a stable `source:windowBucket:sampleSig`
  // key so a same-window re-run of emit-changes never double-emits. Nullable —
  // historical rows and non-emit-changes writers don't carry one.
  dedupeKey        String?  @unique @map("dedupe_key")

  @@index([detectedAt(sort: Desc)])
  @@index([source, changeType])
  @@index([relatedPeCodes], map: "intelligence_change_pe_codes_gin_idx", type: Gin)
  @@map("intelligence_change")
}

model RegulatoryDocket {
  id               String    @id @default(uuid())
  documentId       String    @unique @map("document_id")
  agencyId         String    @map("agency_id")
  docketId         String?   @map("docket_id")
  documentType     String    @map("document_type")
  title            String    @db.Text
  postedDate       DateTime? @map("posted_date")
  commentStartDate DateTime? @map("comment_start_date")
  commentEndDate   DateTime? @map("comment_end_date")
  frDocNum         String?   @map("fr_doc_num")
  subtype          String?
  withdrawn        Boolean   @default(false)
  lastModified     DateTime? @map("last_modified")
  syncedAt         DateTime  @default(now()) @map("synced_at")

  @@index([agencyId, postedDate])
  @@index([commentEndDate])
  @@index([documentType])
  @@map("regulatory_docket")
}

