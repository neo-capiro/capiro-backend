// Registry of fingerprinted, versioned source files behind extracted defense-budget
// rows (Step 0.1, plan §4.2/§4.3). GLOBAL table (no tenant_id / RLS): public-domain
// reference data, same as program_element / federal_award.
//
// Versioning: exactly ONE *live* document per sourceKey (supersededByDocumentId IS NULL);
// re-ingesting identical content (same sourceKey + sha256) is a no-op, while a CHANGED
// sha256 for a sourceKey creates a new row and chains the prior live head via
// supersededByDocumentId. "One live per sourceKey" is enforced by upsertSourceDocument
// (source-document-registry.ts), not a DB partial index (Prisma 5 can't express one); the
// UNIQUE(source_key, sha256) below guarantees checksum de-duplication. Populated by the
// artifact-loading sync/parse scripts (which upsert their document first) and by
// backfill-source-documents.ts.
model SourceDocument {
  id                     String    @id @default(uuid()) @db.Uuid
  // Stable human key, derived from the committed artifact filename (e.g. 'jbook_r1_fy2027').
  sourceKey              String    @map("source_key")
  fiscalYear             Int?      @map("fiscal_year")
  // pb | hasc | sasc | hac_d | sac_d | conference | enacted | supplemental
  budgetCycle            String    @map("budget_cycle")
  // ARMY | NAVY | AF | SF | DW | ... (null for the all-component R-1 master list / committee docs)
  component              String?
  // r1 | r2 | r3 | p1 | p40 | committee_report | conference_report | public_law | other
  documentType           String    @map("document_type")
  title                  String
  // Source PDF URL (J-books); the artifact's source filename when no URL exists (committee docs).
  sourceUrl              String    @map("source_url")
  sha256                 String?   @db.Char(64)
  byteSize               Int?      @map("byte_size")
  pageCount              Int?      @map("page_count")
  downloadedAt           DateTime? @map("downloaded_at") @db.Timestamptz(6)
  // Path under apps/api/scripts/__data__/ for the committed extraction artifact.
  artifactPath           String?   @map("artifact_path")
  // structured_import | deterministic_pdf | llamaparse | manual
  extractionMethod       String    @map("extraction_method")
  extractionToolVersion  String?   @map("extraction_tool_version")
  ingestedAt             DateTime  @default(now()) @map("ingested_at") @db.Timestamptz(6)
  // Version chain: set on the OLD head when a newer version of the same sourceKey is ingested.
  supersededByDocumentId String?   @map("superseded_by_document_id") @db.Uuid
  metadata               Json      @default("{}") @map("metadata_jsonb")

  // ── Immutable raw-archive provenance (PE Watch LlamaParse ingestion) ──
  // A SourceDocument row is NOT proof of archival. These columns are populated
  // only after original bytes are written to the Object-Lock raw bucket and the
  // returned VersionId is captured. Nullable for backward-compat with rows
  // ingested from committed __data__ artifacts (which predate S3 archival).
  archiveBucket    String?   @map("archive_bucket")
  archiveS3Key     String?   @map("archive_s3_key")
  archiveVersionId String?   @map("archive_version_id")
  archiveKmsKeyArn String?   @map("archive_kms_key_arn")
  retainUntil      DateTime? @map("retain_until") @db.Timestamptz(6)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)

  supersededBy SourceDocument?  @relation("SourceDocumentVersion", fields: [supersededByDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supersedes   SourceDocument[] @relation("SourceDocumentVersion")

  programElementSources    ProgramElementSource[]
  programElementProjects   ProgramElementProject[]
  programElementPerformers ProgramElementPerformer[]
  yearSourceValues         ProgramElementYearSourceValue[]
  budgetPositions          ProgramElementBudgetPosition[]
  projectBudgetPositions   ProgramElementProjectBudgetPosition[]
  milestoneSchedulePeriods ProgramElementMilestoneSchedulePeriod[]
  provisions               CommitteeReportProvision[]
  parseJobs                DocumentParseJob[]
  // Defense budget packages (R3 §3.1) — the source doc a topline/vehicle came from.
  budgetPackageVehicles    BudgetPackageVehicle[]
  fundingPositions         FundingPosition[]
  interimFundingPeriods    BudgetInterimFundingPeriod[]

  @@unique([sourceKey, sha256], map: "source_document_source_key_sha256_key")
  @@index([documentType, fiscalYear, budgetCycle, component], map: "source_document_type_fy_cycle_component_idx")
  @@index([sourceKey], map: "source_document_source_key_idx")
  @@index([archiveVersionId], map: "source_document_archive_version_idx")
  @@map("source_document")
}

/// One row per parse attempt over a SourceDocument page range. Immutable audit
/// record of the parse job requested by PE Watch ingestion — satisfies the
/// "record of the pdf AND the parse job" requirement. Global table (no RLS):
/// J-book/committee data is public-domain. Provider is 'llamaparse' for the
/// agentic PDF path or 'deterministic_pdfplumber' for the text-layer fast path.
model DocumentParseJob {
  id                  String    @id @default(uuid()) @db.Uuid
  sourceDocumentId    String    @map("source_document_id") @db.Uuid
  provider            String // 'llamaparse' | 'deterministic_pdfplumber'
  providerJobId       String?   @map("provider_job_id") // LlamaParse job id
  // 'pdf_fast' | 'pdf_premium' | 'pdf_ocr' — always a PDF input for budget books.
  mode                String
  resultType          String    @map("result_type") // 'markdown' | 'json' | 'both'
  pageStart           Int?      @map("page_start")
  pageEnd             Int?      @map("page_end")
  inputSha256         String    @map("input_sha256") @db.Char(64)
  outputMarkdownS3Key String?   @map("output_markdown_s3_key")
  outputJsonS3Key     String?   @map("output_json_s3_key")
  status              String    @default("pending") // pending | running | succeeded | failed
  error               String?   @db.Text
  creditsUsed         Int?      @map("credits_used")
  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  metadata            Json      @default("{}") @map("metadata_jsonb")

  sourceDocument SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@unique([sourceDocumentId, inputSha256, provider, pageStart, pageEnd], map: "document_parse_job_dedup_key")
  @@index([sourceDocumentId], map: "document_parse_job_source_document_idx")
  @@index([status], map: "document_parse_job_status_idx")
  @@index([providerJobId], map: "document_parse_job_provider_job_idx")
  @@map("document_parse_job")
}

/// Cross-source reconciliation review queue (Step 29 §4.1). An entry is queued when
/// a lower-priority source conflicts with the canonical value by > 10% (non-enacted
/// fields) or by ANY amount on the enacted field. capiro_admin resolves entries.
model ReconciliationReviewQueue {
  id                          String    @id @default(uuid()) @db.Uuid
  peCode                      String    @map("pe_code") @db.VarChar(16)
  fy                          Int
  fieldName                   String    @map("field_name")
  conflictType                String    @default("value_conflict") @map("conflict_type")
  currentValue                String?   @map("current_value")
  currentSource               String?   @map("current_source")
  currentSourceDocumentId     String?   @map("current_source_document_id") @db.Uuid
  conflictingSource           String    @map("conflicting_source")
  conflictingValue            String?   @map("conflicting_value")
  conflictingSourceDocumentId String?   @map("conflicting_source_document_id") @db.Uuid
  deltaPct                    Float?    @map("delta_pct")
  queuedAt                    DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  lastObservedAt              DateTime  @default(now()) @map("last_observed_at") @db.Timestamptz(6)
  observationCount            Int       @default(1) @map("observation_count")
  /// `open` -> `pending_approval` (a correction was proposed) -> `resolved`.
  status                      String    @default("open") @db.VarChar(20)
  resolvedByUserId            String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAt                  DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionNotes             String?   @map("resolution_notes") @db.Text
  /// Phase 7 WS K: the governed override proposed from this entry, if any.
  proposedOverrideId          String?   @map("proposed_override_id") @db.Uuid

  @@index([status, queuedAt(sort: Desc)], map: "reconciliation_review_queue_status_idx")
  @@index([peCode, fy], map: "reconciliation_review_queue_pe_fy_idx")
  @@map("reconciliation_review_queue")
}

