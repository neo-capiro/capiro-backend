// Capiro identity / tenancy core schema.
// Scope: tenants, users, tenant_memberships, clerk_events, audit_logs.
// All tenant-scoped tables carry tenant_id NOT NULL and are protected by
// Postgres Row-Level Security policies created in the SQL migration.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Bookworm slim runtime is OpenSSL 3.x on linux-arm64. `native` covers the
  // build host, the explicit target covers cross-arch builds (e.g. building
  // the ARM64 image from an x86 dev machine via buildx).
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), pg_trgm, citext, uuidOssp(map: "uuid-ossp")]
}

enum TenantRole {
  capiro_admin
  user_admin
  standard_user
  client_portal_user

  @@map("tenant_role")
}

enum TenantStatus {
  active
  suspended
  pending

  @@map("tenant_status")
}

enum MembershipStatus {
  invited
  active
  removed

  @@map("membership_status")
}

enum EngagementProvider {
  microsoft_365
  google_workspace
  imap_caldav
  manual

  @@map("engagement_provider")
}

enum EngagementConnectionStatus {
  needs_configuration
  connected
  error
  disabled

  @@map("engagement_connection_status")
}

enum EngagementSource {
  outlook
  google
  imap_caldav
  manual

  @@map("engagement_source")
}

enum AssociationEntityType {
  meeting
  mail_thread
  mail_message
  contact
  task

  @@map("association_entity_type")
}

enum MeetingPrepStatus {
  generated
  edited
  approved
  stale
  failed

  @@map("meeting_prep_status")
}

// Meetings v2 (2026-07): a meeting artifact record is private to its author
// until explicitly shared to the associated client. Applies to the whole
// meeting record (approved Prep / Notes / Debrief). See the Meetings & Meri
// redesign plan (docs/plans/2026-07-10-meetings-meri-v2-redesign-plan.md §5-6).
enum MeetingVisibility {
  private
  shared

  @@map("meeting_visibility")
}

// Meetings v2 (2026-07): debrief lifecycle, mirroring MeetingPrepStatus. Only
// an `approved` debrief is eligible for the Meeting Library and for sharing.
enum MeetingDebriefStatus {
  generated
  edited
  approved

  @@map("meeting_debrief_status")
}

enum EngagementTaskStatus {
  todo
  in_progress
  done
  blocked
  canceled

  @@map("engagement_task_status")
}

enum BillingStatus {
  none
  trialing
  active
  past_due
  canceled
  comped

  @@map("billing_status")
}

model Tenant {
  id                     String        @id @default(uuid()) @db.Uuid
  slug                   String        @unique @db.Citext
  name                   String
  status                 TenantStatus  @default(pending)
  plan                   String?
  settings               Json          @default("{}") @map("settings_jsonb")
  kmsKeyArn              String?       @map("kms_key_arn")
  soc2AuditWindow        Json?         @map("soc2_audit_window")
  // Clerk Organization id this tenant maps to. Populated by the
  // bootstrap-tenant script and used by the middleware to cross-check the
  // Clerk JWT's `org_id` claim against the tenant resolved via slug/UUID.
  clerkOrgId             String?       @unique @map("clerk_org_id")
  // Brand assets, logo lives in S3 under `tenants/{id}/branding/...`.
  // Upload is gated to user_admin (own tenant) and capiro_admin (any tenant).
  logoS3Key              String?       @map("logo_s3_key")
  logoContentType        String?       @map("logo_content_type")
  logoUploadedAt         DateTime?     @map("logo_uploaded_at") @db.Timestamptz(6)
  // Portfolio Tab v2 additions
  accountType            String?       @map("account_type")
  planTier               String        @default("FOUNDATION") @map("plan_tier")
  // Client→data association overhaul: the lobbying firm this tenant files as.
  // Anchors client→LDA resolution to this registrant's filings
  // (lda_filing.registrant_id), collapsing the candidate set from ~46k global
  // LDA clients to just the clients this firm has actually filed for.
  ldaRegistrantId        Int?          @map("lda_registrant_id")
  ldaRegistrantName      String?       @map("lda_registrant_name")
  // Billing (Stripe-direct). billingStatus gates the app + slot enforcement;
  // 'comped' (Capiro staff / promo) bypasses paywalls. clientSlots is the
  // purchased capacity (0 until first checkout); creating a client beyond it
  // returns 402. llmAllowanceUsdPerSlot × clientSlots = pooled monthly LLM
  // allowance before 2× overage; llmHardCapUsd is an optional admin spend cap.
  stripeCustomerId       String?       @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?       @unique @map("stripe_subscription_id")
  billingStatus          BillingStatus @default(none) @map("billing_status")
  clientSlots            Int           @default(0) @map("client_slots")
  llmAllowanceUsdPerSlot Decimal       @default(20) @map("llm_allowance_usd_per_slot") @db.Decimal(12, 2)
  llmHardCapUsd          Decimal?      @map("llm_hard_cap_usd") @db.Decimal(12, 2)
  currentPeriodEnd       DateTime?     @map("current_period_end") @db.Timestamptz(6)
  // Self-service onboarding v1 (docs/plans/onboarding-v1-plan.md). NULL
  // onboarding_flow_version = legacy tenant (pre-self-serve); 1 = provisioned
  // by the onboarding funnel — every onboarding gate/banner/tour keys off it.
  // Billing WRITES for these fields live in apps/onboard-api (single Stripe
  // writer); apps/api only reads them.
  onboardingFlowVersion  Int?          @map("onboarding_flow_version")
  trialEndsAt            DateTime?     @map("trial_ends_at") @db.Timestamptz(6)
  priceLockExpiresAt     DateTime?     @map("price_lock_expires_at") @db.Timestamptz(6)
  importMode             String?       @map("import_mode")
  courtesySwapUsed       Boolean       @default(false) @map("courtesy_swap_used")
  deletionHold           Boolean       @default(false) @map("deletion_hold")
  canceledAt             DateTime?     @map("canceled_at") @db.Timestamptz(6)
  /// Wire/ACH lockout (set/cleared by onboard-api's lifecycle cron when
  /// billing stays past_due beyond the window). Non-null = access suspended.
  lockedAt               DateTime?     @map("locked_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships                  TenantMembership[]
  auditLogs                    AuditLog[]
  clients                      Client[]
  impersonationSessions        ImpersonationSession[]
  engagementConnections        IntegrationConnection[]
  engagementConnectionTokens   IntegrationConnectionToken[]
  engagementContacts           EngagementContact[]
  meetings                     Meeting[]
  meetingAttendees             MeetingAttendee[]
  mailThreads                  MailThread[]
  mailMessages                 MailMessage[]
  engagementAttachments        EngagementAttachment[]
  meetingNotes                 MeetingNote[]
  meetingPreps                 MeetingPrep[]
  engagementTasks              EngagementTask[]
  associationOverrides         ClientAssociationOverride[]
  contextEmbeddings            ContextEmbedding[]
  directoryContactNotes        DirectoryContactNote[]
  directoryContactFavorites    DirectoryContactFavorite[]
  engagementReportTargets      EngagementReportTargetOffice[]
  outreachRecords              OutreachRecord[]
  outreachTemplates            OutreachTemplate[]
  outreachAudiences            OutreachAudience[]
  outreachAudienceMembers      OutreachAudienceMember[]
  MeetingDebrief               MeetingDebrief[]
  meetingBotSessions           MeetingBotSession[]
  outreachJobs                 OutreachJob[]
  outreachJobItems             OutreachJobItem[]
  clioConversations            ClioConversation[]
  clioMessages                 ClioMessage[]
  clioArtifacts                ClioArtifact[]
  clioNotes                    ClioNote[]
  clioResearchSessions         ClioResearchSession[]
  clientCapabilities           ClientCapability[]
  clientSubmissionHistory      ClientSubmissionHistory[]
  clientPeople                 ClientPerson[]
  clientFacilities             ClientFacility[]
  clientTargets                ClientTarget[]
  clientTargetRecommendations  ClientTargetRecommendation[]
  engagementCampaigns          EngagementCampaign[]
  engagementCampaignRecipients EngagementCampaignRecipient[]
  outreachAiTemplates          OutreachAiTemplate[]
  clioMemories                 ClioMemory[]
  clioProactiveAlerts          ClioProactiveAlert[]
  clioScheduledTasks           ClioScheduledTask[]
  meriActionApprovals          MeriActionApproval[]
  meriPendingActions           MeriPendingAction[]
  meriActionProposals          MeriActionProposal[]
  clioAttachments              ClioAttachment[]
  clioMcpServers               ClioMcpServer[]
  clioMcpOAuthCredentials      ClioMcpOAuthCredential[]
  clioFirmSkills               ClioFirmSkill[]
  programElementWatches        ProgramElementWatch[]
  programElementDataIssues     ProgramElementDataIssue[]
  peAlertEmailPrefs            PeAlertEmailPref[]
  actionRecommendations        ActionRecommendation[]
  aiUsageEvents                AiUsageEvent[]
  aiRuns                       AiRun[]
  meriAuditLedgerEntries       MeriAuditLedger[]
  contextPackets               ContextPacket[]
  outcomeEvents                OutcomeEvent[]
  reviewRequests               ReviewRequest[]
  alertGenerationRecords       AlertGenerationRecord[]
  aiCredentials                TenantAiCredential[]
