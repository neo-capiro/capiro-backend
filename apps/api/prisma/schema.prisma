// ─────────────────────────────────────────────────────────────────────────
// Federal Lobbying Intelligence (OpenLobby / Senate LDA-derived reference data)
//
// GLOBAL tables, shared across all tenants. No tenant_id, no RLS.
// Populated by the OpenLobby sync job (apps/api/scripts/sync-openlobby.ts).
// Source: https://www.openlobby.us/data/*.json, itself derived from
// public-domain Senate LDA filings at lda.senate.gov.
// ─────────────────────────────────────────────────────────────────────────

model LobbyIntel {
  // 5K-record federal lobbying client master list (top spenders 2018-2025).
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  name          String
  state         String?
  totalSpending Decimal? @map("total_spending") @db.Decimal(18, 2)
