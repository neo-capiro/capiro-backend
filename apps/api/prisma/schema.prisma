model Meeting {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  clientId           String?           @map("client_id") @db.Uuid
  isInternal         Boolean           @default(false) @map("is_internal")
  connectionId       String?           @map("connection_id") @db.Uuid
  source             EngagementSource  @default(manual)
  externalId         String?           @map("external_id")
  // Meetings v2 Phase 2 groundwork (2026-07-11): Microsoft Graph's cross-mailbox-
  // stable event id. externalId is the per-MAILBOX event id, so two attendees'
  // syncs of the same real meeting produce two rows with the SAME iCalUId — the
  // key the (deferred) cross-user collision model groups/dedupes on. Captured
  // now, DORMANT: nothing reads it until Phase 2's identity switch ships.
  iCalUId            String?           @map("ical_uid")
  subject            String
  description        String?
  location           String?
  startsAt           DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime          @map("ends_at") @db.Timestamptz(6)
  organizerEmail     String?           @map("organizer_email") @db.Citext
  organizerName      String?           @map("organizer_name")
  // IANA timezone captured at sync from Graph event.start.timeZone / Google
  // Calendar start.timeZone. Used to format prep/briefing times in the
  // meeting's local zone instead of server UTC.
  timeZone           String?           @map("time_zone")
  status             String            @default("scheduled")
  // Meetings v2 (2026-07): virtual-meeting classification derived once at
  // sync/create time (see @capiro/shared deriveMeetingVirtuality) instead of
  // regex-scanning free text on every render. eligibleForMeri = isVirtual && joinLink.
  isVirtual          Boolean           @default(false) @map("is_virtual")
  joinLink           String?           @map("join_link")
  provider           String?
  // Private-until-shared visibility. The record is private to createdByUserId
  // until shared to the associated client (requires clientId). Un-share clears
  // sharedAt/sharedByUserId. See redesign plan §5-6.
  visibility         MeetingVisibility @default(private)
  sharedAt           DateTime?         @map("shared_at") @db.Timestamptz(6)
  sharedByUserId     String?           @map("shared_by_user_id") @db.Uuid
  transcriptS3Key    String?           @map("transcript_s3_key")
  metadata           Json              @default("{}") @map("metadata_jsonb")
  raw                Json?             @map("raw_jsonb")
  associationScore   Float?            @map("association_score")
  associationReason  String?           @map("association_reason")
  associationSignals Json              @default("{}") @map("association_signals_jsonb")
  createdByUserId    String?           @map("created_by_user_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  connection      IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  attendees       MeetingAttendee[]
  attachments     EngagementAttachment[]
  notes           MeetingNote[]
  debriefs        MeetingDebrief[]
  botSessions     MeetingBotSession[]
  preps           MeetingPrep[]
  tasks           EngagementTask[]
  outreachRecords OutreachRecord[]
  clioNotes       ClioNote[]

  @@unique([tenantId, source, externalId], map: "meetings_tenant_source_external_key")
  @@index([tenantId, startsAt], map: "meetings_tenant_starts_idx")
  @@index([tenantId, clientId, startsAt], map: "meetings_tenant_client_starts_idx")
  // Phase 2 cross-mailbox grouping/matching lookups (WHERE tenant_id=? AND ical_uid=?).
  @@index([tenantId, iCalUId], map: "meetings_tenant_ical_idx")
  @@map("meetings")
}

