// ===========================================================================
// Phase 7 Workstream D — canonical snapshot storage and the promotion ledger.
//
// Migration: 20260822010000_pe_budget_phase7_canonical_promotion
//
// These tables are the canonical boundary. Writing them requires the dedicated
// `capiro_pe_promoter` role, and rows belonging to a snapshot that has left
// STAGING are immutable for every role including the promoter — enforced by
// BEFORE row triggers, not by grants alone, because ALTER DEFAULT PRIVILEGES
// re-grants DML to capiro_app on every newly created table.
// ===========================================================================

model DefenseBudgetCanonicalSnapshot {
  id                  String    @id @default(uuid()) @db.Uuid
  snapshotKey         String    @unique(map: "defense_budget_canonical_snapshot_key_unique") @map("snapshot_key")
  domain              String    @default("defense_budget") @db.VarChar(64)
  environment         String    @db.VarChar(32)
  cycleId             String    @map("cycle_id")
  fiscalYear          Int       @map("fiscal_year")
  status              String    @default("STAGING") @db.VarChar(32)
  requiredScopes      Json      @default("[]") @map("required_scopes")
  completedScopes     Json      @default("[]") @map("completed_scopes")
  snapshotHash        String?   @map("snapshot_hash") @db.Char(64)
  mappingRegistryHash String    @map("mapping_registry_hash") @db.Char(64)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz(6)
  supersededAt        DateTime? @map("superseded_at") @db.Timestamptz(6)

  activePointers        DefenseBudgetActiveSnapshot[]
  runs                  DefenseBudgetPromotionRun[]
  canonicalRows         DefenseBudgetCanonicalRow[]
  activationsAsNew      DefenseBudgetPromotionActivation[] @relation("ActivationNewSnapshot")
  activationsAsPrevious DefenseBudgetPromotionActivation[] @relation("ActivationPreviousSnapshot")
  compatibilityRuns     DefenseBudgetCompatibilityProjectionRun[]
  rollbacksFrom         DefenseBudgetRollbackRecord[]      @relation("RollbackFromSnapshot")
  rollbacksTo           DefenseBudgetRollbackRecord[]      @relation("RollbackToSnapshot")

  @@index([domain, environment, status], map: "defense_budget_canonical_snapshot_status_idx")
  @@index([cycleId, fiscalYear], map: "defense_budget_canonical_snapshot_cycle_idx")
  @@map("defense_budget_canonical_snapshot")
}

/// The atomic activation pointer. One row per domain/environment.
model DefenseBudgetActiveSnapshot {
