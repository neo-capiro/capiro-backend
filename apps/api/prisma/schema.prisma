  memoryTransitionAudits       MemoryTransitionAudit[]
  memoryCleanupOutbox          MemoryCleanupOutbox[]
  clientMemoryAccessGrants     ClientMemoryAccess[]
  clientGrantNexuses           ClientGrantNexus[]
  clientFundingOpportunities   ClientFundingOpportunity[]
