model EngagementAttachment {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  clientId         String?   @map("client_id") @db.Uuid
  meetingId        String?   @map("meeting_id") @db.Uuid
  mailMessageId    String?   @map("mail_message_id") @db.Uuid
  fileName         String    @map("file_name")
  contentType      String    @map("content_type")
  byteSize         Int?      @map("byte_size")
  bucket           String
  s3Key            String    @map("s3_key")
  /// The CLIENT-supplied checksum. An untrusted claim — never compared against
  /// as proof of integrity. See calculatedSha256 for the server's own digest.
  checksumSha256   String?   @map("checksum_sha256")
  source           String    @default("manual")
  // Generic generated-document provenance. Hearing recaps use
  // sourceEntityType="hearing_session" plus the intel session id.
  sourceEntityType String?   @map("source_entity_type") @db.VarChar(64)
  sourceEntityId   String?   @map("source_entity_id") @db.VarChar(128)
  uploadedByUserId String?   @map("uploaded_by_user_id") @db.Uuid
  // Meetings v2 (2026-07): stamped by ClientKbService.indexAttachment when the
  // client-KB indexing of this document completes, so the Documents tab can show
  // a per-file "Indexed" badge (null = not yet / not indexable). Non-clientId
  // attachments are never indexed and stay null.
  indexedAt        DateTime? @map("indexed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // ── Phase 1 §3.h — upload lifecycle, scan readiness, bounded extraction ────
  /// AttachmentLifecycleStatus: 'legacy_ready' (pre-Phase-1 rows: usable, but
  /// never scanned) | 'quarantined' (new upload awaiting a scan verdict) |
  /// 'ready' | 'blocked' (threat/unsupported/access_denied/failed) |
  /// 'delete_pending' | 'delete_failed'. The DB default is legacy_ready so this
  /// column's arrival cannot retroactively quarantine historical documents;
  /// confirmAttachment() writes 'quarantined' explicitly for new uploads.
  lifecycleStatus     String    @default("legacy_ready") @map("lifecycle_status") @db.VarChar(32)
  /// Content type detected from MAGIC BYTES, not the declared MIME/extension.
  verifiedContentType String?   @map("verified_content_type") @db.VarChar(255)
  /// sha256 the SERVER calculated over the stored object bytes.
  calculatedSha256    String?   @map("calculated_sha256") @db.VarChar(128)
  scanProvider        String?   @map("scan_provider") @db.VarChar(64)
  /// AttachmentScanStatus: 'pending' | 'clean' | 'threat' | 'unsupported' |
  /// 'access_denied' | 'failed' | 'scanner_not_required'. NULL = never scanned
  /// (every historical row) — deliberately NOT backfilled to 'clean', which
  /// would be a fabricated assertion about bytes no scanner has inspected.
  scanStatus          String?   @map("scan_status") @db.VarChar(32)
  scanResultAt        DateTime? @map("scan_result_at") @db.Timestamptz(6)
  /// 'pending' | 'extracted' | 'truncated' | 'empty' | 'failed' | 'unsupported'
  extractionStatus    String?   @map("extraction_status") @db.VarChar(32)
  /// { chars, truncated, pageLimitHit, rowLimitHit, timedOut, extractedAt … }
  extractionMetadata  Json      @default("{}") @map("extraction_metadata_jsonb")

  // ── Phase 2 §d — per-artifact approval + sharing (2026-08) ────────────────
  // Attachments never had an approval concept before this: a Meri-generated or
  // user-uploaded file was never gated on anything. Single-user approval (Neo
  // decision): any user with access to the meeting — including the uploader
  // themself — may approve; there is no second-reviewer/two-person flow.
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  sharedAt         DateTime? @map("shared_at") @db.Timestamptz(6)
  sharedByUserId   String?   @map("shared_by_user_id") @db.Uuid

  /// Gate H a-6 (LegiWatch): set when a generator (today: the alert-memo
  /// regenerate path) supersedes this document with a newer version, INSTEAD
  /// of calling deleteAttachment. NULL = current version. Deliberately generic
  /// (not memo-specific) — any generator's "regenerate" can adopt this same
  /// contract instead of destructively deleting. The row, its S3 object, and
  /// its KB index are all left exactly as they were; only this pointer and
  /// listAttachments' default filter change.
  supersededByAttachmentId String?                @map("superseded_by_attachment_id") @db.Uuid
  supersededBy             EngagementAttachment?  @relation("AttachmentSupersession", fields: [supersededByAttachmentId], references: [id], onDelete: SetNull)
  supersedes               EngagementAttachment[] @relation("AttachmentSupersession")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  meeting     Meeting?     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  mailMessage MailMessage? @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)
  approvedBy  User?        @relation("EngagementAttachmentApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
