// ─────────────────────────────────────────────────────────────────────────
// AI-generated intelligence insights (GAI-01).
// tenantId scopes a row to a tenant; NULL = a reviewed PUBLIC global insight
// derived only from public-source data. FORCE RLS (ai_run-style): a tenant
// reads its own rows + public (NULL-tenant) rows; a tenant session can only
// INSERT its own tenant's rows; NULL-tenant public rows require withSystem
// (rls_bypass). This closes the cross-tenant read + standard-user global-
// publish exposure that existed while the table was global.
// ─────────────────────────────────────────────────────────────────────────

model IntelligenceInsight {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id") @db.Uuid
  clientId    String?   @map("client_id") @db.Uuid
  category    String // lda, spending, congress, regulatory, anomaly, briefing, health_score
  title       String
  body        String    @db.Text
  severity    String    @default("info") // info, notable, critical
  dataPoints  Json?     @map("data_points")
  generatedAt DateTime  @default(now()) @map("generated_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([category, generatedAt])
  @@index([tenantId, category, generatedAt])
  @@map("intelligence_insight")
}

// ─────────────────────────────────────────────────────────────────────────
// Client-to-intelligence-source mapping (synthesis layer)
// Links CRM clients to external intelligence identities. TENANT-SCOPED: every
// row belongs to one tenant (via its client) and is RLS-isolated on tenant_id
// (migration 20260608010000) — reads must go through withTenant/withSystem.
// ─────────────────────────────────────────────────────────────────────────

model ClientIntelMapping {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  clientId         String    @map("client_id") @db.Uuid
  source           String // 'lda', 'contracting', 'lobby_intel', 'fec'
  externalId       String    @map("external_id")
  externalName     String    @map("external_name")
  confidence       Float
  confirmed        Boolean   @default(false)
  /// WHY this candidate exists, in the identity-tier vocabulary the contractor
  /// matcher uses: 'exact_uei' | 'exact_cage' | 'exact_legal_name_corroborated' |
  /// 'exact_legal_name' | 'fuzzy_name' | 'manual_pin' | 'legacy_unrecorded'.
  /// A bare confidence percentage is not a reason a user can check, and every
  /// pre-existing row predates this column — hence nullable, and hence
  /// 'legacy_unrecorded' rather than back-filling a basis nobody recorded.
  matchBasis       String?   @map("match_basis") @db.VarChar(40)
  /// Identity tier 1-4 (1 = exact verified identifier … 4 = fuzzy name). Drives
  /// the auto-confirm decision; tier 4 is never auto-confirmed.
  matchTier        Int?      @map("match_tier")
  /// The specific facts behind the basis — identifiers matched, normalized names
  /// compared, corroborating and CONFLICTING facts, award footprint. Rendered as
  /// the match explanation, so it must hold facts, never a paraphrase.
  matchEvidence    Json?     @map("match_evidence_jsonb")
  /// The CORPORATE-IDENTITY relationship this mapping asserts between the client
  /// and the federal entity: 'self' | 'alias' | 'former_name' | 'parent' |
  /// 'subsidiary' | 'operating_unit'. This is the identity gap made explicit —
  /// a federal award may name a subsidiary, a legal entity, a historical name or
  /// a parent that is not the CRM client's display name, and "it matched" is not
  /// an answer to "whose money is this". NULL on every pre-existing row: the
  /// relationship was never recorded, and defaulting them all to 'self' would
  /// invent a reviewed assertion nobody made.
  relationshipType String?   @map("relationship_type") @db.VarChar(24)
  /// Whether awards on this federal entity should ROLL UP to the client. Only
  /// meaningful once `relationshipType` is set and `confirmed` is true; NULL
  /// means undecided, which read paths must treat as "do not roll up".
  rollUpAwards     Boolean?  @map("roll_up_awards")
  /// Durable reviewer lifecycle. `candidate` is machine-proposed/unreviewed;
  /// `confirmed` and `rejected` are human or exact-identifier decisions;
  /// `superseded` preserves history after a newer mapping replaces this one.
  reviewStatus     String    @default("candidate") @map("review_status") @db.VarChar(16)
  reviewedBy       String?   @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason  String?   @map("rejection_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([clientId, source, externalId])
  @@index([clientId])
  @@index([tenantId])
  @@index([source, externalId])
  @@index([tenantId, source, reviewStatus], map: "client_intel_mapping_tenant_source_review_idx")
  @@map("client_intel_mapping")
}

// ─────────────────────────────────────────────────────────────────────────
// Manually tracked bills (user-pinned legislation per client).
// TENANT-scoped with RLS. Distinct from the derived "relevant" bills the
// Issue-Bill Linker surfaces by embedding similarity: this records an explicit
// human decision to follow a specific congress_bill for a client, so it
// survives re-matching and always pins to the top of the pipeline kanban.
// ─────────────────────────────────────────────────────────────────────────

model TrackedBill {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  billId    String   @map("bill_id") // FK-ish to congress_bill.id, e.g. "119-hr-1234"
  note      String?  @db.Text
  // How this bill landed on the board: 'recommended' (promoted from the Tracker
  // Recommendations feed), 'manual_search' (added via the Add-bill modal), or
  // 'imported' (legacy / programmatic). Drives Tracker analytics + feedback.
  source    String?  @map("source")
  createdBy String?  @map("created_by") // clerk user id of whoever pinned it
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Change-detection snapshot: the bill state we last reconciled for alerting,
  // so detect-tracker-alerts can diff the live congress_bill against it and emit
  // an alert exactly once per material move. NULL until the first detection pass.
  lastSeenActionText String?   @map("last_seen_action_text") @db.Text
  lastSeenActionDate DateTime? @map("last_seen_action_date") @db.Date
  lastSeenAt         DateTime? @map("last_seen_at") @db.Timestamptz(6)

  @@unique([clientId, billId])
  @@index([tenantId])
  @@index([clientId])
  @@index([billId])
  @@map("tracked_bill")
}

// ─────────────────────────────────────────────────────────────────────────
// Per-user worklist state for client-profile "Top alerts".
// TENANT-scoped with RLS (mirrors tracked_bill / engagement isolation).
// State is keyed by (user, client, alertId) — alertId is the stable composite
// the alerts builder emits ("comment:<docId>", "hearing:<id>", "bill:<billId>",
// "change:<id>", "award:<id>", "competitor:<filingId>", "comment_overdue:<docId>").
// Dismissed/snoozed alerts are filtered out server-side; acknowledged alerts are
// kept but flagged so the UI de-emphasizes them. Compute-on-read alerts have no
// durable row of their own, so this is the ONLY place their handled-state lives.
// ─────────────────────────────────────────────────────────────────────────

model AlertState {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") // clerk user id of whoever set the state
  clientId     String    @map("client_id") @db.Uuid
  alertId      String    @map("alert_id") // stable composite key from the alerts builder
  // 'acknowledged' | 'dismissed' | 'snoozed'
  state        String
  snoozedUntil DateTime? @map("snoozed_until") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, clientId, alertId])
  @@index([tenantId])
  @@index([clientId])
  @@index([userId])
  @@map("alert_state")
}

// ─────────────────────────────────────────────────────────────────────────
// Saved "client brief" notes. A lobbyist can promote an alert (or write a
// free-form note) into the client's brief; all briefs surface in the Outreach
// wizard's context section. TENANT-scoped with RLS.
// ─────────────────────────────────────────────────────────────────────────

model ClientBrief {
