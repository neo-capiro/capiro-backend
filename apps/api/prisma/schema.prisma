// Capiro identity / tenancy core schema.
// Scope: tenants, users, tenant_memberships, clerk_events, audit_logs.
// All tenant-scoped tables carry tenant_id NOT NULL and are protected by
// Postgres Row-Level Security policies created in the SQL migration.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Bookworm slim runtime is OpenSSL 3.x on linux-arm64. `native` covers the
  // build host, the explicit target covers cross-arch builds (e.g. building
  // the ARM64 image from an x86 dev machine via buildx).
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), pg_trgm, citext, uuidOssp(map: "uuid-ossp")]
}

enum TenantRole {
  capiro_admin
  user_admin
  standard_user
  client_portal_user

  @@map("tenant_role")
}

enum TenantStatus {
  active
  suspended
  pending

  @@map("tenant_status")
}

enum MembershipStatus {
  invited
  active
  removed

  @@map("membership_status")
}

enum EngagementProvider {
  microsoft_365
  google_workspace
  imap_caldav
  manual

  @@map("engagement_provider")
}

enum EngagementConnectionStatus {
  needs_configuration
  connected
  error
  disabled

  @@map("engagement_connection_status")
}

enum EngagementSource {
  outlook
  google
  imap_caldav
  manual

  @@map("engagement_source")
}

enum AssociationEntityType {
  meeting
  mail_thread
  mail_message
  contact
  task

  @@map("association_entity_type")
}

enum MeetingPrepStatus {
  generated
  edited
  approved
  stale
  failed

  @@map("meeting_prep_status")
}

// Meetings v2 (2026-07): a meeting artifact record is private to its author
// until explicitly shared to the associated client. Applies to the whole
// meeting record (approved Prep / Notes / Debrief). See the Meetings & Meri
// redesign plan (docs/plans/2026-07-10-meetings-meri-v2-redesign-plan.md §5-6).
enum MeetingVisibility {
  private
  shared

  @@map("meeting_visibility")
}

// Meetings v2 (2026-07): debrief lifecycle, mirroring MeetingPrepStatus. Only
// an `approved` debrief is eligible for the Meeting Library and for sharing.
enum MeetingDebriefStatus {
  generated
  edited
  approved

  @@map("meeting_debrief_status")
}

enum EngagementTaskStatus {
  todo
  in_progress
  done
  blocked
  canceled

  @@map("engagement_task_status")
}

enum BillingStatus {
  none
  trialing
  active
  past_due
  canceled
  comped

  @@map("billing_status")
}

model Tenant {
  id                     String        @id @default(uuid()) @db.Uuid
  slug                   String        @unique @db.Citext
  name                   String
  status                 TenantStatus  @default(pending)
  plan                   String?
  settings               Json          @default("{}") @map("settings_jsonb")
  kmsKeyArn              String?       @map("kms_key_arn")
  soc2AuditWindow        Json?         @map("soc2_audit_window")
  // Clerk Organization id this tenant maps to. Populated by the
  // bootstrap-tenant script and used by the middleware to cross-check the
  // Clerk JWT's `org_id` claim against the tenant resolved via slug/UUID.
  clerkOrgId             String?       @unique @map("clerk_org_id")
  // Brand assets, logo lives in S3 under `tenants/{id}/branding/...`.
  // Upload is gated to user_admin (own tenant) and capiro_admin (any tenant).
  logoS3Key              String?       @map("logo_s3_key")
  logoContentType        String?       @map("logo_content_type")
  logoUploadedAt         DateTime?     @map("logo_uploaded_at") @db.Timestamptz(6)
  // Portfolio Tab v2 additions
  accountType            String?       @map("account_type")
  planTier               String        @default("FOUNDATION") @map("plan_tier")
  // Client→data association overhaul: the lobbying firm this tenant files as.
  // Anchors client→LDA resolution to this registrant's filings
  // (lda_filing.registrant_id), collapsing the candidate set from ~46k global
  // LDA clients to just the clients this firm has actually filed for.
  ldaRegistrantId        Int?          @map("lda_registrant_id")
  ldaRegistrantName      String?       @map("lda_registrant_name")
  // Billing (Stripe-direct). billingStatus gates the app + slot enforcement;
  // 'comped' (Capiro staff / promo) bypasses paywalls. clientSlots is the
  // purchased capacity (0 until first checkout); creating a client beyond it
  // returns 402. llmAllowanceUsdPerSlot × clientSlots = pooled monthly LLM
  // allowance before 2× overage; llmHardCapUsd is an optional admin spend cap.
  stripeCustomerId       String?       @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?       @unique @map("stripe_subscription_id")
  billingStatus          BillingStatus @default(none) @map("billing_status")
  clientSlots            Int           @default(0) @map("client_slots")
  llmAllowanceUsdPerSlot Decimal       @default(20) @map("llm_allowance_usd_per_slot") @db.Decimal(12, 2)
  llmHardCapUsd          Decimal?      @map("llm_hard_cap_usd") @db.Decimal(12, 2)
  currentPeriodEnd       DateTime?     @map("current_period_end") @db.Timestamptz(6)
  // Self-service onboarding v1 (docs/plans/onboarding-v1-plan.md). NULL
  // onboarding_flow_version = legacy tenant (pre-self-serve); 1 = provisioned
  // by the onboarding funnel — every onboarding gate/banner/tour keys off it.
  // Billing WRITES for these fields live in apps/onboard-api (single Stripe
  // writer); apps/api only reads them.
  onboardingFlowVersion  Int?          @map("onboarding_flow_version")
  trialEndsAt            DateTime?     @map("trial_ends_at") @db.Timestamptz(6)
  priceLockExpiresAt     DateTime?     @map("price_lock_expires_at") @db.Timestamptz(6)
  importMode             String?       @map("import_mode")
  courtesySwapUsed       Boolean       @default(false) @map("courtesy_swap_used")
  deletionHold           Boolean       @default(false) @map("deletion_hold")
  canceledAt             DateTime?     @map("canceled_at") @db.Timestamptz(6)
  /// Wire/ACH lockout (set/cleared by onboard-api's lifecycle cron when
  /// billing stays past_due beyond the window). Non-null = access suspended.
  lockedAt               DateTime?     @map("locked_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships                  TenantMembership[]
  auditLogs                    AuditLog[]
  clients                      Client[]
  impersonationSessions        ImpersonationSession[]
  engagementConnections        IntegrationConnection[]
  engagementConnectionTokens   IntegrationConnectionToken[]
  engagementContacts           EngagementContact[]
  meetings                     Meeting[]
  meetingAttendees             MeetingAttendee[]
  mailThreads                  MailThread[]
  mailMessages                 MailMessage[]
  engagementAttachments        EngagementAttachment[]
  meetingNotes                 MeetingNote[]
  meetingPreps                 MeetingPrep[]
  engagementTasks              EngagementTask[]
  associationOverrides         ClientAssociationOverride[]
  contextEmbeddings            ContextEmbedding[]
  directoryContactNotes        DirectoryContactNote[]
  directoryContactFavorites    DirectoryContactFavorite[]
  engagementReportTargets      EngagementReportTargetOffice[]
  outreachRecords              OutreachRecord[]
  outreachTemplates            OutreachTemplate[]
  outreachAudiences            OutreachAudience[]
  outreachAudienceMembers      OutreachAudienceMember[]
  MeetingDebrief               MeetingDebrief[]
  meetingBotSessions           MeetingBotSession[]
  clioConversations            ClioConversation[]
  clioMessages                 ClioMessage[]
  clioArtifacts                ClioArtifact[]
  clioNotes                    ClioNote[]
  clioResearchSessions         ClioResearchSession[]
  clientCapabilities           ClientCapability[]
  clientSubmissionHistory      ClientSubmissionHistory[]
  clientPeople                 ClientPerson[]
  clientFacilities             ClientFacility[]
  clientTargets                ClientTarget[]
  clientTargetRecommendations  ClientTargetRecommendation[]
  engagementCampaigns          EngagementCampaign[]
  engagementCampaignRecipients EngagementCampaignRecipient[]
  outreachAiTemplates          OutreachAiTemplate[]
  clioMemories                 ClioMemory[]
  clioProactiveAlerts          ClioProactiveAlert[]
  clioScheduledTasks           ClioScheduledTask[]
  meriActionApprovals          MeriActionApproval[]
  clioAttachments              ClioAttachment[]
  clioMcpServers               ClioMcpServer[]
  clioMcpOAuthCredentials      ClioMcpOAuthCredential[]
  clioFirmSkills               ClioFirmSkill[]
  programElementWatches        ProgramElementWatch[]
  peAlertEmailPrefs            PeAlertEmailPref[]
  actionRecommendations        ActionRecommendation[]
  aiUsageEvents                AiUsageEvent[]
  aiCredentials                TenantAiCredential[]
  usageMeters                  TenantUsageMeter[]
  memoryItems                  MemoryItem[]
  memoryEdges                  MemoryEdge[]

  @@map("tenants")
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  clerkUserId           String    @unique @map("clerk_user_id")
  email                 String    @unique @db.Citext
  firstName             String?   @map("first_name")
  lastName              String?   @map("last_name")
  // Free-form job title displayed under the user's name in the top-right
  // profile widget. User-editable via /settings.
  title                 String?
  // Per-user HTML email signature appended to outbound outreach emails.
  // Server-sanitized (sanitize-signature.ts) on save; stored already-clean so
  // the send path can append it without re-stripping. `enabled` is the
  // append-by-default preference; each campaign can still override at send time.
  emailSignatureHtml    String?   @map("email_signature_html")
  emailSignatureEnabled Boolean   @default(false) @map("email_signature_enabled")
  // Guided product tour (onboarding v1, Flow 2B.4): set when the user finishes
  // or skips the first-login tour; NULL = auto-launch on next dashboard load.
  // Server-side so the choice follows the user across devices.
  tourCompletedAt       DateTime? @map("tour_completed_at") @db.Timestamptz(6)
  lastSeenAt            DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships               TenantMembership[]
  auditLogs                 AuditLog[]                     @relation("AuditActor")
  impersonationSessions     ImpersonationSession[]         @relation("ImpersonationActor")
  directoryContactNotes     DirectoryContactNote[]         @relation("DirectoryContactNoteAuthor")
  directoryContactFavorites DirectoryContactFavorite[]     @relation("DirectoryContactFavoriteUser")
  meetingNotes              MeetingNote[]                  @relation("MeetingNoteAuthor")
  meetingDebriefs           MeetingDebrief[]               @relation("MeetingDebriefAuthor")
  engagementReportTargets   EngagementReportTargetOffice[] @relation("EngagementReportTargetOfficeAuthor")
  clientTargets             ClientTarget[]                 @relation("ClientTargetAuthor")
  outreachRecords           OutreachRecord[]               @relation("OutreachRecordAuthor")
  outreachTemplates         OutreachTemplate[]             @relation("OutreachTemplateAuthor")
  outreachAiTemplates       OutreachAiTemplate[]           @relation("OutreachAiTemplateAuthor")
  clioConversations         ClioConversation[]             @relation("ClioConversationUser")
  clioMessages              ClioMessage[]                  @relation("ClioMessageUser")
  clioArtifacts             ClioArtifact[]                 @relation("ClioArtifactUser")
  clioNotes                 ClioNote[]                     @relation("ClioNoteUser")
  clioResearchSessions      ClioResearchSession[]          @relation("ClioResearchSessionUser")
  clioAttachments           ClioAttachment[]               @relation("ClioAttachmentUser")
  createdCampaigns          EngagementCampaign[]           @relation("CampaignCreator")
  programElementWatches     ProgramElementWatch[]
  peAlertEmailPrefs         PeAlertEmailPref[]

  @@map("users")
}

model TenantMembership {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  role         TenantRole
  status       MembershipStatus @default(invited)
  /// The "Super Admin" permission bit (onboarding v1): view billing, purchase/
  /// upgrade slots. Only meaningful on role='user_admin'. Grantable by
  /// capiro_admin or an existing billing admin (Settings → Team).
  billingAdmin Boolean          @default(false) @map("billing_admin")
  invitedBy    String?          @map("invited_by") @db.Uuid
  joinedAt     DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId], map: "tenant_memberships_tenant_user_unique")
  @@index([tenantId, role], map: "tenant_memberships_tenant_role_idx")
  @@index([userId], map: "tenant_memberships_user_idx")
  @@map("tenant_memberships")
}

model ClerkEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  payload     Json      @map("payload_jsonb")
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?

  @@index([eventType], map: "clerk_events_event_type_idx")
  @@map("clerk_events")
}

/// Stripe webhook idempotency log (mirrors clerk_events). Keyed by the Stripe
/// event id; re-deliveries with processed_at set are skipped.
model StripeEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  payload     Json      @map("payload_jsonb")
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?

  @@index([eventType], map: "stripe_events_event_type_idx")
  @@map("stripe_events")
}

/// Per-tenant, per-billing-period tracker for LLM overage already reported to
/// the Stripe metered price. The daily report-llm-overage job computes
/// cumulative billable overage (cents) for the period and reports only the
/// delta vs reportedOverageCents, so re-runs never double-bill.
model TenantUsageMeter {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  /// Start of the billing period this row tracks (UTC, day-aligned).
  periodStart          DateTime @map("period_start") @db.Timestamptz(6)
  /// Cumulative billable overage already reported to Stripe for the period.
  reportedOverageCents Int      @default(0) @map("reported_overage_cents")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart], map: "tenant_usage_meters_tenant_period_key")
  @@map("tenant_usage_meters")
}

model Client {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  name                String
  website             String?
  description         String?
  productDescription  String?   @map("product_description")
  primaryContactName  String?   @map("primary_contact_name")
  primaryContactEmail String?   @map("primary_contact_email") @db.Citext
  primaryContactPhone String?   @map("primary_contact_phone")
  logoS3Key           String?   @map("logo_s3_key")
  logoContentType     String?   @map("logo_content_type")
  logoUploadedAt      DateTime? @map("logo_uploaded_at") @db.Timestamptz(6)
  intakeData          Json      @default("{}") @map("intake_data_jsonb")
  status              String    @default("active")
  // Portfolio Tab v2 additions
  sectorTag           String?   @map("sector_tag")
  profileType         String?   @default("CLIENT") @map("profile_type")
  profileStatus       String    @default("ACTIVE") @map("profile_status")
  submissionTracks    String[]  @default([]) @map("submission_tracks")
  // Manual client-level LDA issue-code override, set in the client summary
  // settings. Unioned with the auto codes from the confirmed LDA match to drive
  // bill/regulation matching (works even when no LDA entity is mapped).
  issueCodes          String[]  @default([]) @map("issue_codes")
  // Step 2.3 — government identifiers + code arrays for procurement matching.
  uei                 String?   @db.VarChar(12)
  cageCode            String?   @map("cage_code") @db.VarChar(5)
  naicsCodes          String[]  @default([]) @map("naics_codes")
  pscCodes            String[]  @default([]) @map("psc_codes")
  // Client→data association overhaul: the confirmed set of Senate LDA client_ids
  // this client resolves to (one id per lobbying-firm relationship — a real
  // company can have many, e.g. Boeing = 27). Denormalized read-cache of the
  // confirmed source='lda' ClientIntelMapping rows; reads join
  // lda_filing.client_id = ANY(ldaClientIds) instead of fuzzy-matching the name.
  ldaClientIds        Int[]     @default([]) @map("lda_client_ids")
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                  Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagementContacts      EngagementContact[]
  meetings                Meeting[]
  mailThreads             MailThread[]
  engagementAttachments   EngagementAttachment[]
  meetingNotes            MeetingNote[]
  meetingDebriefs         MeetingDebrief[]
  meetingBotSessions      MeetingBotSession[]
  meetingPreps            MeetingPrep[]
  engagementTasks         EngagementTask[]
  associationOverrides    ClientAssociationOverride[]
  engagementReportTargets EngagementReportTargetOffice[]
  outreachRecords         OutreachRecord[]
  clioConversations       ClioConversation[]
  clioMessages            ClioMessage[]
  clioArtifacts           ClioArtifact[]
  clioNotes               ClioNote[]
  clioResearchSessions    ClioResearchSession[]
  capabilities            ClientCapability[]
  submissionHistory       ClientSubmissionHistory[]
  people                  ClientPerson[]
  facilities              ClientFacility[]
  targets                 ClientTarget[]
  targetRecommendations   ClientTargetRecommendation[]
  engagementCampaigns     EngagementCampaign[]
  clioProactiveAlerts     ClioProactiveAlert[]
  actionRecommendations   ActionRecommendation[]

  @@index([tenantId], map: "clients_tenant_idx")
  @@index([tenantId, name], map: "clients_tenant_name_idx")
  @@map("clients")
}

model DirectoryContactNote {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  directoryContactId   String   @map("directory_contact_id")
  directoryContactName String?  @map("directory_contact_name")
  body                 String   @db.Text
  createdByUserId      String?  @map("created_by_user_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("DirectoryContactNoteAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, directoryContactId, createdAt], map: "directory_contact_notes_tenant_contact_created_idx")
  @@index([createdByUserId], map: "directory_contact_notes_created_by_idx")
  @@map("directory_contact_notes")
}

/// Per-user "favorite"/starred directory members, so users get quick access to
/// the offices they email most when building outreach.
model DirectoryContactFavorite {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  directoryContactId   String   @map("directory_contact_id")
  directoryContactName String?  @map("directory_contact_name")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("DirectoryContactFavoriteUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, directoryContactId], map: "directory_contact_favorites_unique")
  @@index([tenantId, userId], map: "directory_contact_favorites_tenant_user_idx")
  @@map("directory_contact_favorites")
}

model IntegrationConnection {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  provider        EngagementProvider
  accountEmail    String?                    @map("account_email") @db.Citext
  displayName     String?                    @map("display_name")
  status          EngagementConnectionStatus @default(needs_configuration)
  scopes          String[]                   @default([])
  syncState       Json                       @default("{}") @map("sync_state_jsonb")
  lastSyncAt      DateTime?                  @map("last_sync_at") @db.Timestamptz(6)
  nextSyncAt      DateTime?                  @map("next_sync_at") @db.Timestamptz(6)
  lastError       String?                    @map("last_error")
  createdByUserId String?                    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token        IntegrationConnectionToken?
  meetings     Meeting[]
  mailThreads  MailThread[]
  mailMessages MailMessage[]

  @@unique([tenantId, provider, accountEmail], map: "engagement_connections_tenant_provider_account_key")
  @@index([tenantId, status], map: "engagement_connections_tenant_status_idx")
  @@map("engagement_connections")
}

model IntegrationConnectionToken {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  connectionId           String   @unique @map("connection_id") @db.Uuid
  accessTokenCiphertext  String   @map("access_token_ciphertext")
  accessTokenIv          String   @map("access_token_iv")
  accessTokenAuthTag     String   @map("access_token_auth_tag")
  refreshTokenCiphertext String?  @map("refresh_token_ciphertext")
  refreshTokenIv         String?  @map("refresh_token_iv")
  refreshTokenAuthTag    String?  @map("refresh_token_auth_tag")
  keyVersion             String   @map("key_version")
  scopes                 String[] @default([])
  homeAccountId          String?  @map("home_account_id")
  expiresAt              DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, connectionId], map: "engagement_connection_tokens_tenant_connection_idx")
  @@map("engagement_connection_tokens")
}

model EngagementContact {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  clientId               String?  @map("client_id") @db.Uuid
  directoryEntryId       String?  @map("directory_entry_id")
  acquisitionPersonnelId String?  @map("acquisition_personnel_id") @db.Uuid
  fullName               String?  @map("full_name")
  email                  String?  @db.Citext
  phone                  String?
  organization           String?
  title                  String?
  source                 String   @default("manual")
  metadata               Json     @default("{}") @map("metadata_jsonb")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  attendees MeetingAttendee[]
  tasks     EngagementTask[]

  @@unique([tenantId, email], map: "engagement_contacts_tenant_email_key")
  @@index([tenantId, clientId], map: "engagement_contacts_tenant_client_idx")
  @@index([acquisitionPersonnelId], map: "engagement_contacts_acquisition_personnel_id_idx")
  @@map("engagement_contacts")
}

model Meeting {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  clientId           String?           @map("client_id") @db.Uuid
  isInternal         Boolean           @default(false) @map("is_internal")
  connectionId       String?           @map("connection_id") @db.Uuid
  source             EngagementSource  @default(manual)
