// Phase 4 WS M (plan §18): truthful schedule-period fidelity for R-4/R-4A
// milestones. planned_date/actual_date on ProgramElementMilestone are exact
// calendar dates ONLY when the source prints an exact date; quarter/month/
// year labels must never be coerced into fabricated first/last-day dates.
// This child table preserves the raw period text, period kind, and every
// explicit structured component (fiscal/calendar year, quarter, month) with
// source provenance. ADDITIVE.
//
// periodRole: 'planned' | 'actual'.
// periodKind: exact_date | calendar_month | calendar_quarter | fiscal_quarter
//             | fiscal_year | text_only | range | unknown
//             (R4_SCHEDULE_PERIOD_KIND_V1_VALUES, CHECK-constrained in the
//             reviewed migration).
model ProgramElementMilestoneSchedulePeriod {
  id               String    @id @default(uuid()) @db.Uuid
  milestoneId      String    @map("milestone_id") @db.Uuid
  peCode           String    @map("pe_code") @db.VarChar(16)
  milestoneType    String    @map("milestone_type")
  periodRole       String    @map("period_role") // planned | actual
  rawText          String    @db.Text
  periodKind       String    @map("period_kind")
  fiscalYear       Int?      @map("fiscal_year")
  fiscalQuarter    Int?      @map("fiscal_quarter")
  calendarYear     Int?      @map("calendar_year")
  calendarQuarter  Int?      @map("calendar_quarter")
  calendarMonth    Int?      @map("calendar_month")
  exactDate        DateTime? @map("exact_date") @db.Date
  rangeStart       DateTime? @map("range_start") @db.Date
  rangeEnd         DateTime? @map("range_end") @db.Date
  sourceUrl        String?   @map("source_url")
  pageNumber       Int?      @map("page_number")
  metadata         Json      @default("{}") @map("metadata_jsonb")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceDocumentId String?   @map("source_document_id") @db.Uuid

  milestone      ProgramElementMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  programElement ProgramElement          @relation(fields: [peCode], references: [peCode], onDelete: Cascade)
  sourceDocument SourceDocument?         @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([milestoneId, periodRole, rawText], map: "program_element_milestone_schedule_period_natural_key")
  @@index([peCode, milestoneType], map: "program_element_milestone_schedule_period_pe_type_idx")
  @@index([periodKind], map: "program_element_milestone_schedule_period_kind_idx")
  @@map("program_element_milestone_schedule_period")
}

model ProgramElementQuarantine {
  id            String   @id @default(uuid()) @db.Uuid
  rawRecord     Json     @map("raw_record")
  reason        String
  source        String
  quarantinedAt DateTime @default(now()) @map("quarantined_at") @db.Timestamptz(6)

