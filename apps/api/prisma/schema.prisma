model DefenseBudgetPromotionAudit {
  id                       String   @id @default(uuid()) @db.Uuid
  attemptKind              String   @map("attempt_kind") @db.VarChar(32)
  outcome                  String   @db.VarChar(16)
  actorId                  String?  @map("actor_id")
  cycleId                  String?  @map("cycle_id")
  scope                    Json?
  eligibilityHash          String?  @map("eligibility_hash") @db.Char(64)
  planId                   String?  @map("plan_id")
  planHash                 String?  @map("plan_hash") @db.Char(64)
  authorizationId          String?  @map("authorization_id")
  expectedActiveSnapshotId String?  @map("expected_active_snapshot_id") @db.Uuid
  reasons                  Json     @default("[]")
  detail                   String?
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "defense_budget_promotion_audit_created_idx")
  @@index([planId], map: "defense_budget_promotion_audit_plan_idx")
  @@map("defense_budget_promotion_audit")
}
