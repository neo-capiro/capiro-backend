model User {
  id                    String    @id @default(uuid()) @db.Uuid
  clerkUserId           String    @unique @map("clerk_user_id")
  email                 String    @unique @db.Citext
  firstName             String?   @map("first_name")
  lastName              String?   @map("last_name")
  // Free-form job title displayed under the user's name in the top-right
  // profile widget. User-editable via /settings.
  title                 String?
  // Per-user HTML email signature appended to outbound outreach emails.
  // Server-sanitized (sanitize-signature.ts) on save; stored already-clean so
  // the send path can append it without re-stripping. `enabled` is the
  // append-by-default preference; each campaign can still override at send time.
  emailSignatureHtml    String?   @map("email_signature_html")
  emailSignatureEnabled Boolean   @default(false) @map("email_signature_enabled")
  // Guided product tour (onboarding v1, Flow 2B.4): set when the user finishes
  // or skips the first-login tour; NULL = auto-launch on next dashboard load.
  // Server-side so the choice follows the user across devices.
  tourCompletedAt       DateTime? @map("tour_completed_at") @db.Timestamptz(6)
  // LegiWatch orientation is a per-user preference that follows the analyst
  // across browsers and devices instead of a shared localStorage flag.
  legiwatchIntroSeenAt  DateTime? @map("legiwatch_intro_seen_at") @db.Timestamptz(6)
  lastSeenAt            DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships                      TenantMembership[]
  auditLogs                        AuditLog[]                     @relation("AuditActor")
  impersonationSessions            ImpersonationSession[]         @relation("ImpersonationActor")
  directoryContactNotes            DirectoryContactNote[]         @relation("DirectoryContactNoteAuthor")
  directoryContactFavorites        DirectoryContactFavorite[]     @relation("DirectoryContactFavoriteUser")
  meetingNotes                     MeetingNote[]                  @relation("MeetingNoteAuthor")
  meetingNotesApproved             MeetingNote[]                  @relation("MeetingNoteApprovedBy")
  meetingNotesShared               MeetingNote[]                  @relation("MeetingNoteSharedBy")
  meetingDebriefs                  MeetingDebrief[]               @relation("MeetingDebriefAuthor")
  meetingDebriefsShared            MeetingDebrief[]               @relation("MeetingDebriefSharedBy")
  meetingPrepsShared               MeetingPrep[]                  @relation("MeetingPrepSharedBy")
  engagementAttachmentsApproved    EngagementAttachment[]         @relation("EngagementAttachmentApprovedBy")
  engagementAttachmentsShared      EngagementAttachment[]         @relation("EngagementAttachmentSharedBy")
  engagementReportTargets          EngagementReportTargetOffice[] @relation("EngagementReportTargetOfficeAuthor")
  clientTargets                    ClientTarget[]                 @relation("ClientTargetAuthor")
  outreachRecords                  OutreachRecord[]               @relation("OutreachRecordAuthor")
  outreachTemplates                OutreachTemplate[]             @relation("OutreachTemplateAuthor")
  outreachAiTemplates              OutreachAiTemplate[]           @relation("OutreachAiTemplateAuthor")
  clioConversations                ClioConversation[]             @relation("ClioConversationUser")
  clioMessages                     ClioMessage[]                  @relation("ClioMessageUser")
  clioArtifacts                    ClioArtifact[]                 @relation("ClioArtifactUser")
  clioNotes                        ClioNote[]                     @relation("ClioNoteUser")
  clioResearchSessions             ClioResearchSession[]          @relation("ClioResearchSessionUser")
  clioAttachments                  ClioAttachment[]               @relation("ClioAttachmentUser")
  createdCampaigns                 EngagementCampaign[]           @relation("CampaignCreator")
  programElementWatches            ProgramElementWatch[]
  programElementDataIssuesReported ProgramElementDataIssue[]      @relation("PeDataIssueReporter")
  programElementDataIssuesResolved ProgramElementDataIssue[]      @relation("PeDataIssueResolver")
  peAlertEmailPrefs                PeAlertEmailPref[]
  clientMemoryAccessGrants         ClientMemoryAccess[]           @relation("ClientMemoryAccessUser")
  governedMemoryAccessGrants       MemoryAccessGrant[]            @relation("MemoryAccessGrantUser")
  outreachDraftArtifacts           OutreachDraftArtifact[]        @relation("OutreachDraftArtifactAuthor")
  outreachDraftVersions            OutreachDraftVersion[]         @relation("OutreachDraftVersionAuthor")
  outreachSendIntents              OutreachSendIntent[]           @relation("OutreachSendIntentOwner")

  @@map("users")
}

model TenantMembership {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  role         TenantRole
  status       MembershipStatus @default(invited)
  /// The "Super Admin" permission bit (onboarding v1): view billing, purchase/
  /// upgrade slots. Only meaningful on role='user_admin'. Grantable by
  /// capiro_admin or an existing billing admin (Settings → Team).
  billingAdmin Boolean          @default(false) @map("billing_admin")
  invitedBy    String?          @map("invited_by") @db.Uuid
  joinedAt     DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId], map: "tenant_memberships_tenant_user_unique")
  @@index([tenantId, role], map: "tenant_memberships_tenant_role_idx")
  @@index([userId], map: "tenant_memberships_user_idx")
  @@map("tenant_memberships")
}

/// Ledger of identity-rebinding events: every time an existing local user row
/// is re-pointed at a different Clerk identity, or two identities are merged.
///
/// Three code paths can do this today, all keyed on EMAIL alone:
///   * tenant-context.middleware self-heal (adopts an email-matched row),
///   * clerk-webhook.service (merges when clerkUserId and email rows differ),
///   * clerk-provisioning.service (same shape).
///
/// Email equality is good evidence that two records are the same PERSON, but it
/// is not proof that two CLERK IDENTITIES are — a stale local row whose
/// user.deleted webhook never landed is enough to hand its memberships to a new
/// identity.
///
/// This table is RECORD-ONLY for now, deliberately. Blocking the rebind
/// requires knowing how often it legitimately fires and on what kind of rows,
/// and there is no such telemetry today; a naive gate would break the self-heal
/// path whose entire purpose is preventing lockouts when the Clerk webhook is
/// slow or undelivered. Populate this, review it, then decide.
///
/// Has no tenant_id: the middleware path detects a conflict BEFORE any tenant is
/// resolved, which is also why these cannot be written to audit_logs (its
/// tenant_id is NOT NULL).
model UserIdentityConflict {
  id                  String    @id @default(uuid()) @db.Uuid
  /// 'rebind' | 'merge'
  kind                String
  /// Where it happened: 'middleware_self_heal' | 'clerk_webhook' | 'clerk_provisioning'
  source              String
  email               String
  /// The Clerk identity the row is being re-pointed AT.
  incomingClerkUserId String    @map("incoming_clerk_user_id")
  /// The local user row being re-pointed, and the identity it held before.
  existingUserId      String    @map("existing_user_id") @db.Uuid
  previousClerkUserId String?   @map("previous_clerk_user_id")
  /// Memberships the surviving row held at the time, for after-the-fact review.
  membershipCount     Int       @default(0) @map("membership_count")
  detectedAt          DateTime  @default(now()) @map("detected_at") @db.Timestamptz(6)
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  resolution          String?

  @@index([detectedAt])
  @@index([email])
  @@map("user_identity_conflict")
}

/// Durable, retryable record of an identity side effect that MUST eventually
/// reach Clerk. Written in the SAME transaction as the local state change, then
/// drained out-of-band by IdentityOutboxWorker.
///
/// Exists because de-provisioning was fire-and-forget: removeMember flipped the
/// local membership to 'removed' and called Clerk's
/// deleteOrganizationMembership INSIDE the same interactive transaction, then
/// swallowed any failure. A failed delete left the user in the Clerk org — still
/// being issued org-bearing tokens — with nothing recording it. A slow delete
/// blew the 5s transaction budget and rolled the removal back entirely.
///
/// Modelled on api-strategy's sp_event_outbox.
model IdentityOutbox {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// e.g. 'clerk.membership.delete'
  type     String
  /// { clerkOrgId, clerkUserId, membershipId }
  payload  Json

  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.Text
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)

  @@index([consumedAt, nextAttemptAt], map: "identity_outbox_pending_idx")
  @@index([tenantId, createdAt], map: "identity_outbox_tenant_created_idx")
  @@map("identity_outbox")
}

model ClerkEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  payload     Json      @map("payload_jsonb")
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?

  @@index([eventType], map: "clerk_events_event_type_idx")
  @@map("clerk_events")
}

/// Stripe webhook idempotency log (mirrors clerk_events). Keyed by the Stripe
/// event id; re-deliveries with processed_at set are skipped.
model StripeEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  payload     Json      @map("payload_jsonb")
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?

  @@index([eventType], map: "stripe_events_event_type_idx")
  @@map("stripe_events")
}

/// Per-tenant, per-billing-period tracker for LLM overage already reported to
/// the Stripe metered price. The daily report-llm-overage job computes
/// cumulative billable overage (cents) for the period and reports only the
/// delta vs reportedOverageCents, so re-runs never double-bill.
model TenantUsageMeter {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  /// Start of the billing period this row tracks (UTC, day-aligned).
  periodStart          DateTime @map("period_start") @db.Timestamptz(6)
  /// Cumulative billable overage already reported to Stripe for the period.
  reportedOverageCents Int      @default(0) @map("reported_overage_cents")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart], map: "tenant_usage_meters_tenant_period_key")
  @@map("tenant_usage_meters")
}

model Client {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  name                   String
  website                String?
  description            String?
  productDescription     String?   @map("product_description")
  primaryContactName     String?   @map("primary_contact_name")
  primaryContactEmail    String?   @map("primary_contact_email") @db.Citext
  primaryContactPhone    String?   @map("primary_contact_phone")
  logoS3Key              String?   @map("logo_s3_key")
  logoContentType        String?   @map("logo_content_type")
  logoUploadedAt         DateTime? @map("logo_uploaded_at") @db.Timestamptz(6)
  intakeData             Json      @default("{}") @map("intake_data_jsonb")
  status                 String    @default("active")
  // Portfolio Tab v2 additions
  sectorTag              String?   @map("sector_tag")
  profileType            String?   @default("CLIENT") @map("profile_type")
  profileStatus          String    @default("ACTIVE") @map("profile_status")
  submissionTracks       String[]  @default([]) @map("submission_tracks")
  // Manual client-level LDA issue-code override, set in the client summary
  // settings. Unioned with the auto codes from the confirmed LDA match to drive
  // bill/regulation matching (works even when no LDA entity is mapped).
  issueCodes             String[]  @default([]) @map("issue_codes")
  // Step 2.3 — government identifiers + code arrays for procurement matching.
  uei                    String?   @db.VarChar(12)
  cageCode               String?   @map("cage_code") @db.VarChar(5)
  naicsCodes             String[]  @default([]) @map("naics_codes")
  pscCodes               String[]  @default([]) @map("psc_codes")
  /// Funding Opportunities P19 — MakeGov/Tango entity shadow sync status.
  /// This is the client's OWN sync bookkeeping; the fetched entity DATA lives
  /// in the GLOBAL `tango_resource_snapshot` table (P15), keyed by this same
  /// `uei` — no separate link row. A UEI is already a global, exact 1:1 key,
  /// and `TangoResourceLink` is reserved for linking INTO Capiro's own global
  /// reference tables (federal_contractor et al.), never to a tenant-owned
  /// row like Client — `tango-store.service.ts`'s `assertKnownLocalType`
  /// refuses that on purpose (decision-log D-34).
  ///
  /// `tangoEntityLastSyncedAt` is the last SUCCESSFUL sync — "successful"
  /// meaning a definitive provider answer, found OR not_found; both are
  /// evidence, not a failure (tango.errors.ts's own framing for `not_found`).
  /// `tangoEntityLastAttemptAt` is the latest attempt regardless of outcome,
  /// reported independently so a rail failing repeatedly cannot read as
  /// healthy — same distinction this program already draws for source
  /// freshness generally (baseline-contract-v1.json's
  /// `sourceFreshnessSemantics`). `tangoEntityLastError` is redacted, and
  /// cleared (set null) on the next successful attempt.
  tangoEntityLastSyncedAt  DateTime? @map("tango_entity_last_synced_at") @db.Timestamptz(6)
  tangoEntityLastAttemptAt DateTime? @map("tango_entity_last_attempt_at") @db.Timestamptz(6)
  tangoEntityLastError     String?   @map("tango_entity_last_error")
  /// Grants.gov "Eligible Applicants" values this client qualifies as, e.g.
  /// "Small businesses" or "State governments".
  ///
  /// LABELS, not the numeric Grants.gov codes — `federal_grant.eligibility`
  /// stores labels (verified live 2026-07-28: 17 distinct label strings across
  /// 816 of 866 rows), and District Nexus F3 eligibility compares the two by
  /// string. A client populated with codes would match nothing. The canonical
  /// list is `GRANTS_GOV_APPLICANT_TYPES` in @capiro/shared.
  ///
  /// Until this is populated, `computeEligibility` can only return
  /// `needs_review` or `unknown`, never `eligible`. Empty is the honest default:
  /// it says "we do not know", which is true, rather than guessing a type from
  /// the sector and telling a user they can apply for something they cannot.
  applicantTypes         String[]  @default([]) @map("applicant_types")
  /// DURABLE socioeconomic certifications the company HOLDS. Canonical values are
  /// the six in `set-aside.ts`: 8A, SDVOSB, VOSB, WOSB, EDWOSB, HUBZONE. Empty
  /// means unknown, never ineligible.
  ///
  /// This comment previously named SAM's `typeOfSetAside` vocabulary (8AN,
  /// SDVOSBC, HZC, SBA, SBP) as canonical, and the DTO accepted it. That was the
  /// wrong vocabulary for a company profile and admitted two things that are not
  /// certifications: SBA/SBP are general small-business RESTRICTIONS on a
  /// solicitation (no firm holds an "SBA certification"), and the 8AN/SDVOSBS/
  /// WOSBSS/EDWOSBSS/HZS family are SOLE-SOURCE notice codes — a competition
  /// method, not a status. Recording either then fed the eligibility check, which
  /// read it back as evidence and reported the client `eligible`.
  ///
  /// Legacy rows are migrated by `repair-set-aside-certifications.ts`.
  setAsideCertifications String[]  @default([]) @map("set_aside_certifications")
  // Client→data association overhaul: the confirmed set of Senate LDA client_ids
  // this client resolves to (one id per lobbying-firm relationship — a real
  // company can have many, e.g. Boeing = 27). Denormalized read-cache of the
  // confirmed source='lda' ClientIntelMapping rows; reads join
  // lda_filing.client_id = ANY(ldaClientIds) instead of fuzzy-matching the name.
  ldaClientIds           Int[]     @default([]) @map("lda_client_ids")
  /// Ethical wall (master plan Phase 1): when true, this client's memory
  /// (clio_memory scope='client', client-linked memory_items, and their
  /// embeddings) is recallable ONLY by users granted a ClientMemoryAccess row.
  /// false (default) = the pre-wall relevance-only behavior, so enabling the
  /// column changes nothing until a wall is explicitly erected per client.
  /// Admins are NOT exempt — a real ethical screen binds seniors too; a
  /// user_admin manages grants (and any self-grant is audit-logged).
  memoryWall             Boolean   @default(false) @map("memory_wall")
  createdByUserId        String?   @map("created_by_user_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                  Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagementContacts      EngagementContact[]
  meetings                Meeting[]
  mailThreads             MailThread[]
  engagementAttachments   EngagementAttachment[]
  meetingNotes            MeetingNote[]
  meetingDebriefs         MeetingDebrief[]
  meetingBotSessions      MeetingBotSession[]
  meetingPreps            MeetingPrep[]
  engagementTasks         EngagementTask[]
  associationOverrides    ClientAssociationOverride[]
  engagementReportTargets EngagementReportTargetOffice[]
  outreachRecords         OutreachRecord[]
  clioConversations       ClioConversation[]
  clioMessages            ClioMessage[]
  clioArtifacts           ClioArtifact[]
  clioNotes               ClioNote[]
  clioResearchSessions    ClioResearchSession[]
  capabilities            ClientCapability[]
  submissionHistory       ClientSubmissionHistory[]
  people                  ClientPerson[]
  facilities              ClientFacility[]
  targets                 ClientTarget[]
  targetRecommendations   ClientTargetRecommendation[]
  engagementCampaigns     EngagementCampaign[]
  clioProactiveAlerts     ClioProactiveAlert[]
  actionRecommendations   ActionRecommendation[]
  memoryAccessGrants      ClientMemoryAccess[]
  governedMemoryGrants    MemoryAccessGrant[]
  grantNexuses            ClientGrantNexus[]
  fundingOpportunities    ClientFundingOpportunity[]

  @@index([tenantId], map: "clients_tenant_idx")
  @@index([tenantId, name], map: "clients_tenant_name_idx")
  @@map("clients")
}

/// Ethical-wall grant (master plan Phase 1): membership row allowing one user
/// to recall one walled client's memory. Meaningful only while
/// Client.memoryWall = true; rows may be staged before a wall is erected.
/// Fail-closed by construction: a walled client with zero grants is invisible
/// to everyone (including admins) until a user_admin grants access via
/// PUT /clients/:id/memory-access (audit-logged).
model ClientMemoryAccess {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// user_admin who granted the access (plain uuid, no FK — mirrors
  /// Client.createdByUserId; survives the granter's departure).
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation("ClientMemoryAccessUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId, userId], map: "client_memory_access_uniq")
  @@index([tenantId, userId], map: "client_memory_access_user_idx")
  @@map("client_memory_access")
}

