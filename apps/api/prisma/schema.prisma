  totalSpending5y Decimal? @map("total_spending_5y") @db.Decimal(18, 2)
  quarterlyTrend  Json     @default("[]") @map("quarterly_trend")
  lastSyncedAt    DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@map("lda_issue_code")
}

model LdaGovernmentEntity {
  // 257 federal government entity reference records.
  id             Int      @id
  name           String
  totalFilings5y Int      @default(0) @map("total_filings_5y")
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@map("lda_government_entity")
}

// ─────────────────────────────────────────────────────────────────────────
// FEC Campaign Finance Data
//
// GLOBAL tables, shared across all tenants. No tenant_id, no RLS.
// Populated by apps/api/scripts/sync-fec.ts.
// Source: https://api.open.fec.gov/v1/, FEC campaign finance data.
// ─────────────────────────────────────────────────────────────────────────

model FecCommittee {
  // PACs and campaign committees from FEC API.
  id                 String   @id // committee_id like C00835926
  name               String
  committeeType      String?  @map("committee_type")
  designation        String?
  party              String?
  state              String?
  treasurerName      String?  @map("treasurer_name")
  totalReceipts      Decimal? @map("total_receipts") @db.Decimal(18, 2)
  totalDisbursements Decimal? @map("total_disbursements") @db.Decimal(18, 2)
  cashOnHand         Decimal? @map("cash_on_hand") @db.Decimal(18, 2)
  cycles             Int[]    @default([])
  lastSyncedAt       DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([name], map: "fec_committee_name_idx")
  @@map("fec_committee")
}

model FecContribution {
  // Individual/PAC contributions to candidates (Schedule A).
  id                    String    @id @default(uuid()) @db.Uuid
  committeeId           String    @map("committee_id")
  committeeName         String?   @map("committee_name")
  candidateId           String?   @map("candidate_id")
  candidateName         String?   @map("candidate_name")
  contributorName       String?   @map("contributor_name")
  contributorEmployer   String?   @map("contributor_employer")
  contributorOccupation String?   @map("contributor_occupation")
  amount                Decimal   @db.Decimal(18, 2)
  contributionDate      DateTime? @map("contribution_date") @db.Date
  receiptType           String?   @map("receipt_type")
  memoText              String?   @map("memo_text")
  state                 String?
  cycle                 Int
  lastSyncedAt          DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([committeeId, candidateName, contributorEmployer, amount, cycle], map: "fec_contribution_dedup_key")
  @@index([committeeId], map: "fec_contribution_committee_id_idx")
  @@index([candidateName], map: "fec_contribution_candidate_name_idx")
  @@index([contributorEmployer], map: "fec_contribution_employer_idx")
  @@index([cycle], map: "fec_contribution_cycle_idx")
  @@map("fec_contribution")
}

model FecPacContribution {
  // Schedule B — disbursements BY a committee (PAC) TO candidates/committees.
  // This is the organization's OWN PAC giving — legally distinct from the
  // individual employer-linked contributions in FecContribution (Schedule A).
  // GLOBAL table (no tenant_id, no RLS); attributed to a client via a confirmed
  // ClientIntelMapping(source='fec_committee') linking client -> committeeId.
  id                   String    @id @default(uuid()) @db.Uuid
  committeeId          String    @map("committee_id") // the giving PAC committee
  committeeName        String?   @map("committee_name")
  recipientName        String?   @map("recipient_name") // candidate/committee receiving
  recipientCommitteeId String?   @map("recipient_committee_id")
  candidateId          String?   @map("candidate_id")
  candidateName        String?   @map("candidate_name")
  amount               Decimal   @db.Decimal(18, 2)
  disbursementDate     DateTime? @map("disbursement_date") @db.Date
  disbursementType     String?   @map("disbursement_type")
  memoText             String?   @map("memo_text")
  cycle                Int
  lastSyncedAt         DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([committeeId, recipientName, amount, disbursementDate, cycle], map: "fec_pac_contribution_dedup_key")
  @@index([committeeId], map: "fec_pac_contribution_committee_id_idx")
  @@index([candidateName], map: "fec_pac_contribution_candidate_name_idx")
  @@index([cycle], map: "fec_pac_contribution_cycle_idx")
  @@map("fec_pac_contribution")
}

// ─────────────────────────────────────────────────────────────────────────
// Congress.gov Legislative Data
//
// GLOBAL tables, shared across all tenants. No tenant_id, no RLS.
// Populated by apps/api/scripts/sync-congress.ts.
// Source: https://api.congress.gov/v3/, Congress.gov API.
// ─────────────────────────────────────────────────────────────────────────

model CongressBill {
  // Bills from Congress.gov (118th and 119th Congress).
  id                      String    @id // e.g. "119-hr-1234"
  congress                Int
  billType                String    @map("bill_type")
  billNumber              String    @map("bill_number")
  title                   String
  introducedDate          DateTime? @map("introduced_date") @db.Date
  sponsorName             String?   @map("sponsor_name")
  sponsorState            String?   @map("sponsor_state")
  sponsorParty            String?   @map("sponsor_party")
  // Canonical sponsor identity (Bucket-#3 C6.P6.1) — soft ref -> congress_member.bioguide_id
  sponsorBioguideId       String?   @map("sponsor_bioguide_id")
  latestActionText        String?   @map("latest_action_text")
  latestActionDate        DateTime? @map("latest_action_date") @db.Date
  policyArea              String?   @map("policy_area")
  subjects                String[]  @default([])
  peCodes                 String[]  @default([]) @map("pe_codes")
  committees              Json      @default("[]")
  cosponsorsCount         Int       @default(0) @map("cosponsors_count")
  originChamber           String?   @map("origin_chamber")
  updateDate              DateTime? @map("update_date") @db.Timestamptz(6)
  // Advances when the bill TEXT changes even if no action fired (LegiWatch A3,
  // text-changed alert). Congress.gov returns it; we persist it now.
  updateDateIncludingText DateTime? @map("update_date_including_text") @db.Timestamptz(6)
  // Canonical derived legislative stage (LegiWatch A4). ONE source of truth
  // (deriveBillStage in @capiro/shared) over action history + rule outcomes +
  // roll-call votes. e.g. introduced|committee|reported|rule_pending|
  // rule_failed|floor|passed_chamber|resolving|to_president|enacted|failed|vetoed
  status                  String?
  statusAt                DateTime? @map("status_at") @db.Timestamptz(6)
  url                     String?
  lastSyncedAt            DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  actions       CongressBillAction[]
  committeeRefs CongressBillCommittee[]
  subjectRefs   CongressBillSubject[]
  cosponsors    CongressBillCosponsor[]

  @@index([congress], map: "congress_bill_congress_idx")
  @@index([policyArea], map: "congress_bill_policy_area_idx")
  @@index([peCodes], map: "congress_bill_pe_codes_gin_idx", type: Gin)
  @@index([sponsorBioguideId], map: "congress_bill_sponsor_bioguide_idx")
  @@index([status], map: "congress_bill_status_idx")
  @@map("congress_bill")
}

// CBO cost estimates (Bucket-#3 C4.F1, SC2.4). GLOBAL public-record table —
// populated by sync-congress from the bill-detail cboCostEstimates[] the sync
// already fetches (zero extra API calls) + later the CBO RSS discovery job.
model CboCostEstimate {
  id           String   @id // CBO publication id parsed from the URL (e.g. "62540")
  billId       String?  @map("bill_id") // soft ref -> congress_bill.id ("119-hr-8800")
  congress     Int
  billType     String   @map("bill_type")
  billNumber   String   @map("bill_number")
  title        String   @db.Text
  description  String?  @db.Text
  pubDate      DateTime @map("pub_date") @db.Timestamptz(6)
  cboUrl       String   @unique @map("cbo_url")
  source       String   @default("congress-api") // 'congress-api' | 'cbo-rss'
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([billId])
  @@index([pubDate(sort: Desc)])
  @@map("cbo_cost_estimate")
}

// Canonical congressional-member roster (Bucket-#3 C6.P6.1 / C1.V1). GLOBAL
// public-record table — the entity-normalization anchor for Bioguide IDs
// (SC2.2: every member a tool cites must resolve to a row here). lisId is the
// Senate LIS id the senate.gov roll-call XML uses (crosswalk via the CC0
// unitedstates/congress-legislators dataset); idsJsonb carries the full id
// block (fec/opensecrets/govtrack/wikidata/...).
model CongressMember {
  bioguideId   String    @id @map("bioguide_id")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  fullName     String    @map("full_name")
  party        String?
  state        String?
  district     Int?
  chamber      String // 'house' | 'senate'
  lisId        String?   @unique @map("lis_id")
  isCurrent    Boolean   @default(false) @map("is_current")
  congresses   Int[]     @default([])
  idsJsonb     Json      @default("{}") @map("ids_jsonb")
  updateDate   DateTime? @map("update_date") @db.Timestamptz(6)
  lastSyncedAt DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([chamber, state])
  @@index([lastName])
  @@index([isCurrent])
  @@map("congress_member")
}

// Per-bill cosponsor rows (Bucket-#3 C6.P6.1 / C1.V4). GLOBAL. Populated by
// sync-congress from /bill/{c}/{t}/{n}/cosponsors for lobbying-relevant bills.
// bioguideId soft-refs congress_member; withdrawn cosponsors kept with their
// withdrawnDate (pagination.count on the API excludes them — we keep both).
model CongressBillCosponsor {
  id              String    @id @default(uuid()) @db.Uuid
  billId          String    @map("bill_id")
  bioguideId      String    @map("bioguide_id")
  fullName        String    @map("full_name")
  party           String?
  state           String?
  district        Int?
  sponsorshipDate DateTime? @map("sponsorship_date") @db.Date
  isOriginal      Boolean   @default(false) @map("is_original")
  withdrawnDate   DateTime? @map("withdrawn_date") @db.Date
  lastSyncedAt    DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  bill CongressBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, bioguideId])
  @@index([bioguideId])
  @@map("congress_bill_cosponsor")
}

// Canonical congressional committee registry (Bucket-#3 C6.P6.1). GLOBAL.
// Keyed by the Congress.gov systemCode (the registry's 'committee' canonical
// id, e.g. "hsag00"; subcommittees "hsag16" with parentSystemCode "hsag00").
// Source: CC0 unitedstates/congress-legislators committees-current.json —
// thomas_id maps deterministically to systemCode (lowercase + "00" for full
// committees, lowercase parent + 2-digit sub id for subcommittees).
model CongressCommittee {
  systemCode       String   @id @map("system_code")
  thomasId         String   @map("thomas_id")
  name             String
  chamber          String // 'house' | 'senate' | 'joint'
  parentSystemCode String?  @map("parent_system_code")
  url              String?
  jurisdiction     String?  @db.Text
  isCurrent        Boolean  @default(true) @map("is_current")
  lastSyncedAt     DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  memberships CongressCommitteeMembership[]

  @@index([chamber])
  @@index([parentSystemCode])
  @@map("congress_committee")
}

// Committee membership rosters (Bucket-#3 C6.P6.1). GLOBAL. Source: CC0
// committee-membership-current.json — the ONLY machine-readable roster source
// (the Congress.gov API has no membership endpoint, verified). side is the
// dataset's 'majority'/'minority' (join congress_member for actual party).
model CongressCommitteeMembership {
  id           String   @id @default(uuid()) @db.Uuid
  systemCode   String   @map("system_code")
  bioguideId   String   @map("bioguide_id")
  side         String // 'majority' | 'minority'
  rank         Int?
  title        String? // 'Chair' | 'Chairman' | 'Ranking Member' | 'Ex Officio' | ...
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  committee CongressCommittee @relation(fields: [systemCode], references: [systemCode], onDelete: Cascade)

  @@unique([systemCode, bioguideId])
  @@index([bioguideId])
  @@map("congress_committee_membership")
}

// Generic external-id -> canonical-entity crosswalk (Bucket-#3 C6, Appendix B).
// GLOBAL. idType is a free-form source namespace ('lis', 'fec', 'opensecrets',
// 'govtrack', 'wikidata', 'thomas', ...) — broader than CanonicalIdType, since
// its whole purpose is resolving NON-canonical ids to canonical entities.
// entityKey is the canonical id (bioguideId / systemCode / billId / ...).
model EntityCrosswalk {
  id           String   @id @default(uuid()) @db.Uuid
  idType       String   @map("id_type")
  idValue      String   @map("id_value")
  entityType   String   @map("entity_type") // 'member' | 'committee' | 'bill' | 'company' | ...
  entityKey    String   @map("entity_key")
  source       String // which sync wrote it (e.g. 'sync-congress-members')
  confidence   Float    @default(1.0)
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([idType, idValue])
  @@index([entityType, entityKey])
  @@map("entity_crosswalk")
}

// Roll-call votes (LegiWatch A1 / Bucket-#3 C1.V2-V3). GLOBAL public-record
// table. House from Congress.gov /v3/house-vote; Senate from senate.gov LIS
// XML. billId is a SOFT ref (a vote may reference a bill we don't track) —
// parsed from House legislationType+Number or Senate document_name. A House
// RULE vote has billId = the hres (e.g. "119-hres-1398"); its target bills
// (H.R. 8800 …) receive the outcome via bill_rule_link. NO FK on billId so a
// vote on an untracked measure still persists.
model RollCallVote {
  id           String   @id // "{chamber}-{congress}-{session}-{roll}" e.g. "house-119-1-240"
  chamber      String // 'house' | 'senate'
  congress     Int
  session      Int
  rollNumber   Int      @map("roll_number")
  billId       String?  @map("bill_id") // soft ref -> congress_bill.id
  question     String?  @db.Text
  result       String? // "Passed" | "Failed" | "Agreed to" | "Rejected" | ...
  voteType     String?  @map("vote_type")
  voteDate     DateTime @map("vote_date") @db.Timestamptz(6)
  yeas         Int      @default(0)
  nays         Int      @default(0)
  present      Int      @default(0)
  notVoting    Int      @default(0) @map("not_voting")
  partyTotals  Json     @default("{}") @map("party_totals")
  title        String?  @db.Text
  sourceUrl    String?  @map("source_url")
  source       String // 'house-api' | 'senate-lis'
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  memberVotes MemberVote[]

  @@index([billId])
  @@index([chamber, congress, session])
  @@index([voteDate(sort: Desc)])
  @@map("roll_call_vote")
}

// Per-member positions on a roll-call vote (LegiWatch A1). GLOBAL. memberKey is
// the non-null natural key: the resolved bioguide, else "lis:{lisId}" when a
// Senate lis id has no crosswalk row yet — so the tally stays COMPLETE and the
// crosswalk lag is visible rather than silently dropping members. bioguideId is
// null for those unresolved rows; queries "how did member X vote" filter on it.
model MemberVote {
  id         String  @id @default(uuid()) @db.Uuid
  voteId     String  @map("vote_id")
  memberKey  String  @map("member_key") // bioguide, or "lis:{lisId}" when unresolved
  bioguideId String? @map("bioguide_id") // null when a Senate lis id didn't resolve
  lisId      String? @map("lis_id")
  voteCast   String  @map("vote_cast") // 'Yea' | 'Nay' | 'Present' | 'Not Voting'
  party      String?
  state      String?

  vote RollCallVote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@unique([voteId, memberKey])
  @@index([bioguideId])
  @@map("member_vote")
}

// Rule resolution -> target bill linkage (LegiWatch A2). GLOBAL. A House rule
// (hres) "provides for consideration of" one or more measures; its adoption/
// failure is the real gate on whether those measures advance, but Congress.gov
// records the rule's fate on the RULE, not the target bill. This link lets the
// tracker propagate a rule's outcome onto every target bill. Soft refs both
// sides (no FK) — rule or target may not both be in congress_bill.
model BillRuleLink {
  id           String   @id @default(uuid()) @db.Uuid
  ruleBillId   String   @map("rule_bill_id") // the hres, e.g. "119-hres-1398"
  targetBillId String   @map("target_bill_id") // e.g. "119-hr-8800"
  source       String // 'title-parse' | 'action-parse'
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([ruleBillId, targetBillId])
  @@index([targetBillId])
  @@map("bill_rule_link")
}

/// Cached full bill text fetched from GovInfo, used by the bill PE-code extractor.
/// Global table — no tenant_id, no RLS. One row per bill (bill_id unique).
model BillText {
  id          String   @id @default(uuid()) @db.Uuid
  billId      String   @unique @map("bill_id")
  sourceUrl   String?  @map("source_url")
  textContent String   @map("text_content") @db.Text
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("bill_text")
}

// ─────────────────────────────────────────────────────────────────────────
// Expanded Congress bill data (normalized)
// GLOBAL tables, no tenant_id, no RLS.
// ─────────────────────────────────────────────────────────────────────────

model CongressBillAction {
  id      String       @id @default(uuid())
  billId  String       @map("bill_id")
  date    DateTime
  text    String       @db.Text
  type    String?
  chamber String?
  bill    CongressBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId, date])
  @@map("congress_bill_action")
}

model CongressBillCommittee {
  id            String       @id @default(uuid())
  billId        String       @map("bill_id")
  committeeName String       @map("committee_name")
  committeeCode String?      @map("committee_code")
  chamber       String?
  bill          CongressBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([committeeCode])
  @@map("congress_bill_committee")
}

model CongressBillSubject {
  id     String       @id @default(uuid())
  billId String       @map("bill_id")
  name   String
  bill   CongressBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([name])
  @@map("congress_bill_subject")
}

// ─────────────────────────────────────────────────────────────────────────
// Program Element Intelligence (DoD PE watch)
//
// GLOBAL tables, shared across all tenants. No tenant_id, no RLS.
// Populated by PE Watch sync jobs.
// ─────────────────────────────────────────────────────────────────────────

model ProgramElement {
  peCode             String    @id @map("pe_code") @db.VarChar(16)
  service            String?
  serviceCode        String?   @map("service_code")
  appropriationType  String?   @map("appropriation_type")
  budgetActivity     String?   @map("budget_activity")
  budgetActivityName String?   @map("budget_activity_name")
  lineNumber         String?   @map("line_number")
  title              String
  description        String?   @db.Text
  acatLevel          String?   @map("acat_level")
  programOfRecord    String?   @map("program_of_record")
  status             String?
  rDocUrl            String?   @map("r_doc_url")
  pDocUrl            String?   @map("p_doc_url")
  oDocUrl            String?   @map("o_doc_url")
  raw                Json      @default("{}") @map("raw_jsonb")
  source             String
  sourceConfidence   Float?    @map("source_confidence")
  firstSeenFy        Int?      @map("first_seen_fy")
  lastSyncedAt       DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  // Soft-retire marker. Set by reconcile-stale-pes for PEs that exist ONLY because
  // of the old stanford spreadsheet (source='stanford_pe_directory_jan2026') and
  // carry no live signal (no linked person/award/bill/watch/year). Reads exclude
  // retiredAt IS NOT NULL by default. Reversible. NOT a hard delete — watches /
  // awards / bills reference pe_code with no FK, so we never DELETE the row.
  retiredAt          DateTime? @map("retired_at") @db.Timestamptz(6)
  retiredReason      String?   @map("retired_reason")

  years                    ProgramElementYear[]
  milestones               ProgramElementMilestone[]
  milestoneSchedulePeriods ProgramElementMilestoneSchedulePeriod[]
  yearSourceValues         ProgramElementYearSourceValue[]
  budgetPositions          ProgramElementBudgetPosition[]
  projectBudgetPositions   ProgramElementProjectBudgetPosition[]
  deltas                   ProgramElementDelta[]
  watches                  ProgramElementWatch[]
  dataIssues               ProgramElementDataIssue[]
  conferenceProbabilities  ConferenceProbability[]
  sources                  ProgramElementSource[]
  projects                 ProgramElementProject[]
  performers               ProgramElementPerformer[]

  @@index([serviceCode], map: "program_element_service_code_idx")
  @@index([appropriationType], map: "program_element_appropriation_type_idx")
  @@index([status], map: "program_element_status_idx")
  @@index([retiredAt], map: "program_element_retired_at_idx")
  @@map("program_element")
}

// Page-level provenance for a Program Element, sourced from DoD Comptroller
// budget justification books (J-books). Each row is one citation users can open
// at the exact page (deep link: `${sourceUrl}#page=${pageNumber}`) and screenshot
// the original exhibit. Mirrors AcquisitionPersonnelSource. Global table (no
// tenant_id / RLS): J-book data is public-domain and read-only via API.
model ProgramElementSource {
  id               String   @id @default(uuid()) @db.Uuid
  peCode           String   @map("pe_code") @db.VarChar(16)
  docType          String   @map("doc_type") @db.VarChar(8) // R | P | O
  exhibitType      String?  @map("exhibit_type") @db.VarChar(16) // R-1 | R-2 | R-2A | P-1 | P-40
  fy               Int?
  sourceUrl        String   @map("source_url")
  pageNumber       Int?     @map("page_number")
  pageEnd          Int?     @map("page_end")
  snippet          String?  @db.Text
  publisher        String?  @db.VarChar(64) // e.g. "DoD Comptroller"
  confidence       Float    @default(0.9)
  metadata         Json     @default("{}") @map("metadata_jsonb")
  observedAt       DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Registry link (Step 0.1): the fingerprinted source file this citation came from.
  sourceDocumentId String?  @map("source_document_id") @db.Uuid

  programElement ProgramElement  @relation(fields: [peCode], references: [peCode], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([peCode, docType, sourceUrl, pageNumber], map: "program_element_source_pe_doc_url_page_key")
  @@index([peCode], map: "program_element_source_pe_code_idx")
  @@index([peCode, fy], map: "program_element_source_pe_fy_idx")
  @@index([docType], map: "program_element_source_doc_type_idx")
  @@index([sourceDocumentId], map: "program_element_source_source_document_idx")
  @@map("program_element_source")
}

// Project / sub-element within a Program Element, sourced from Service RDT&E
// Justification Book R-2A exhibits (e.g. PE 0601102A -> projects AA1, AA2, ...).
// Each project carries its own mission narrative and a page-level citation back to
// the originating exhibit. Global table (no tenant_id / RLS): J-book data is
// public-domain and read-only via API. Mirrors ProgramElementSource conventions.
model ProgramElementProject {
  id               String   @id @default(uuid()) @db.Uuid
  peCode           String   @map("pe_code") @db.VarChar(16)
  // Phase 4 WS M: expanded from VarChar(8) to the source-faithful bounded
  // width VarChar(32) (R-2A project token policy: 1-32 chars, no truncation).
  // Widening only; enforced by reviewed migration
  // 20260817010000_rdte_phase4_projection_schema.
  projectCode      String   @map("project_code") @db.VarChar(32)
  title            String
  mission          String?  @db.Text
  budgetActivity   String?  @map("budget_activity")
  fy               Int?
  sourceUrl        String?  @map("source_url")
  pageNumber       Int?     @map("page_number")
  source           String   @default("comptroller_jbook_r2a")
  confidence       Float    @default(0.9)
  metadata         Json     @default("{}") @map("metadata_jsonb")
  firstSeenAt      DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSyncedAt     DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Registry link (Step 0.1): the fingerprinted source file this project came from.
  sourceDocumentId String?  @map("source_document_id") @db.Uuid

  programElement ProgramElement  @relation(fields: [peCode], references: [peCode], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([peCode, projectCode], map: "program_element_project_pe_code_project_key")
  @@index([peCode], map: "program_element_project_pe_code_idx")
  @@index([sourceDocumentId], map: "program_element_project_source_document_idx")
  @@map("program_element_project")
}

model ProgramElementYear {
  id             String   @id @default(uuid()) @db.Uuid
  peCode         String   @map("pe_code") @db.VarChar(16)
  fy             Int
  request        Decimal? @db.Decimal(14, 2)
  hascMark       Decimal? @map("hasc_mark") @db.Decimal(14, 2)
  sascMark       Decimal? @map("sasc_mark") @db.Decimal(14, 2)
  hacDMark       Decimal? @map("hac_d_mark") @db.Decimal(14, 2)
  sacDMark       Decimal? @map("sac_d_mark") @db.Decimal(14, 2)
  // Appropriations-track conference (Defense Appropriations conference / JES). RESERVED:
  // no loader populates it yet — it is the ladder's "conference" rung (see @capiro/shared
  // FUNDING_CURRENT_PRECEDENCE). Kept NULL until a real appropriations-conference source lands.
  conference     Decimal? @db.Decimal(14, 2)
  // NDAA (authorization-track) conference-report value. Written by the NDAA conference
  // loader. Deliberately OUTSIDE the appropriations funding ladder so it never becomes the
  // "current" appropriations number — it reconciles the authorization marks (HASC/SASC).
  ndaaConference Decimal? @map("ndaa_conference") @db.Decimal(14, 2)
  enacted        Decimal? @db.Decimal(14, 2)
  reprogrammed   Decimal? @db.Decimal(14, 2)
  executed       Decimal? @db.Decimal(14, 2)
  notes          String?  @db.Text
  rDocSection    String?  @map("r_doc_section")
  raw            Json     @default("{}") @map("raw_jsonb")
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  programElement ProgramElement @relation(fields: [peCode], references: [peCode], onDelete: Cascade)

  @@unique([peCode, fy], map: "program_element_year_pe_code_fy_key")
  @@index([fy], map: "program_element_year_fy_idx")
  @@map("program_element_year")
}

// Budget-cycle (PB position) dimension + FYDP outyears (Step 1.3, plan §5/§6).
// ONE row per (PE, budget cycle, asserted FY, value kind): every fiscal year a
// budget book *asserts* a value FOR, tagged with the book/stage that asserts it.
// This single shape stores FY27 PB's FY27 request AND FY27 PB's FY28-31 outyears
// AND FY26 PB's FY27 projection — exactly what PB-vs-prior-PB and outyear-delta
// computation need. ADDITIVE: ProgramElementYear remains the "current consolidated
// stage ladder" the profile UI renders today; nothing here changes that consumer.
//
// Global table (no tenant_id / RLS): public-domain budget data, same as
// program_element / federal_award. Mirrors ProgramElementSource provenance
// conventions (sourceUrl + pageNumber deep link, nullable source_document_id FK).
//
// positionCycle = the book/stage asserting the values, e.g.
//   'pb_fy2026' | 'pb_fy2027' | 'hasc_fy2027' | 'enacted_fy2026' | ...
// assertedFy    = the fiscal year the dollars/quantity are FOR (the FYDP column).
// valueKind     = 'total' (dollars $M) | 'quantity' (units) | 'unit_cost' ($M/unit).
// amount is in $ MILLIONS for 'total'/'unit_cost' (project money convention); for
// 'quantity' rows amount carries the unit count and `quantity` may duplicate it.
model ProgramElementBudgetPosition {
  id               String   @id @default(uuid()) @db.Uuid
  peCode           String   @map("pe_code") @db.VarChar(16)
  positionCycle    String   @map("position_cycle")
  assertedFy       Int      @map("asserted_fy")
  amount           Decimal  @db.Decimal(14, 2)
  quantity         Decimal? @db.Decimal(14, 2)
  valueKind        String   @map("value_kind") // total | quantity | unit_cost
  sourceUrl        String?  @map("source_url")
  pageNumber       Int?     @map("page_number")
  metadata         Json     @default("{}") @map("metadata_jsonb")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Registry link (Step 0.1): the fingerprinted source file this position came from.
  sourceDocumentId String?  @map("source_document_id") @db.Uuid

  programElement ProgramElement  @relation(fields: [peCode], references: [peCode], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([peCode, positionCycle, assertedFy, valueKind], map: "program_element_budget_position_natural_key")
  @@index([peCode, assertedFy], map: "program_element_budget_position_pe_fy_idx")
  @@index([positionCycle], map: "program_element_budget_position_cycle_idx")
  @@index([sourceDocumentId], map: "program_element_budget_position_source_document_idx")
  @@map("program_element_budget_position")
}

// Phase 4 WS M (plan §18): project-level budget-position dimension. The
// R-2A project funding extractor asserts annual project values per President's
// Budget cycle (positionCycle = 'pb_fy<cycleFY>'). Every year-bearing R-2A
// project value is a position of the printing cycle — never the outyear
// cycle's independently submitted request. Same provenance conventions as
// ProgramElementBudgetPosition (sourceUrl/pageNumber, nullable
// source_document_id FK). ADDITIVE: no existing table is altered.
//
// amount is in $ MILLIONS (project money convention); original value/unit are
// preserved in metadata by the loader (exact decimal strings, never floats).
// valueKind: 'total' (dollars $M) | 'quantity' (units).
model ProgramElementProjectBudgetPosition {
  id               String   @id @default(uuid()) @db.Uuid
  peCode           String   @map("pe_code") @db.VarChar(16)
  projectCode      String   @map("project_code") @db.VarChar(32)
  positionCycle    String   @map("position_cycle")
  assertedFy       Int      @map("asserted_fy")
  amount           Decimal  @db.Decimal(14, 2)
  quantity         Decimal? @db.Decimal(14, 2)
  valueKind        String   @map("value_kind") // total | quantity
  sourceUrl        String?  @map("source_url")
  pageNumber       Int?     @map("page_number")
  metadata         Json     @default("{}") @map("metadata_jsonb")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Registry link: the fingerprinted source file this position came from.
  sourceDocumentId String?  @map("source_document_id") @db.Uuid

  programElement ProgramElement  @relation(fields: [peCode], references: [peCode], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([peCode, projectCode, positionCycle, assertedFy, valueKind], map: "program_element_project_budget_position_natural_key")
  @@index([peCode, projectCode], map: "program_element_project_budget_position_pe_project_idx")
  @@index([peCode, assertedFy], map: "program_element_project_budget_position_pe_fy_idx")
  @@index([positionCycle], map: "program_element_project_budget_position_cycle_idx")
  @@index([sourceDocumentId], map: "program_element_project_budget_position_source_document_idx")
  @@map("program_element_project_budget_position")
}

// Typed, materiality-scored budget delta (Step 1.4, plan §6). ONE row per
// (PE, asserted FY, delta type, fromRef, toRef) — the engine recomputes it
// idempotently from ProgramElementYear / ProgramElementBudgetPosition /
// ProgramElementProcurementLine. Latest-wins: a recompute that finds a changed
// magnitude stamps `supersededAt` on the prior live row (supersededAt IS NULL)
// and inserts a fresh one, so history is preserved without breaking the natural
// key. Global table (no tenant_id / RLS): the delta itself is public-domain budget
// math; clientRelevance is computed PER-TENANT at read time and is NEVER stored.
//
// deltaType (text, enum-as-text — keep parsers tolerant of new types):
//   pb_vs_prior_pb | mark_vs_request | mark_vs_mark | conference_vs_marks |
//   enacted_vs_request | new_start | termination | zeroed | transfer_candidate |
//   quantity_change | unit_cost_change | outyear_shift | project_level_change
// fromRef / toRef = the positionCycle or field name each side reads (e.g.
//   'request'→'hascMark', or 'pb_fy2026'→'pb_fy2027').
// materialityScore (0..1) + materialityFactors (per-factor contributions) come
// from the PURE scorer (deltas/materiality-scorer.ts); clientRelevance is layered
// in at read time, never persisted.
model ProgramElementDelta {
  id                 String    @id @default(uuid()) @db.Uuid
  peCode             String    @map("pe_code") @db.VarChar(16)
  assertedFy         Int       @map("asserted_fy")
  deltaType          String    @map("delta_type")
  fromRef            String?   @map("from_ref")
  toRef              String?   @map("to_ref")
  amountFrom         Decimal?  @map("amount_from") @db.Decimal(14, 2)
  amountTo           Decimal?  @map("amount_to") @db.Decimal(14, 2)
  deltaAbs           Decimal?  @map("delta_abs") @db.Decimal(14, 2)
  deltaPct           Float?    @map("delta_pct")
  // Exact-copy change-summary narrative (Step 1.5 attaches it; never generated).
  explanation        String?   @db.Text
  // Source rows/pages used to compute this delta (provenance for the "evidence chip").
  evidence           Json      @default("{}") @map("evidence_jsonb")
  materialityScore   Float     @map("materiality_score")
  materialityFactors Json      @default("{}") @map("materiality_factors_jsonb")
  computedAt         DateTime  @default(now()) @map("computed_at") @db.Timestamptz(6)
  // Set on the OLD row when a recompute supersedes it; NULL = current live delta.
  supersededAt       DateTime? @map("superseded_at") @db.Timestamptz(6)

  programElement ProgramElement @relation(fields: [peCode], references: [peCode], onDelete: Cascade)

  // NOTE: the natural-key uniqueness is enforced by a PARTIAL functional unique index
  // (WHERE superseded_at IS NULL, COALESCE-ing the nullable from/to refs) created in
  // the migration raw SQL — Prisma 5 cannot express partial/functional unique indexes,
  // so this is a plain compound index here (kept queryable) and the migration adds the
  // partial unique constraint. Latest-wins: superseded rows share the natural key.
  @@index([peCode, assertedFy, deltaType, fromRef, toRef], map: "program_element_delta_natural_key_idx")
  @@index([peCode, assertedFy], map: "program_element_delta_pe_fy_idx")
  @@index([deltaType], map: "program_element_delta_type_idx")
  @@index([materialityScore(sort: Desc)], map: "program_element_delta_score_idx")
  @@index([supersededAt], map: "program_element_delta_superseded_idx")
  @@map("program_element_delta")
}

