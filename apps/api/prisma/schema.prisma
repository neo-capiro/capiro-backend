  outreachDraftArtifacts       OutreachDraftArtifact[]
  outreachDraftVersions        OutreachDraftVersion[]
  outreachSendIntents          OutreachSendIntent[]
  outreachDeliveries           OutreachDelivery[]
  compliancePolicyPacks        CompliancePolicyPack[]
