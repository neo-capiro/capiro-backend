}

// ─────────────────────────────────────────────────────────────────────────
// Federal Spending Intelligence (OpenSpending / USASpending.gov)
//
// GLOBAL tables, shared across all tenants. No tenant_id, no RLS.
// Populated by the OpenSpending sync job (apps/api/scripts/sync-openspending.ts).
// Source: https://www.openspending.us/data/*.json, derived from
// public USASpending.gov contract and grant award data.
// ─────────────────────────────────────────────────────────────────────────

model FederalContractor {
  // Top federal contractors with parent-company UEI rollup.
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  slug              String?
  uei               String?
  recipientId       String?  @map("recipient_id")
  totalContracts    Decimal? @map("total_contracts") @db.Decimal(18, 2)
  pctOfAllContracts Float?   @map("pct_of_all_contracts")
  costPerTaxpayer   Float?   @map("cost_per_taxpayer")
  category          String? // Defense | Health | Tech | etc
  subsidiaries      Int?
  yearlySpend       Json     @default("[]") @map("yearly_spend_jsonb") // [{year, amount}]
  topAgencies       Json     @default("[]") @map("top_agencies_jsonb") // [{slug, name, amount}]
  topAwards         Json     @default("[]") @map("top_awards_jsonb") // [{awardId, description, amount, agency, startDate}]
  noBidAwards       Json     @default("[]") @map("no_bid_awards_jsonb")
  noBidTotal        Decimal? @map("no_bid_total") @db.Decimal(18, 2)
  rankByContracts   Int?     @map("rank_by_contracts")
  lastSyncedAt      DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  raw               Json     @default("{}") @map("raw_jsonb")

  @@index([name], map: "federal_contractor_name_idx")
  @@index([uei], map: "federal_contractor_uei_idx")
  @@map("federal_contractor")
}

model FederalAgency {
  // 97 federal agencies with budget authority + top contractors.
  slug            String   @id
  name            String
  abbreviation    String?
  code            String?
  displayName     String?  @map("display_name")
  budgetAuthority Decimal? @map("budget_authority") @db.Decimal(18, 2)
  obligated       Decimal? @db.Decimal(18, 2)
  outlays         Decimal? @db.Decimal(18, 2)
  pctOfTotal      Float?   @map("pct_of_total")
  pctOfBudget     Float?   @map("pct_of_budget")
  pctContracts    Float?   @map("pct_contracts")
  costPerAmerican Float?   @map("cost_per_american")
  rankBySpending  Int?     @map("rank_by_spending")
  contractsTotal  Decimal? @map("contracts_total") @db.Decimal(18, 2)
  grantsTotal     Decimal? @map("grants_total") @db.Decimal(18, 2)
  yearlyBudget    Json     @default("[]") @map("yearly_budget_jsonb")
  topContractors  Json     @default("[]") @map("top_contractors_jsonb")
  lastSyncedAt    DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([name], map: "federal_agency_name_idx")
  @@map("federal_agency")
}

model FederalIndustry {
  // Top NAICS industries by federal contract spending.
  code          String   @id // NAICS code, e.g. 336411
  name          String
  slug          String?
  totalSpending Decimal? @map("total_spending") @db.Decimal(18, 2)
  rank          Int?
  pctOfTotal    Float?   @map("pct_of_total")
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@map("federal_industry")
}

// ─────────────────────────────────────────────────────────────────────────
// Senate LDA Federal Lobbying Intelligence (raw filings dataset)
//
// GLOBAL tables, shared across all tenants. No tenant_id, no RLS.
// Populated by apps/api/scripts/sync-lda.ts.
// Source: https://lda.senate.gov/api/v1/, public Senate LD-1/LD-2 filings.
// ─────────────────────────────────────────────────────────────────────────

model LdaFiling {
  // Core filing record (~512K over 5 years).
  id                 String    @id @default(uuid()) @db.Uuid
  filingUuid         String    @unique @map("filing_uuid")
  filingType         String    @map("filing_type")
  filingYear         Int       @map("filing_year")
  filingPeriod       String?   @map("filing_period")
  income             Decimal?  @map("income") @db.Decimal(18, 2)
  expenses           Decimal?  @map("expenses") @db.Decimal(18, 2)
  dtPosted           DateTime? @map("dt_posted") @db.Timestamptz(6)
  registrantId       Int?      @map("registrant_id")
  registrantName     String    @default("") @map("registrant_name")
  clientId           Int?      @map("client_id")
  clientName         String    @default("") @map("client_name")
  clientState        String?   @map("client_state")
  clientCountry      String    @default("US") @map("client_country")
  clientDescription  String?   @map("client_description")
  issueCodes         String[]  @default([]) @map("issue_codes")
  governmentEntities Json      @default("[]") @map("government_entities")
  lobbyists          Json      @default("[]") @map("lobbyists")
  lobbyingActivities Json      @default("[]") @map("lobbying_activities")
  filingDocumentUrl  String?   @map("filing_document_url")
  lastSyncedAt       DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([filingYear], map: "lda_filing_year_idx")
  @@index([dtPosted], map: "lda_filing_dt_posted_idx")
  @@index([clientId], map: "lda_filing_client_id_idx")
  @@index([registrantId], map: "lda_filing_registrant_id_idx")
  @@index([clientName], map: "lda_filing_client_name_idx")
  @@index([registrantName], map: "lda_filing_registrant_name_idx")
  @@map("lda_filing")
}

model LdaClient {
  // 134K lobbying clients extracted from LDA filings.
  id                 Int       @id
  name               String
  generalDescription String?   @map("general_description")
  state              String?
  country            String    @default("US")
  effectiveDate      DateTime? @map("effective_date") @db.Date
  totalFilings       Int       @default(0) @map("total_filings")
  totalSpending      Decimal?  @map("total_spending") @db.Decimal(18, 2)
  latestFilingYear   Int?      @map("latest_filing_year")
  issueCodes         String[]  @default([]) @map("issue_codes")
  lastSyncedAt       DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([name], map: "lda_client_name_idx")
  @@index([state], map: "lda_client_state_idx")
  @@map("lda_client")
}

model LdaRegistrant {
  // 17K lobbying firms (registrants) extracted from LDA filings.
  id                Int      @id
  houseRegistrantId Int?     @map("house_registrant_id")
  name              String
  description       String?
  address           String?
  city              String?
  state             String?
  country           String   @default("US")
  contactName       String?  @map("contact_name")
  contactPhone      String?  @map("contact_phone")
  totalFilings      Int      @default(0) @map("total_filings")
  totalClients      Int      @default(0) @map("total_clients")
  lastSyncedAt      DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([name], map: "lda_registrant_name_idx")
  @@map("lda_registrant")
}

model LdaLobbyist {
  // 88K registered lobbyists extracted from LDA filings.
  id               Int      @id
  firstName        String   @default("") @map("first_name")
  lastName         String   @default("") @map("last_name")
  prefix           String?
  suffix           String?
  coveredPositions Json     @default("[]") @map("covered_positions")
  registrantIds    Int[]    @default([]) @map("registrant_ids")
  activeYears      Int[]    @default([]) @map("active_years")
  lastSyncedAt     DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([lastName, firstName], map: "lda_lobbyist_name_idx")
  @@map("lda_lobbyist")
}

model LdaContribution {
  // 192K contribution reports (LD-203 filings).
  id                String    @id @default(uuid()) @db.Uuid
  filingUuid        String    @unique @map("filing_uuid")
  filingType        String    @map("filing_type")
  filingYear        Int       @map("filing_year")
  filingPeriod      String?   @map("filing_period")
  filerType         String    @default("registrant") @map("filer_type")
  dtPosted          DateTime? @map("dt_posted") @db.Timestamptz(6)
  registrantId      Int?      @map("registrant_id")
  registrantName    String?   @map("registrant_name")
  lobbyistId        Int?      @map("lobbyist_id")
  lobbyistName      String?   @map("lobbyist_name")
  noContributions   Boolean   @default(false) @map("no_contributions")
  pacs              Json      @default("[]") @map("pacs")
  contributionItems Json      @default("[]") @map("contribution_items")
  lastSyncedAt      DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([filingYear], map: "lda_contribution_year_idx")
  @@index([registrantId], map: "lda_contribution_registrant_id_idx")
  @@map("lda_contribution")
}

model LdaIssueCode {
  // 79 LDA issue code reference records with 5-year aggregates.
  code            String   @id
  name            String
  totalFilings5y  Int      @default(0) @map("total_filings_5y")
  totalSpending5y Decimal? @map("total_spending_5y") @db.Decimal(18, 2)
  quarterlyTrend  Json     @default("[]") @map("quarterly_trend")
  lastSyncedAt    DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@map("lda_issue_code")
}

model LdaGovernmentEntity {
  // 257 federal government entity reference records.
  id             Int      @id
  name           String
  totalFilings5y Int      @default(0) @map("total_filings_5y")
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@map("lda_government_entity")
}

// ─────────────────────────────────────────────────────────────────────────
// FEC Campaign Finance Data
//
// GLOBAL tables, shared across all tenants. No tenant_id, no RLS.
// Populated by apps/api/scripts/sync-fec.ts.
// Source: https://api.open.fec.gov/v1/, FEC campaign finance data.
// ─────────────────────────────────────────────────────────────────────────

model FecCommittee {
  // PACs and campaign committees from FEC API.
  id                 String   @id // committee_id like C00835926
  name               String
  committeeType      String?  @map("committee_type")
  designation        String?
  party              String?
  state              String?
  treasurerName      String?  @map("treasurer_name")
  totalReceipts      Decimal? @map("total_receipts") @db.Decimal(18, 2)
  totalDisbursements Decimal? @map("total_disbursements") @db.Decimal(18, 2)
  cashOnHand         Decimal? @map("cash_on_hand") @db.Decimal(18, 2)
  cycles             Int[]    @default([])
  lastSyncedAt       DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([name], map: "fec_committee_name_idx")
  @@map("fec_committee")
}

model FecContribution {
  // Individual/PAC contributions to candidates (Schedule A).
  id                    String    @id @default(uuid()) @db.Uuid
  committeeId           String    @map("committee_id")
  committeeName         String?   @map("committee_name")
  candidateId           String?   @map("candidate_id")
  candidateName         String?   @map("candidate_name")
  contributorName       String?   @map("contributor_name")
  contributorEmployer   String?   @map("contributor_employer")
  contributorOccupation String?   @map("contributor_occupation")
  amount                Decimal   @db.Decimal(18, 2)
  contributionDate      DateTime? @map("contribution_date") @db.Date
  receiptType           String?   @map("receipt_type")
  memoText              String?   @map("memo_text")
  state                 String?
  cycle                 Int
  lastSyncedAt          DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([committeeId, candidateName, contributorEmployer, amount, cycle], map: "fec_contribution_dedup_key")
  @@index([committeeId], map: "fec_contribution_committee_id_idx")
  @@index([candidateName], map: "fec_contribution_candidate_name_idx")
  @@index([contributorEmployer], map: "fec_contribution_employer_idx")
  @@index([cycle], map: "fec_contribution_cycle_idx")
  @@map("fec_contribution")
}

model FecPacContribution {
  // Schedule B — disbursements BY a committee (PAC) TO candidates/committees.
  // This is the organization's OWN PAC giving — legally distinct from the
  // individual employer-linked contributions in FecContribution (Schedule A).
  // GLOBAL table (no tenant_id, no RLS); attributed to a client via a confirmed
  // ClientIntelMapping(source='fec_committee') linking client -> committeeId.
  id                   String    @id @default(uuid()) @db.Uuid
  committeeId          String    @map("committee_id") // the giving PAC committee
  committeeName        String?   @map("committee_name")
  recipientName        String?   @map("recipient_name") // candidate/committee receiving
  recipientCommitteeId String?   @map("recipient_committee_id")
  candidateId          String?   @map("candidate_id")
  candidateName        String?   @map("candidate_name")
  amount               Decimal   @db.Decimal(18, 2)
  disbursementDate     DateTime? @map("disbursement_date") @db.Date
  disbursementType     String?   @map("disbursement_type")
  memoText             String?   @map("memo_text")
  cycle                Int
  lastSyncedAt         DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([committeeId, recipientName, amount, disbursementDate, cycle], map: "fec_pac_contribution_dedup_key")
  @@index([committeeId], map: "fec_pac_contribution_committee_id_idx")
  @@index([candidateName], map: "fec_pac_contribution_candidate_name_idx")
  @@index([cycle], map: "fec_pac_contribution_cycle_idx")
  @@map("fec_pac_contribution")
}

// ─────────────────────────────────────────────────────────────────────────
// Congress.gov Legislative Data
//
// GLOBAL tables, shared across all tenants. No tenant_id, no RLS.
// Populated by apps/api/scripts/sync-congress.ts.
// Source: https://api.congress.gov/v3/, Congress.gov API.
// ─────────────────────────────────────────────────────────────────────────

model CongressBill {
  // Bills from Congress.gov (118th and 119th Congress).
  id                      String    @id // e.g. "119-hr-1234"
  congress                Int
  billType                String    @map("bill_type")
  billNumber              String    @map("bill_number")
  title                   String
  introducedDate          DateTime? @map("introduced_date") @db.Date
  sponsorName             String?   @map("sponsor_name")
  sponsorState            String?   @map("sponsor_state")
  sponsorParty            String?   @map("sponsor_party")
  // Canonical sponsor identity (Bucket-#3 C6.P6.1) — soft ref -> congress_member.bioguide_id
  sponsorBioguideId       String?   @map("sponsor_bioguide_id")
  latestActionText        String?   @map("latest_action_text")
  latestActionDate        DateTime? @map("latest_action_date") @db.Date
  policyArea              String?   @map("policy_area")
  subjects                String[]  @default([])
  peCodes                 String[]  @default([]) @map("pe_codes")
  committees              Json      @default("[]")
  cosponsorsCount         Int       @default(0) @map("cosponsors_count")
  originChamber           String?   @map("origin_chamber")
  updateDate              DateTime? @map("update_date") @db.Timestamptz(6)
  // Advances when the bill TEXT changes even if no action fired (LegiWatch A3,
  // text-changed alert). Congress.gov returns it; we persist it now.
  updateDateIncludingText DateTime? @map("update_date_including_text") @db.Timestamptz(6)
  // Canonical derived legislative stage (LegiWatch A4). ONE source of truth
  // (deriveBillStage in @capiro/shared) over action history + rule outcomes +
  // roll-call votes. e.g. introduced|committee|reported|rule_pending|
  // rule_failed|floor|passed_chamber|resolving|to_president|enacted|failed|vetoed
  status                  String?
  statusAt                DateTime? @map("status_at") @db.Timestamptz(6)
  url                     String?
  lastSyncedAt            DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  actions       CongressBillAction[]
  committeeRefs CongressBillCommittee[]
  subjectRefs   CongressBillSubject[]
  cosponsors    CongressBillCosponsor[]

  @@index([congress], map: "congress_bill_congress_idx")
  @@index([policyArea], map: "congress_bill_policy_area_idx")
  @@index([peCodes], map: "congress_bill_pe_codes_gin_idx", type: Gin)
  @@index([sponsorBioguideId], map: "congress_bill_sponsor_bioguide_idx")
  @@index([status], map: "congress_bill_status_idx")
  @@map("congress_bill")
}

// CBO cost estimates (Bucket-#3 C4.F1, SC2.4). GLOBAL public-record table —
// populated by sync-congress from the bill-detail cboCostEstimates[] the sync
// already fetches (zero extra API calls) + later the CBO RSS discovery job.
model CboCostEstimate {
  id           String   @id // CBO publication id parsed from the URL (e.g. "62540")
  billId       String?  @map("bill_id") // soft ref -> congress_bill.id ("119-hr-8800")
  congress     Int
  billType     String   @map("bill_type")
  billNumber   String   @map("bill_number")
  title        String   @db.Text
  description  String?  @db.Text
  pubDate      DateTime @map("pub_date") @db.Timestamptz(6)
  cboUrl       String   @unique @map("cbo_url")
  source       String   @default("congress-api") // 'congress-api' | 'cbo-rss'
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([billId])
  @@index([pubDate(sort: Desc)])
  @@map("cbo_cost_estimate")
}

// Canonical congressional-member roster (Bucket-#3 C6.P6.1 / C1.V1). GLOBAL
// public-record table — the entity-normalization anchor for Bioguide IDs
// (SC2.2: every member a tool cites must resolve to a row here). lisId is the
// Senate LIS id the senate.gov roll-call XML uses (crosswalk via the CC0
// unitedstates/congress-legislators dataset); idsJsonb carries the full id
// block (fec/opensecrets/govtrack/wikidata/...).
model CongressMember {
  bioguideId   String    @id @map("bioguide_id")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  fullName     String    @map("full_name")
  party        String?
  state        String?
  district     Int?
  chamber      String // 'house' | 'senate'
  lisId        String?   @unique @map("lis_id")
  isCurrent    Boolean   @default(false) @map("is_current")
  congresses   Int[]     @default([])
  idsJsonb     Json      @default("{}") @map("ids_jsonb")
  updateDate   DateTime? @map("update_date") @db.Timestamptz(6)
  lastSyncedAt DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([chamber, state])
  @@index([lastName])
  @@index([isCurrent])
  @@map("congress_member")
}

// Per-bill cosponsor rows (Bucket-#3 C6.P6.1 / C1.V4). GLOBAL. Populated by
// sync-congress from /bill/{c}/{t}/{n}/cosponsors for lobbying-relevant bills.
// bioguideId soft-refs congress_member; withdrawn cosponsors kept with their
// withdrawnDate (pagination.count on the API excludes them — we keep both).
model CongressBillCosponsor {
  id              String    @id @default(uuid()) @db.Uuid
  billId          String    @map("bill_id")
  bioguideId      String    @map("bioguide_id")
  fullName        String    @map("full_name")
  party           String?
  state           String?
  district        Int?
  sponsorshipDate DateTime? @map("sponsorship_date") @db.Date
  isOriginal      Boolean   @default(false) @map("is_original")
  withdrawnDate   DateTime? @map("withdrawn_date") @db.Date
  lastSyncedAt    DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  bill CongressBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, bioguideId])
  @@index([bioguideId])
  @@map("congress_bill_cosponsor")
}

// Canonical congressional committee registry (Bucket-#3 C6.P6.1). GLOBAL.
// Keyed by the Congress.gov systemCode (the registry's 'committee' canonical
// id, e.g. "hsag00"; subcommittees "hsag16" with parentSystemCode "hsag00").
// Source: CC0 unitedstates/congress-legislators committees-current.json —
// thomas_id maps deterministically to systemCode (lowercase + "00" for full
// committees, lowercase parent + 2-digit sub id for subcommittees).
model CongressCommittee {
  systemCode       String   @id @map("system_code")
  thomasId         String   @map("thomas_id")
  name             String
  chamber          String // 'house' | 'senate' | 'joint'
  parentSystemCode String?  @map("parent_system_code")
  url              String?
  jurisdiction     String?  @db.Text
  isCurrent        Boolean  @default(true) @map("is_current")
  lastSyncedAt     DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  memberships CongressCommitteeMembership[]

  @@index([chamber])
  @@index([parentSystemCode])
  @@map("congress_committee")
}

// Committee membership rosters (Bucket-#3 C6.P6.1). GLOBAL. Source: CC0
// committee-membership-current.json — the ONLY machine-readable roster source
// (the Congress.gov API has no membership endpoint, verified). side is the
// dataset's 'majority'/'minority' (join congress_member for actual party).
model CongressCommitteeMembership {
  id           String   @id @default(uuid()) @db.Uuid
  systemCode   String   @map("system_code")
  bioguideId   String   @map("bioguide_id")
  side         String // 'majority' | 'minority'
  rank         Int?
  title        String? // 'Chair' | 'Chairman' | 'Ranking Member' | 'Ex Officio' | ...
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  committee CongressCommittee @relation(fields: [systemCode], references: [systemCode], onDelete: Cascade)

  @@unique([systemCode, bioguideId])
  @@index([bioguideId])
  @@map("congress_committee_membership")
}

// Generic external-id -> canonical-entity crosswalk (Bucket-#3 C6, Appendix B).
// GLOBAL. idType is a free-form source namespace ('lis', 'fec', 'opensecrets',
// 'govtrack', 'wikidata', 'thomas', ...) — broader than CanonicalIdType, since
// its whole purpose is resolving NON-canonical ids to canonical entities.
// entityKey is the canonical id (bioguideId / systemCode / billId / ...).
model EntityCrosswalk {
  id           String   @id @default(uuid()) @db.Uuid
  idType       String   @map("id_type")
  idValue      String   @map("id_value")
  entityType   String   @map("entity_type") // 'member' | 'committee' | 'bill' | 'company' | ...
  entityKey    String   @map("entity_key")
  source       String // which sync wrote it (e.g. 'sync-congress-members')
  confidence   Float    @default(1.0)
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([idType, idValue])
  @@index([entityType, entityKey])
  @@map("entity_crosswalk")
}

// Roll-call votes (LegiWatch A1 / Bucket-#3 C1.V2-V3). GLOBAL public-record
// table. House from Congress.gov /v3/house-vote; Senate from senate.gov LIS
// XML. billId is a SOFT ref (a vote may reference a bill we don't track) —
// parsed from House legislationType+Number or Senate document_name. A House
// RULE vote has billId = the hres (e.g. "119-hres-1398"); its target bills
// (H.R. 8800 …) receive the outcome via bill_rule_link. NO FK on billId so a
// vote on an untracked measure still persists.
model RollCallVote {
  id           String   @id // "{chamber}-{congress}-{session}-{roll}" e.g. "house-119-1-240"
  chamber      String // 'house' | 'senate'
  congress     Int
  session      Int
  rollNumber   Int      @map("roll_number")
  billId       String?  @map("bill_id") // soft ref -> congress_bill.id
  question     String?  @db.Text
  result       String? // "Passed" | "Failed" | "Agreed to" | "Rejected" | ...
  voteType     String?  @map("vote_type")
  voteDate     DateTime @map("vote_date") @db.Timestamptz(6)
  yeas         Int      @default(0)
  nays         Int      @default(0)
  present      Int      @default(0)
  notVoting    Int      @default(0) @map("not_voting")
  partyTotals  Json     @default("{}") @map("party_totals")
  title        String?  @db.Text
  sourceUrl    String?  @map("source_url")
  source       String // 'house-api' | 'senate-lis'
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  memberVotes MemberVote[]

  @@index([billId])
  @@index([chamber, congress, session])
  @@index([voteDate(sort: Desc)])
  @@map("roll_call_vote")
}

// Per-member positions on a roll-call vote (LegiWatch A1). GLOBAL. memberKey is
// the non-null natural key: the resolved bioguide, else "lis:{lisId}" when a
// Senate lis id has no crosswalk row yet — so the tally stays COMPLETE and the
// crosswalk lag is visible rather than silently dropping members. bioguideId is
// null for those unresolved rows; queries "how did member X vote" filter on it.
model MemberVote {
  id         String  @id @default(uuid()) @db.Uuid
  voteId     String  @map("vote_id")
  memberKey  String  @map("member_key") // bioguide, or "lis:{lisId}" when unresolved
  bioguideId String? @map("bioguide_id") // null when a Senate lis id didn't resolve
  lisId      String? @map("lis_id")
  voteCast   String  @map("vote_cast") // 'Yea' | 'Nay' | 'Present' | 'Not Voting'
  party      String?
  state      String?

  vote RollCallVote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@unique([voteId, memberKey])
  @@index([bioguideId])
  @@map("member_vote")
}

// Rule resolution -> target bill linkage (LegiWatch A2). GLOBAL. A House rule
// (hres) "provides for consideration of" one or more measures; its adoption/
// failure is the real gate on whether those measures advance, but Congress.gov
// records the rule's fate on the RULE, not the target bill. This link lets the
// tracker propagate a rule's outcome onto every target bill. Soft refs both
// sides (no FK) — rule or target may not both be in congress_bill.
model BillRuleLink {
  id           String   @id @default(uuid()) @db.Uuid
  ruleBillId   String   @map("rule_bill_id") // the hres, e.g. "119-hres-1398"
  targetBillId String   @map("target_bill_id") // e.g. "119-hr-8800"
  source       String // 'title-parse' | 'action-parse'
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([ruleBillId, targetBillId])
  @@index([targetBillId])
  @@map("bill_rule_link")
}

/// Cached full bill text fetched from GovInfo, used by the bill PE-code extractor.
/// Global table — no tenant_id, no RLS. One row per bill (bill_id unique).
model BillText {
  id          String   @id @default(uuid()) @db.Uuid
  billId      String   @unique @map("bill_id")
  sourceUrl   String?  @map("source_url")
  textContent String   @map("text_content") @db.Text
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("bill_text")
}

// ─────────────────────────────────────────────────────────────────────────
