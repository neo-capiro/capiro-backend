  snapshot DefenseBudgetCanonicalSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([domain, environment], map: "defense_budget_active_snapshot_singleton_unique")
  @@map("defense_budget_active_snapshot")
}

model DefenseBudgetPromotionPlan {
