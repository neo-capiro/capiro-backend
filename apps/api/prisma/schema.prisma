// ─────────────────────────────────────────────────────────────────────────
// Census, ACS 5-Year data by congressional district
// GLOBAL table, no tenant_id, no RLS.
// Source: api.census.gov/data/2022/acs/acs5
// ─────────────────────────────────────────────────────────────────────────

model CensusDistrict {
  id                    String   @id // e.g. "119-CA-52" (congress-state-district)
  congress              Int // 118, 119
  state                 String // 2-letter state code
  stateFips             String   @map("state_fips")
  district              String // district number or "AL" for at-large
  totalPopulation       Int?     @map("total_population")
  medianHouseholdIncome Int?     @map("median_household_income")
  medianAge             Float?   @map("median_age")
  percentBachelorPlus   Float?   @map("percent_bachelor_plus") // % with bachelor's degree+
  percentPoverty        Float?   @map("percent_poverty")
  percentVeteran        Float?   @map("percent_veteran")
  percentUninsured      Float?   @map("percent_uninsured")
  laborForceSize        Int?     @map("labor_force_size")
  unemploymentRate      Float?   @map("unemployment_rate")
  topIndustries         Json     @default("[]") @map("top_industries") // [{name, employment, percent}]
  dataYear              Int      @map("data_year") // ACS vintage year
  syncedAt              DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@index([congress, state])
  @@index([state, district])
  @@map("census_district")
}

// ─────────────────────────────────────────────────────────────────────────
// LegiStorm Legislative Districts (WS-B, LegiStorm gaps/enrichment plan).
// GLOBAL reference table, no tenant_id, no RLS — same trust tier as
// CensusDistrict. One row per (legistorm district id, status): a district
// can have BOTH a current ('C') and a future/enacted-not-yet-effective ('F')
// row at once across a redistricting cycle — WS-C's redistricting-watch
// alerting diffs the 'F' rows against the 'C' rows for the same state/chamber.
// Populated by scripts/sync-legistorm-districts.ts (full reconciliation each
// run — districts change only at redistricting, not incrementally).
// ─────────────────────────────────────────────────────────────────────────
model LegislativeDistrict {
  /// `${legistormDistrictId}-${status}`, e.g. "603-F" — mirrors CensusDistrict's composed string PK.
  id                     String    @id
  legistormDistrictId    Int       @map("legistorm_district_id")
  /// 'house' | 'senate' — lowercase, matching congress_member.chamber's convention.
  chamber                String
  state                  String    @db.VarChar(2)
  /// Bare number as a string (e.g. "1", "25"); null for a Senate seat.
  districtNo             String?   @map("district_no")
  /// 1 | 2 | 3 — which Senate election cohort; null for a House seat.
  senateClass            Int?      @map("senate_class")
  name                   String
  /// 'C' current | 'F' future (enacted, not yet effective).
  status                 String
  effectiveDate          DateTime? @map("effective_date") @db.Date
  enactedDate            DateTime? @map("enacted_date") @db.Date
  /// bioguide_id(s) of the member(s) LegiStorm reports for this district row —
  /// for a 'F' row, this is the incumbent mapped onto the FUTURE boundary
  /// (forward-looking information not derivable from congress_member, which
  /// only carries today's district assignment). Empty array for a vacant seat.
  currentMemberBioguides String[]  @default([]) @map("current_member_bioguides")
  /// Our OWN S3 object key for the re-hosted KML boundary — NEVER the raw
  /// LegiStorm URL (which embeds our API key in its path). Null until the
  /// boundary has been fetched.
  kmlS3Key               String?   @map("kml_s3_key")
  syncedAt               DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  /// District Nexus browser-safe boundary artifact metadata (Phase 1). Built
  /// once by build-district-boundary-artifacts from Census cartographic data
  /// (status 'C') or this row's own re-hosted kmlS3Key (status 'F') — never
  /// the raw vendor URL. Null until the artifact builder has processed this row.
  geoJsonS3Key         String?   @map("geojson_s3_key")
  boundaryBboxJson     Json?     @map("boundary_bbox_json")
  boundaryCentroidJson Json?     @map("boundary_centroid_json")
  /// 'census_cartographic_500k' | 'legistorm_kml'
  boundarySource       String?   @map("boundary_source")
  boundaryBuiltAt      DateTime? @map("boundary_built_at") @db.Timestamptz(6)
  boundaryHash         String?   @map("boundary_hash")

  @@index([state, chamber, status])
  @@index([legistormDistrictId])
  @@map("legislative_district")
}

// ─────────────────────────────────────────────────────────────────────────
// LegiStorm Privately Funded Travel (WS-F, LegiStorm gaps/enrichment plan).
// GLOBAL reference table, no tenant_id, no RLS — public federal disclosure
// data, same trust tier as CensusDistrict / congress_member. `id` is
// LegiStorm's own trip id (natural PK — the row IS the vendor's record 1:1).
// Populated by scripts/sync-legistorm-trips.ts via an INCREMENTAL
// updated_from/updated_to window (unlike WS-B's districts, which fetch the
// full list every run) — there is no /trips/retired-ids endpoint, so this
// is upsert-by-id ONLY, with NO deletion/reconciliation step. Applying WS-B's
// "delete anything not in this batch" pattern here would be a real bug: an
// incremental fetch never re-sees a trip from outside its date window, so
// reconciling deletions against an incremental batch would wrongly delete
// every historical trip each run.
// ─────────────────────────────────────────────────────────────────────────
model LegistormTrip {
  /// LegiStorm's own trip id.
  id                              Int       @id
  /// LegiStorm member_id of the approving member (join key into the directory snapshot's numeric ids).
  approverMemberId                Int?      @map("approver_member_id")
  approverName                    String?   @map("approver_name")
  /// Populated when the traveler was a MEMBER (mutually exclusive with travelerStaffId).
  travelerMemberId                Int?      @map("traveler_member_id")
  /// Populated when the traveler was a STAFFER (mutually exclusive with travelerMemberId).
  travelerStaffId                 Int?      @map("traveler_staff_id")
  travelerName                    String?   @map("traveler_name")
  companionName                   String?   @map("companion_name")
  companionStatus                 String?   @map("companion_status")
  startDate                       DateTime? @map("start_date") @db.Date
  endDate                         DateTime? @map("end_date") @db.Date
  durationDays                    Int?      @map("duration_days")
  purpose                         String?   @db.Text
  comment                         String?   @db.Text
  totalCost                       Float?    @map("total_cost")
  transportationExpenses          Float?    @map("transportation_expenses")
  lodgingExpenses                 Float?    @map("lodging_expenses")
  mealExpenses                    Float?    @map("meal_expenses")
  otherExpenses                   Float?    @map("other_expenses")
  companionTransportationExpenses Float?    @map("companion_transportation_expenses")
  companionLodgingExpenses        Float?    @map("companion_lodging_expenses")
  companionOtherExpenses          Float?    @map("companion_other_expenses")
  /// [{id, name, stateId}] — trip destinations; small, denormalized, matches stateLegislator.committees' own Json-array convention.
  destinations                    Json      @default("[]")
  /// [{id, name}] — the org(s) that paid for the trip.
  sponsors                        Json      @default("[]")
  filedDate                       DateTime? @map("filed_date") @db.Date
  amendedDate                     DateTime? @map("amended_date") @db.Date
  /// LegiStorm's own updated_at for this trip — distinct from syncedAt (when WE last wrote this row).
  vendorUpdatedAt                 DateTime? @map("vendor_updated_at") @db.Timestamptz(6)
  syncedAt                        DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@index([approverMemberId])
  @@index([travelerMemberId])
  @@index([travelerStaffId])
  @@map("legistorm_trip")
}

// ─────────────────────────────────────────────────────────────────────────
// Committee membership watch (WS-G, LegiStorm gaps/enrichment plan —
// optional temporal enrichment). NOT a record of vendor data — it's our OWN
// bookkeeping ledger of "who was on which committee as of the last
// emit-committee-changes.ts run", analogous to a watermark. The ingestion
// pipeline explicitly drops LegiStorm's own dated roster_snapshot history
// (directory-indexes.ts: "drops the raw LegiStorm rows and keeps only
// committee LEADERSHIP"), so there is no historical roster data to read
// directly — this table is what makes a gained/lost/role-changed diff
// possible at all. Rows are upserted for a gain/role-change and DELETED for
// a loss (this table represents current state, unlike legistorm_trip /
// legislative_district, which are historical/reference records that are
// never deleted).
// ─────────────────────────────────────────────────────────────────────────
model CommitteeMembershipWatch {
  committeeId String   @map("committee_id")
  personId    String   @map("person_id")
  personName  String?  @map("person_name")
  /// Position text as of the last run, e.g. "Chair", "Ranking Member"; null = plain member.
  role        String?
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@id([committeeId, personId])
  @@map("committee_membership_watch")
}

// ─────────────────────────────────────────────────────────────────────────
// BEA, Bureau of Economic Analysis GDP/industry data
// GLOBAL table, no tenant_id, no RLS.
// Source: apps.bea.gov/api/data/
// ─────────────────────────────────────────────────────────────────────────

model BeaData {
  id          String   @id @default(uuid())
  datasetName String   @map("dataset_name") // NIPA, Regional, Industry
  tableName   String   @map("table_name")
  lineNumber  Int?     @map("line_number")
  seriesCode  String?  @map("series_code")
  description String   @db.Text
  year        Int
  period      String // Q1-Q4, Annual
  value       Float?
  units       String? // Billions of dollars, Index, Percent
  geoFips     String?  @map("geo_fips") // state/county FIPS for regional
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@unique([datasetName, tableName, seriesCode, year, period, geoFips])
  @@index([datasetName, year])
  @@index([geoFips])
  @@map("bea_data")
}

// ─────────────────────────────────────────────────────────────────────────
// Grants.gov, Federal grant opportunities (NOFOs)
// GLOBAL table, no tenant_id, no RLS.
// Source: api.grants.gov/v1/api/search2
// ─────────────────────────────────────────────────────────────────────────

model FederalGrant {
  id                String    @id // opportunity ID from Grants.gov
  title             String    @db.Text
  agency            String // awarding agency
  subAgency         String?   @map("sub_agency")
  opportunityNumber String?   @map("opportunity_number")
  category          String? // Discretionary, Mandatory, etc.
  fundingInstrument String?   @map("funding_instrument") // Grant, Cooperative Agreement
  eligibility       String[]  @default([]) // eligible applicant types
  cfdaNumbers       String[]  @default([]) @map("cfda_numbers")
  awardCeiling      Float?    @map("award_ceiling")
  awardFloor        Float?    @map("award_floor")
  estimatedFunding  Float?    @map("estimated_funding")
  expectedAwards    Int?      @map("expected_awards")
  openDate          DateTime? @map("open_date") @db.Date
  closeDate         DateTime? @map("close_date") @db.Date
  status            String? // posted, closed, archived, forecasted
  description       String?   @db.Text
  url               String?
  syncedAt          DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  // ── District Nexus Workstream C: fields that only exist on the
  // fetchOpportunity detail payload (search2 returns just 10 fields —
  // id/number/title/agencyCode/agency/openDate/closeDate/oppStatus/docType/
  // cfdaList — verified live 2026-07-24). Written exclusively by
  // enrich-grant-details.ts; sync-grants.ts must never null these.
  eligibilityText  String?   @map("eligibility_text") @db.Text
  costSharing      Boolean?  @map("cost_sharing")
  // 'synopsis' | 'forecast' — the two payload shapes are NOT interchangeable
  // (a forecast has no responseDate/applicantEligibilityDesc; its description
  // lives in forecastDesc and its due date in estApplicationResponseDate).
  docType          String?   @map("doc_type")
  revision         Int?
  // Close-date semantics when the date alone is misleading ("continuous",
  // "TBD", explicit ET cutoffs). Never parsed into closeDate.
  responseDateDesc String?   @map("response_date_desc") @db.Text
  amendmentCount   Int?      @map("amendment_count")
  lastUpdatedAt    DateTime? @map("last_updated_at") @db.Timestamptz(6)
  raw              Json?
  detailSyncedAt   DateTime? @map("detail_synced_at") @db.Timestamptz(6)

  @@index([agency])
  @@index([closeDate])
  @@index([status])
  @@index([docType])
  // Drives enrich-grant-details.ts's candidate scan (detailSyncedAt IS NULL
  // first, then stalest-first).
  @@index([detailSyncedAt])
  // The ACTIVE-grant predicate, which constrains status AND closeDate together,
  // plus the enricher's two allocation scans which additionally constrain
  // detailSyncedAt. The read path used to filter on `status` alone and trim the
  // dates in TypeScript after a LIMIT — which, ordered by soonest deadline, spent
  // the whole cap on long-expired notices and dropped the open ones. Postgres
  // will not combine the two single-column btrees above as efficiently as this.
  @@index([status, closeDate, detailSyncedAt], map: "federal_grant_lifecycle_enrichment_idx")
  @@map("federal_grant")
}

// ─────────────────────────────────────────────────────────────────────────
// GAO, Government Accountability Office reports
// GLOBAL table, no tenant_id, no RLS.
// Source: gao.gov/api/products + RSS
// ─────────────────────────────────────────────────────────────────────────

model GaoReport {
  id              String    @id // GAO report number e.g. "GAO-24-106155"
  title           String    @db.Text
  url             String?
  publishDate     DateTime? @map("publish_date") @db.Date
  reportType      String?   @map("report_type") // Report, Testimony, Correspondence
  topics          String[]  @default([])
  agencies        String[]  @default([]) // agencies covered
  summary         String?   @db.Text
  recommendations Int? // number of recommendations
  syncedAt        DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@index([publishDate])
  @@index([reportType])
  @@map("gao_report")
}

// ─────────────────────────────────────────────────────────────────────────
// Open States, state legislature bills and legislators
// GLOBAL table, no tenant_id, no RLS.
// Source: v3.openstates.org/
// ─────────────────────────────────────────────────────────────────────────

// State Legislation Platform Phase 0 (S2 truth layer, 2026-07-10). `id` is the
// canonical DD1 natural key "<state>-<sessionKey>-<billnumber>" (e.g.
// "tx-2025-hb1234"), mirroring congress_bill's "119-hr-8800" convention — NOT
// the old openstates bill id (that lives in `openstatesId`). LegiScan is the
// bill spine (getMasterListRaw change_hash diff + getBill payload); OpenStates
// stays for people/committees only. Re-keyed via a one-time wipe-and-resync
// (migration 20260710000000_state_truth_layer) — safe because nothing has an
// inbound FK to state_bill.id (verified: intel_tracked_bill only accepts
// congress ids today; Explorer/search_state_bills reads are pass-through).
model StateBill {
  id                 String    @id // DD1 key: "<state>-<sessionKey>-<billnumber>"
  state              String // 2-letter state code
  session            String // legislative session (display name)
  sessionKey         String    @map("session_key") // DD1: LegiScan session.year_start, or "<year_start>x<session_id>" for specials
  identifier         String // e.g. "HB 1234"
  billNumber         String    @map("bill_number") // normalized "HB1234" (DD1 key component)
  title              String    @db.Text
  chamber            String? // upper, lower
  classification     String[]  @default([]) // bill, resolution, etc.
  subjects           String[]  @default([])
  description        String?   @db.Text // LegiScan description -> Explorer "abstract"
  sponsorName        String?   @map("sponsor_name")
  sponsorParty       String?   @map("sponsor_party")
  sponsorCount       Int       @default(0) @map("sponsor_count")
  // Canonical derived status (S3, deriveStateBillStatus in @capiro/shared).
  status             String?
  statusAt           DateTime? @map("status_at") @db.Timestamptz(6)
  statusSource       String?   @map("status_source") // 'derived'
  // 2026-07-10 hot-fix (S5.3 emit-windowing bug): INGESTION-time anchor for
  // when the deriver actually wrote a status change, set by
  // derive-state-bill-status.ts. statusAt is the legislative EVENT date
  // (@db.Date, midnight granularity) and must never be used to window an
  // incremental sweep against a run's startedAt timestamp — nearly every
  // transition's midnight-dated statusAt sits BEFORE the same day's later
  // emit-run startedAt, so it was silently dropped from the changes inbox.
  statusDerivedAt    DateTime? @map("status_derived_at") @db.Timestamptz(6)
  // Raw LegiScan facts the S3 deriver reads (DD8 — coded facts are the
  // derivation spine, text-regex is fallback only). status: 1 Introduced /
  // 2 Engrossed / 3 Enrolled / 4 Passed / 5 Vetoed / 6 Failed. progress[]:
  // {date, event} where event 7=Override, 8=Chaptered, 10=Report Pass,
  // 11=Report DNP (LegiScan's own progress-event codes).
  legiscanStatus     Int?      @map("legiscan_status")
  legiscanProgress   Json      @default("[]") @map("legiscan_progress")
  // B2 text-changed watermark (latest texts[].date) — metadata only, no blobs (DD7).
  textDate           DateTime? @map("text_date") @db.Timestamptz(6)
  latestActionDate   DateTime? @map("latest_action_date") @db.Date
  latestActionText   String?   @map("latest_action_text")
  url                String? // legiscan/openstates source link
  stateUrl           String?   @map("state_url") // official state_link (LegiScan)
  legiscanBillId     Int?      @unique @map("legiscan_bill_id")
  legiscanChangeHash String?   @map("legiscan_change_hash")
  openstatesId       String?   @map("openstates_id") // pre-re-key id, kept for cross-check
  syncedAt           DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  // Current committee referral (Phase 1 M2.2, PD3 substrate) — LegiScan's
  // getBill.committee is mutable bill state (which committee holds it NOW),
  // not a derivable join, so it's captured per-sync like status/latestAction.
  // Soft ref (StateCommittee.id's own "<state>-<chamber>-<slug(name)>" scheme
  // is the crosswalk — same id lands whether the committee was first seen via
  // this referral or via the OpenStates roster normalization, M2.2).
  currentCommitteeId String?   @map("current_committee_id")

  actions        StateBillAction[]
  sponsors       StateBillSponsor[]
  versions       StateBillVersion[]
  calendarEvents StateBillCalendarEvent[]
  links          StateBillLink[]          @relation("StateBillLinkFromBill")

  @@index([state, session])
  @@index([state, latestActionDate])
  @@index([state, status])
  @@index([currentCommitteeId], map: "state_bill_currentCommitteeId_idx")
  @@index([statusDerivedAt])
  @@map("state_bill")
}

model StateLegislator {
  id               String   @id // openstates person ID (kept as PK — no re-key needed)
  name             String
  state            String
  chamber          String? // upper, lower
  district         String?
  party            String?
  email            String?
  image            String?
  url              String?
  committees       Json     @default("[]") // [{name, role}]
  active           Boolean  @default(true)
  legiscanPeopleId Int?     @unique @map("legiscan_people_id")
  syncedAt         DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  committeeMemberships StateCommitteeMembership[]

  @@index([state, chamber])
  @@index([party, state])
  @@map("state_legislator")
}

// State bill action history (mirrors CongressBillAction). Append-only via
// anti-join on (billKey, date, orderKey) — firstSeenAt is never touched on
// re-drain (S1.4); this is the honest anchor the SLA telemetry (S1.6) measures.
model StateBillAction {
  id          String    @id @default(uuid()) @db.Uuid
  billKey     String    @map("bill_key")
  date        DateTime  @db.Date
  text        String    @db.Text
  chamber     String?
  importance  Int? // LegiScan's own significance bit
  orderKey    Int       @map("order_key") // stable sort within a day (LegiScan history array order)
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  bill        StateBill @relation(fields: [billKey], references: [id], onDelete: Cascade)

  @@unique([billKey, date, orderKey])
  @@index([billKey, date])
  @@index([firstSeenAt])
  @@map("state_bill_action")
}

// State bill sponsors (mirrors CongressBillCosponsor). Diff-synced — new rows
// inserted via anti-join (stamping firstSeenAt), withdrawals removed, existing
// rows never blanket-recreated (S1.4) — firstSeenAt is the only honest
// sponsor-momentum anchor since LegiScan carries no per-sponsor add-date.
model StateBillSponsor {
  id               String    @id @default(uuid()) @db.Uuid
  billKey          String    @map("bill_key")
  legiscanPeopleId Int?      @map("legiscan_people_id")
  legislatorId     String?   @map("legislator_id") // soft ref -> state_legislator.id via crosswalk
  name             String
  party            String?
  sponsorType      String    @map("sponsor_type") // 'primary' | 'cosponsor'
  sponsorOrder     Int       @map("sponsor_order")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSyncedAt     DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  bill             StateBill @relation(fields: [billKey], references: [id], onDelete: Cascade)

  @@unique([billKey, legiscanPeopleId])
  @@index([legislatorId])
  @@map("state_bill_sponsor")
}

// State roll-call votes (mirrors RollCallVote). billKey is a SOFT ref (no FK)
// — matches the federal RollCallVote.billId pattern, since a vote may
// reference a bill not yet drained.
model StateRollCallVote {
  id                 String   @id // "<state>-rc-<legiscan_roll_call_id>"
  billKey            String?  @map("bill_key")
  legiscanRollCallId Int      @unique @map("legiscan_roll_call_id")
  chamber            String?
  date               DateTime @db.Date
  motion             String?  @db.Text // LegiScan vote desc
  yeas               Int      @default(0)
  nays               Int      @default(0)
  nv                 Int      @default(0)
  absent             Int      @default(0)
  passed             Boolean?
  sourceUrl          String?  @map("source_url")
  lastSyncedAt       DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  memberVotes StateMemberVote[]

  @@index([billKey])
  @@index([date(sort: Desc)])
  @@map("state_roll_call_vote")
}

// Per-member positions on a state roll call (mirrors MemberVote). legislatorId
// is null until crosswalk-resolved (the Senate-LIS lag pattern federally).
model StateMemberVote {
  id               String            @id @default(uuid()) @db.Uuid
  voteId           String            @map("vote_id")
  legiscanPeopleId Int               @map("legiscan_people_id")
  legislatorId     String?           @map("legislator_id")
  voteCast         String            @map("vote_cast") // 'Yea' | 'Nay' | 'NV' | 'Absent'
  vote             StateRollCallVote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@unique([voteId, legiscanPeopleId])
  @@index([legislatorId])
  @@map("state_member_vote")
}

// State bill version metadata ONLY (DD7 — no text blobs in Phase 0; the
// text-changed emitter anchors on StateBill.textDate, not content).
model StateBillVersion {
  id            String    @id @default(uuid()) @db.Uuid
  billKey       String    @map("bill_key")
  legiscanDocId Int       @unique @map("legiscan_doc_id")
  versionType   String    @map("version_type") // Introduced|Amended|Engrossed|Enrolled|Chaptered|Comm Sub|...
  date          DateTime  @db.Date
  stateUrl      String?   @map("state_url")
  mime          String?
  lastSyncedAt  DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  bill          StateBill @relation(fields: [billKey], references: [id], onDelete: Cascade)

  @@index([billKey, date])
  @@map("state_bill_version")
}

// Bill<->bill relationships from LegiScan `sasts` (mirrors BillRuleLink,
// generalized). relatedBillKey is a SOFT ref — null until the target bill is
// ingested (S4 companion-moved detection tolerates this).
model StateBillLink {
  id                    String    @id @default(uuid()) @db.Uuid
  billKey               String    @map("bill_key")
  relatedBillKey        String?   @map("related_bill_key")
  legiscanRelatedBillId Int       @map("legiscan_related_bill_id")
  linkType              String    @map("link_type") // 'same_as'|'companion'|'similar'|'replaces'|'replaced_by'
  lastSyncedAt          DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  bill                  StateBill @relation("StateBillLinkFromBill", fields: [billKey], references: [id], onDelete: Cascade)

  @@unique([billKey, legiscanRelatedBillId])
  @@index([relatedBillKey])
  @@map("state_bill_link")
}

// State bill calendar events (hearing/exec session/floor). Flattened —
// LegiScan calendar[] arrives per-bill. eventKey is the S4 hearing watermark
// value; delete-and-recreate per drain (no watermark semantics on the rows
// themselves, DD7-adjacent — small sets).
model StateBillCalendarEvent {
  id           String    @id @default(uuid()) @db.Uuid
  billKey      String    @map("bill_key")
  eventType    String    @map("event_type") // hearing|executive session|floor
  date         DateTime  @db.Date
  time         String?
  location     String?
  eventKey     String    @map("event_key") // "<billKey>:<type>:<date>:<location>"
  lastSyncedAt DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  bill         StateBill @relation(fields: [billKey], references: [id], onDelete: Cascade)

  @@unique([billKey, eventKey])
  @@index([date])
  @@map("state_bill_calendar_event")
}

// LegiScan session registry — sineDie backs the dead_by_deadline status (S3);
// convene/crossover/cutoff procedural-calendar fields are added progressively
// in Phase 1 (M2), priority states first.
model StateSession {
  id                String    @id // "<state>-<legiscan_session_id>"
  state             String
  legiscanSessionId Int       @unique @map("legiscan_session_id")
  sessionKey        String    @map("session_key") // DD1 sessionKey
  name              String
  yearStart         Int       @map("year_start")
  yearEnd           Int       @map("year_end")
  special           Boolean   @default(false)
  sineDie           DateTime? @map("sine_die") @db.Date
  prior             Boolean   @default(false)
  lastSyncedAt      DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  // Procedural calendar (Phase 1 M2.1, PD5). sineDie stays LegiScan-automated;
  // these are NCSL manual curation, priority states first — a `load-state-calendars`
  // seed load, never guessed (calendarSource/calendarConfidence carry provenance so
  // the deadline emitter can tell a curated cutoff from an absent one).
  convene                   DateTime? @db.Date
  crossoverDate             DateTime? @map("crossover_date") @db.Date
  committeeCutoffDate       DateTime? @map("committee_cutoff_date") @db.Date
  secondCommitteeCutoffDate DateTime? @map("second_committee_cutoff_date") @db.Date
  calendarSource            String?   @map("calendar_source") // 'legiscan' | 'ncsl' | 'manual'
  calendarConfidence        String?   @map("calendar_confidence") // 'high' | 'curated' | 'estimated'

  @@index([state])
  @@map("state_session")
}

// Committee registry, populated from getBill.committee refs during the bill
// drain. Roster normalization (from StateLegislator.committees Json) stays
// Phase 1 per the parent plan's scoping.
model StateCommittee {
  id                  String   @id // "<state>-<chamber>-<slug(name)>"
  state               String
  chamber             String?
  name                String
  legiscanCommitteeId Int?     @unique @map("legiscan_committee_id")
  lastSyncedAt        DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  memberships StateCommitteeMembership[]

  @@map("state_committee")
}

// Committee roster (Phase 1 M2.2, PD3/PD8 substrate). Normalized out of
// StateLegislator.committees Json ([{name, role}], sync-openstates.ts) —
// role is OpenStates' raw string ('Chair' | 'Vice Chair' | 'Member' | ...),
// kept verbatim rather than coerced into the federal 'Chair'/'Ranking Member'
// vocabulary since state chambers don't share a minority-leadership title.
model StateCommitteeMembership {
  id           String   @id @default(uuid()) @db.Uuid
  committeeId  String   @map("committee_id")
  legislatorId String   @map("legislator_id")
  role         String?
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  committee  StateCommittee  @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  legislator StateLegislator @relation(fields: [legislatorId], references: [id], onDelete: Cascade)

  @@unique([committeeId, legislatorId])
  @@index([legislatorId])
  @@map("state_committee_membership")
}

// Per-(state,session) LegiScan cursor: change_hash cache for the masterlist
// diff, the bill-drain queue, and quota self-accounting (LegiScan sends no
// quota headers). Hash-cache loss is harmless — the next masterlist marks
// everything changed and the drain re-upserts idempotently.
model StateSyncCursor {
  id           String    @id // "<state>-<legiscan_session_id>"
  state        String
  sessionId    Int       @map("session_id")
  sessionKey   String    @map("session_key")
  billHashes   Json      @default("{}") @map("bill_hashes") // { "<bill_id>": "<change_hash>" }
  pendingBills Int[]     @default([]) @map("pending_bills") // drain queue of changed bill_ids
  queriesUsed  Int       @default(0) @map("queries_used") // month-to-date self-accounting
  quotaMonth   String?   @map("quota_month") // "2026-07"; reset on rollover
  lastListAt   DateTime? @map("last_list_at") @db.Timestamptz(6)
  lastDrainAt  DateTime? @map("last_drain_at") @db.Timestamptz(6)

  @@index([state])
  @@map("state_sync_cursor")
}

// State agency rulemaking (Phase 1 M3.1) — GLOBAL, no tenant_id/RLS, same
// source-table convention as state_bill/state_committee. Field set
// deliberately mirrors FederalRegisterDocument (above) so the unified
// rule-emitter (M3.3, intel-api) treats federal + state rules with one code
// path — jurisdiction distinguishes them, exactly like state_bill vs
// congress_bill. State EOs get ruleType='executive_order' (federal EOs
// already live in FederalRegisterDocument as PRESIDENTIAL_DOCUMENT — no
// separate model, matching that precedent).
model StateRule {
  id               String    @id // "<state>-<register-doc-id>"
  state            String
  agency           String
  title            String    @db.Text
  abstract         String?   @db.Text
  ruleType         String    @map("rule_type") // 'proposed' | 'emergency' | 'final' | 'notice' | 'executive_order'
  docketId         String?   @map("docket_id")
  registerCitation String?   @map("register_citation")
  publicationDate  DateTime  @map("publication_date") @db.Date
  commentStartDate DateTime? @map("comment_start_date") @db.Date
  // The deadline anchor M3.4's comment-period reuse (check-comment-periods.ts) reads.
  commentEndDate   DateTime? @map("comment_end_date") @db.Date
  effectiveDate    DateTime? @map("effective_date") @db.Date
  sourceUrl        String    @map("source_url")
  // Bill -> rule successor (deferred to P2 per the plan; column ships now so a
  // later linker doesn't need a migration).
  linkedBillKeys   String[]  @default([]) @map("linked_bill_keys")
  syncedAt         DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@index([state, publicationDate])
  @@index([commentEndDate])
  @@map("state_rule")
}

// ─────────────────────────────────────────────────────────────────────────
// CRS Reports, Congressional Research Service
// GLOBAL table, no tenant_id, no RLS.
// Source: crsreports.congress.gov (scrape index)
// ─────────────────────────────────────────────────────────────────────────

model CrsReport {
  id       String    @id // CRS report number e.g. "R47650"
  title    String    @db.Text
  date     DateTime? @db.Date
  authors  String[]  @default([])
  topics   String[]  @default([])
  summary  String?   @db.Text
  pdfUrl   String?   @map("pdf_url")
  htmlUrl  String?   @map("html_url")
  active   Boolean   @default(true) // false if report is archived/withdrawn
  syncedAt DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@index([date])
  @@map("crs_report")
}

// ─────────────────────────────────────────────────────────────────────────
// RSS News & Intelligence articles (aggregated from multiple sources)
// GLOBAL table, no tenant_id, no RLS.
// Sources: Roll Call, The Hill, Axios, Politico, agency press, think tanks
// ─────────────────────────────────────────────────────────────────────────

model IntelArticle {
  id          String   @id @default(uuid())
  source      String // "roll_call", "the_hill", "brookings", "whitehouse", etc.
  feedUrl     String?  @map("feed_url")
  title       String   @db.Text
  url         String   @unique
  author      String?
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  summary     String?  @db.Text
  categories  String[] @default([])
  agencies    String[] @default([]) // extracted agency names
  topics      String[] @default([]) // extracted topic keywords
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@index([source, publishedAt])
  @@index([publishedAt])
  @@map("intel_article")
}

/// Member press/news items ingested from each congressional member's RSS feed by
/// scripts/sync-member-press.ts (scheduled, every 3 days). GLOBAL table, no
/// tenant_id, no RLS. Powers the directory member-profile "News" tab; keyed by
/// bioguide_id (the directory member key), deduped per (bioguide_id, link).
model MemberPressItem {
  id          String    @id @default(uuid()) @db.Uuid
  bioguideId  String    @map("bioguide_id")
  title       String    @db.Text
  link        String    @db.Text
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  summary     String?   @db.Text
  source      String? // rss source tag / feed host
  syncedAt    DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@unique([bioguideId, link], map: "member_press_item_bioguide_link_key")
  @@index([bioguideId, publishedAt(sort: Desc)], map: "member_press_item_bioguide_published_idx")
  @@map("member_press_item")
}

// ─────────────────────────────────────────────────────────────────────────
// Congressional Committee Activity (hearings, markups)
// GLOBAL table, no tenant_id, no RLS.
// Source: congress.gov API + committee RSS feeds
// ─────────────────────────────────────────────────────────────────────────

model CommitteeHearing {
  id            String    @id @default(uuid())
  chamber       String // House, Senate, Joint
  committeeName String    @map("committee_name")
  committeeCode String?   @map("committee_code")
  title         String    @db.Text
  /// Eastern calendar day (DISPLAY only). Derived from startsAt, not authoritative.
  date          DateTime  @db.Date
  /// Eastern wall-clock for display, e.g. "10:00 AM". Zone-less by construction —
  /// never parse this back into an instant; read startsAt instead.
  time          String?
  /// The true UTC instant the hearing begins; null for a date-only record (one
  /// announced without a time — never a fabricated midnight). This is the ONLY
  /// field that time-based logic (liveness, windowing, cross-day ordering) may read.
  startsAt      DateTime? @map("starts_at") @db.Timestamptz(6)
  location      String?
  type          String? // hearing, markup, meeting
  witnesses     String[]  @default([])
  url           String?
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@index([date])
  @@index([committeeName, date])
  @@index([startsAt])
  @@map("committee_hearing")
}

// Hearing → bill agenda link (LegiWatch B3). GLOBAL public-record table, no
// tenant_id / no RLS — same posture as committee_hearing. sync-hearings reads
// the committee-meeting detail's `relatedItems.bills[]` (already fetched, was
// dropped) and writes one row per (hearing, bill) on the agenda. billId is a
// SOFT ref to congress_bill.id ("119-hr-8800") — a meeting can list a bill we
// don't track. intel-api's detector joins tracked bills × upcoming hearings
// here to fire the `bill_hearing_scheduled` alert.
model CommitteeHearingBill {
  id        String   @id @default(uuid())
  hearingId String   @map("hearing_id") // → committee_hearing.id
  billId    String   @map("bill_id") // soft ref → congress_bill.id
  congress  Int
  syncedAt  DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@unique([hearingId, billId])
  @@index([billId])
  @@map("committee_hearing_bill")
}

// ─────────────────────────────────────────────────────────────────────────
// OfficialHearingTranscript — Track B (H2): the OFFICIAL published hearing
// transcript TEXT, ingested from GovInfo's Congressional Hearings (CHRG)
// collection (txtLink = plain text). Distinct from the machine (Deepgram) live
// transcript in intel-api. GLOBAL public-record table, no tenant_id / no RLS —
// same posture as committee_hearing. `hearingId` soft-links to a committee_hearing
// row when correlated (nullable — official transcripts often predate/aren't
// matched to a scheduled-meeting row). Scoped to 2026 by the ingestion sync.
model OfficialHearingTranscript {
  id            String    @id // GovInfo packageId, e.g. "CHRG-119hhrg58001"
  hearingId     String?   @map("hearing_id") // soft ref to committee_hearing.id
  source        String    @default("govinfo") // 'govinfo' | 'congress'
  congress      Int
  chamber       String
  committeeName String?   @map("committee_name")
  title         String    @db.Text
  date          DateTime  @db.Date
  sourceUrl     String    @map("source_url") // the GovInfo package/txt link
  format        String    @default("txt") // 'txt' | 'htm' | 'pdf'
  text          String    @db.Text // extracted plain-text transcript
  charCount     Int       @map("char_count")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  fetchedAt     DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@index([hearingId])
  @@index([congress, chamber, date])
  @@index([date])
  @@map("official_hearing_transcript")
}

// ─────────────────────────────────────────────────────────────────────────
// SyncRun, observability for sync scripts
// GLOBAL table, no tenant_id, no RLS. One row per sync execution.
// ─────────────────────────────────────────────────────────────────────────

model SyncRun {
  id           String    @id @default(uuid()) @db.Uuid
  source       String
  startedAt    DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  rowsInserted Int       @default(0) @map("rows_inserted")
  rowsUpdated  Int       @default(0) @map("rows_updated")
  errorCount   Int       @default(0) @map("error_count")
  status       String    @default("running")
  errorMessage String?   @map("error_message")

  @@index([source, startedAt(sort: Desc)], map: "sync_run_source_started_at_idx")
  @@map("sync_run")
}

/// Global 24h response cache for GovInfo (api.data.gov) JSON API calls. Keyed by
/// the request URL (api_key stripped). Global table — no tenant_id, no RLS.
model GovInfoCache {
  id        String   @id @default(uuid()) @db.Uuid
  url       String   @unique
  response  Json     @map("response_jsonb")
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@index([fetchedAt], map: "govinfo_cache_fetched_at_idx")
  @@map("govinfo_cache")
}

/// Child procurement line items under a parent Program Element (P-Doc / Procurement
/// budget books). A parent PE (e.g. 0204134N F/A-18 Series) has FY totals on
/// program_element_year; its sub-line breakouts (kit codes, sub-quantities) live
/// here. Global table — no tenant_id, no RLS. Idempotent dedup on
/// (pe_code, line_description, fy).
model ProgramElementProcurementLine {
  id              String   @id @default(uuid()) @db.Uuid
  peCode          String   @map("pe_code") @db.VarChar(16)
  lineDescription String   @map("line_description")
  fy              Int
  quantity        Decimal? @db.Decimal(14, 2)
  dollars         Decimal? @db.Decimal(18, 2)
  unitCost        Decimal? @map("unit_cost") @db.Decimal(18, 2)
  source          String?
  sourceUrl       String?  @map("source_url")
  raw             Json     @default("{}") @map("raw_jsonb")
  lastSyncedAt    DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([peCode, lineDescription, fy], map: "pe_procurement_line_dedup_key")
  @@index([peCode], map: "pe_procurement_line_pe_code_idx")
  @@index([fy], map: "pe_procurement_line_fy_idx")
  @@map("program_element_procurement_line")
}

/// Federal contract/assistance awards from USAspending.gov, enriched with PE
/// attribution. Global table (no tenant_id, no RLS). pe_code is nullable — an
/// award with no resolvable PE keeps pe_code NULL (NOT quarantined). The Step 6
/// /contractors endpoint reads contractor_name + amount + awarded_at + pe_code.
model FederalAward {
  id                             String    @id @default(uuid()) @db.Uuid
  // USAspending generated_unique_award_id — stable idempotency key.
  awardUniqueId                  String    @unique @map("award_unique_id")
  piid                           String?
  fain                           String?
  awardingAgency                 String?   @map("awarding_agency")
  awardingSubTier                String?   @map("awarding_sub_tier")
  contractorName                 String?   @map("contractor_name")
  recipientUei                   String?   @map("recipient_uei")
  amount                         Decimal?  @db.Decimal(18, 2)
  description                    String?   @db.Text
  peCode                         String?   @map("pe_code") @db.VarChar(16)
  // How pe_code was resolved, for provenance/auditing and honest UI labeling.
  // Null when pe_code is null. Values: 'description_regex' (legacy text match),
  // 'dod_acquisition_program' (linked via the contract's DoD acquisition / MDAP
  // code through the reviewed program_element_acquisition_program map). Lets the
  // contractor panel state HOW a contractor was tied to a PE rather than implying
  // a precision the source does not have.
  peCodeSource                   String?   @map("pe_code_source")
  // ── USAspending File C (financial_accounts_by_awards) funding crosswalk ──────────
  // Populated by enrich-award-pe-tas from /api/v2/awards/funding/. The Treasury
  // Account Symbol + Program Activity are the federal mechanism that ties an award
  // to the appropriation account / program activity it was funded from. We store the
  // dominant (largest-obligation) TAS+PA for display + the PE crosswalk. PE attribution
  // from TAS+PA is intentionally LOWER precision than the R-3 named-prime link (one
  // account/PA funds many PEs), so peCodeConfidence + peCodeCandidateCount make the
  // ambiguity explicit and the UI never implies a false 1:1.
  fundingTas                     String?   @map("funding_tas") // e.g. '057-3600' (federal_account) or full TAS label
  fundingTasTitle                String?   @map("funding_tas_title") // e.g. 'RDT&E, Air Force'
  programActivityCode            String?   @map("program_activity_code") // e.g. '0001'
  programActivityName            String?   @map("program_activity_name") // e.g. 'BASIC RESEARCH'
  fundingFy                      Int?      @map("funding_fy") // reporting fiscal year of the dominant File C row
  // 0..1 confidence of the pe_code attribution. 1.0 only when UEI-confirmed against an
  // R-3 named prime; ~0.5 when account+PA+FY resolve to a single PE; lower when ambiguous.
  peCodeConfidence               Float?    @map("pe_code_confidence")
  // How many distinct PEs the award's (account + program activity + FY) could map to.
  // 1 = unambiguous; >1 = the UI shows "funded via <account> (N programs)" not a single PE.
  peCodeCandidateCount           Int?      @map("pe_code_candidate_count")
  // When peCodeSource='uei_confirmed_r3_prime', the matched performer row id (audit trail).
  matchedPerformerId             String?   @map("matched_performer_id") @db.Uuid
  // DoD Major Defense Acquisition Program (MDAP) attribution straight off the
  // contract record (USAspending latest_transaction_contract_data). Always present
  // on contracts; '000'/'NONE' for services & non-program awards. This is the
  // zero-inference link between a contractor and a weapons program — e.g.
  // '198'/'F-35', '516'/'SSN 774'. PE attribution is derived from these via the
  // program_element_acquisition_program map, NOT fabricated.
  dodAcqProgramCode              String?   @map("dod_acq_program_code")
  dodAcqProgramName              String?   @map("dod_acq_program_name")
  // Place of performance (where the work happens) — primary signal for district
  // nexus. Recipient location (where the company is HQ'd) kept as a fallback.
  // Two-letter state + congressional-district number as text ('02', 'AL'); null
  // when USAspending omits it. Populated by sync-federal-award location fields.
  popState                       String?   @map("pop_state")
  popCongressionalDistrict       String?   @map("pop_congressional_district")
  recipientState                 String?   @map("recipient_state")
  recipientCongressionalDistrict String?   @map("recipient_congressional_district")
  actionDate                     DateTime? @map("action_date") @db.Date
  awardedAt                      DateTime? @map("awarded_at") @db.Timestamptz(6)
  raw                            Json      @default("{}") @map("raw_jsonb")
  lastSyncedAt                   DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@index([peCode], map: "federal_award_pe_code_idx")
  @@index([contractorName], map: "federal_award_contractor_name_idx")
  @@index([popState, popCongressionalDistrict], map: "federal_award_pop_district_idx")
  @@index([awardedAt], map: "federal_award_awarded_at_idx")
  @@index([actionDate], map: "federal_award_action_date_idx")
  @@index([dodAcqProgramCode], map: "federal_award_dod_acq_program_idx")
  @@map("federal_award")
}

// ─────────────────────────────────────────────────────────────────────────
// District Nexus + Grants (Phase 1). Deliberately kept out of FederalAward:
// contracts and financial assistance are different data products (amounts,
// identity keys, and geography semantics all differ) and must never be
// merged in storage. GLOBAL table, no tenant_id, no RLS — mirrors FederalAward.
// Source: USAspending spending_by_award, award_type_codes 02/03/04/05.
// ─────────────────────────────────────────────────────────────────────────

model FederalAssistanceAward {
  id             String  @id @default(uuid()) @db.Uuid
  // USAspending generated_internal_id — stable idempotency key (same field
  // sync-federal-award.ts keys contracts on; assistance and contract awards
  // never collide because USAspending prefixes them ASST_* vs CONT_*).
  awardUniqueId  String  @unique @map("award_unique_id")
  // For assistance awards, USAspending's "Award ID" field IS the FAIN (or a
  // block/formula grant's aggregate identifier) — never the contract PIID.
  fain           String?
  uri            String?
  // Deterministic normalization of the "Award Type" label USAspending returns
  // (e.g. "BLOCK GRANT (A)") back to its filed award_type_code (02/03/04/05),
  // via the documented type enumeration — never inferred/guessed per-record.
  awardTypeCode  String? @map("award_type_code")
  awardTypeLabel String? @map("award_type_label")

  recipientName       String? @map("recipient_name")
  recipientUei        String? @map("recipient_uei")
  parentRecipientName String? @map("parent_recipient_name")
  parentRecipientUei  String? @map("parent_recipient_uei")

  // Raw "Assistance Listings" array as returned: [{cfda_number, cfda_program_title}].
  assistanceListings       Json?   @map("assistance_listings")
  // Primary ALN denormalized from the top-level "CFDA Number" field, for filters.
  assistanceListingNumber  String? @map("assistance_listing_number")
  assistanceListingTitle   String? @map("assistance_listing_title")
  fundingOpportunityNumber String? @map("funding_opportunity_number")
  saiNumber                String? @map("sai_number")

  awardingAgency  String? @map("awarding_agency")
  awardingSubTier String? @map("awarding_sub_tier")
  fundingAgency   String? @map("funding_agency")
  fundingSubTier  String? @map("funding_sub_tier")

  totalObligatedAmount    Decimal? @map("total_obligated_amount") @db.Decimal(18, 2)
  totalOutlayedAmount     Decimal? @map("total_outlayed_amount") @db.Decimal(18, 2)
  // Not yet available from any verified source field — column reserved for a
  // future enrichment pass (matching contribution beyond the federal share).
  nonFederalFundingAmount Decimal? @map("non_federal_funding_amount") @db.Decimal(18, 2)

  description      String?   @db.Text
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  lastModifiedDate DateTime? @map("last_modified_date") @db.Timestamptz(6)

  popState                    String? @map("pop_state")
  // Raw code exactly as USAspending returns it (incl. sentinels "00"/"90"/"98"/"ZZ").
  popCongressionalDistrictRaw String? @map("pop_congressional_district_raw")
  popCongressionalDistrict    String? @map("pop_congressional_district")
  // 'original' (as-reported, what the search endpoint returns) | 'current'
  // (only ever set if a future enrichment pass sources district_current).
  popCdVintage                String? @map("pop_cd_vintage")
  popCity                     String? @map("pop_city")
  popZip                      String? @map("pop_zip")
  popCountry                  String? @map("pop_country")

  recipientState                    String? @map("recipient_state")
  recipientCongressionalDistrictRaw String? @map("recipient_congressional_district_raw")
  recipientCongressionalDistrict    String? @map("recipient_congressional_district")
  recipientCity                     String? @map("recipient_city")
  recipientZip                      String? @map("recipient_zip")

  // From the per-award detail enrichment pass (enrich-assistance-award-details).
  subawardCount    Int?      @map("subaward_count")
  detailEnrichedAt DateTime? @map("detail_enriched_at") @db.Timestamptz(6)

  // The VENDOR payload verbatim (fixes a known FederalAward defect, which
  // stores its own mapped object instead of the source response).
  raw          Json     @default("{}") @map("raw_jsonb")
  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([recipientUei], map: "faa_recipient_uei_idx")
  @@index([popState, popCongressionalDistrict], map: "faa_pop_district_idx")
  @@index([recipientState, recipientCongressionalDistrict], map: "faa_recipient_district_idx")
  @@index([assistanceListingNumber], map: "faa_aln_idx")
  @@index([awardingAgency], map: "faa_awarding_agency_idx")
  @@index([endDate], map: "faa_end_date_idx")
  @@map("federal_assistance_award")
}

/// Verified client roles in federal assistance that public award data cannot
/// safely infer on its own (subrecipient, project-site, partner, etc.).
/// Tenant-scoped + RLS-isolated per the review_request template. Never a copy
/// of public award/opportunity data — those stay in their global tables and
/// are joined at read time by assistanceAwardId / grantOpportunityId.
model ClientGrantNexus {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  // FK-less pointer into the global federal_assistance_award table (upsert-only,
  // no tenant scoping — a hard FK would force cascade semantics onto a table
  // that's never deleted from). Joined at read time, not enforced by the DB.
  assistanceAwardId  String? @map("assistance_award_id") @db.Uuid
  // FederalGrant.id (Grants.gov opportunity id) — same rationale, no FK.
  grantOpportunityId String? @map("grant_opportunity_id")
  facilityId         String? @map("facility_id") @db.Uuid

  /// direct_recipient | subrecipient | project_site | research_partner |
  /// coalition_partner | beneficiary | matching_contributor | opportunity_candidate
  relationshipType        String   @map("relationship_type")
  relationshipDescription String?  @map("relationship_description") @db.Text
  attributableAmount      Decimal? @map("attributable_amount") @db.Decimal(18, 2)
  beneficiaryCount        Int?     @map("beneficiary_count")

  evidenceSourceType  String    @map("evidence_source_type")
  evidenceSourceRef   String?   @map("evidence_source_ref")
  confidence          Float     @default(1)
  verificationStatus  String    @default("unverified") @map("verification_status")
  externalUseApproved Boolean   @default(false) @map("external_use_approved")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId    String?   @map("verified_by_user_id") @db.Uuid

  effectiveStart DateTime? @map("effective_start") @db.Date
  effectiveEnd   DateTime? @map("effective_end") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // B3: prevents a concurrent double-run of generate-grant-opportunity-candidates.ts
  // from creating duplicate rows for the same (tenant, client, opportunity,
  // relationship) under the SAME evidence source. evidenceSourceType is part of
  // the key deliberately — a producer row (deterministic_relevance_v1) and a
  // human-entered row (e.g. analyst_manual_entry) for the same pair are meant
  // to coexist (see generate-grant-opportunity-candidates.spec.ts's "a
  // human-created row for the same pair is never read or touched").
  @@unique([tenantId, clientId, grantOpportunityId, relationshipType, evidenceSourceType], map: "client_grant_nexus_producer_unique_idx")
  @@index([tenantId, clientId], map: "client_grant_nexus_tenant_client_idx")
  @@index([tenantId, assistanceAwardId], map: "client_grant_nexus_tenant_award_idx")
  @@index([tenantId, grantOpportunityId], map: "client_grant_nexus_tenant_opp_idx")
  @@map("client_grant_nexus")
}

/// Funding Opportunities — a client's durable WORKFLOW relationship to ONE future
/// funding opportunity: either a Grants.gov NOFO (`federal_grant`) or a SAM.gov
/// contract notice (`sam_opportunity`). TENANT-scoped, RLS FORCE-enabled.
///
/// ── Why this is not ClientGrantNexus ────────────────────────────────────────
/// ClientGrantNexus answers "does this client have a defensible geographic NEXUS
/// through federal assistance money" — it is EVIDENCE, and its
/// 'opportunity_candidate' relationshipType was a narrow bolt-on so the District
/// Nexus opportunity pipeline had something to read. This model answers a
/// different question: "what is our team DOING about this opportunity". A pursuit
/// decision is not geographic evidence. Folding the two would let saving an
/// opportunity start contributing to a district nexus score, which is exactly the
/// false claim the District Nexus rules forbid — a future opportunity never
/// creates district context by itself. They stay separate tables on purpose, and
/// nothing in the District Nexus aggregate reads this one.
///
/// Exactly ONE source record is referenced; `source` says which, and a CHECK
/// constraint in the migration enforces the exclusivity rather than trusting the
/// writer. No FK to either source table: `federal_grant` and `sam_opportunity`
/// are GLOBAL upsert-only catalogs, and a hard FK would force cascade semantics
/// onto tables nothing ever deletes from (same rationale as
/// ClientGrantNexus.grantOpportunityId / .assistanceAwardId).
model ClientFundingOpportunity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  /// 'grants_gov' | 'sam_gov'.
  source             String  @db.VarChar(16)
  /// FederalGrant.id (a Grants.gov opportunity id) — set iff source='grants_gov'.
  grantOpportunityId String? @map("grant_opportunity_id")
  /// SamOpportunity.id (uuid) — set iff source='sam_gov'.
  samOpportunityId   String? @map("sam_opportunity_id") @db.Uuid

  /// GENERIC source identity (P13), alongside — never instead of — the two legacy
  /// pointers above.
  ///
  /// The pair of nullable pointer columns works for exactly two sources. Agency
  /// forecasts, DIBBS and SBIR/STTR each want this same durable decision record,
  /// and a third column per source means a wider CHECK, another partial unique
  /// index and another branch in every writer, forever.
  ///
  /// `sourceRecordType` is the SHAPE of the thing pointed at
  /// ('grants_gov_opportunity' | 'sam_notice' | 'tango_procurement_forecast' | …),
  /// which is a different question from `source` (the product rail) and will stop
  /// being 1:1 with it once Tango supplies three record types under three rails.
  ///
  /// NULLABLE for both legacy sources, and that is load-bearing rather than lax:
  /// pre-P13 code writing during a rolling deploy sets neither, so a NOT NULL
  /// would make the older API a hard failure the moment the migration lands.
  /// The migration backfills every existing row; the update path backfills the
  /// rolling-deploy tail; reads fall back to the legacy pointer either way.
  /// A FUTURE source, by contrast, MUST carry both and no legacy pointer — see
  /// client_funding_opportunity_one_source_chk in the P13 migration.
  sourceRecordType   String? @map("source_record_type") @db.VarChar(48)
  sourceRecordKey    String? @map("source_record_key") @db.Text

  /// 'suggested' | 'saved' | 'pursuing' | 'dismissed' | 'won' | 'lost' | 'expired'.
  /// CHECK-constrained in the migration.
  workflowStatus String  @default("suggested") @map("workflow_status") @db.VarChar(16)
  /// Assigned owner — `users.id`. Always same-tenant; the service verifies
  /// membership before writing, because a uuid in a request body proves nothing.
  ownerUserId    String? @map("owner_user_id") @db.Uuid
  /// Explicit, reviewable project site (`client_facilities.id`). The ONLY path
  /// from an opportunity to a congressional district — never inferred from the
  /// notice, which publishes applicant eligibility (grants) or a place of
  /// performance that may be nowhere near the client (SAM).
  facilityId     String? @map("facility_id") @db.Uuid
  notes          String? @db.Text

  /// Deterministic snapshot from when this row was last scored. A SNAPSHOT, not
  /// the live answer: the read path recomputes relevance on every request, so
  /// these exist for producer bookkeeping, alert diffing and audit ("what did we
  /// think when we suggested this"), never as the number rendered to a user.
  relevanceScore    Int?    @map("relevance_score")
  matchSignals      Json    @default("[]") @map("match_signals_jsonb")
  eligibilityState  String? @map("eligibility_state") @db.VarChar(16)
  eligibilityReason String? @map("eligibility_reason") @db.Text

  /// How the row came to exist: 'deterministic_relevance_v1' (producer) or
  /// 'user_action' (a human saved/pursued it). Mirrors
  /// ClientGrantNexus.evidenceSourceType, and is what lets the producer tell its
  /// own rows apart from a human's.
  evidenceSourceType       String    @map("evidence_source_type") @db.VarChar(48)
  /// TRUE when a human created this row. The producer must never overwrite one.
  userCreated              Boolean   @default(false) @map("user_created")
  /// Stamped when the producer decides a suggestion IT created no longer clears
  /// the relevance floor. Never applied to a row a human has acted on — a
  /// dismissal or a pursuit is a decision, not a stale guess.
  staleAt                  DateTime? @map("stale_at") @db.Timestamptz(6)
  /// Source lifecycle snapshots used by the deterministic alert/expiry pass.
  sourceStatusSnapshot     String?   @map("source_status_snapshot") @db.VarChar(64)
  responseDeadlineSnapshot DateTime? @map("response_deadline_snapshot") @db.Timestamptz(6)
  sourceUpdatedAtSnapshot  DateTime? @map("source_updated_at_snapshot") @db.Timestamptz(6)
  /// Hash of the SOURCE-PUBLISHED content at the last observation, from
  /// `source-lifecycle.ts`. Answers "was this amended" WITHOUT consulting any
  /// local clock: `sam_opportunity.updatedAt` is a Prisma @updatedAt column and
  /// `federal_grant.detailSyncedAt`/`syncedAt` move whenever a job visits the
  /// row, so keying amendment alerts on them alerted on our own syncs. NULL =
  /// no baseline yet, which the processor establishes SILENTLY.
  sourceFingerprint        String?   @map("source_fingerprint")
  /// Whether the SOURCE considered this live at the last observation. Stored
  /// rather than reconstructed from `sourceStatusSnapshot`: a legacy row with no
  /// snapshot reconstructed to "active", so an already-closed opportunity fired
  /// a spurious closure alert the first time it was seen, and a status string
  /// cannot express the date half of the lifecycle at all.
  sourceActiveSnapshot     Boolean?  @map("source_active_snapshot")
  alertState               Json      @default("{}") @map("alert_state_jsonb")

  /// The team's DECISION, kept separate from `workflowStatus` (where a pursuit is)
  /// and from the machine recommendation (which is recomputed on read, never
  /// stored). A team can decide to monitor something with no pursuit, or to pass on
  /// something whose source is still wide open — folding those into workflowStatus
  /// makes "we chose not to bid" indistinguishable from "the source closed", and
  /// only one of those is a decision somebody can be asked about later.
  /// NULL means nobody has decided yet, correct for every producer-created row.
  /// CHECK-constrained to pursue|monitor|pass (migration 20260819010000), and the
  /// same migration CHECKs that a decision always carries its actor and timestamp.
  humanDecision    String?   @map("human_decision") @db.VarChar(16)
  decisionReason   String?   @map("decision_reason") @db.Text
  decisionAt       DateTime? @map("decision_at") @db.Timestamptz(6)
  decisionByUserId String?   @map("decision_by_user_id") @db.Uuid
  /// What happens next, and by when. A due date with no action is a reminder about
  /// nothing, so the migration CHECKs that direction; an action with no due date is
  /// fine.
  nextAction       String?   @map("next_action") @db.Text
  nextActionDueAt  DateTime? @map("next_action_due_at") @db.Timestamptz(6)

  dismissedReason String? @map("dismissed_reason") @db.Text
  /// Free-text won/lost context. Only ever set by an explicit user action.
  outcomeNote     String? @map("outcome_note") @db.Text

  /// The pursuit pipeline stage (P35): reviewing | qualified | pursuing |
  /// submitted | won | lost | passed. CHECK-constrained in migration
  /// 20260901010000.
  ///
  /// A SECOND field beside `workflowStatus`, never a replacement. That column
  /// carries two values that are not capture stages at all — `suggested` is the
  /// producer's own output and `expired` is a mechanical consequence of the
  /// source closing — and it has no room for `qualified` or `submitted`.
  ///
  /// NULLABLE, and the NULL is load-bearing twice over. During a rolling deploy
  /// an older pod INSERTs without it and must succeed. And a producer-created
  /// `suggested` row genuinely HAS no stage: mapping it to `reviewing` would put
  /// the producer's whole backlog on a board column named for a human activity
  /// nobody is performing. `expired` is unstaged for the same reason in reverse —
  /// which stage a row was in when the source closed is not recorded, and picking
  /// one fabricates a capture history.
  ///
  /// Reads reconcile this with `workflowStatus` in exactly one place
  /// (`effectiveStage` in funding-opportunity-pipeline.ts): the legacy status wins
  /// for anything it can express, and this column only adds resolution the legacy
  /// one cannot.
  pipelineStage         String?   @map("pipeline_stage") @db.VarChar(16)
  /// Optimistic-concurrency token. The transition service puts this in the WHERE,
  /// so two simultaneous drags cannot both succeed — the loser updates 0 rows and
  /// gets a conflict rather than silently discarding the other person's decision.
  /// NOT NULL DEFAULT 0 so an older pod's INSERT still produces a usable token.
  pipelineStageVersion  Int       @default(0) @map("pipeline_stage_version")
  pipelineStageAt       DateTime? @map("pipeline_stage_at") @db.Timestamptz(6)
  /// Who moved it. NULL on a non-NULL stage is MEANINGFUL, not missing: it means
  /// the migration inferred the stage from the legacy status, so the read reports
  /// the basis as derived rather than claiming a person moved it.
  pipelineStageByUserId String?   @map("pipeline_stage_by_user_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  stageTransitions FundingOpportunityStageTransition[]

  // ONE workflow row per (tenant, client, source opportunity) — a saved
  // opportunity that the producer re-scores must update in place, not accumulate
  // a second row whose status disagrees with the first.
  //
  // Enforced by two PARTIAL unique indexes in the migration
  // (…WHERE grant_opportunity_id IS NOT NULL / …WHERE sam_opportunity_id IS NOT
  // NULL), which Prisma cannot express: Postgres treats NULLs as distinct, so a
  // plain @@unique across the nullable pair would admit unlimited duplicates for
  // the other source. Nothing in this file may use `upsert` against those keys
  // for the same reason — the writers do find-then-create-or-update, matching
  // SamOpportunityMatch and generate-grant-opportunity-candidates.ts.
  @@index([tenantId, clientId, workflowStatus], map: "client_funding_opportunity_tenant_client_status_idx")
  @@index([tenantId, clientId, pipelineStage], map: "client_funding_opportunity_pipeline_stage_idx")
  @@index([tenantId, grantOpportunityId], map: "client_funding_opportunity_tenant_grant_idx")
  @@index([tenantId, samOpportunityId], map: "client_funding_opportunity_tenant_sam_idx")
  @@index([tenantId, ownerUserId], map: "client_funding_opportunity_tenant_owner_idx")
  @@index([tenantId, workflowStatus, responseDeadlineSnapshot], map: "client_funding_opportunity_lifecycle_idx")
  // Keyset cursor for the lifecycle processor. It used to read one capped
  // `take: 5000` window per tenant and report the cap as an ERROR COUNT, so
  // beyond 5,000 tracked rows the pass was silently partial — rows after the cap
  // were never expired and never alerted. It now walks `id > cursor ORDER BY id`.
  @@index([tenantId, id], map: "client_funding_opportunity_tenant_cursor_idx")
  // Partial on human_decision: only decided rows are indexed, which is a small
  // fraction of a table that is overwhelmingly machine suggestions. Read by the
  // P10 triage inbox as "decided rows for this tenant, soonest action first".
  @@index([tenantId, humanDecision, nextActionDueAt], map: "client_funding_opportunity_decision_idx")
  // The GENERIC identity index (P13). Also a PARTIAL unique index — created only
  // in the migration, for the same reason as the two legacy ones: Prisma cannot
  // express `WHERE source_record_key IS NOT NULL`, and without the predicate every
  // row that has not been backfilled yet would collide on NULL.
  //   client_funding_opportunity_generic_uniq
  //     UNIQUE (tenant_id, client_id, source, source_record_key)
  //     WHERE source_record_key IS NOT NULL
  @@index([tenantId, sourceRecordType, sourceRecordKey], map: "client_funding_opportunity_source_record_idx")
  @@map("client_funding_opportunity")
}

// ═══════════════════════════════════════════════════════════════════════════
// MakeGov/Tango provider substrate (P15).
//
// Every model below is GLOBAL — no `tenantId` field, no RLS, same category as
// `FederalGrant` / `SamOpportunity` / `FederalContractor` above. That is
// deliberate, not an oversight: a Tango observation of an entity, opportunity,
// forecast or vehicle is a fact about the FEDERAL MARKETPLACE, not about any one
// tenant, exactly like the existing global reference tables it sits beside.
// `PrismaService.tenantScopedModels` is derived from the schema by scanning for a
// `tenantId` field, so omitting it here is what keeps
// `tenant-scope-guard.spec.ts` correctly silent on plain
// `this.prisma.tangoResourceSnapshot.*` calls — no `withTenant`/`withSystem`
// wrapping, no `// tenant-scope-exempt:` comment, because there is no tenant
// dimension to exempt.
//
// No tenant API exposes a raw row from any of these tables. Everything a tenant
// sees is either (a) a REVIEWED, promoted fact written into tenant-owned storage
// by a later phase (P19's entity profile, P20's enrichment acceptance), or (b) a
// derived read the service layer shapes — never `SELECT *` surfaced verbatim.
// ═══════════════════════════════════════════════════════════════════════════

/// One OBSERVATION of a Tango resource, at a point in time.
///
/// APPEND-ONLY AND IMMUTABLE once written: `contentSha256`, `normalizedJsonb`,
/// `sourceUpdatedAt` and `providerFetchedAt` on a given row never change after
/// INSERT. The only fields that ever transition are `active` (true → false,
/// exactly once, when a NEWER observation supersedes this one) and
/// `supersededAt`. That is the "versioned head" the plan's acceptance criterion
/// asks for: `(resourceType, externalId)` has at most one row with `active =
/// true` at any moment — its current head — and every prior observation stays in
/// the table, unmodified, as history.
///
/// DUPLICATE SUPPRESSION: `TangoStoreService.writeSnapshot` computes a canonical
/// SHA-256 over the normalized payload (stable key ordering, so field-order
/// noise from the provider never produces a spurious "change") and looks it up
/// against `(resourceType, externalId, contentSha256)` BEFORE writing anything.
/// An exact repeat is a true no-op — no row touched, no timestamp bumped — which
/// is what makes a nightly re-sync of unchanged data free of write amplification.
model TangoResourceSnapshot {
  id       String @id @default(uuid()) @db.Uuid
  /// 'entity' | 'opportunity' | 'notice' | 'forecast' | 'vehicle' |
  /// 'vehicle_awardee'. Mirrors TANGO_RESOURCE_TYPES in
  /// apps/api/src/external/tango/tango.types.ts (P14) — CHECK-constrained in the
  /// migration to that exact vocabulary, not re-derived from it, since a schema
  /// file cannot import a TypeScript const array.
  resourceType String @map("resource_type") @db.VarChar(32)
  /// The provider's own identifier for this record (a UEI, an opportunity id, a
  /// forecast id, a vehicle uuid, …). Together with `resourceType` this is the
  /// NATURAL KEY the plan asks for — deterministic, and never Capiro-assigned.
  externalId String @map("external_id") @db.Text

  /// Which version of Capiro's OWN mapping (apps/api/src/external/tango/
  /// tango.mappers.ts) produced `normalizedJsonb`. Lets a later phase identify
  /// "this observation was normalized by an older mapper" and re-fetch, even when
  /// the provider's raw content has not changed — a mapper bug fix is not a
  /// provider content change, and conflating the two would hide the fix from
  /// every already-synced row.
  schemaVersion Int @default(1) @map("schema_version")

  /// The provider's own last-modified stamp for this record, when it supplies
  /// one. NULL is a fact some resources carry honestly — P14's TangoForecast, for
  /// instance, has no modified stamp at all — never backfilled with `fetchedAt`.
  sourceUpdatedAt DateTime? @map("source_updated_at") @db.Timestamptz(6)
  /// When CAPIRO fetched this observation. Always set; this is "when we looked",
  /// distinct from `sourceUpdatedAt`'s "when the source says it changed".
  providerFetchedAt DateTime @map("provider_fetched_at") @db.Timestamptz(6)
  /// The provider's own URL for this record, when one exists (an opportunity's
  /// `sam_url`, for example). NULL for resource types the provider gives no
  /// direct link for — an entity has none.
  sourceUrl String? @map("source_url") @db.Text

  /// Lower-case hex SHA-256 (64 chars), over a CANONICALIZED serialization of
  /// `normalizedJsonb` (recursively sorted object keys, so key-order noise from
  /// the provider can never look like a content change). CHECK-constrained to the
  /// hex-64 shape in the migration.
  contentSha256 String @map("content_sha256") @db.VarChar(64)
  /// The NORMALIZED domain object (TangoEntity, TangoOpportunity, …) as produced
  /// by tango.mappers.ts — never the provider's raw response. This is what makes
  /// "no raw payload reaches a tenant API" true by construction rather than by
  /// convention: nothing in this column ever held an un-mapped field, because the
  /// mapper's allow-list already dropped it before this row was built.
  normalizedJsonb Json @map("normalized_jsonb")

  /// TRUE for exactly one row per (resourceType, externalId) — the current head.
  /// Enforced by a partial unique index, not just application logic.
  active Boolean @default(true)
  /// Monotonic per (resourceType, externalId), starting at 1. Lets a reader ask
  /// "how many times has this changed" without counting rows by hand.
  version Int @default(1)
  /// Set once, when a NEWER observation supersedes this row. NULL while active.
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Natural-key uniqueness: the same exact content can never be stored twice for
  // the same resource. This is the query `writeSnapshot` uses to detect a no-op.
  @@unique([resourceType, externalId, contentSha256], map: "tango_resource_snapshot_natural_key_uniq")
  // History lookups: "every observation of this resource, oldest first."
  @@index([resourceType, externalId, version], map: "tango_resource_snapshot_history_idx")
  @@map("tango_resource_snapshot")
}

/// A REVIEWED crosswalk between a GLOBAL Capiro resource and a Tango resource.
///
/// Deliberately narrow in what it may link. `localResourceType` is
/// CHECK-constrained to the small set of EXISTING global reference tables
/// (`sam_opportunity`, `federal_grant`, `federal_contractor`, `federal_award`) —
/// the exact tables this schema already treats as tenant-scope-exempt. A
/// TENANT-owned resource (a client, a client_funding_opportunity row) is never a
/// valid target here: linking tenant data into a globally-readable crosswalk
/// table would be the same class of leak RLS exists to prevent, just via a table
/// that has none. Tenant-facing review workflows (a client's entity match, an
/// enrichment proposal) belong to P19/P20's own tenant-scoped tables instead.
model TangoResourceLink {
  id String @id @default(uuid()) @db.Uuid

  /// 'sam_opportunity' | 'federal_grant' | 'federal_contractor' | 'federal_award'.
  /// CHECK-constrained in the migration. No FK: the target table is polymorphic
  /// (selected by this column), which Postgres cannot express as a single FK
  /// constraint — enforced instead by TangoStoreService validating against
  /// LOCAL_LINK_RESOURCE_TYPES before every write, and proven by a rehearsal
  /// insert that an unsupported type is refused.
  localResourceType String @map("local_resource_type") @db.VarChar(32)
  /// The target row's own primary key, as TEXT regardless of its native type —
  /// `sam_opportunity.id` is a uuid, `federal_grant.id` is a free-form Grants.gov
  /// opportunity number. Text is the only type that holds both honestly.
  localResourceId String @map("local_resource_id") @db.Text

  /// Mirrors TangoResourceSnapshot.resourceType. CHECK-constrained to the same
  /// TANGO_RESOURCE_TYPES vocabulary.
  tangoResourceType String @map("tango_resource_type") @db.VarChar(32)
  tangoExternalId   String @map("tango_external_id") @db.Text

  /// HOW this link was established. Only two values, and neither is a fuzzy
  /// name match — the same "never fuzzy-match identity" invariant P02 enforced
  /// for award history applies here:
  ///   'exact_identifier' — an unambiguous identifier equality (an opportunity
  ///                         id, a solicitation number, a UEI). No human judgment
  ///                         was involved in proposing it.
  ///   'reviewed_manual'  — a human explicitly confirmed this specific pair.
  /// CHECK-constrained in the migration.
  basis String @map("basis") @db.VarChar(24)
  /// 'active' | 'rejected' | 'superseded'. CHECK-constrained. A rejection is
  /// DURABLE — the CHECK below requires an actor and timestamp whenever status is
  /// 'rejected', the same actor+timestamp pairing rule as P07's human-decision
  /// columns, so a rejection can never be silently recreated as an unattributed
  /// row.
  status String @default("active") @map("status") @db.VarChar(16)
  /// 'high' | 'medium' | 'low'. CHECK-constrained. Always populated — an
  /// 'exact_identifier' link is 'high' by construction; a future phase proposing
  /// a less-certain candidate before promotion would use 'medium' or 'low'.
  confidenceBand String @map("confidence_band") @db.VarChar(8)
  /// 'none' | 'field_conflict' | 'identity_conflict'. CHECK-constrained. Records
  /// that a linked pair disagrees on some field (P27's per-field agreement
  /// tracking) without resolving the disagreement here — resolution is a
  /// source-precedence decision the linking phase owns, per plan §4.2: no source
  /// silently overwrites the other.
  conflictState String @default("none") @map("conflict_state") @db.VarChar(24)

  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes  String?   @map("review_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // One link row per pair. Re-proposing the same pair finds this row rather than
  // creating a duplicate.
  @@unique([localResourceType, localResourceId, tangoResourceType, tangoExternalId], map: "tango_resource_link_pair_uniq")
  @@index([tangoResourceType, tangoExternalId], map: "tango_resource_link_tango_idx")
  @@map("tango_resource_link")
}

/// Resumable pagination state for ONE provider-side sync walk.
///
/// Keyed on (syncVerb, resourceType, filterFingerprint) rather than just
/// (syncVerb, resourceType): a sync re-run with DIFFERENT filters — a different
/// fiscal year, a different NAICS — must not resume from a cursor that belongs to
/// an unrelated filtered walk. `filterFingerprint` is a deterministic hash of the
/// exact filter object, so the same filters always land on the same checkpoint
/// and different filters never collide.
///
/// This checkpoint is about Tango's OWN pagination (walking its global
/// forecast/opportunity/vehicle lists), which is not partitioned by tenant
/// upstream — a separate concern from P03/P04's tenant-and-client keyset walk,
/// which already has its own resumable-cursor mechanism in
/// producer-pagination.ts. The two are not the same cursor and must not be
/// confused.
model TangoSyncCheckpoint {
  id String @id @default(uuid()) @db.Uuid

  /// The sync script name, e.g. 'sync-tango-client-entities'. Mirrors
  /// `sync_run.source`'s convention.
  syncVerb String @map("sync_verb") @db.VarChar(64)
  /// Mirrors TangoResourceSnapshot.resourceType. CHECK-constrained.
  resourceType String @map("resource_type") @db.VarChar(32)
  /// Lower-case hex SHA-256 of the canonicalized filter object used for this
  /// walk. CHECK-constrained to the hex-64 shape, same as the snapshot's content
  /// hash.
  filterFingerprint String @map("filter_fingerprint") @db.VarChar(64)

  /// OPAQUE. Pass back to the provider verbatim; never parsed or constructed
  /// client-side — the same rule as the P10 inbox cursor, for the same reason:
  /// the provider's cursor encoding is not part of any contract Capiro owns.
  cursor String? @map("cursor") @db.Text
  /// The incremental "changed since" window this walk is covering, when the sync
  /// is windowed rather than a full walk.
  windowStart DateTime? @map("window_start") @db.Timestamptz(6)
  windowEnd   DateTime? @map("window_end") @db.Timestamptz(6)

  /// 'in_progress' | 'complete' | 'incomplete'. CHECK-constrained. Mirrors the
  /// COMPLETE/INCOMPLETE vocabulary in producer-pagination.ts (P03/P04) — the
  /// same two words mean the same thing everywhere in this program.
  completeness  String   @default("in_progress") @map("completeness") @db.VarChar(16)
  rowsProcessed Int      @default(0) @map("rows_processed")
  lastRunAt     DateTime? @map("last_run_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([syncVerb, resourceType, filterFingerprint], map: "tango_sync_checkpoint_walk_uniq")
  @@map("tango_sync_checkpoint")
}

/// One provider API call, for account-level usage accounting.
///
/// NEVER carries a request header or a key — there is no column for either, on
/// purpose, and `TangoStoreService.recordUsage`'s input type has no field that
/// could hold one. P18 reads this table to answer "how close are we to the
/// account's rate limit" and "when did we last successfully sync resource X";
/// this phase only creates the substrate — nothing writes to it yet.
model TangoApiUsage {
  id String @id @default(uuid()) @db.Uuid

  /// The gateway method that was called (`getEntity`, `listForecasts`, …) —
  /// mirrors TangoError.operation from tango.errors.ts (P14). Called "call
  /// family" per the plan's own wording.
  callFamily String @map("call_family") @db.VarChar(64)
  /// Bucketed to the minute, so usage aggregates cheaply without a GROUP BY over
  /// raw timestamps at query time.
  timestampBucket DateTime @map("timestamp_bucket") @db.Timestamptz(6)
  /// 'success' or one of TangoErrorKind's 7 values. CHECK-constrained to exactly
  /// that set, so a usage row's status is always one this program already knows
  /// how to reason about.
  status String @map("status") @db.VarChar(16)
  /// How many domain rows the call returned. NULL for a get-by-id call, where
  /// "one or none" is not a count worth a column.
  rowCount Int? @map("row_count")

  rateLimitRemaining Int? @map("rate_limit_remaining")
  rateLimitLimit     Int? @map("rate_limit_limit")
  rateLimitResetIn   Int? @map("rate_limit_reset_in")
  durationMs         Int  @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Time-ordered scan for "usage in the last N minutes", the shape P18's health
  // check and rate-ceiling logic both need.
  @@index([callFamily, timestampBucket], map: "tango_api_usage_family_time_idx")
  @@map("tango_api_usage")
}

/// Funding Opportunities P20 — client profile enrichment review workflow.
///
/// ONE proposed change to ONE field on ONE client's profile, sourced from
/// Tango entity data (P19's snapshot), pending human review. TENANT-scoped
/// (unlike every other Tango-owned model above) because this is fundamentally
/// about a client's own profile, not a global marketplace fact — see the
/// migration's own header for why this is a new table rather than
/// `TangoResourceLink` (reserved for GLOBAL reference tables, never a
/// tenant-owned row) or `ClientIntelMapping` (a different question: "same
/// legal entity", not "should this field change").
///
/// No `client`/`tenant` Prisma relation object is declared here — matching
/// `ClientFundingOpportunity`'s own convention (plain scalar
/// tenantId/clientId, FK enforced in raw SQL, no Prisma-level navigation
/// needed by anything that reads this table).
model ClientProfileEnrichmentCandidate {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  /// 'tango' today; CHECK-constrained so a future second enrichment source
  /// cannot silently share this vocabulary without a reviewed migration.
  source String @default("tango") @db.VarChar(16)
  /// 'naicsCodes' | 'pscCodes' | 'setAsideCertifications' | 'cageCode' — the
  /// CLIENT model's own field name, verbatim, not the Tango snapshot's
  /// snake_case. This row is about a client field; a reviewer should not need
  /// a second translation table to know which one.
  field String @db.VarChar(32)
  /// The client's value AT PROPOSAL TIME — a snapshot, not a live read, so a
  /// reviewer sees exactly what would change even after the client's live
  /// value has since moved on.
  currentValueJsonb  Json? @map("current_value_jsonb")
  proposedValueJsonb Json  @map("proposed_value_jsonb")
  /// Canonicalized hash of (source, field, proposedValueJsonb) — see
  /// tango-store.service.ts's computeContentHash for the same canonicalization
  /// this reuses. The unique index below is keyed on this, not the raw JSONB,
  /// because Postgres cannot uniquely index an unbounded JSONB value directly.
  contentHash String @map("content_hash") @db.VarChar(64)

  /// 'pending' | 'accepted' | 'rejected'. A REJECTED row is NEVER resurrected
  /// by a later proposal of the identical content — same durability
  /// principle as tango_resource_link (P15) and client_intel_mapping (P05).
  /// There is no bulk-accept anything: every row is reviewed by its own
  /// primary key, one at a time (this phase's acceptance bar — "no accept-all
  /// for certifications" — generalized here to no accept-all at all).
  status         String    @default("pending") @db.VarChar(16)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?  @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, clientId, source, field, contentHash], map: "client_profile_enrichment_candidate_content_uniq")
  @@index([tenantId, status], map: "client_profile_enrichment_candidate_pending_idx")
  @@map("client_profile_enrichment_candidate")
}

/// Funding Opportunities P22 — relevant vehicles and past-performance sync.
///
/// A MATERIALIZED, tenant-scoped summary: "this client (or its parent
/// entity) is an awardee on this Tango vehicle, with this past-performance
/// summary." The authoritative, versioned observation stays in the GLOBAL
/// `tango_resource_snapshot` table (P15) — this table exists so a fast,
/// indexed read never scans JSONB across every vehicle-awardee snapshot
/// government-wide to answer "which vehicles matter to THIS client". See
/// the migration's own header for the full reasoning, including why
/// `relationship` ('self' | 'parent') is never collapsed into one boolean —
/// `TangoVehicleAwardee`'s own doc (P14) already draws that line, and P23
/// depends on it staying drawn.
model ClientRelevantVehicle {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  /// Matches tango_resource_snapshot.externalId for resourceType='vehicle'.
  /// Deliberately FK-less — global provider data, tenant-scoped summary.
  tangoVehicleId String  @map("tango_vehicle_id")
  vehicleName    String? @map("vehicle_name")
  vehicleType    String? @map("vehicle_type") @db.VarChar(64)
  /// 'self' | 'parent'. CHECK-constrained in the migration.
  relationship  String @db.VarChar(16)
  recipientUei  String @map("recipient_uei") @db.VarChar(12)
  orderCount        Int?    @map("order_count")
  idvObligations    Float?  @map("idv_obligations")
  idvContractsValue Float?  @map("idv_contracts_value")

  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, clientId, tangoVehicleId, relationship], map: "client_relevant_vehicle_uniq")
  @@index([tenantId, clientId], map: "client_relevant_vehicle_tenant_client_idx")
  @@map("client_relevant_vehicle")
}

/// Agency procurement forecast (Funding Opportunities P24) — a pre-
/// solicitation signal, never an active competition.
///
/// GLOBAL, no tenant_id, no RLS — provider catalog data, the same category
/// as sam_opportunity/federal_grant (P00) and tango_resource_snapshot (P15),
/// never a tenant- or client-owned fact.
///
/// A SINGLE CURRENT-STATE TABLE, deliberately NOT layered on P15's versioned
/// tango_resource_snapshot the way P19/P20/P22's syncs are. That mechanism
/// exists to keep a full audit trail of every observed value for a LOW-
/// volume, per-client-relevant resource; a forecast is a HIGH-volume
/// (24,000+ live rows, confirmed) catalog record Capiro tracks the CURRENT
/// state of, the same shape of resource sam_opportunity/federal_grant
/// already are as single current-state tables. `snapshot` below holds the
/// full normalized shape of the MOST RECENT observation for audit/debugging
/// — an upsert overwrites it, it does not grow a new row.
model TangoProcurementForecast {
  id String @id @default(uuid()) @db.Uuid

  /// Tango's own forecast id. The sync's upsert key.
  tangoForecastId String  @unique @map("tango_forecast_id")
  externalId      String? @map("external_id")

  title       String
  description String?

  /// The provider's own flat agency label (e.g. "VA") — distinct from, and
  /// not always consistent with, the organization hierarchy below (P24
  /// finding, decision-log D-45).
  agency String?

  /// Organization hierarchy. Every level independently nullable — the
  /// provider's own hierarchy is not always fully populated.
  departmentCode         String? @map("department_code")
  departmentName         String? @map("department_name")
  organizationAgencyCode String? @map("organization_agency_code")
  organizationAgencyName String? @map("organization_agency_name")
  officeCode             String? @map("office_code")
  officeName             String? @map("office_name")
  /// Opaque, stable provider id for the organization node. Never parsed.
  organizationId         String? @map("organization_id")

  anticipatedAwardDate DateTime? @map("anticipated_award_date") @db.Date
  /// Free text, e.g. "Q3 FY27". Not a date, and never parsed into one.
  estimatedPeriod      String?   @map("estimated_period")
  fiscalYear           Int?      @map("fiscal_year")

  naicsCode String? @map("naics_code")
  /// ALWAYS NULL today. Confirmed absent from this resource's own
  /// available_fields (decision-log D-45) — kept for a future provider
  /// release, not an oversight.
  pscCode   String? @map("psc_code")
  setAside  String? @map("set_aside")

  /// Free text naming a vehicle, e.g. "To Be Determined". No separate
  /// structured link exists on this resource (D-45) — "vehicle text/link" in
  /// the plan is one field in practice, not two.
  contractVehicle    String? @map("contract_vehicle")
  /// Free text, not a structured address — matches TangoForecast's own field.
  placeOfPerformance String? @map("place_of_performance")

  /// Structured on the live server (D-45) — flattened to columns here since
  /// this table has no JSON contact field of its own.
  primaryContactName  String? @map("primary_contact_name")
  primaryContactEmail String? @map("primary_contact_email")
  primaryContactPhone String? @map("primary_contact_phone")
  primaryContactTitle String? @map("primary_contact_title")

  status   String?
  isActive Boolean? @map("is_active")

  sourceSystem String? @map("source_system")
  /// ALWAYS NULL today. Confirmed absent (decision-log D-45).
  sourceUrl    String? @map("source_url")

  /// The provider's own last-touched stamp (D-45) — drives the incremental
  /// sync's modified_after window. Null when the provider never stated one.
  providerModifiedAt DateTime? @map("provider_modified_at") @db.Timestamptz(6)

  /// Full normalized shape of the most recent observation. Overwritten on
  /// every sync, not versioned — see this model's own doc for why.
  snapshot Json @map("snapshot")

  firstSyncedAt DateTime @default(now()) @map("first_synced_at") @db.Timestamptz(6)
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([fiscalYear], map: "tango_procurement_forecast_fiscal_year_idx")
  @@index([agency], map: "tango_procurement_forecast_agency_idx")
  @@index([providerModifiedAt], map: "tango_procurement_forecast_modified_idx")
  @@map("tango_procurement_forecast")
}

/// MakeGov/Tango's federal-account x fiscal-year budget rollup (P44).
///
/// BETA CONTEXT, NOT CAPIRO'S BUDGET. This table illuminates EXECUTION at the
/// federal-account grain — what an account was enacted, apportioned, obligated
/// and outlayed. Capiro's own Program Element tables answer a different
/// question at a different grain (a line item's request, mark and enacted
/// amount), and the two must never be compared or merged. Plan §P44 is explicit:
/// this phase writes no Program Element, project, request, mark, enacted or
/// canonical defense-budget table, and any relationship between an account and
/// a PE is a Capiro mapping with its own recorded basis, never a provider
/// assertion.
///
/// GLOBAL — no tenant_id, no RLS. "Federal account 097-0400 obligated $X in
/// FY26" is a fact about the federal government, same category as
/// `tango_procurement_forecast`, `sam_opportunity` and `federal_grant`.
///
/// SINGLE CURRENT STATE, not layered on P15's versioned snapshot store — the
/// same deliberate deviation P24 made and recorded as decision-log D-46, for
/// the same reason: a budget rollup's history is the FISCAL YEAR dimension the
/// table already carries, so a second versioning axis would store the same fact
/// twice and invite the two to disagree.
///
/// THE MONEY COLUMNS ARE NULLABLE AND NULL IS NOT ZERO. Live observation
/// (2026-09-01, P44's own shape probe): on a real row `contract_obligated` was
/// a number while `enacted_ba`, `requested_ba`, `apportioned`,
/// `obligated_total`, `outlayed_total` and `unobligated_balance` were ALL null.
/// An account the provider has not attributed is not an account with no money.
model TangoBudgetAccount {
  id String @id @default(uuid()) @db.Uuid

  /// Tango's own row id for this account x fiscal-year pair. The upsert key.
  tangoAccountRowId Int @unique @map("tango_account_row_id")

  /// Treasury federal account symbol, e.g. "097-0400". The provider's own
  /// identifier for the account, and the ONLY key a Capiro-side mapping may
  /// join on — see this model's doc on why no PE relationship is inferred.
  federalAccountSymbol String @map("federal_account_symbol")
  fiscalYear           Int    @map("fiscal_year")

  accountTitle String  @map("account_title")
  /// Nullable, and observed NULL on a live row while `agencyName` was present.
  agencyCode   String? @map("agency_code")
  agencyName   String? @map("agency_name")
  bureauName   String? @map("bureau_name")

  beaCategory     String? @map("bea_category")
  onOffBudget     String? @map("on_off_budget")
  subfunctionCode String? @map("subfunction_code")

  /// Budget authority and execution. Every one nullable; see the model doc.
  /// `@db.Decimal(20, 2)` rather than a float: these are dollars, and a float
  /// that rounds an obligation is a number nobody can reconcile against the
  /// source.
  requestedBa        Decimal? @map("requested_ba") @db.Decimal(20, 2)
  enactedBa          Decimal? @map("enacted_ba") @db.Decimal(20, 2)
  apportioned        Decimal? @db.Decimal(20, 2)
  obligatedTotal     Decimal? @map("obligated_total") @db.Decimal(20, 2)
  outlayedTotal      Decimal? @map("outlayed_total") @db.Decimal(20, 2)
  unobligatedBalance Decimal? @map("unobligated_balance") @db.Decimal(20, 2)
  contractObligated  Decimal? @map("contract_obligated") @db.Decimal(20, 2)
  assistanceObligated Decimal? @map("assistance_obligated") @db.Decimal(20, 2)

  /// The PROVIDER'S OWN confidence in its attribution, carried verbatim.
  /// This is what makes the "beta" label honest rather than decorative: the
  /// source tells us how sure it is, and the UI repeats it instead of
  /// presenting every row with equal weight.
  attributionStatus     String? @map("attribution_status")
  attributionConfidence String? @map("attribution_confidence")

  /// Full normalized shape of the most recent observation. Overwritten on
  /// every sync, not versioned — same policy as the forecast table above.
  snapshot Json @map("snapshot")

  sourceUrl String? @map("source_url")

  firstSyncedAt DateTime @default(now()) @map("first_synced_at") @db.Timestamptz(6)
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendorFlows TangoBudgetVendorFlow[]

  @@index([federalAccountSymbol, fiscalYear], map: "tango_budget_account_symbol_fy_idx")
  @@index([agencyCode], map: "tango_budget_account_agency_idx")
  @@map("tango_budget_account")
}

/// One recipient's contract flow out of one federal account (P44).
///
/// RELEVANT VENDORS ONLY. The provider's own recipients endpoint returns every
/// recipient of an account; this table stores a row only when the recipient's
/// UEI is one Capiro already knows — the same "walk everything, persist only
/// what we can defend" discipline P22 applied to vehicle awardees. A table of
/// every federal recipient would be a copy of USAspending nobody asked for.
///
/// GLOBAL, like its parent. The UEI filter decides what gets WRITTEN; it does
/// not make the resulting row tenant-scoped, because "vendor X received $Y from
/// account Z" is a public fact and two tenants knowing the same vendor must not
/// produce two rows.
model TangoBudgetVendorFlow {
  id String @id @default(uuid()) @db.Uuid

  budgetAccountId String             @map("budget_account_id") @db.Uuid
  budgetAccount   TangoBudgetAccount @relation(fields: [budgetAccountId], references: [id], onDelete: Cascade)

  /// The join key, and the reason this row exists at all.
  recipientUei  String  @map("recipient_uei")
  recipientName String? @map("recipient_name")

  /// The funding office, opaque provider id plus its own labels. Nullable
  /// because the provider's recipients rows are not guaranteed to carry one.
  fundingOrganizationId String? @map("funding_organization_id")
  fundingOfficeCode     String? @map("funding_office_code")
  fundingOfficeName     String? @map("funding_office_name")
  fundingAgencyCode     String? @map("funding_agency_code")
  fundingAgencyName     String? @map("funding_agency_name")

  contractObligated Decimal? @map("contract_obligated") @db.Decimal(20, 2)
  contractOutlayed  Decimal? @map("contract_outlayed") @db.Decimal(20, 2)
  contractCount     Int?     @map("contract_count")

  lastSyncedAt DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([recipientUei], map: "tango_budget_vendor_flow_uei_idx")
  @@index([budgetAccountId], map: "tango_budget_vendor_flow_account_idx")
  @@map("tango_budget_vendor_flow")
}

/// Per-FIELD agreement between Capiro's first-party SAM.gov row and
/// MakeGov/Tango's own observation of the same opportunity (P27).
///
/// EVIDENCE, NOT A MERGE. Nothing in this program writes to `sam_opportunity`
/// from a Tango observation. Plan §4.2: first-party ingestion stays
/// authoritative for canonical lifecycle fields, a Tango observation may
/// verify or identify a conflict, the conflict is RECORDED, and no
/// "last write wins" merge is permitted. `resolution` starts 'unreviewed' and
/// the local value stays canonical until a human says otherwise.
///
/// The LINK itself is not here — it lives in P15's `tango_resource_link`,
/// whose `basis` column admits only `exact_identifier` | `reviewed_manual`.
/// A second link table would mean two answers to "is this linked".
///
/// Global table — no tenant_id, no RLS. "SAM.gov and the provider disagree
/// about this notice's deadline" is a fact about the federal marketplace,
/// same category as `sam_opportunity` and `tango_resource_snapshot`.
model TangoOpportunityParity {
  id String @id @default(uuid()) @db.Uuid

  /// The provider's opportunity id. Also the tango_resource_link /
  /// tango_resource_snapshot external id for the same record.
  tangoOpportunityId String @map("tango_opportunity_id")
  /// `sam_opportunity.id`. A SOFT pointer with no FK, matching
  /// tango_resource_link's own local_resource_id: a cascade from either
  /// catalog would delete the evidence that they ever disagreed.
  samOpportunityId   String @map("sam_opportunity_id") @db.Uuid

  /// Bounded by tango_opportunity_parity_field_chk. Only lifecycle facts BOTH
  /// catalogs carry — a provider-exclusive field would report as a conflict on
  /// every row and belongs in the snapshot instead.
  field String

  /// Both sides verbatim, stringified for storage AFTER the typed comparison.
  /// NULL means that side stated nothing — never zero, never false, never "no".
  localValue    String? @map("local_value")
  providerValue String? @map("provider_value")

  /// 'agree' | 'conflict' | 'local_only' | 'provider_only' | 'both_absent'.
  /// Five values, not two: "they disagree" and "only one of them said
  /// anything" are different findings and only the first needs a human.
  agreement String

  /// 'unreviewed' | 'local_canonical' | 'accepted_provider' | 'dismissed'.
  /// 'local_canonical' is recorded explicitly rather than left implied, so
  /// "nobody has looked" stays distinguishable from "we looked and kept ours".
  resolution  String  @default("unreviewed")
  reviewedBy  String? @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes String? @map("review_notes")

  /// When this comparison was first seen with its CURRENT outcome, and when it
  /// was last confirmed. A conflict standing for three weeks reads differently
  /// from one that appeared this morning.
  firstObservedAt DateTime @default(now()) @map("first_observed_at") @db.Timestamptz(6)
  lastObservedAt  DateTime @default(now()) @map("last_observed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tangoOpportunityId, samOpportunityId, field], map: "tango_opportunity_parity_record_field_uniq")
  @@index([agreement, resolution, lastObservedAt], map: "tango_opportunity_parity_conflict_idx")
  @@index([samOpportunityId], map: "tango_opportunity_parity_sam_idx")
  @@map("tango_opportunity_parity")
}

/// One observation of one notice in an opportunity's history (P28).
///
/// The material-change TIMELINE is DERIVED from these rows at read time by
/// `opportunity-change-classifier.ts`, never stored: a derived timeline kept
/// alongside its own inputs is a second thing that can be wrong about them.
///
/// Not folded into P15's `tango_resource_snapshot` because the access pattern
/// is the opposite one — "every notice under THIS opportunity, in order" —
/// which a (resource_type, external_id) snapshot table cannot answer without
/// scanning its JSON. Hence real columns for the ordering keys and the compared
/// facts, plus `snapshot` for the full normalized observation.
///
/// Global table — no tenant_id, no RLS. "This solicitation's deadline moved on
/// 14 July" is a fact about the federal marketplace.
model TangoOpportunityNotice {
  id String @id @default(uuid()) @db.Uuid

  /// The provider's own notice id. The sync's upsert key.
  tangoNoticeId String @unique @map("tango_notice_id")
  /// The parent opportunity, when the sync knows it. Nullable: a notice can be
  /// observed through a solicitation-number query before its parent is walked.
  tangoOpportunityId String? @map("tango_opportunity_id")
  /// `sam_opportunity.id` when P27's crosswalk resolved the parent. Soft
  /// pointer, no FK — the history must outlive either catalog's row lifecycle.
  samOpportunityId String? @map("sam_opportunity_id") @db.Uuid

  solicitationNumber String? @map("solicitation_number")
  title              String?

  /// The notice body, verbatim. Untrusted source text — never an instruction.
  /// Stored so a later phase has it without re-fetching; nothing on the
  /// timeline path selects it.
  description String?
  /// SHA-256 of the normalized body. The classifier compares THIS, never the
  /// bodies: a description runs to tens of kilobytes and the timeline query
  /// fetches up to 500 notices. Null when the provider stated no description —
  /// and null on every row written before the field was requested at all,
  /// which is why both columns are nullable rather than backfilled.
  descriptionSha256 String? @map("description_sha256")

  /// The ordering keys. `providerUpdatedAt` is the tiebreaker, so two notices
  /// posted the same day still order deterministically.
  postedDate        DateTime? @map("posted_date") @db.Timestamptz(6)
  providerUpdatedAt DateTime? @map("provider_updated_at") @db.Timestamptz(6)

  /// The compared facts, as real columns: the change classifier reads every one
  /// of them on every timeline request.
  responseDeadline DateTime? @map("response_deadline") @db.Timestamptz(6)
  active           Boolean?
  setAside         String?   @map("set_aside")
  naicsCode        String?   @map("naics_code")
  pscCode          String?   @map("psc_code")
  attachmentCount  Int?      @map("attachment_count")

  sourceUrl String? @map("source_url")

  /// Canonical SHA-256 over the normalized observation. A re-sync with
  /// identical content is a no-op — same hash, no new observation, and
  /// therefore no material change in the derived timeline.
  contentHash String @map("content_hash")
  snapshot    Json   @map("snapshot")

  firstSyncedAt DateTime @default(now()) @map("first_synced_at") @db.Timestamptz(6)
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tangoOpportunityId, postedDate], map: "tango_opportunity_notice_parent_idx")
  @@index([samOpportunityId, postedDate], map: "tango_opportunity_notice_sam_idx")
  @@map("tango_opportunity_notice")
}

/// An attachment on a federal solicitation, and — once fetched — where the
/// archived copy lives (P29).
///
/// Metadata and archive are ONE row with an explicit `status`, not two tables:
/// knowing an attachment exists and holding a copy of it are different facts,
/// and two tables would let them disagree about the same file. Only
/// `status = 'archived'` may be cited by a downstream claim (P30/P31), and the
/// database enforces that an archived row carries its bucket, key, byte count
/// and hash — a failed fetch cannot mark metadata complete.
///
/// `refused` and `failed` are separate: one is Capiro declining to go somewhere
/// (no retry) and the other is a transient condition (retry later).
///
/// `archiveKey` embeds the content hash, so identical bytes re-archive to the
/// identical key and CHANGED bytes get a different one rather than overwriting.
/// A requirement extracted from version A must still resolve to version A's
/// bytes after the agency posts version B.
///
/// Global table — no tenant_id, no RLS.
model OpportunityAttachment {
  id String @id @default(uuid()) @db.Uuid

  /// At least one parent is required (CHECK). Soft pointers, no FKs.
  samOpportunityId String? @map("sam_opportunity_id") @db.Uuid
  tangoNoticeId    String? @map("tango_notice_id")

  /// Verbatim. The natural key together with its parent.
  sourceUrl String @map("source_url")

  /// Source-stated. All nullable — SAM.gov's resource links routinely carry a
  /// URL and nothing else, and deriving a filename from the last path segment
  /// is a guess that reads like a fact.
  fileName          String? @map("file_name")
  declaredMimeType  String? @map("declared_mime_type")
  declaredSizeBytes BigInt? @map("declared_size_bytes")
  postedDate        DateTime? @map("posted_date") @db.Timestamptz(6)

  /// Observed on fetch. Null until then.
  observedMimeType  String? @map("observed_mime_type")
  observedSizeBytes BigInt? @map("observed_size_bytes")
  contentSha256     String? @map("content_sha256")

  archiveBucket    String? @map("archive_bucket")
  archiveKey       String? @map("archive_key")
  archiveVersionId String? @map("archive_version_id")

  /// 'metadata_only' | 'archived' | 'refused' | 'failed'.
  status String @default("metadata_only")
  /// Bounded machine reason, plus a sanitized detail that NEVER contains any
  /// part of the file body.
  failureReason String? @map("failure_reason")
  failureDetail String? @map("failure_detail")

  firstSeenAt   DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([samOpportunityId, status], map: "opportunity_attachment_sam_idx")
  @@index([status, firstSeenAt], map: "opportunity_attachment_status_idx")
  @@index([contentSha256], map: "opportunity_attachment_hash_idx")
  @@map("opportunity_attachment")
}

/// The text of an archived attachment, with its own availability story (P30).
///
/// Separate from the attachment row because "we hold the document" and "we hold
/// its text" are different facts with different reasons for being false. Blank
/// must never read as "this document has no requirements", so the reason is a
/// column: `not_entitled` is a billing fact, `not_provided` is a fact about the
/// document (a scanned fax has no text layer), `pending` and `failed` are
/// operational.
///
/// `attachmentContentSha256` is the binding that makes a citation safe. P31
/// cites this text as evidence; if the agency reposts the document it archives
/// under a NEW hash (P29's key IS the hash), this row stops matching, and the
/// citation reads as stale rather than silently pointing at text that does not
/// contain the quoted claim.
///
/// Provider and local-parser text are never mixed: `extractionMethod` is part
/// of the uniqueness key, so the two coexist as separate labelled rows.
///
/// Global table — no tenant_id, no RLS.
model OpportunityDocumentText {
  id String @id @default(uuid()) @db.Uuid

  /// `opportunity_attachment.id`. Soft pointer, no FK.
  attachmentId String @map("attachment_id") @db.Uuid
  /// The hash of the exact bytes this text came from. NOT NULL: text with no
  /// binding is text nothing may cite.
  attachmentContentSha256 String @map("attachment_content_sha256")

  /// 'available' | 'not_entitled' | 'not_provided' | 'pending' | 'failed'.
  status String
  /// 'provider' | 'local_parser'. Never mixed within a row.
  extractionMethod String? @map("extraction_method")
  /// The plan the extraction was made under, so a later downgrade explains
  /// itself.
  providerTier String? @map("provider_tier")

  /// UNTRUSTED SOURCE CONTENT. Never interpreted as an instruction anywhere.
  text      String?
  charCount Int?    @map("char_count")
  /// True when the provider returned a bounded excerpt. A truncated body that
  /// claimed to be complete would let P31 conclude a requirement is absent from
  /// a document it only half read.
  truncated Boolean @default(false)

  failureReason String?   @map("failure_reason")
  fetchedAt     DateTime? @map("fetched_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([attachmentContentSha256], map: "opportunity_document_text_binding_idx")
  @@index([status, createdAt], map: "opportunity_document_text_status_idx")
  @@map("opportunity_document_text")
}

/// A CANDIDATE requirement extracted from a solicitation document, bound to the
/// exact bytes and character range it came from (P31).
///
/// GLOBAL, because "this solicitation requires a facility clearance at
/// paragraph 3.2" is a fact about a public document — the same fact for every
/// tenant, extracted once. The tenant's DECISION about it lives in
/// `OpportunityRequirementReview`, which is tenant-scoped with RLS.
///
/// Every evidence column is NOT NULL. An assertion with no citation is what
/// this phase exists to make impossible, and a nullable column is a promise the
/// schema does not keep. The span is checked for coherence and the excerpt's
/// length must MATCH it — an excerpt longer than its claimed range is a
/// paraphrase wearing a citation.
///
/// `attachmentContentSha256` is the same binding P30's text rows carry: when an
/// agency reposts a document it archives under a new hash, and every candidate
/// bound to the old one is stale by construction rather than by a cleanup job.
///
/// `extractionMethod` and `extractionModel` are NOT NULL, so "the machine said
/// so" and "a human confirmed it" can never be conflated on a read.
model OpportunityRequirement {
  id String @id @default(uuid()) @db.Uuid

  attachmentId            String  @map("attachment_id") @db.Uuid
  attachmentContentSha256 String  @map("attachment_content_sha256")
  /// Denormalized so the detail surface reads a solicitation's requirements
  /// without joining through attachments.
  samOpportunityId        String? @map("sam_opportunity_id") @db.Uuid

  /// Bounded by CHECK. See REQUIREMENT_TYPES.
  requirementType String @map("requirement_type")
  /// One sentence, in Capiro's words, of what the excerpt requires.
  statement       String

  /// THE EVIDENCE. All NOT NULL.
  sourceExcerpt String  @map("source_excerpt")
  excerptStart  Int     @map("excerpt_start")
  excerptEnd    Int     @map("excerpt_end")
  /// Genuinely optional: a plain-text extraction has offsets and no pages.
  sourcePage    Int?    @map("source_page")

  /// 'model' | 'deterministic_pattern' | 'human', and the model/rule id.
  extractionMethod String @map("extraction_method")
  extractionModel  String @map("extraction_model")
  /// Evidence quality. NEVER a probability that the requirement is real.
  confidence       String

  /// Set when a later sync observed the document change under this candidate.
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([attachmentContentSha256, requirementType, excerptStart, excerptEnd], map: "opportunity_requirement_evidence_uniq")
  @@index([samOpportunityId, requirementType], map: "opportunity_requirement_sam_idx")
  @@index([attachmentContentSha256, supersededAt], map: "opportunity_requirement_binding_idx")
  @@map("opportunity_requirement")
}

/// One team's decision about one extracted requirement (P31).
///
/// TENANT-SCOPED with RLS ENABLED + FORCED and the standard four policies. The
/// requirement itself is a global fact about a public document; the review is a
/// fact about one team, and putting it on the shared row would show every
/// tenant what one team decided.
///
/// `reviewedBy`/`reviewedAt` are all-or-nothing with `status`, the same shape as
/// P07's decision-actor CHECK: a decision nobody can be attributed to is a
/// decision nobody can be asked about later.
model OpportunityRequirementReview {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  requirementId String @map("requirement_id") @db.Uuid

  /// 'pending' | 'accepted' | 'rejected'.
  status      String
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes String?   @map("review_notes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, requirementId], map: "opportunity_requirement_review_tenant_req_uniq")
  @@index([tenantId, status], map: "opportunity_requirement_review_status_idx")
  @@map("opportunity_requirement_review")
}

/// One recorded stage move on a tracked opportunity (Funding Opportunities P35).
///
/// TENANT-SCOPED with RLS ENABLED + FORCED, unlike the provider catalog tables in
/// this program: "who moved this to lost, when, and why" is a fact about ONE team.
///
/// `actorUserId` is NOT NULL. There is no way to record a stage move nobody
/// performed, which is what "producers cannot alter stage" means at the schema
/// level rather than as a convention.
///
/// The migration CHECKs that `submitted`, `won`, `lost` and `passed` carry a
/// non-empty `reason` — a recorded loss nobody explained is a loss nobody can
/// learn from — and that `fromStage <> toStage`, because a move to where it
/// already was is not a move.
model FundingOpportunityStageTransition {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  clientFundingOpportunityId String @map("client_funding_opportunity_id") @db.Uuid

  /// NULL means "entered the pipeline". A real and common first entry.
  fromStage String? @map("from_stage") @db.VarChar(16)
  toStage   String  @map("to_stage") @db.VarChar(16)

  actorUserId String  @map("actor_user_id") @db.Uuid
  reason      String? @db.Text

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  row    ClientFundingOpportunity @relation(fields: [clientFundingOpportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientFundingOpportunityId, occurredAt(sort: Desc)], map: "funding_opportunity_stage_transition_row_idx")
  @@index([tenantId, actorUserId, occurredAt(sort: Desc)], map: "funding_opportunity_stage_transition_actor_idx")
  @@map("funding_opportunity_stage_transition")
}

/// Reviewed, EXPLICIT map from a DoD Major Defense Acquisition Program (MDAP)
/// code — as it appears on USAspending contract records
/// (latest_transaction_contract_data.dod_acquisition_program) — to a Program
/// Element. This is the defensible bridge that lets the PE contractor panel show
/// "who are the primes on this program" without inferring PE from coarse funding
/// accounts. Entries are curated/seeded (not machine-derived), so attribution is
/// auditable: e.g. ('198','F-35') -> the F-35-related PEs the program tracks.
/// A program maps to one-or-more PEs and a PE may be reached by one-or-more
/// program codes; the (acqProgramCode, peCode) pair is unique. Global table —
/// no tenant_id, no RLS (federal reference data, same as federal_award).
model ProgramElementAcquisitionProgram {
  id             String   @id @default(uuid()) @db.Uuid
  /// MDAP code exactly as USAspending emits it (e.g. '198', '516', 'SDN').
  acqProgramCode String   @map("acq_program_code")
  /// Human-readable program name for display/provenance (e.g. 'F-35').
  acqProgramName String?  @map("acq_program_name")
  peCode         String   @map("pe_code") @db.VarChar(16)
  /// Where this mapping came from (e.g. 'seed_curated_v1') for auditing.
  source         String   @default("seed_curated_v1")
  /// 0..1 reviewer confidence; the read path can threshold on this if needed.
  confidence     Float    @default(1.0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)

  @@unique([acqProgramCode, peCode], map: "pe_acq_program_code_pe_key")
  @@index([peCode], map: "pe_acq_program_pe_code_idx")
  @@index([acqProgramCode], map: "pe_acq_program_code_idx")
  @@map("program_element_acquisition_program")
}

/// Named prime contractor ("performing activity") for a Program Element, extracted
/// verbatim from the Service RDT&E Justification Book R-3 "Product Development" /
/// "Support" / "Management Services" cost-analysis tables (and embedded R-2A tables).
/// This is the zero-inference, government-STATED PE -> prime link: the exhibit names
/// the company, contract method/type, performing location, and total contract cost.
/// Each row carries page-level provenance so the contractor panel can deep-link to
/// the exact exhibit page ("per the Navy's own FY27 R-3 exhibit, page N"). Global
/// table (no tenant_id / RLS): J-book data is public-domain reference data, same as
/// program_element / federal_award. Loaded by the sync-jbook-performers verb from a
/// committed offline extraction artifact (scripts/__data__/jbook_performers_*.json);
/// no PDF/Python at runtime. Idempotent: unique on the natural performer key.
model ProgramElementPerformer {
  id                  String   @id @default(uuid()) @db.Uuid
  peCode              String   @map("pe_code") @db.VarChar(16)
  /// Company name exactly as printed in the exhibit (e.g. 'LOCKHEED MARTIN CORPORATION').
  performer           String
  /// Uppercased/punctuation-stripped name for joins/dedup (e.g. 'LOCKHEED MARTIN CORP').
  performerNormalized String   @map("performer_normalized")
  /// Performing location as printed (state code 'AL', 'Various', city, or country).
  /// NOT NULL ('' when absent) so the natural-key unique index is deterministic
  /// (Postgres treats NULLs as distinct, which would break idempotent upserts).
  location            String   @default("") @map("location")
  /// Contract method & type token ('SS/IDIQ','C/CPAF','MIPR',...). '' when blank/Various.
  contractMethod      String   @default("") @map("contract_method")
  /// Cost-category item label from the exhibit row (e.g. 'THAAD Development - Capability').
  costCategory        String   @default("") @map("cost_category")
  /// Total contract cost in $M as printed (TotalCost column). Null when not stated.
  totalCostM          Decimal? @map("total_cost_m") @db.Decimal(18, 3)
  /// R-3 table family this came from: 'product_development' | 'support' | 'management_services'.
  tableType           String?  @map("table_type")
  /// Project (R-2A) code/name when the table is under a specific project, else null.
  projectCode         String?  @map("project_code")
  projectName         String?  @map("project_name")
  fy                  Int
  sourceUrl           String   @map("source_url")
  pageNumber          Int      @map("page_number")
  /// Publishing component for provenance label (e.g. 'DoD Comptroller (Navy)').
  publisher           String?
  /// True when the performer is a real named company (has a legal suffix / not 'Various'/
  /// 'TBD'/government-internal MIPR). Lets the read path surface only real primes by default.
  isNamedCompany      Boolean  @default(true) @map("is_named_company")
  source              String   @default("comptroller_jbook_r3")
  confidence          Float    @default(0.95)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSyncedAt        DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  // Registry link (Step 0.1): the fingerprinted source file this performer row came from.
  sourceDocumentId    String?  @map("source_document_id") @db.Uuid

  programElement ProgramElement  @relation(fields: [peCode], references: [peCode], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Natural key: same prime can appear under different cost categories / projects / methods.
  @@unique([peCode, performerNormalized, location, contractMethod, costCategory, fy], map: "program_element_performer_natural_key")
  @@index([peCode], map: "program_element_performer_pe_code_idx")
  @@index([performerNormalized], map: "program_element_performer_norm_idx")
  @@index([isNamedCompany], map: "program_element_performer_named_idx")
  @@index([sourceDocumentId], map: "program_element_performer_source_document_idx")
  @@map("program_element_performer")
}

// ─────────────────────────────────────────────────────────────────────────
// PROGRAM GRAPH (Step 2.1) — the canonical Program entity + alias dictionary +
// review-gated PE/project -> program matching. GLOBAL tables (no tenant_id / RLS):
// these describe public-domain federal programs, same as program_element /
// federal_award. PeProgramMatch is the graph's source of truth going forward;
// program_element_acquisition_program is kept for award attribution.
// ─────────────────────────────────────────────────────────────────────────

/// Canonical defense program (e.g. 'F-35', 'SSN 774'). One row per real-world
/// program-of-record. Seeded from program_element_acquisition_program MDAP codes
/// (seed-programs.ts) and grown by the matcher / human review. PE links live on
/// PeProgramMatch, not here.
model Program {
  id                 String   @id @default(uuid()) @db.Uuid
  canonicalName      String   @map("canonical_name")
  component          String? // service / component (e.g. 'AF', 'NAVY', 'ARMY', 'OSD')
  capabilityArea     String?  @map("capability_area")
  acquisitionPathway String?  @map("acquisition_pathway")
  /// MDAP code from the program_element_acquisition_program seed (e.g. '198'); null
  /// for programs introduced outside the curated MDAP map.
  mdapCode           String?  @map("mdap_code")
  description        String?  @db.Text
  status             String   @default("active") @db.VarChar(20)
  metadata           Json     @default("{}") @map("metadata_jsonb")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  aliases        ProgramAlias[]
  matches        PeProgramMatch[]
  samMatches     SamOpportunityMatch[]
  personRoles    PersonRole[]
  officeLinks    ProgramOfficeProgramLink[]
  provisionLinks ProvisionPeLink[]

  @@index([mdapCode], map: "program_mdap_code_idx")
  @@index([component], map: "program_component_idx")
  @@index([status], map: "program_status_idx")
  @@map("program")
}

/// Alias / known name for a Program — drives fuzzy PE/project -> program matching.
/// aliasNormalized is the upper-cased, punctuation-stripped form used for the
/// pg_trgm trigram index. aliasType records WHERE the alias came from so the
/// matcher can weight official names over usage strings.
model ProgramAlias {
  id              String   @id @default(uuid()) @db.Uuid
  programId       String   @map("program_id") @db.Uuid
  alias           String
  /// Upper-cased, punctuation-stripped form (see normalizeAlias in pe-program-matcher).
  aliasNormalized String   @map("alias_normalized")
  /// 'canonical' | 'acronym' | 'pe_title' | 'project_title' | 'p1_line_name' |
  /// 'mdap_name' | 'office_usage' | 'congressional' | 'sam_usage' | 'award_usage'.
  aliasType       String   @map("alias_type")
  source          String
  sourceUrl       String?  @map("source_url")
  confidence      Float    @default(0.9)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, aliasNormalized, aliasType], map: "program_alias_program_norm_type_key")
  @@index([programId], map: "program_alias_program_id_idx")
  @@index([aliasNormalized], map: "program_alias_normalized_idx")
  // NOTE: the pg_trgm GIN index on alias_normalized is created in raw SQL in the
  // migration (Prisma cannot express `USING gin (... gin_trgm_ops)`).
  @@map("program_alias")
}

/// PE (and optionally a project within it) -> Program link, with evidence and a
/// confidence tier. The graph's source of truth. Machine matches land here as
/// 'candidate'/'quarantined' for HUMAN review; 'accepted' is reserved for curated
/// seed rows and reviewer confirmations (and the documented official+exact
/// auto-accept rule). NEVER auto-accepted from a fuzzy path.
model PeProgramMatch {
  id               String    @id @default(uuid()) @db.Uuid
  peCode           String    @map("pe_code") @db.VarChar(16)
  /// Project (R-2A) code within the PE when the match is project-level, else null.
  /// Phase 4 WS M: widened to VarChar(32) to match program_element_project.project_code.
  projectCode      String?   @map("project_code") @db.VarChar(32)
  programId        String    @map("program_id") @db.Uuid
  score            Float
  /// 'exact_pe_number' | 'exact_project_title' | 'r2a_office_named' |
  /// 'other_funding_link' | 'official_office_page' | 'sar_msar' | 'sam_match' |
  /// 'award_match' | 'press_release' | 'news_only' | 'mdap_curated' (seed).
  evidenceTier     String    @map("evidence_tier")
  /// Array of evidence items: { kind, sourceUrl, pageNumber?, quote? }.
  evidence         Json      @default("[]") @map("evidence_jsonb")
  /// 'accepted' | 'candidate' | 'quarantined' | 'rejected'. Default derived from
  /// score+tier per the plan thresholds (see deriveMatchStatus).
  status           String    @default("candidate") @db.VarChar(20)
  /// True when score < 0.50 — stored as a weak signal, NEVER surfaced.
  weakSignal       Boolean   @default(false) @map("weak_signal")
  matchBasis       String?   @map("match_basis") @db.Text
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)
  decisionNotes    String?   @map("decision_notes") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Unique on (peCode, coalesce(projectCode,''), programId): a project-null and a
  // project-scoped match to the same program coexist; two matches with the same
  // (pe, project, program) do not. Postgres treats NULLs as distinct, so the
  // coalesce()-based uniqueness is enforced via a raw expression index in the
  // migration (Prisma cannot express a functional unique index).
  @@index([programId], map: "pe_program_match_program_id_idx")
  @@index([peCode], map: "pe_program_match_pe_code_idx")
  @@index([status], map: "pe_program_match_status_idx")
  @@map("pe_program_match")
}

// ─────────────────────────────────────────────────────────────────────────
// SAM.gov OPPORTUNITIES (Step 3.1) — DoD contract opportunities + review-gated
// opportunity -> program / PE matching. GLOBAL tables (no tenant_id / RLS): these
// describe public-domain federal solicitations, same as federal_award / program.
// SamOpportunityMatch mirrors PeProgramMatch / ProvisionPeLink review gating: a
// machine match lands as 'candidate' or 'quarantined'; only a verbatim PE-code hit
// in the description is 'accepted'. PSC/NAICS-only matches are NEVER auto-accepted.
// ─────────────────────────────────────────────────────────────────────────

/// A SAM.gov contract opportunity (solicitation / notice). One row per notice_id.
/// Loaded by sync-sam-opportunities (DoD-filtered, incremental). Global table —
/// no tenant_id, no RLS (federal reference data, same as federal_award).
model SamOpportunity {
  id                 String    @id @default(uuid()) @db.Uuid
  /// SAM.gov noticeId — stable idempotency key.
  noticeId           String    @unique @map("notice_id")
  solicitationNumber String?   @map("solicitation_number")
  title              String
  /// SAM.gov notice type (e.g. 'Solicitation', 'Combined Synopsis/Solicitation',
  /// 'Presolicitation', 'Sources Sought', 'Award Notice').
  noticeType         String    @map("notice_type") @db.VarChar(32)
  /// SAM.gov `baseType` — the notice's ORIGINAL type before any amendment.
  /// Distinct from `noticeType`: an amended solicitation carries type
  /// 'Solicitation' with baseType 'Presolicitation', and conflating them makes a
  /// sources-sought notice read as an open solicitation. Available on every
  /// search-v2 record; recoverable for already-ingested rows from `raw`.
  baseType           String?   @map("base_type") @db.VarChar(64)
  agency             String?
  /// SAM.gov `subTier` — the service/component beneath the department. Almost
  /// always null on DoD records (the org path is what is populated), so a null
  /// here means "the notice did not say", not "no subagency".
  subAgency          String?   @map("sub_agency")
  office             String?
  /// SAM.gov `typeOfSetAsideDescription` (human-readable, e.g. 'Total Small
  /// Business Set-Aside (FAR 19.5)'). NULL = full and open, or not stated.
  setAside           String?   @map("set_aside")
  /// SAM.gov `typeOfSetAside` (the code, e.g. 'SBA', 'SDVOSBC', '8AN').
  setAsideCode       String?   @map("set_aside_code") @db.VarChar(16)
  /// Product/Service Code.
  pscCode            String?   @map("psc_code") @db.VarChar(8)
  naicsCode          String?   @map("naics_code") @db.VarChar(8)
  postedDate         DateTime? @map("posted_date") @db.Timestamptz(6)
  responseDeadline   DateTime? @map("response_deadline") @db.Timestamptz(6)
  archiveDate        DateTime? @map("archive_date") @db.Timestamptz(6)
  description        String?   @db.Text
  /// Primary point-of-contact name (public header field).
  pocName            String?   @map("poc_name")
  pocEmail           String?   @map("poc_email")
  placeOfPerformance Json      @default("{}") @map("place_of_performance_jsonb")
  sourceUrl          String?   @map("source_url")
  /// Derived from archiveDate: false once the notice's archive date has passed.
  active             Boolean   @default(true)
  raw                Json      @default("{}") @map("raw_jsonb")
  lastSyncedAt       DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  matches SamOpportunityMatch[]

  @@index([active, responseDeadline], map: "sam_opportunity_active_response_deadline_idx")
  // Funding Opportunities read path: the default view is "active, soonest
  // deadline first" filtered by notice type, and `notice_type` alone was not
  // selective enough to keep that off a full scan of the notice table.
  @@index([active, noticeType, responseDeadline], map: "sam_opportunity_active_type_deadline_idx")
  // The full pursuit predicate also constrains archiveDate: `active` is derived
  // from the ARCHIVE date, which commonly trails the response deadline by weeks,
  // so `active = true` admits notices whose window to respond has already shut.
  // Added alongside sam_opportunity_active_response_deadline_idx rather than
  // replacing it — dropping an index a live read path uses, to add one trailing
  // column, is not worth the window.
  @@index([active, responseDeadline, archiveDate], map: "sam_opportunity_lifecycle_idx")
  @@index([setAsideCode], map: "sam_opportunity_set_aside_code_idx")
  @@index([solicitationNumber], map: "sam_opportunity_solicitation_number_idx")
  @@index([naicsCode], map: "sam_opportunity_naics_code_idx")
  @@index([pscCode], map: "sam_opportunity_psc_code_idx")
  @@index([office], map: "sam_opportunity_office_idx")
  @@map("sam_opportunity")
}

/// Review-gated SAM.gov opportunity -> Program (and/or PE) link, with a confidence
/// and a match basis. The graph's source of truth for "which opportunity belongs to
/// which program". Mirrors PeProgramMatch gating: machine matches land as
/// 'candidate'/'quarantined' for HUMAN review. A verbatim PE-code hit in the
/// description is the ONLY auto-'accepted' basis; PSC/NAICS-only matches are
/// 'quarantined' and NEVER auto-accepted.
model SamOpportunityMatch {
  id            String   @id @default(uuid()) @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  programId     String?  @map("program_id") @db.Uuid
  peCode        String?  @map("pe_code") @db.VarChar(16)
  /// 'program_alias' | 'office' | 'psc_naics_component' | 'description_pe_code'.
  matchBasis    String   @map("match_basis") @db.VarChar(24)
  confidence    Float    @default(0.5)
  /// 'candidate' | 'accepted' | 'quarantined' | 'rejected'. Default 'candidate';
  /// only 'description_pe_code' may be 'accepted'.
  reviewStatus  String   @default("candidate") @map("review_status") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  opportunity SamOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  program     Program?       @relation(fields: [programId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Unique on (opportunity_id, coalesce(program_id::text,''), coalesce(pe_code,'')) —
  // Postgres treats NULLs as distinct, so the coalesce()-based uniqueness is enforced
  // via a raw expression index in the migration (Prisma cannot express it).
  @@index([programId], map: "sam_opportunity_match_program_id_idx")
  @@index([peCode], map: "sam_opportunity_match_pe_code_idx")
  @@index([reviewStatus], map: "sam_opportunity_match_review_status_idx")
  @@map("sam_opportunity_match")
}

/// A captured narrative PROVISION from a congressional committee report (HASC/SASC
/// markup, HAC-D/SAC-D report, conference report) — the LANGUAGE that directs/adds/
/// cuts/restricts, not just the dollar tables (Step 2.4, plan §4.1 / §6 / §10). GLOBAL
/// public-domain congressional data (no tenant_id / RLS), like program /
/// source_document. Populated by the (follow-on) language-extraction loader.
model CommitteeReportProvision {
  id               String   @id @default(uuid()) @db.Uuid
  sourceDocumentId String?  @map("source_document_id") @db.Uuid
  /// Issuing committee short code: 'HASC' | 'SASC' | 'HAC-D' | 'SAC-D' | 'CONF'.
  committee        String   @db.VarChar(16)
  fy               Int
  /// The provision's heading / item title as it appears in the report.
  heading          String   @db.Text
  /// The full provision language (verbatim).
  text             String   @db.Text
  pageStart        Int?     @map("page_start")
  pageEnd          Int?     @map("page_end")
  /// Deterministic classifier output (see provision-action-classifier): 'directs_briefing'
  /// | 'directs_report' | 'adds' | 'cuts' | 'transfers' | 'restricts' | 'encourages' |
  /// 'expresses_concern'. Null when the language is ambiguous / unclassified.
  actionType       String?  @map("action_type") @db.VarChar(24)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceDocument SourceDocument?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  links          ProvisionPeLink[]

  @@index([committee, fy], map: "committee_report_provision_committee_fy_idx")
  @@index([actionType], map: "committee_report_provision_action_type_idx")
  @@index([sourceDocumentId], map: "committee_report_provision_source_document_idx")
  @@map("committee_report_provision")
}

/// Review-gated link from a captured committee-report provision to a PE / project /
/// program. matchBasis records HOW the link was found ('pe_code' from a verbatim PE
/// number is accepted; fuzzy 'project_title' / 'program_alias' land as 'candidate').
/// GLOBAL congressional data (no tenant_id / RLS).
model ProvisionPeLink {
  id           String   @id @default(uuid()) @db.Uuid
  provisionId  String   @map("provision_id") @db.Uuid
  peCode       String?  @map("pe_code") @db.VarChar(16)
  /// Phase 4 WS M: widened to VarChar(32) to match program_element_project.project_code.
  projectCode  String?  @map("project_code") @db.VarChar(32)
  programId    String?  @map("program_id") @db.Uuid
  /// 'pe_code' | 'project_title' | 'program_alias' | 'manual' — how the link was found.
  matchBasis   String   @map("match_basis") @db.VarChar(24)
  confidence   Float    @default(0.5)
  /// 'accepted' | 'candidate' | 'rejected'. Verbatim PE-code links are 'accepted';
  /// fuzzy title/alias links land as 'candidate' for human review.
  reviewStatus String   @default("candidate") @map("review_status") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  provision CommitteeReportProvision @relation(fields: [provisionId], references: [id], onDelete: Cascade)
  program   Program?                 @relation(fields: [programId], references: [id], onDelete: SetNull)

  // Unique on (provisionId, coalesce(peCode,''), coalesce(programId::text,'')): Postgres
  // treats NULLs as distinct, so the coalesce()-based uniqueness is enforced via a raw
  // expression index in the migration (Prisma cannot express a functional unique index).
  @@index([peCode], map: "provision_pe_link_pe_code_idx")
  @@index([programId], map: "provision_pe_link_program_id_idx")
  @@index([reviewStatus], map: "provision_pe_link_review_status_idx")
  @@map("provision_pe_link")
}

/// A program/acquisition office (PEO, PM shop, CPE, contracting office, etc.).
/// People hang off OFFICES and ROLES, never directly off PEs (plan §8/§14). Global
/// reference data: no tenant_id / RLS, like program / acquisition_personnel.
/// Time-versioned for reorgs via validFrom/validTo.
model ProgramOffice {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  /// 'peo' | 'pm' | 'cpe' | 'pae' | 'directorate' | 'command' | 'contracting_office' | 'other'
  officeType     String    @map("office_type") @db.VarChar(24)
  service        String?   @db.VarChar(8)
  parentOfficeId String?   @map("parent_office_id") @db.Uuid
  sourceUrl      String?   @map("source_url")
  status         String    @default("active") @db.VarChar(16)
  validFrom      DateTime? @map("valid_from") @db.Timestamptz(6)
  validTo        DateTime? @map("valid_to") @db.Timestamptz(6)
  metadata       Json      @default("{}") @map("metadata_jsonb")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  parentOffice ProgramOffice?             @relation("ProgramOfficeParent", fields: [parentOfficeId], references: [id], onDelete: SetNull)
  childOffices ProgramOffice[]            @relation("ProgramOfficeParent")
  roles        PersonRole[]
  programLinks ProgramOfficeProgramLink[]

  @@index([service], map: "program_office_service_idx")
  @@index([officeType], map: "program_office_office_type_idx")
  @@index([parentOfficeId], map: "program_office_parent_idx")
  @@map("program_office")
}

/// A person's role at an office and/or on a program, with a compliance classification
/// (contactUse) and review gate. Replaces the free-text person->PE shortcut (plan §8).
/// Global reference data. staleAt set by the staleness job when observedAt > 180d
/// without re-assertion (stale roles are excluded from recommendation surfaces).
model PersonRole {
  id             String    @id @default(uuid()) @db.Uuid
  personId       String    @map("person_id") @db.Uuid
  officeId       String?   @map("office_id") @db.Uuid
  programId      String?   @map("program_id") @db.Uuid
  roleTitle      String    @map("role_title")
  /// 'peo' | 'pm' | 'deputy' | 'chief_engineer' | 'contracting_officer' | 'staff' | 'other'
  roleType       String    @map("role_type") @db.VarChar(24)
  source         String    @db.VarChar(64)
  sourceUrl      String?   @map("source_url")
  sourceQuote    String?   @map("source_quote") @db.Text
  observedAt     DateTime  @map("observed_at") @db.Timestamptz(6)
  effectiveStart DateTime? @map("effective_start") @db.Timestamptz(6)
  effectiveEnd   DateTime? @map("effective_end") @db.Timestamptz(6)
  confidence     Float     @default(0.5)
  /// 'accepted' | 'candidate' | 'quarantined'
  reviewStatus   String    @default("candidate") @map("review_status") @db.VarChar(20)
  /// 'lobbying_contact' | 'program_ownership_context' | 'official_procurement_poc' |
  /// 'internal_owner' | 'relationship_owner' | 'do_not_contact_procurement_sensitive' |
  /// 'candidate' | 'quarantined'. Set by the contact-use policy module.
  contactUse     String    @map("contact_use") @db.VarChar(40)
  staleAt        DateTime? @map("stale_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  person  AcquisitionPersonnel @relation(fields: [personId], references: [id], onDelete: Cascade)
  office  ProgramOffice?       @relation(fields: [officeId], references: [id], onDelete: SetNull)
  program Program?             @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([personId], map: "person_role_person_id_idx")
  @@index([officeId], map: "person_role_office_id_idx")
  @@index([programId], map: "person_role_program_id_idx")
  @@index([reviewStatus], map: "person_role_review_status_idx")
  @@index([contactUse], map: "person_role_contact_use_idx")
  @@map("person_role")
}

/// Office -> Program link (which office manages/executes/supports a program). Review-gated;
/// alias-derived links are 'candidate' only. Global reference data.
model ProgramOfficeProgramLink {
  id           String   @id @default(uuid()) @db.Uuid
  officeId     String   @map("office_id") @db.Uuid
  programId    String   @map("program_id") @db.Uuid
  /// 'manages' | 'executes' | 'supports'
  relation     String   @db.VarChar(16)
  sourceUrl    String?  @map("source_url")
  confidence   Float    @default(0.5)
  reviewStatus String   @default("candidate") @map("review_status") @db.VarChar(20)
  /// Provenance for derived links (derive-office-program-links). Array of
  /// { kind, detail, count?, sourceUrl? }. Empty for hand/import-created rows.
  evidence     Json     @default("[]") @map("evidence_jsonb")
  /// Highest tier that produced the link: owner_in_office | people_majority |
  /// office_name_exact | por_majority | people_minority | office_name_trgm.
  evidenceTier String?  @map("evidence_tier")
  /// Human-readable basis ("7 of 9 office people map to program X").
  matchBasis   String?  @map("match_basis") @db.Text
  /// Regenerable cohort tag (e.g. 'derive-office-program-links@v1'); NULL for
  /// hand/import-created links, which the deriver never clobbers.
  derivedBy    String?  @map("derived_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  office  ProgramOffice @relation(fields: [officeId], references: [id], onDelete: Cascade)
  program Program       @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([officeId, programId], map: "program_office_program_link_office_program_key")
  @@index([programId], map: "program_office_program_link_program_id_idx")
  @@map("program_office_program_link")
}

/// Canonical institutional-memory item (plan §0.5). Projected to an Obsidian-
/// format markdown file in the vault; consumed structurally by the AI /
/// Intelligence Center. Facts live in the referenced entity row (entityId);
/// this holds the interpretation/narrative around them. RLS-FORCED on tenant_id.
model MemoryItem {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  clientId      String?  @map("client_id") @db.Uuid
  ownerUserId   String?  @map("owner_user_id") @db.Uuid
  type          String   @db.VarChar(32)
  visibility    String   @default("tenant") @db.VarChar(16)
  entityId      String?  @map("entity_id") @db.Uuid
  slug          String
  title         String
  aliases       String[] @default([])
  tags          String[] @default([])
  source        String   @db.VarChar(24)
  sourceRef     String?  @map("source_ref")
  provenance    String   @default("human") @db.VarChar(32)
  sections      Json     @default("[]") @map("sections_jsonb")
  schemaVersion Int      @default(1) @map("schema_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Phase 1 governance/temporal fields (blueprint Table 19), additive only.
  // Populated by the candidate write path (1B) and confirm/correct/forget
  // verbs (1D). Existing rows backfill to status='active', trainingUse=
  // 'excluded', exportable=true (see migration for defaults).
  status            String    @default("active") @db.VarChar(16)
  lastConfirmedAt   DateTime? @map("last_confirmed_at") @db.Timestamptz(6)
  reviewCadenceDays Int?      @map("review_cadence_days")
  supersedesId      String?   @map("supersedes_id") @db.Uuid
  contradictsId     String?   @map("contradicts_id") @db.Uuid
  sensitivity       String    @default("normal") @db.VarChar(16)
  retentionPolicy   Json?     @map("retention_policy_jsonb")
  legalHold         Boolean   @default(false) @map("legal_hold")
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy         String?   @map("revoked_by") @db.Uuid
  exportable        Boolean   @default(true)
  trainingUse       String    @default("excluded") @map("training_use") @db.VarChar(16)
  /// Phase 4 — extraction confidence [0,1]; NULL = unscored (human/legacy),
  /// read as the NEUTRAL prior at recall (never demoted). Backfilled from
  /// clio_memory.metadata_jsonb.confidence over the clio: projection linkage.
  confidence        Float?
  /// Phase 6 — governed-ingestion provenance. ingestRunId links to the
  /// memory_ingest_run pass that wrote/refreshed this row; reviewState is
  /// 'auto' (structural/derived, no review needed), 'unreviewed' (a content
  /// projection awaiting a human confirm in the learned-surface UI), or
  /// 'confirmed'. Default 'auto' ⇒ existing rows + recall unchanged.
  ingestRunId       String?   @map("ingest_run_id") @db.Uuid
  ingestedAt        DateTime? @map("ingested_at") @db.Timestamptz(6)
  reviewState       String    @default("auto") @map("review_state") @db.VarChar(16)

  // G2 (20260713020000_memory_client_scope_ephemeral) — ephemeral/working memory.
  // NULL = durable (every pre-G2 row). The RLS expiry predicate that hides an
  // expired row ships in 20260713030000_memory_items_expiry_rls.
  //
  // SQL-ONLY: PARTIAL INDEX memory_items_expiry_idx (tenant_id, expires_at)
  //   WHERE expires_at IS NOT NULL.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  // ── MeriV2 Phase 3 governance (20260729010000_memory_governance_context_v2) ──
  // Conservative defaults deliberately carry NO approval and NO authority:
  // memoryClass/memoryAuthority default to 'legacy_unclassified' (a quarantine
  // state, never active authority) and governedStatus to 'pending_review'.
  // Every read/write today goes through $queryRaw; these are modelled so
  // `prisma migrate dev` cannot propose dropping them.
  //
  // SQL-ONLY (not expressible in Prisma — see the migration):
  //   CHECK memory_items_memory_class_check, _authority_check, _scope_check,
  //     _governed_status_check, _conflict_status_check, _source_excerpt_cap_check,
  //     _confidence_range_check, _ephemeral_ttl_check, _instruction_authority_check
  //   PARTIAL INDEX memory_items_review_due_idx (tenant_id, review_due_at)
  //     WHERE governed_status IN ('active','stale','conflicted')
  //   PARTIAL INDEX memory_items_conflict_group_idx (tenant_id, conflict_group_id)
  //     WHERE conflict_group_id IS NOT NULL
  //   PARTIAL INDEX memory_items_source_identity_idx
  //     (tenant_id, source_type, source_id) WHERE source_id IS NOT NULL
  memoryClass            String    @default("legacy_unclassified") @map("memory_class") @db.VarChar(40)
  memoryAuthority        String    @default("legacy_unclassified") @map("memory_authority") @db.VarChar(40)
  memoryScope            String    @default("firm") @map("memory_scope") @db.VarChar(24)
  governedStatus         String    @default("pending_review") @map("governed_status") @db.VarChar(24)
  sourceType             String    @default("unknown") @map("source_type") @db.VarChar(40)
  sourceId               String?   @map("source_id")
  sourceExcerpt          String?   @map("source_excerpt")
  sourceContentHash      String?   @map("source_content_hash") @db.VarChar(96)
  sourceVersion          String?   @map("source_version") @db.VarChar(160)
  assertedByUserId       String?   @map("asserted_by_user_id") @db.Uuid
  approvedByUserId       String?   @map("approved_by_user_id") @db.Uuid
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz(6)
  secondApprovedByUserId String?   @map("second_approved_by_user_id") @db.Uuid
  secondApprovedAt       DateTime? @map("second_approved_at") @db.Timestamptz(6)
  asOf                   DateTime? @map("as_of") @db.Timestamptz(6)
  effectiveFrom          DateTime? @map("effective_from") @db.Timestamptz(6)
  validUntil             DateTime? @map("valid_until") @db.Timestamptz(6)
  reviewDueAt            DateTime? @map("review_due_at") @db.Timestamptz(6)
  conflictStatus         String    @default("none") @map("conflict_status") @db.VarChar(24)
  conflictGroupId        String?   @map("conflict_group_id") @db.Uuid
  /// Winning row of `conflictGroupId`. Deliberately NO FK in the migration (a
  /// conflict group is resolved by application policy, and a controlling row may
  /// be revoked without cascading), so it stays a bare uuid here too.
  controllingItemId      String?   @map("controlling_item_id") @db.Uuid
  originSurface          String?   @map("origin_surface") @db.VarChar(48)
  originTraceId          String?   @map("origin_trace_id") @db.VarChar(160)
  /// context_packet.id this item was extracted from. No FK in the migration —
  /// packets are prunable trace data and must not pin memory rows.
  originContextPacketId  String?   @map("origin_context_packet_id") @db.Uuid
  originModel            String?   @map("origin_model") @db.VarChar(160)
  originPromptVersion    String?   @map("origin_prompt_version") @db.VarChar(80)
  instructionsAllowed    Boolean   @default(false) @map("instructions_allowed")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  edges     MemoryEdge[]
  ingestRun MemoryIngestRun? @relation(fields: [ingestRunId], references: [id], onDelete: SetNull)

  supersedes     MemoryItem?  @relation("MemoryItemSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   MemoryItem[] @relation("MemoryItemSupersession")
  contradicts    MemoryItem?  @relation("MemoryItemContradiction", fields: [contradictsId], references: [id], onDelete: SetNull)
  contradictedBy MemoryItem[] @relation("MemoryItemContradiction")

  // Candidate lineage back-relations (20260729011000_memory_governance_lineage).
  duplicateCandidates     MemoryCandidate[] @relation("MemoryCandidateDuplicateItem")
  contradictingCandidates MemoryCandidate[] @relation("MemoryCandidateContradictsItem")
  committedCandidates     MemoryCandidate[] @relation("MemoryCandidateCommittedItem")

  @@unique([tenantId, type, slug], map: "memory_items_tenant_type_slug_unique")
  @@index([tenantId, clientId], map: "memory_items_tenant_client_idx")
  @@index([tenantId, visibility, ownerUserId], map: "memory_items_tenant_visibility_owner_idx")
  @@index([tenantId, type], map: "memory_items_tenant_type_idx")
  @@index([entityId], map: "memory_items_entity_idx")
  @@index([tenantId, status], map: "memory_items_tenant_status_idx")
  @@index([tenantId, governedStatus, memoryClass, memoryScope, clientId], map: "memory_items_governed_recall_idx")
  @@map("memory_items")
}

/// Directed graph edge derived from a `[[type:slug]]` wikilink in an item's
/// markdown (criterion #5). Merged with DB FKs to feed the Intelligence Center
/// knowledge-graph tab. Re-derived on every save, so it is a cache.
model MemoryEdge {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  srcItemId String   @map("src_item_id") @db.Uuid
  relation  String   @default("mentions") @db.VarChar(32)
  dstType   String   @map("dst_type") @db.VarChar(32)
  dstSlug   String   @map("dst_slug")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  src    MemoryItem @relation(fields: [srcItemId], references: [id], onDelete: Cascade)

  @@unique([srcItemId, relation, dstType, dstSlug], map: "memory_edges_unique")
  @@index([tenantId, dstType, dstSlug], map: "memory_edges_tenant_dst_idx")
  @@map("memory_edges")
}

/// Phase 1 (1B) — candidate lifecycle for memory writes (blueprint §4.6.5).
/// A write NEVER lands in clio_memory/memory_items directly anymore; it
/// first becomes a candidate row here, which `evaluateMemoryCandidate`
/// (memory-candidate-rules.ts) resolves to PASS (auto-commit, same
/// transaction cycle) or WARN (stays 'pending' until an admin approves/
/// rejects it via memory.controller.ts). `payload_jsonb` carries exactly
/// what MeriToolsService.saveMemory needs to commit later: key/value/source/
/// scope/ownerUserId. `committed_memory_id` points at the `clio_memory` row
/// once committed (clio_memory stays the fast write/recall path per D1;
/// memory_items remains the write-through governance projection).
model MemoryCandidate {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  proposedBy String  @map("proposed_by") @db.Uuid
  sourceKind String  @map("source_kind") @db.VarChar(24) // explicit_user | workflow_event | artifact_approval | model_extraction | settings_sections
  scope      String  @db.VarChar(16) // personal | firm | client (G2)
  /// G2: set iff scope='client' — the client the proposed memory belongs to.
  clientId   String? @map("client_id") @db.Uuid
  payload    Json    @map("payload_jsonb")
  provenance Json    @map("provenance_jsonb")

  /// Phase 2 immutable revision lineage. Prisma owns the database shape,
  /// while lifecycle mutations are restricted to the locked
  /// create_memory_candidate_revision SQL function.
  revisionRootId         String?   @map("revision_root_id") @db.Uuid
  predecessorCandidateId String?   @map("predecessor_candidate_id") @db.Uuid
  revisionNumber         Int       @default(1) @map("revision_number")
  supersededById         String?   @map("superseded_by_id") @db.Uuid
  duplicateOfId          String?   @map("duplicate_of_id") @db.Uuid
  contradictsId          String?   @map("contradicts_id") @db.Uuid
  status                 String    @default("pending") @db.VarChar(16) // pending | approved | rejected | auto_committed
  /// Phase 4 — extraction confidence [0,1] for the proposed memory; NULL =
  /// unscored (explicit human save). Drives the model_extraction low-confidence
  /// review rule (memory-candidate-rules.ts).
  confidence             Float?
  decidedBy              String?   @map("decided_by") @db.Uuid
  decidedAt              DateTime? @map("decided_at") @db.Timestamptz(6)
  committedMemoryId      String?   @map("committed_memory_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // ── MeriV2 Phase 3 governance (20260729010000_memory_governance_context_v2) ──
  // The legacy `scope`/`status` columns above are RETAINED untouched for
  // rollback; `memoryScope`/`governedStatus` are the v2 vocabulary and were
  // backfilled from them by the migration. governedStatus defaults to
  // 'suggested' (weaker than memory_items' 'pending_review') so a brand-new
  // candidate is not implicitly queued for review.
  //
  // SQL-ONLY (not expressible in Prisma — see the migration):
  //   CHECK memory_candidate_memory_class_check, _authority_check, _scope_check,
  //     _governed_status_check, _conflict_status_check, _source_excerpt_cap_check,
  //     _confidence_range_check, _ephemeral_ttl_check
  //   PARTIAL INDEX memory_candidate_source_identity_idx
  //     (tenant_id, source_type, source_id) WHERE source_id IS NOT NULL
  //   PARTIAL INDEX memory_candidate_duplicate_item_idx / _contradicts_item_idx /
  //     _committed_item_idx (tenant_id, <col>) WHERE <col> IS NOT NULL
  memoryClass            String    @default("legacy_unclassified") @map("memory_class") @db.VarChar(40)
  memoryAuthority        String    @default("legacy_unclassified") @map("memory_authority") @db.VarChar(40)
  memoryScope            String    @default("firm") @map("memory_scope") @db.VarChar(24)
  governedStatus         String    @default("suggested") @map("governed_status") @db.VarChar(24)
  sourceType             String    @default("unknown") @map("source_type") @db.VarChar(40)
  sourceId               String?   @map("source_id")
  sourceRef              String?   @map("source_ref")
  sourceExcerpt          String?   @map("source_excerpt")
  sourceContentHash      String?   @map("source_content_hash") @db.VarChar(96)
  sourceVersion          String?   @map("source_version") @db.VarChar(160)
  assertedByUserId       String?   @map("asserted_by_user_id") @db.Uuid
  approvedByUserId       String?   @map("approved_by_user_id") @db.Uuid
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz(6)
  secondApprovedByUserId String?   @map("second_approved_by_user_id") @db.Uuid
  secondApprovedAt       DateTime? @map("second_approved_at") @db.Timestamptz(6)
  asOf                   DateTime? @map("as_of") @db.Timestamptz(6)
  effectiveFrom          DateTime? @map("effective_from") @db.Timestamptz(6)
  validUntil             DateTime? @map("valid_until") @db.Timestamptz(6)
  expiresAt              DateTime? @map("expires_at") @db.Timestamptz(6)
  reviewCadenceDays      Int?      @map("review_cadence_days")
  reviewDueAt            DateTime? @map("review_due_at") @db.Timestamptz(6)
  conflictStatus         String    @default("none") @map("conflict_status") @db.VarChar(24)
  conflictGroupId        String?   @map("conflict_group_id") @db.Uuid
  /// No FK in the migration — mirrors memory_items.controlling_item_id.
  controllingItemId      String?   @map("controlling_item_id") @db.Uuid
  sensitivity            String    @default("normal") @db.VarChar(24)
  retentionPolicy        Json?     @map("retention_policy_jsonb")
  legalHold              Boolean   @default(false) @map("legal_hold")
  originSurface          String?   @map("origin_surface") @db.VarChar(48)
  originTraceId          String?   @map("origin_trace_id") @db.VarChar(160)
  /// No FK in the migration — mirrors memory_items.origin_context_packet_id.
  originContextPacketId  String?   @map("origin_context_packet_id") @db.Uuid
  originModel            String?   @map("origin_model") @db.VarChar(160)
  originPromptVersion    String?   @map("origin_prompt_version") @db.VarChar(80)
  instructionsAllowed    Boolean   @default(false) @map("instructions_allowed")

  // ── Candidate → item lineage (20260729011000_memory_governance_lineage) ──
  // Distinct from the legacy `duplicateOfId` (candidate → candidate) and
  // `contradictsId` / `committedMemoryId` (bare uuids, no FK): these three DO
  // carry real FKs to memory_items with ON DELETE SET NULL.
  duplicateMemoryItemId   String? @map("duplicate_memory_item_id") @db.Uuid
  contradictsMemoryItemId String? @map("contradicts_memory_item_id") @db.Uuid
  committedMemoryItemId   String? @map("committed_memory_item_id") @db.Uuid

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  duplicateOf MemoryCandidate?  @relation("MemoryCandidateDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  MemoryCandidate[] @relation("MemoryCandidateDuplicate")

  revisionRoot MemoryCandidate?  @relation("MemoryCandidateRevisionRoot", fields: [tenantId, revisionRootId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "memory_candidate_revision_root_fk")
  revisions    MemoryCandidate[] @relation("MemoryCandidateRevisionRoot")
  predecessor  MemoryCandidate?  @relation("MemoryCandidatePredecessor", fields: [tenantId, predecessorCandidateId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "memory_candidate_predecessor_fk")
  successors   MemoryCandidate[] @relation("MemoryCandidatePredecessor")
  supersededBy MemoryCandidate?  @relation("MemoryCandidateSupersession", fields: [tenantId, supersededById], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "memory_candidate_superseded_by_fk")
  supersedes   MemoryCandidate[] @relation("MemoryCandidateSupersession")

  duplicateMemoryItem   MemoryItem? @relation("MemoryCandidateDuplicateItem", fields: [duplicateMemoryItemId], references: [id], onDelete: SetNull)
  contradictsMemoryItem MemoryItem? @relation("MemoryCandidateContradictsItem", fields: [contradictsMemoryItemId], references: [id], onDelete: SetNull)
  committedMemoryItem   MemoryItem? @relation("MemoryCandidateCommittedItem", fields: [committedMemoryItemId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id], map: "memory_candidate_tenant_id_id_unique")
  @@index([tenantId, status], map: "memory_candidate_tenant_status_idx")
  @@index([tenantId, proposedBy], map: "memory_candidate_tenant_proposed_by_idx")
  @@index([tenantId, governedStatus, memoryClass, clientId, createdAt(sort: Desc)], map: "memory_candidate_governed_queue_idx")
  @@map("memory_candidate")
}

/// Phase 6 — governed-ingestion provenance ledger. One row per backfill / cron /
/// write-through / correction pass into the memory store, capturing actor +
/// trigger + counts, so every projected memory_items row can be traced to an
/// auditable pass (memory_items.ingest_run_id). RLS-FORCED on tenant_id.
model MemoryIngestRun {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// cron | manual_backfill | write_through | correction (CHECK-enforced).
  trigger     String    @db.VarChar(24)
  actorUserId String?   @map("actor_user_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  /// running | completed | failed (CHECK-enforced).
  status      String    @default("running") @db.VarChar(16)
  counts      Json      @default("{}") @map("counts_jsonb")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MemoryItem[]

  @@index([tenantId, startedAt(sort: Desc)], map: "memory_ingest_run_tenant_started_idx")
  @@map("memory_ingest_run")
}

/// MeriV2 Phase 3 (20260729010000_memory_governance_context_v2) — fine-grained
/// edit/review/approval grant over governed memory. Deliberately NOT an overload
/// of `client_memory_access`, whose existing meaning is ethical-wall READ
/// permission. clientId NULL = a firm-wide grant. RLS-FORCED on tenant_id.
///
/// SQL-ONLY (not expressible in Prisma — see the migration):
///   CHECK memory_access_grant_status_check (status IN ('active','revoked','expired'))
///   CHECK memory_access_grant_permissions_check (permissions <@ the 8-verb vocabulary:
///     propose, review, approve, edit, confirm, mark_stale, revoke, resolve_conflict)
///   PARTIAL UNIQUE INDEX memory_access_grant_unique_active
///     (tenant_id, client_id, user_id) WHERE status = 'active' — deliberately
///     NOT declared as @@unique here: a full unique key would be a lie (it would
///     forbid an 'active' grant coexisting with a prior 'revoked' one for the
///     same triple) and would expose an unsound findUnique/upsert on the client.
model MemoryAccessGrant {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  clientId        String?   @map("client_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  permissions     String[]  @default([])
  status          String    @default("active") @db.VarChar(16)
  /// Granter (plain uuid, no FK — mirrors ClientMemoryAccess.grantedBy; survives
  /// the granter's departure).
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  reason          String?
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User    @relation("MemoryAccessGrantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status], map: "memory_access_grant_user_idx")
  @@map("memory_access_grant")
}

/// MeriV2 Phase 3 (20260729010000_memory_governance_context_v2) — immutable SOC 2
/// evidence for governed-memory lifecycle transitions. Ids/status/reason ONLY;
/// never a memory body. `effectiveTenantId` is the tenant the actor was operating
/// as (impersonation-aware) and is NOT NULL. memoryItemId / memoryCandidateId
/// deliberately carry NO FK so audit evidence outlives its subject.
///
/// SQL-ONLY (not expressible in Prisma — see the migration):
///   CHECK memory_transition_exact_subject_check (exactly one of memory_item_id /
///     memory_candidate_id is non-NULL)
///   CHECK memory_transition_metadata_size_check (metadata_jsonb <= 32 KiB)
model MemoryTransitionAudit {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  memoryItemId           String?  @map("memory_item_id") @db.Uuid
  memoryCandidateId      String?  @map("memory_candidate_id") @db.Uuid
  actorUserId            String?  @map("actor_user_id") @db.Uuid
  effectiveTenantId      String   @map("effective_tenant_id") @db.Uuid
  clientId               String?  @map("client_id") @db.Uuid
  fromStatus             String?  @map("from_status") @db.VarChar(24)
  toStatus               String   @map("to_status") @db.VarChar(24)
  reasonCode             String   @map("reason_code") @db.VarChar(48)
  reason                 String
  sourceType             String?  @map("source_type") @db.VarChar(40)
  sourceId               String?  @map("source_id")
  proposalId             String?  @map("proposal_id") @db.Uuid
  impersonationSessionId String?  @map("impersonation_session_id") @db.Uuid
  metadata               Json     @default("{}") @map("metadata_jsonb")
  occurredAt             DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt(sort: Desc)], map: "memory_transition_audit_tenant_time_idx")
  @@index([tenantId, memoryItemId, occurredAt(sort: Desc)], map: "memory_transition_audit_item_idx")
  @@index([tenantId, memoryCandidateId, occurredAt(sort: Desc)], map: "memory_transition_audit_candidate_idx")
  @@map("memory_transition_audit")
}

/// MeriV2 Phase 3 (20260729010000_memory_governance_context_v2) — durable,
/// idempotent cleanup of SECONDARY projections (clio_memory rows, embeddings,
/// vault files) after recall has already been suppressed synchronously by the
/// governed status. memoryItemId / clioMemoryId carry no FK: the outbox row must
/// survive long enough to delete what the item pointed at.
///
/// SQL-ONLY (not expressible in Prisma — see the migrations):
///   CHECK memory_cleanup_status_check (status IN ('pending','running','completed','failed'))
///   CHECK memory_cleanup_operation_check — widened by
///     20260729011000_memory_governance_lineage to: index_memory_item,
///     revoke_projections, supersede_projections, expire_projections,
///     purge_projections
model MemoryCleanupOutbox {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// Subject for projection-DELETION jobs. NULLABLE as of
  /// 20260811040000_memory_index_outbox_subject: an `index_memory_item` job is
  /// enqueued in the same transaction as the clio_memory write, BEFORE the
  /// memory_items row exists (projectClioMemory is what creates it), so it names
  /// clioMemoryId instead. memory_cleanup_subject_present_check requires that at
  /// least one of the two columns is set.
  memoryItemId   String?   @map("memory_item_id") @db.Uuid
  clioMemoryId   String?   @map("clio_memory_id") @db.Uuid
  operation      String    @db.VarChar(32)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(192)
  status         String    @default("pending") @db.VarChar(16)
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey], map: "memory_cleanup_outbox_idempotency_key")
  @@index([status, nextAttemptAt, createdAt], map: "memory_cleanup_outbox_pending_idx")
  @@map("memory_cleanup_outbox")
}

// ─────────────────────────────────────────────────────────────────────────
// MeriV2 (P0-T7) — first-class Claim/Evidence store (data warehouse #5) +
// Compliance/Audit store (#6). Additive promotion of evidence that today is
// embedded JSON on program_element_delta / action_recommendation /
// provision_pe_link. Tenant-scoped with RLS via the tracked_bill /
// notification_log convention (tenant_id column + policy, no Tenant FK).
// ─────────────────────────────────────────────────────────────────────────

/// A discrete, attributable statement MeriV2 asserts about a subject. Every
/// claim surfaced in an artifact must carry >= 1 Evidence row (SC3.3);
/// unsupported claims are flagged, not emitted.
model Claim {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  subjectType         String    @map("subject_type") // 'client' | 'bill' | 'program_element' | 'member' | ...
  subjectId           String    @map("subject_id")
  statement           String    @db.Text
  confidence          String    @default("unknown") // 'high' | 'medium' | 'low' | 'unknown'
  freshnessAt         DateTime? @map("freshness_at") @db.Timestamptz(6)
  userEdited          Boolean   @default(false) @map("user_edited")
  originalStatement   String?   @map("original_statement") @db.Text
  // Forward-referenced ids (ClioArtifact / Phase-5 TranscriptSegment); kept as
  // plain uuid columns (no FK) so this store does not couple to those tables.
  artifactId          String?   @map("artifact_id") @db.Uuid
  transcriptSegmentId String?   @map("transcript_segment_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidence Evidence[]

  @@index([tenantId])
  @@index([tenantId, subjectType, subjectId])
  @@index([artifactId])
  @@map("claim")
}

/// A source citation backing a Claim (Appendix B canonical ids). tenant_id is
/// denormalized from the parent Claim for RLS defense-in-depth.
model Evidence {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  claimId    String   @map("claim_id") @db.Uuid
  sourceType String   @map("source_type") // 'congress_bill' | 'lda_filing' | 'transcript_segment' | ...
  sourceId   String   @map("source_id")
  url        String?
  quote      String?  @db.Text
  pageNumber Int?     @map("page_number")
  accessedAt DateTime @map("accessed_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([claimId])
  @@map("evidence")
}

/// PASS/WARN/BLOCK record written by the Phase-2 compliance precheck engine —
/// warehouse #6, the system of record for approval gates.
model ComplianceCheck {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  trigger            String // 'send_email' | 'lda_threshold' | 'gift_travel' | 'fara_risk' | ...
  decision           String // 'PASS' | 'WARN' | 'BLOCK'
  reason             String   @db.Text
  ruleSource         String?  @map("rule_source")
  policyPackKey      String?  @map("policy_pack_key") @db.VarChar(120)
  policyPackVersion  String?  @map("policy_pack_version") @db.VarChar(80)
  policyBinding      String?  @map("policy_binding") @db.VarChar(280)
  policyDecisionHash String?  @map("policy_decision_hash") @db.VarChar(64)
  requiredApproval   Boolean  @default(false) @map("required_approval")
  actorUserId        String?  @map("actor_user_id") // clerk user id of the actor, if any
  entityType         String?  @map("entity_type")
  entityId           String?  @map("entity_id")
  occurredAt         DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, trigger])
  @@map("compliance_check")
}

// ─────────────────────────────────────────────────────────────────────────
// BUDGET LINES / MONEY GRAPH (BL-0 — budget-lines-ui-implementation-plan.md §2,
// object model per defense-money-graph-consolidated-plan.md §1.2/§1.3/§1.6).
// GLOBAL tables (no tenant_id / RLS): public-domain budget data, same as
// program_element / federal_award. All derived rows are regenerable from their
// source tables — derive verbs delete-and-rewrite their own derivedBy cohort,
// so nothing here is ever hand-edited in place.
// ─────────────────────────────────────────────────────────────────────────

/// §1.2 — one normalized committee/appropriations event per (line, fy, stage,
/// action), derived deterministically from program_element_year marks by
/// derive-budget-actions. Powers the Movement feed, watchlist signal feed,
/// catalog Signal chips, and the 360 Legislation tab's action list.
/// stage: PB|HASC|SASC|HAC_D|SAC_D|CONF|ENACTED (REPROG/SUPP reserved for
/// report-language/reprogramming ingests that don't exist yet).
/// action: add|cut|new_start|termination (hold|transfer|rescission reserved).
model BudgetAction {
  id           String   @id @default(uuid()) @db.Uuid
  peCode       String   @map("pe_code") @db.VarChar(16)
  fy           Int
  stage        String   @db.VarChar(12)
  action       String   @db.VarChar(16)
  /// Signed $ MILLIONS measured against `baseline`; null for non-monetary events.
  amount       Decimal? @db.Decimal(14, 2)
  /// What `amount` is measured against: request|prior_stage|prior_year.
  baseline     String   @db.VarChar(12)
  /// Render-safe one-liner ("SASC +$42.0M over request").
  note         String?  @db.Text
  /// §1.4 provenance: the source numbers this action was derived from.
  evidenceJson Json     @default("{}") @map("evidence_jsonb")
  /// Bill that asserted this action, when attributable (LEG-B; null until the
  /// marks ingestion carries bill identity — never inferred).
  billId       String?  @map("bill_id")
  derivedBy    String   @map("derived_by") @db.VarChar(48)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([peCode, fy, stage, action], map: "budget_action_natural_key")
  @@index([peCode], map: "budget_action_pe_code_idx")
  @@index([fy, stage], map: "budget_action_fy_stage_idx")
  @@index([action], map: "budget_action_action_idx")
  @@map("budget_action")
}

/// §1.3 — typed, evidence-bearing edge between two budget lines. status
/// 'candidate' edges render dashed + labeled and are NEVER silently promoted;
/// acceptance is a human review action (mirrors PeProgramMatch discipline).
model BudgetLineRelationship {
  id           String   @id @default(uuid()) @db.Uuid
  fromPeCode   String   @map("from_pe_code") @db.VarChar(16)
  toPeCode     String   @map("to_pe_code") @db.VarChar(16)
  /// related_pe_exhibit|same_program|rdte_to_procurement|procurement_to_om|
  /// predecessor_successor|same_capability
  relType      String   @map("rel_type") @db.VarChar(40)
  confidence   String   @db.VarChar(8) // high|med|low
  status       String   @default("accepted") @db.VarChar(12) // accepted|candidate
  /// Human-readable evidence ("P-40 'Related PEs' lists 0604011A").
  evidence     String   @db.Text
  evidenceJson Json     @default("{}") @map("evidence_jsonb")
  derivedBy    String   @map("derived_by") @db.VarChar(48)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([fromPeCode, toPeCode, relType], map: "budget_line_relationship_natural_key")
  @@index([fromPeCode], map: "budget_line_relationship_from_idx")
  @@index([toPeCode], map: "budget_line_relationship_to_idx")
  @@index([relType], map: "budget_line_relationship_type_idx")
  @@map("budget_line_relationship")
}

/// §1.6 — curated demand-side capability ("I sell X — where's the money?").
/// Seeded from scripts/__data__/corrected_json/capabilities_seed.json by
/// seed-capabilities; grown only by curation, never by unreviewed inference.
model Capability {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(32)
  name         String
  /// Search aliases ("GPS-denied", "alt-nav", "M-code").
  aliases      String[] @default([])
  /// Two-level taxonomy path ("Autonomy › Positioning & Timing").
  taxonomyPath String   @map("taxonomy_path")
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  matches CapabilityBudgetLineMatch[]

  @@map("capability")
}

/// Capability ↔ budget line match with auditable evidence. matchedOn records
/// exactly which signal produced the match ('title_keyword:PNT',
/// 'description_keyword:counter-UAS', 'curated'), so the finder can always
/// answer "why is this line recommended?".
model CapabilityBudgetLineMatch {
  id           String   @id @default(uuid()) @db.Uuid
  capabilityId String   @map("capability_id") @db.Uuid
  peCode       String   @map("pe_code") @db.VarChar(16)
  confidence   String   @db.VarChar(8) // high|med|low
  matchedOn    String   @map("matched_on")
  status       String   @default("accepted") @db.VarChar(12) // accepted|candidate|rejected
  derivedBy    String   @map("derived_by") @db.VarChar(48)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, peCode], map: "capability_budget_line_match_natural_key")
  @@index([peCode], map: "capability_budget_line_match_pe_idx")
  @@map("capability_budget_line_match")
}

/// Catalog-sortable engine outputs, refreshed wholesale by
/// derive-intelligence-cache (delete-and-rewrite). One row per live budget
/// line. The per-PE intelligence endpoint still computes live; this cache
/// exists so the CATALOG can filter/sort thousands of lines by maturity /
/// appropriability / signal without running engines per row per request.
model ProgramElementIntelligenceCache {
  peCode        String   @id @map("pe_code") @db.VarChar(16)
  /// RDTE_PE|PROCUREMENT_BLIN|OM_BLI (MILCON_PROJECT/TRANSFER/CLASSIFIED reserved).
  lineType      String?  @map("line_type") @db.VarChar(20)
  /// Transition-maturity rung 0-5 (F19); null when not applicable/classifiable.
  maturity      Int?
  /// Full ladder: rungs with reached/evidence strings.
  maturityJson  Json     @default("{}") @map("maturity_jsonb")
  appropTier    String?  @map("approp_tier") @db.VarChar(8) // high|med|low
  appropScore   Int?     @map("approp_score")
  /// Factor breakdown incl. unscored factors (F27) — per-factor evidence.
  appropJson    Json     @default("{}") @map("approp_jsonb")
  /// Latest budget_action on the line: add|cut|new_start|termination|... + tone.
  signalType    String?  @map("signal_type") @db.VarChar(16)
  signalTone    String?  @map("signal_tone") @db.VarChar(12)
  signalFy      Int?     @map("signal_fy")
  valleyOfDeath Boolean  @default(false) @map("valley_of_death")
  postureJson   Json     @default("{}") @map("posture_jsonb")
  anomaliesJson Json     @default("[]") @map("anomalies_jsonb")
  computedAt    DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@index([lineType], map: "pe_intelligence_cache_line_type_idx")
  @@index([appropScore], map: "pe_intelligence_cache_approp_idx")
  @@index([signalType], map: "pe_intelligence_cache_signal_idx")
  @@map("program_element_intelligence_cache")
}

/// Bill ↔ budget-line link with typed evidence (legislative-timeline plan
/// LEG-B; consolidated plan §1.5). Replaces the flat CongressBill.peCodes
/// array as the system of record for WHY a bill is linked to a line — the
/// array stays for back-compat/GIN-filtered list queries, this table carries
/// the evidence. GLOBAL (no tenant_id / RLS), public-domain congressional data.
/// Mirrors ProvisionPeLink review discipline: only a verbatim PE code in
/// official bill text is auto-accepted; everything fuzzier lands candidate.
model BillBudgetLineLink {
  id           String    @id @default(uuid()) @db.Uuid
  billId       String    @map("bill_id")
  peCode       String    @map("pe_code") @db.VarChar(16)
  /// explicit_pe_code | budget_table_row | committee_mark_row | report_language
  /// | title_match | manual
  linkType     String    @map("link_type") @db.VarChar(24)
  confidence   Float     @default(1.0)
  /// Render-safe evidence ('Found in enrolled bill text: "…0603270A…"').
  evidence     String    @db.Text
  evidenceJson Json      @default("{}") @map("evidence_jsonb")
  status       String    @default("accepted") @db.VarChar(12) // accepted|candidate|rejected
  derivedBy    String    @map("derived_by") @db.VarChar(48)
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([billId, peCode, linkType], map: "bill_budget_line_link_natural_key")
  @@index([peCode], map: "bill_budget_line_link_pe_idx")
  @@index([billId], map: "bill_budget_line_link_bill_idx")
  @@map("bill_budget_line_link")
}

// ─────────────────────────────────────────────────────────────────────────────
// Defense budget packages (Release R3, plan §3.1)
//
// GLOBAL public-domain data — no tenant_id, no RLS, exactly like source_document /
// committee_report_provision / bill_budget_line_link. Legislative vehicles,
// official funding positions, CR periods, and public laws are public facts: ONE
// global record no matter how many tenants read it. capiro_app is auto-granted by
// the ALTER DEFAULT PRIVILEGES installed in 20260502020000_capiro_app_role.
//
// EVERY amount is stored in MILLIONS of dollars, and is only meaningful alongside
// its (fiscalYear, stage, vehicleClass, scope, source).
// ─────────────────────────────────────────────────────────────────────────────

/// One budget cycle for one domain, e.g. ('defense', 2027) = "FY27 Defense Budget".
/// Parent of every vehicle and funding position in that cycle.
model BudgetPackage {
  id         String   @id @default(uuid()) @db.Uuid
  /// Budget domain. 'defense' initially; the model is domain-generic on purpose.
  domain     String   @db.VarChar(24)
  fiscalYear Int      @map("fiscal_year")
  /// Display name, e.g. 'FY27 Defense Budget'.
  name       String
  /// 'open' | 'enacted' | 'lapsed' | 'closed' — cycle rollup, not a vehicle status.
  status     String   @default("open") @db.VarChar(24)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicles  BudgetPackageVehicle[]
  positions FundingPosition[]

  @@unique([domain, fiscalYear], map: "budget_package_domain_fy_key")
  @@index([domain, fiscalYear], map: "budget_package_domain_fy_idx")
  @@map("budget_package")
}

/// One legislative vehicle inside a package: the presidential request, a chamber
/// NDAA, a defense-appropriations bill, a conference report, a CR, a supplemental,
/// or the enacted public law.
///
/// A package MAY have MULTIPLE vehicles at the same (track, stage) — a chamber can
/// move more than one bill, and omnibus/minibus/supplemental vehicles coexist.
/// Nothing may assume one row per stage forever (§3.2, §5 edge cases 21-22).
model BudgetPackageVehicle {
  id               String    @id @default(uuid()) @db.Uuid
  packageId        String    @map("package_id") @db.Uuid
  /// @capiro/shared BUDGET_VEHICLE_CLASSES: request | authorization | appropriation
  /// | interim_funding | supplemental | reconciliation.
  track            String    @db.VarChar(24)
  /// @capiro/shared FUNDING_STAGES: president | house | senate | conference | enacted.
  stage            String    @db.VarChar(16)
  /// Canonical congress_bill id when the vehicle IS a bill. No FK: congress_bill is
  /// loaded by a separate pipeline and a vehicle can be announced before the row lands.
  billId           String?   @map("bill_id")
  /// Committee/conference report number, e.g. 'H. Rept. 119-512'.
  reportNumber     String?   @map("report_number")
  /// Public law number once enacted, e.g. 'P.L. 119-86'.
  publicLaw        String?   @map("public_law")
  chamber          String?   @db.VarChar(16)
  /// Display label, e.g. 'House NDAA (H.R. 8070)'.
  label            String
  /// 'introduced' | 'reported' | 'passed' | 'enacted' | 'failed' | 'expired'.
  status           String    @default("introduced") @db.VarChar(24)
  statusAt         DateTime? @map("status_at") @db.Timestamptz(6)
  sourceDocumentId String?   @map("source_document_id") @db.Uuid
  sourceUrl        String?   @map("source_url")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  package        BudgetPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  positions FundingPosition[]

  @@index([packageId, track, stage], map: "budget_package_vehicle_package_track_stage_idx")
  @@index([billId], map: "budget_package_vehicle_bill_idx")
  @@index([sourceDocumentId], map: "budget_package_vehicle_source_document_idx")
  @@map("budget_package_vehicle")
}

/// One officially-sourced topline dollar figure, in MILLIONS, pinned to a fiscal
/// year, a pipeline stage, a vehicle class, and an exact funding scope.
///
/// HARD RULE (§3.2): a delta may only be computed between two rows with the SAME
/// fiscalYear AND the SAME scope. Core DoD discretionary, Function 050, total
/// national defense, and the defense-appropriations title are DIFFERENT scopes and
/// are never subtracted from one another.
///
/// Authorization and appropriation stay SEPARATE rows, never coalesced into one
/// unlabelled "current" amount (§5 edge case 14).
///
/// verificationStatus is the review ladder: parsers write 'extracted' and NEVER
/// 'verified' (§3.3); a human promotes to 'reviewed' then 'verified'; a figure
/// replaced by a later official number becomes 'superseded' and is KEPT for audit.
/// Live-row uniqueness is a PARTIAL unique index (excluding 'superseded') created in
/// the migration, so history accumulates without breaking the natural key.
model FundingPosition {
  id                 String    @id @default(uuid()) @db.Uuid
  packageId          String    @map("package_id") @db.Uuid
  vehicleId          String?   @map("vehicle_id") @db.Uuid
  /// Denormalized from the vehicle so Bill 360 resolves positions by bill id in ONE
  /// index hit; kept in sync by the loader.
  billId             String?   @map("bill_id")
  fiscalYear         Int       @map("fiscal_year")
  /// @capiro/shared BUDGET_VEHICLE_CLASSES.
  vehicleClass       String    @map("vehicle_class") @db.VarChar(24)
  /// @capiro/shared FUNDING_STAGES.
  stage              String    @db.VarChar(16)
  /// @capiro/shared FUNDING_SCOPES — the measurement basis. NEVER null.
  scope              String    @db.VarChar(40)
  /// Dollars in MILLIONS. Decimal (not float) so reported figures round-trip exactly.
  amountMillions     Decimal   @map("amount_millions") @db.Decimal(14, 2)
  /// When the figure took effect / was published.
  effectiveDate      DateTime? @map("effective_date") @db.Timestamptz(6)
  sourceDocumentId   String?   @map("source_document_id") @db.Uuid
  sourceUrl          String?   @map("source_url")
  sourcePage         Int?      @map("source_page")
  note               String?   @db.Text
  /// @capiro/shared FUNDING_VERIFICATION_STATUSES: extracted | reviewed | verified | superseded.
  verificationStatus String    @default("extracted") @map("verification_status") @db.VarChar(16)
  verifiedByUserId   String?   @map("verified_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  package        BudgetPackage         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  vehicle        BudgetPackageVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  sourceDocument SourceDocument?       @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // NOTE: live-row uniqueness on
  //   (package_id, COALESCE(vehicle_id), fiscal_year, vehicle_class, stage, scope)
  //   WHERE verification_status <> 'superseded'
  // is a partial functional unique index created in the migration raw SQL — Prisma 5
  // cannot express partial/functional unique indexes. Kept queryable here.
  @@index([packageId, vehicleId, fiscalYear, vehicleClass, stage, scope], map: "funding_position_natural_key_idx")
  @@index([packageId, stage, scope], map: "funding_position_package_stage_scope_idx")
  @@index([billId, fiscalYear], map: "funding_position_bill_fy_idx")
  @@index([verificationStatus], map: "funding_position_verification_idx")
  @@index([sourceDocumentId], map: "funding_position_source_document_idx")
  @@map("funding_position")
}

/// One continuing-resolution / lapse window in a fiscal year's funding history:
/// the CR sequence, the date it funded through, whether a lapse (shutdown)
/// followed, and the vehicle/public law that carried it.
///
/// Powers the historical CR + shutdown timeline. R3 creates the table and the
/// loader path; the FY2022-FY2026 backfill and its UI are R4/R7.
model BudgetInterimFundingPeriod {
  id               String    @id @default(uuid()) @db.Uuid
  domain           String    @db.VarChar(24)
  fiscalYear       Int       @map("fiscal_year")
  /// 1-based order within the fiscal year. Gaps are a data error (§3.7).
  sequence         Int
  startDate        DateTime? @map("start_date") @db.Timestamptz(6)
  /// The date this vehicle funded operations THROUGH. Must be >= startDate (§3.7).
  coverageThrough  DateTime? @map("coverage_through") @db.Timestamptz(6)
  /// e.g. 'CR #1 (H.R. 5371)' | 'Full-year CR' | 'Consolidated Approps. Act, 2026'.
  vehicleLabel     String    @map("vehicle_label")
  billId           String?   @map("bill_id")
  publicLaw        String?   @map("public_law")
  /// Days of lapsed appropriations that began at the end of this period. 0 = no lapse.
  shutdownDays     Int?      @map("shutdown_days")
  notes            String?   @db.Text
  sourceDocumentId String?   @map("source_document_id") @db.Uuid
  sourceUrl        String?   @map("source_url")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([domain, fiscalYear, sequence], map: "budget_interim_funding_period_natural_key")
  @@index([domain, fiscalYear, sequence], map: "budget_interim_funding_period_domain_fy_seq_idx")
  @@index([billId], map: "budget_interim_funding_period_bill_idx")
  @@map("budget_interim_funding_period")
}

// ===========================================================================
// ASSURANCE PERSISTENCE (migrations 20260811010000 / 20260811020000 /
// 20260811030000). Every table below is RLS ENABLE + FORCE with a
// <table>_tenant_isolation policy on `app.current_tenant`, and carries NO
// explicit GRANT (capiro_app is covered by ALTER DEFAULT PRIVILEGES).
//
// These models exist so the assurance code can actually REACH the tables through
// Prisma. The governance tables added by 20260729010000 spent a whole phase
// unreachable because their models were missing; this follows the corrected
// pattern rather than extending that drift.
// ===========================================================================

/// A versioned compliance policy pack (packages/meriv2-core/src/assurance/
/// policy-pack.ts, CompliancePolicyPack) with its full lifecycle recorded.
///
/// `packKey` is the stable identity across versions; `version` is the immutable
/// release. A partial unique index enforces AT MOST ONE `published` version per
/// (tenant, packKey) in the database rather than in whichever code path publishes
/// next, and DB CHECKs restate the load-bearing in-code guards: a non-production
/// pack cannot be published, a published pack must carry review + publication
/// attribution, and four-eyes requires two DISTINCT reviewers.
///
/// `rulesHash` is policyPackRulesHash(pack) — tamper evidence over the
/// decision-bearing rule material only, so review/publication churn does not
/// change it but an out-of-band rule edit does.
model CompliancePolicyPack {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  packKey                String    @map("pack_key") @db.VarChar(120)
  version                String    @db.VarChar(80)
  jurisdiction           String    @default("all") @db.VarChar(32)
  /// draft | pending_review | reviewed | published | retired | disabled_example
  status                 String    @default("draft") @db.VarChar(24)
  /// not_required_product_policy | pending | approved | rejected
  legalReviewStatus      String    @default("pending") @map("legal_review_status") @db.VarChar(40)
  /// PolicyAuthority — what authorizes this pack to exist at all.
  authorityJson          Json      @map("authority_jsonb")
  effectiveFrom          DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveUntil         DateTime? @map("effective_until") @db.Timestamptz(6)
  ownerUserId            String    @map("owner_user_id") @db.Uuid
  reviewedByUserId       String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt             DateTime? @map("reviewed_at") @db.Timestamptz(6)
  secondApprovedByUserId String?   @map("second_approved_by_user_id") @db.Uuid
  secondApprovedAt       DateTime? @map("second_approved_at") @db.Timestamptz(6)
  publishedByUserId      String?   @map("published_by_user_id") @db.Uuid
  publishedAt            DateTime? @map("published_at") @db.Timestamptz(6)
  fourEyesRequired       Boolean   @default(true) @map("four_eyes_required")
  rulesJson              Json      @default("[]") @map("rules_jsonb")
  /// PASS | WARN | BLOCK. Defaults to WARN so an unmatched action fails safe.
  fallbackOutcome        String    @default("WARN") @map("fallback_outcome") @db.VarChar(8)
  /// Defaults TRUE: a pack is non-production until someone deliberately says so.
  nonProduction          Boolean   @default(true) @map("non_production")
  rulesHash              String    @map("rules_hash") @db.VarChar(64)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events    CompliancePolicyPackEvent[]
  decisions CompliancePolicyDecision[]

  @@unique([tenantId, packKey, version], map: "compliance_policy_pack_version_unique")
  @@index([tenantId, status, jurisdiction, effectiveFrom(sort: Desc)], map: "compliance_policy_pack_lookup_idx")
  @@map("compliance_policy_pack")
}

/// APPEND-ONLY lifecycle ledger for a policy pack: create / submit_review /
/// review / approve / publish / retire / rollback / simulate. There is no update
/// path — the row IS the evidence. `metadataJson` is size-capped by a DB CHECK so
/// this can never become a place to smuggle a payload dump.
model CompliancePolicyPackEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  policyPackId         String   @map("policy_pack_id") @db.Uuid
  fromStatus           String?  @map("from_status") @db.VarChar(24)
  toStatus             String?  @map("to_status") @db.VarChar(24)
  action               String   @db.VarChar(24)
  actorUserId          String   @map("actor_user_id") @db.Uuid
  actorRole            String   @map("actor_role") @db.VarChar(32)
  /// Set on a rollback: the version rolled back FROM.
  rolledBackFromPackId String?  @map("rolled_back_from_pack_id") @db.Uuid
  reason               String
  note                 String?
  metadataJson         Json     @default("{}") @map("metadata_jsonb")
  occurredAt           DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyPack CompliancePolicyPack @relation(fields: [policyPackId], references: [id], onDelete: Cascade)

  @@index([tenantId, policyPackId, occurredAt(sort: Desc)], map: "compliance_policy_pack_event_pack_idx")
  @@map("compliance_policy_pack_event")
}

/// The SELECTED-VERSION audit: which pack version, and which rule inside it,
/// bound one specific action. Without this there is no way to answer "what policy
/// actually applied on that date" once a pack has been republished.
///
/// `policyPackId` is NULLABLE on purpose so a no-pack-selected FAIL-SAFE decision
/// is still recorded rather than silently unlogged, and `binding`
/// (proposalPolicyBinding: pack@version:rule) survives deletion of the pack row.
/// `simulated` distinguishes a dry run from an enforcement event.
model CompliancePolicyDecision {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  policyPackId         String?  @map("policy_pack_id") @db.Uuid
  packKey              String?  @map("pack_key") @db.VarChar(120)
  packVersion          String?  @map("pack_version") @db.VarChar(80)
  ruleId               String?  @map("rule_id") @db.VarChar(120)
  /// PASS | WARN | BLOCK
  outcome              String   @db.VarChar(8)
  code                 String?  @db.VarChar(48)
  tier                 String?  @db.VarChar(16)
  simulated            Boolean  @default(false)
  binding              String   @db.VarChar(280)
  decisionHash         String   @map("decision_hash") @db.VarChar(64)
  contextHash          String   @map("context_hash") @db.VarChar(64)
  policySource         String   @map("policy_source") @db.VarChar(24)
  policyMode           String   @map("policy_mode") @db.VarChar(16)
  effectiveUserId      String   @map("effective_user_id") @db.Uuid
  effectiveAt          DateTime @map("effective_at") @db.Timestamptz(6)
  tool                 String   @db.VarChar(80)
  channel              String   @db.VarChar(24)
  recipientType        String?  @map("recipient_type") @db.VarChar(24)
  actorUserId          String   @map("actor_user_id") @db.Uuid
  actorRole            String   @map("actor_role") @db.VarChar(32)
  clientId             String?  @map("client_id") @db.Uuid
  jurisdiction         String   @db.VarChar(32)
  meriActionProposalId String?  @map("meri_action_proposal_id") @db.Uuid
  reason               String
  decidedAt            DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyPack CompliancePolicyPack? @relation(fields: [policyPackId], references: [id], onDelete: SetNull)

  @@index([tenantId, decidedAt(sort: Desc)], map: "compliance_policy_decision_recent_idx")
  @@index([tenantId, packKey, packVersion], map: "compliance_policy_decision_version_idx")
  @@index([tenantId, decisionHash], map: "compliance_policy_decision_hash_idx")
  @@map("compliance_policy_decision")
}

/// One evaluation RUN and its category-specific release decision
/// (packages/meriv2-core/src/assurance/eval-gate.ts, ReleaseGateReport).
///
/// `thresholdsJson` stores the thresholds ACTUALLY USED, so a later threshold
/// change cannot retroactively rewrite whether a past release was allowed.
/// `provenanceHash` is unique per tenant, making a re-run of the identical
/// provenance tuple idempotent instead of duplicating history. The sign-off columns
/// cover cost/latency ONLY — there is deliberately no generic override column,
/// because a safety or scope invariant is not waivable.
model AssuranceEvalRun {
  id                         String   @id @default(uuid()) @db.Uuid
  tenantId                   String   @map("tenant_id") @db.Uuid
  gitSha                     String?  @map("git_sha") @db.VarChar(80)
  promptVersion              String?  @map("prompt_version") @db.VarChar(120)
  contextCompilerVersion     String?  @map("context_compiler_version") @db.VarChar(120)
  toolManifestHash           String?  @map("tool_manifest_hash") @db.VarChar(128)
  model                      String?  @db.VarChar(160)
  provider                   String?  @db.VarChar(40)
  datasetVersion             String?  @map("dataset_version") @db.VarChar(120)
  runDate                    DateTime @map("run_date") @db.Timestamptz(6)
  provenanceHash             String   @map("provenance_hash") @db.VarChar(64)
  thresholdsJson             Json     @map("thresholds_jsonb")
  baselineJson               Json?    @map("baseline_jsonb")
  candidateJson              Json?    @map("candidate_jsonb")
  allowed                    Boolean
  blockersJson               Json     @default("[]") @map("blockers_jsonb")
  warningsJson               Json     @default("[]") @map("warnings_jsonb")
  costLatencySignoffByUserId String?  @map("cost_latency_signoff_by_user_id") @db.Uuid
  costLatencySignoffReason   String?  @map("cost_latency_signoff_reason")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  results     AssuranceEvalResult[]
  domainGates AssuranceEvalDomainGate[]

  @@unique([tenantId, provenanceHash], map: "assurance_eval_run_provenance_unique")
  @@index([tenantId, runDate(sort: Desc)], map: "assurance_eval_run_recent_idx")
  @@map("assurance_eval_run")
}

/// One eval CASE outcome within a run. `caseId` is what an accepted feedback
/// fixture key points at (AssuranceEvalFixture.fixtureKey), so a regression traces
/// back to the feedback that created its fixture.
model AssuranceEvalResult {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  evalRunId String  @map("eval_run_id") @db.Uuid
  caseId    String  @map("case_id") @db.VarChar(160)
  /// L0 | L1 | L2 | L3 | L4
  tier      String? @db.VarChar(4)
  domain    String  @db.VarChar(32)
  /// critical | high | medium | low
  severity  String  @db.VarChar(12)
  passed    Boolean
  score     Float?
  threshold Float?
  metric    String? @db.VarChar(48)
  detail    String

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evalRun AssuranceEvalRun @relation(fields: [evalRunId], references: [id], onDelete: Cascade)

  @@unique([evalRunId, caseId], map: "assurance_eval_result_case_unique")
  @@index([tenantId, domain, passed], map: "assurance_eval_result_domain_idx")
  @@map("assurance_eval_result")
}

/// The per-DOMAIN gate verdict, stored as immutable evidence rather than
/// re-derived from AssuranceEvalResult later. Re-derivation would silently change
/// if the summarizer changed; the point is that the per-domain verdict AT RELEASE
/// TIME is a fact on the record — one critical legislative / tenancy / approval /
/// compliance regression blocks release regardless of the average.
model AssuranceEvalDomainGate {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  evalRunId          String  @map("eval_run_id") @db.Uuid
  domain             String  @db.VarChar(32)
  passed             Int
  failed             Int
  criticalFailed     Int     @map("critical_failed")
  highFailed         Int     @map("high_failed")
  minimumScore       Float?  @map("minimum_score")
  blocked            Boolean
  blockerReasonsJson Json    @default("[]") @map("blocker_reasons_jsonb")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evalRun AssuranceEvalRun @relation(fields: [evalRunId], references: [id], onDelete: Cascade)

  @@unique([evalRunId, domain], map: "assurance_eval_domain_gate_unique")
  @@map("assurance_eval_domain_gate")
}

/// A candidate regression fixture raised from real user feedback, PENDING human
/// review (packages/meriv2-core/src/assurance/feedback-fixtures.ts).
///
/// Feedback never becomes golden truth automatically. DB CHECKs restate the
/// in-code invariants: a decided candidate must name its reviewer/time/reason, an
/// ACCEPTED candidate must be anonymized under a named anonymization version, and
/// the reviewer must not be the creator — you cannot promote your own feedback.
///
/// `summary` is reviewer-facing and size-capped. Prompt/response BODIES are
/// deliberately absent: a fixture references a trace and a claim-ledger hash, it
/// does not store the conversation. `sourceMessageId` carries no FK so the evidence
/// outlives a deleted conversation.
model AssuranceFeedbackCandidate {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  /// pending_review | accepted | rejected
  status               String    @default("pending_review") @db.VarChar(16)
  /// Canonical codes only, enforced by a DB CHECK against the apps/api vocabulary.
  reasonCodes          String[]  @map("reason_codes")
  surface              String    @db.VarChar(64)
  sourceMessageId      String?   @map("source_message_id") @db.Uuid
  traceId              String?   @map("trace_id") @db.VarChar(160)
  contextPacketId      String?   @map("context_packet_id") @db.Uuid
  claimLedgerHash      String?   @map("claim_ledger_hash") @db.VarChar(128)
  summary              String?
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  anonymized           Boolean   @default(false)
  anonymizationVersion String?   @map("anonymization_version") @db.VarChar(80)
  reviewedByUserId     String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewReason         String?   @map("review_reason")
  fixtureId            String?   @map("fixture_id") @db.VarChar(64)

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fixtures AssuranceEvalFixture[]

  @@index([tenantId, status, createdAt(sort: Desc)], map: "assurance_feedback_candidate_queue_idx")
  @@map("assurance_feedback_candidate")
}

/// An ACCEPTED regression fixture. `fixtureKey` is the deterministic
/// 'feedback-<sha>' that AssuranceEvalResult.caseId references.
///
/// The source candidate is ON DELETE RESTRICT: a fixture must never become
/// unattributable by deleting its provenance.
model AssuranceEvalFixture {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  fixtureKey           String    @map("fixture_key") @db.VarChar(64)
  sourceCandidateId    String    @map("source_candidate_id") @db.Uuid
  datasetVersion       String    @map("dataset_version") @db.VarChar(120)
  category             String    @db.VarChar(40)
  surface              String    @db.VarChar(64)
  traceRef             String?   @map("trace_ref") @db.VarChar(160)
  contextPacketRef     String?   @map("context_packet_ref") @db.VarChar(160)
  claimLedgerHash      String?   @map("claim_ledger_hash") @db.VarChar(128)
  anonymizationVersion String    @map("anonymization_version") @db.VarChar(80)
  acceptedByUserId     String    @map("accepted_by_user_id") @db.Uuid
  acceptedAt           DateTime  @map("accepted_at") @db.Timestamptz(6)
  retiredAt            DateTime? @map("retired_at") @db.Timestamptz(6)

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceCandidate AssuranceFeedbackCandidate @relation(fields: [sourceCandidateId], references: [id], onDelete: Restrict)

  @@unique([tenantId, fixtureKey], map: "assurance_eval_fixture_key_unique")
  @@index([tenantId, datasetVersion, retiredAt], map: "assurance_eval_fixture_dataset_idx")
  @@map("assurance_eval_fixture")
}

// ── Phase 2 V1 budget verification audit tables ──────────────────── //
// These Prisma models map the actual SQL tables created by PR #739 and
// Phase 0 containment. They are audit-only: no canonical Program Element
// promotion authority exists here. The V1 verification gate persists
// candidate, proof snapshot, run, checks, discrepancies, and decisions.

/// One extraction candidate per unique identity. Idempotent on exact identity.
/// R2: Full candidate identity includes cycle, manifest, artifact, source,
/// verifier, and policy material. Deterministic UUID (not random default).
model BudgetExtractionCandidateV1 {
  id                        String   @id @db.Uuid
  cycleId                   String   @map("cycle_id")
  manifestContentSha256     String   @map("manifest_content_sha256") @db.Char(64)
  manifestDocumentKey       String   @map("manifest_document_key")
  extractionArtifactId      String   @map("extraction_artifact_id")
  extractionArtifactSha256  String   @map("extraction_artifact_sha256") @db.Char(64)
  extractionArtifactLocator String?  @map("extraction_artifact_locator")
  sourceDocumentId          String   @map("source_document_id") @db.Uuid
  sourceSha256              String   @map("source_sha256") @db.Char(64)
  verifierVersion           String   @map("verifier_version")
  policyVersion             String   @map("policy_version")
  policySha256              String   @map("policy_sha256") @db.Char(64)
  status                    String   @default("EXTRACTED")
  currentRunId              String?  @map("current_run_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  runs            BudgetVerificationRunV1[]
  discrepancies   BudgetVerificationDiscrepancyV1[]
  reviewDecisions BudgetReviewDecisionV1[]

  @@unique([cycleId, manifestContentSha256, manifestDocumentKey, sourceDocumentId, sourceSha256, extractionArtifactId, extractionArtifactSha256, verifierVersion, policyVersion, policySha256], map: "budget_v1_candidate_identity_key")
  @@index([sourceDocumentId], map: "budget_v1_candidate_source_document_idx")
  @@index([status], map: "budget_v1_candidate_status_idx")
  @@index([cycleId], map: "budget_v1_candidate_cycle_idx")
  @@map("budget_extraction_candidate_v1")
}

/// One verification run per candidate attempt. Completed runs are append-only.
/// R2: Deterministic UUID. Run integrity: completed_at >= started_at,
/// risk 0..100, exact decision/status mapping, controlled routes, SHA format.
model BudgetVerificationRunV1 {
  id                       String   @id @db.Uuid
  candidateId              String   @map("candidate_id") @db.Uuid
  verifierVersion          String   @map("verifier_version")
  policyVersion            String   @map("policy_version")
  policySha256             String   @map("policy_sha256") @db.Char(64)
  decision                 String // PASS | REVIEW | REJECT
  status                   String // VERIFICATION_PASSED | NEEDS_REVIEW | REJECTED
  route                    String // none | targeted_local_reextraction | paid_page_verifier | human_review
  riskScore                Int      @map("risk_score")
  startedAt                DateTime @map("started_at") @db.Timestamptz(6)
  completedAt              DateTime @map("completed_at") @db.Timestamptz(6)
