  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  author     User?   @relation("MeetingNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  approvedBy User?   @relation("MeetingNoteApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  sharedBy   User?   @relation("MeetingNoteSharedBy", fields: [sharedByUserId], references: [id], onDelete: SetNull)

