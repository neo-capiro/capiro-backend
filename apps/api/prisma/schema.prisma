  tenantId      String   @map("tenant_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  createdBy     String?  @map("created_by") // clerk user id
  sourceAlertId String?  @map("source_alert_id") // alertId it was promoted from, if any
  sourceType    String?  @map("source_type") // 'comment_deadline' | 'change' | 'hearing' | 'manual' | ...
  title         String
  body          String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([clientId])
  @@map("client_brief")
}

// ─────────────────────────────────────────────────────────────────────────
// Tracker tab — per-client watchlist, alert preferences, feedback, and the
// notification delivery ledger. All TENANT-scoped with RLS (mirrors the
// tracked_bill / alert_state isolation convention: tenant_id column + policy,
// no Prisma relation/FK). The board membership table is tracked_bill itself.
// ─────────────────────────────────────────────────────────────────────────

// Per-client targeting config authored on the Tracker → Configure panel. Tunes
// the Recommendations matcher and alert routing. One row per client.
model ClientWatchlist {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  // Capiro-managed issue-area labels the client has switched on.
  issueAreas String[] @default([]) @map("issue_areas")
  // JSON array of watchlist tag objects, each:
  //   { tag, issueArea?, synonyms[], relatedEntities[], riskTerms[],
  //     position?: 'support'|'oppose'|'monitor', priority: 'low'|'med'|'high' }
  tags       Json     @default("[]")
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([clientId])
  @@index([tenantId])
  @@map("client_watchlist")
}

// Per-user-per-client alert delivery preferences (triggers, materiality floor,
// and channel config). SMS is wired but DORMANT until an origination number is
// provisioned (see tracker/sms/sms.service.ts).
model AlertPreference {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  userId           String   @map("user_id") // clerk user id; prefs are per user, per client
  triggers         String[] @default([]) @map("triggers") // enabled trigger keys
  materiality      String   @default("medium") // 'low' | 'medium' | 'high'
  emailEnabled     Boolean  @default(false) @map("email_enabled")
  emailAddress     String?  @map("email_address")
  emailCadence     String   @default("realtime") @map("email_cadence") // realtime | daily | weekly
  smsEnabled       Boolean  @default(false) @map("sms_enabled")
  smsPhone         String?  @map("sms_phone") // E.164
  smsPhoneVerified Boolean  @default(false) @map("sms_phone_verified")
  smsCadence       String   @default("realtime") @map("sms_cadence") // realtime | daily
  quietHoursStart  String?  @map("quiet_hours_start") // "22:00"
  quietHoursEnd    String?  @map("quiet_hours_end") // "07:00"
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, clientId])
  @@index([tenantId])
  @@index([clientId])
  @@map("alert_preference")
