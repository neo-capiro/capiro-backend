  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submissionHistory ClientSubmissionHistory[]

  @@index([tenantId, clientId], map: "client_capabilities_tenant_client_idx")
  @@map("client_capabilities")
}

model ClientSubmissionHistory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  capabilityId String?  @map("capability_id") @db.Uuid
  fiscalYear   String   @map("fiscal_year")
  title        String
  meta         String?
  outcome      String?
  outcomeType  String   @default("in_progress") @map("outcome_type")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  capability ClientCapability? @relation(fields: [capabilityId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId, capabilityId], map: "client_submission_history_tenant_client_cap_idx")
  @@map("client_submission_history")
}

model ClientPerson {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  name        String
  title       String?
  email       String?   @db.Citext
  phone       String?
  role        String?
  lastContact DateTime? @map("last_contact") @db.Timestamptz(6)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId], map: "client_people_tenant_client_idx")
  // Import-path identity lookup: Meri's update_client_profile and the contact
  // import merge on (tenant, client, email) rather than appending blindly, so
  // re-running enrichment stops duplicating every contact.
  //
  // Deliberately NOT @@unique. Tenants that ran the old append-only import
  // already hold duplicate rows, and a unique index would fail to build on a
  // live database — the merge in ClientPeopleService.upsertPersonForImport is
  // the guard, backed by the atomic consumedAt claim in MeriApprovalService
  // that stops one approval executing twice. Promote to unique once existing
  // duplicates have been reconciled.
  @@index([tenantId, clientId, email], map: "client_people_tenant_client_email_idx")
  @@map("client_people")
}

model ClientFacility {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  clientId              String    @map("client_id") @db.Uuid
  name                  String
  addressLine           String?   @map("address_line")
  city                  String?
  state                 String?   @db.VarChar(2)
  zip                   String?   @db.VarChar(10)
  congressionalDistrict String?   @map("congressional_district") @db.VarChar(2)
  districtSource        String?   @map("district_source") @db.VarChar(16)
  employeeCount         Int?      @map("employee_count")
  notes                 String?
  // District Impact Engine (Phase 1 M1.1) — Census Geocoder outputs. One batch
  // call yields the federal CD (above) AND both state legislative chambers, so
  // these ride alongside the existing federal column rather than a new model.
  latitude              Float?
  longitude             Float?
  /// Census SLDL/SLDU BASENAME. In named-district states this is a NAME, not a
  /// number ('8th Bristol', 'First Bristol and Plymouth', 'Merrimack 18'), so
  /// the column is 64 wide, NOT the 8 it shipped as — at 8 every write for such
  /// a state threw and poisoned the nightly geocode run (migration
  /// 20260810050000). Longest real value is MA's 42-char senate district.
  stateHouseDistrict    String?   @map("state_house_district") @db.VarChar(64)
  stateSenateDistrict   String?   @map("state_senate_district") @db.VarChar(64)
  geocodedAt            DateTime? @map("geocoded_at") @db.Timestamptz(6)
  // 'matched' | 'no_match' | 'ambiguous' | 'error' — never silently absent when a geocode was attempted.
  geocodeStatus         String?   @map("geocode_status") @db.VarChar(16)
  /// W4.2: change-hash of the normalized address at last geocode attempt — the
  /// geocode-facilities scan re-geocodes only when the current address hash
  /// differs (not on any unrelated updated_at bump), and stamps it on every
  /// attempt so address-less/no-match rows don't starve the batch cap.
  geocodeInputHash      String?   @map("geocode_input_hash")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId], map: "client_facilities_tenant_client_idx")
  @@index([state, congressionalDistrict], map: "client_facilities_district_idx")
  @@index([state, stateHouseDistrict], map: "client_facilities_state_house_idx")
  @@index([state, stateSenateDistrict], map: "client_facilities_state_senate_idx")
  @@map("client_facilities")
}

/// Client Targets — a congressional office (member) a lobbying team intends to
/// engage on behalf of a client. Firm-wide per client (tenant-scoped, RLS;
/// mirrors ClientFacility). memberId is the congressional directory member
/// identifier (DirectoryContact.id / bioguide). A compact member snapshot is
/// denormalized at add-time so the portfolio card pills and Targets list render
/// without a directory round-trip and survive directory refreshes. source marks
/// whether the user added it manually or from a Meri recommendation.
model ClientTarget {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  memberId        String   @map("member_id")
  memberName      String?  @map("member_name")
  // Which directory this target came from: 'congress' (LegiStorm snapshot) or
  // 'state' (OpenStates state_legislator table). Drives snapshot resolution on
  // add and profile click-through on the client. Widened party/state/chamber
  // below because state values are full words ("Democrat", "upper").
  sourceDirectory String   @default("congress") @map("source_directory") @db.VarChar(16)
  party           String?  @db.VarChar(32)
  // TEXT (not VarChar): some state legislators have NAMED districts (e.g. MA
  // "Norfolk, Bristol and Plymouth"), so the district-qualified value is unbounded.
  state           String?
  chamber         String?  @db.VarChar(24)
  committee       String?
  // Engagement priority tier (1 = highest .. 3), null = untiered. Drives the
  // tiered visual grouping in the Targets tab.
  tier            Int?     @db.SmallInt
  source          String   @default("manual") @db.VarChar(8)
  addedByUserId   String?  @map("added_by_user_id") @db.Uuid
  addedAt         DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addedBy User?  @relation("ClientTargetAuthor", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([clientId, memberId], map: "client_targets_client_member_key")
  @@index([tenantId, clientId], map: "client_targets_tenant_client_idx")
  @@map("client_targets")
}

/// Persisted Office Recommender ("Suggested by Meri") output for a client's
/// Targets tab. Computing recommendations means resolving tracked bills +
/// scoring every congressional office, which is too slow to run on every page
/// view — so we compute once (lazily, on first view), store the result here, and
/// serve the cache thereafter. A manual "Refresh" recomputes on demand. One row
/// per client (firm-wide, tenant-scoped via RLS). tenant/client FK relations with
/// ON DELETE CASCADE so a deleted client takes its cache with it (mirrors
/// ClientTarget / ActionRecommendation).
model ClientTargetRecommendation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  /// Array<OfficeRecommendation> (see office-recommender.service.ts) as JSON.
  recommendations Json     @default("[]") @map("recommendations_jsonb")
  computedAt      DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId], map: "client_target_recommendations_client_key")
  @@index([tenantId, clientId], map: "client_target_recommendations_tenant_client_idx")
  @@map("client_target_recommendations")
}

/// Step 3.2 — materiality-gated, client-specific action card (plan §10 card spec,
/// §19 workflow states). Tenant-scoped with RLS (mirrors ClientFacility). deltaId /
/// programId / peCode / ownerUserId are plain ids (no FK), matching repo convention.
model ActionRecommendation {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  clientId              String    @map("client_id") @db.Uuid
  peCode                String?   @map("pe_code") @db.VarChar(16)
  programId             String?   @map("program_id") @db.Uuid
  deltaId               String?   @map("delta_id") @db.Uuid
  actionType            String    @map("action_type") @db.VarChar(40)
  issueTitle            String    @map("issue_title") @db.Text
  whatChanged           String    @map("what_changed") @db.Text
  whyItMatters          String    @map("why_it_matters") @db.Text
  recommendedAction     String    @map("recommended_action") @db.Text
  targetAudience        Json      @default("[]") @map("target_audience_jsonb")
  suggestedArtifactType String?   @map("suggested_artifact_type") @db.VarChar(40)
  deadline              DateTime? @db.Date
  deadlineSource        String?   @map("deadline_source") @db.VarChar(24)
  ownerUserId           String?   @map("owner_user_id") @db.Uuid
  priority              Int       @default(0)
  confidence            Json      @default("{}") @map("confidence_jsonb")
  uncertainty           String?   @db.Text
  evidence              Json      @default("[]") @map("evidence_jsonb")
  status                String    @default("new") @db.VarChar(24)
  dismissalReason       String?   @map("dismissal_reason") @db.Text
  outcome               String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, deadline], map: "action_recommendation_tenant_status_deadline_idx")
  @@index([tenantId, clientId], map: "action_recommendation_tenant_client_idx")
  @@map("action_recommendation")
}

model EngagementCampaign {
