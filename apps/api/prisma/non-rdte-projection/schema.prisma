model NonRdteBudgetLineSourceObservation {
  id                              String   @id @default(uuid()) @db.Uuid
  identityFamily                  String   @map("identity_family") @db.VarChar(32)
  identityNaturalKey              String   @map("identity_natural_key") @db.Text
  exhibit                         String   @db.VarChar(32)
  fiscalYear                      Int      @map("fiscal_year")
  sourceUrl                       String   @map("source_url") @db.Text
  pageNumber                      Int      @map("page_number")
  pageEnd                         Int?     @map("page_end")
  sourceDocumentId                String   @map("source_document_id") @db.Uuid
  extractionArtifactId            String   @map("extraction_artifact_id")
  extractionArtifactContentSha256 String   @map("extraction_artifact_content_sha256") @db.Char(64)
  assertionId                     String   @map("assertion_id")
  verificationCandidateId         String   @map("verification_candidate_id")
  verificationRunId               String   @map("verification_run_id")
  verificationDecisionId          String   @map("verification_decision_id")
  sourcePdfSha256                 String   @map("source_pdf_sha256") @db.Char(64)
  evidenceIds                     Json     @map("evidence_ids_jsonb")
  metadata                        Json     @default("{}") @map("metadata_jsonb")
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([identityNaturalKey, sourceDocumentId, assertionId], map: "non_rdte_budget_line_source_observation_natural_key")
  @@index([identityFamily, fiscalYear], map: "non_rdte_source_observation_family_fy_idx")
  @@index([verificationRunId], map: "non_rdte_source_observation_verification_run_idx")
  @@map("non_rdte_budget_line_source_observation")
}

model NonRdteBudgetLineRelationship {
  id                              String   @id @default(uuid()) @db.Uuid
  fromFamily                      String   @map("from_family") @db.VarChar(32)
  fromNaturalKey                  String   @map("from_natural_key") @db.Text
  toFamily                        String   @map("to_family") @db.VarChar(32)
  toNaturalKey                    String   @map("to_natural_key") @db.Text
  relationshipType                String   @map("relationship_type") @db.VarChar(64)
  explicitInSource                Boolean  @map("explicit_in_source")
  sourceDocumentId                String   @map("source_document_id") @db.Uuid
  extractionArtifactId            String   @map("extraction_artifact_id")
  extractionArtifactContentSha256 String   @map("extraction_artifact_content_sha256") @db.Char(64)
  assertionId                     String   @map("assertion_id")
  verificationCandidateId         String   @map("verification_candidate_id")
  verificationRunId               String   @map("verification_run_id")
  verificationDecisionId          String   @map("verification_decision_id")
  sourcePdfSha256                 String   @map("source_pdf_sha256") @db.Char(64)
  evidenceIds                     Json     @map("evidence_ids_jsonb")
  metadata                        Json     @default("{}") @map("metadata_jsonb")
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([fromNaturalKey, toNaturalKey, relationshipType, sourceDocumentId], map: "non_rdte_budget_line_relationship_natural_key")
  @@index([fromNaturalKey], map: "non_rdte_budget_line_relationship_from_idx")
  @@index([toNaturalKey], map: "non_rdte_budget_line_relationship_to_idx")
  @@map("non_rdte_budget_line_relationship")
}
