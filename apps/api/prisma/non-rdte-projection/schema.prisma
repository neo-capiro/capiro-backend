  verificationRunId               String   @map("verification_run_id")
  verificationDecisionId          String   @map("verification_decision_id")
  sourcePdfSha256                 String   @map("source_pdf_sha256") @db.Char(64)
  evidenceIds                     Json     @map("evidence_ids_jsonb")
  metadata                        Json     @default("{}") @map("metadata_jsonb")
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sag OmSag @relation(fields: [omSagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([omSagId, fiscalYear, fundingField], map: "om_sag_year_natural_key")
  @@index([fiscalYear], map: "om_sag_year_fy_idx")
  @@index([verificationRunId], map: "om_sag_year_verification_run_idx")
