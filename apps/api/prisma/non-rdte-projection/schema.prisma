model MilconProject {
  id                 String   @id @default(uuid()) @db.Uuid
  naturalKey         String   @unique(map: "milcon_project_natural_key") @map("natural_key")
  component          String   @db.VarChar(16)
  account            String   @db.Text
  projectCode        String   @map("project_code") @db.VarChar(64)
  printedProjectCode String   @map("printed_project_code") @db.VarChar(64)
  installation       String?  @db.Text
  location           String?  @db.Text
  title              String?  @db.Text
  categoryCode       String?  @map("category_code") @db.VarChar(64)
  scope              String?  @db.Text
  metadata           Json     @default("{}") @map("metadata_jsonb")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  years   MilconProjectYear[]
  details MilconDetailFact[]

  @@unique([component, account, projectCode, location], map: "milcon_project_native_key")
  @@index([component, account], map: "milcon_project_component_account_idx")
  @@index([installation], map: "milcon_project_installation_idx")
  @@map("milcon_project")
}

