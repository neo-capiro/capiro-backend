{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "rootDir": "../..",
    "baseUrl": "../..",
    "paths": {
      "@capiro/shared/*": ["packages/shared/src/*"],
      "@capiro/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": [
    "src/defense-budget/parser-router/**/*.ts",
    "src/defense-budget/contracts/**/*.ts",
    "src/defense-budget/verification/**/*.ts",
    "scripts/profile-defense-budget-document.ts",
    "scripts/plan-defense-budget-parse.ts",
    "scripts/extract-defense-budget-cycle.ts",
    "scripts/replay-defense-budget-parser-artifact.ts",
    "scripts/verify-defense-budget-parser-runtime.ts",
    "scripts/verify-defense-budget-parser-architecture.ts",
    "scripts/verify-pe-budget-phase-3-negative-controls.ts",
    "scripts/verify-pe-budget-phase-3-closeout.ts"
  ],
  "exclude": ["**/*.spec.ts"]
}
