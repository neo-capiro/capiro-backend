{
  "name": "@capiro/infra-cdk",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "capiro-cdk": "bin/capiro.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "synth:meriv2-ops": "cdk synth --app \"ts-node --prefer-ts-exts bin/meriv2-operations.ts\"",
    "diff:meriv2-ops": "cdk diff --app \"ts-node --prefer-ts-exts bin/meriv2-operations.ts\"",
    "deploy:meriv2-ops": "cdk deploy --app \"ts-node --prefer-ts-exts bin/meriv2-operations.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:engagement-api": "node scripts/run-engagement-api-tests.mjs",
    "synth:engagement-api:test": "node scripts/synth-engagement-api-test.mjs",
    "verify:engagement-api": "pnpm run typecheck && pnpm run test:engagement-api && pnpm run synth:engagement-api:test"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.161.1",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "aws-cdk": "^2.161.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
