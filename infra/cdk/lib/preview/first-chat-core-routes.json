  "memoryPost": [
    "^/api/memory/candidates/[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}/owner-decision$",
    "^/api/memory/version-candidates/[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}/(approve|reject)$",
