{
  "family": "capiro-prod-intel-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::967807252336:role/Capiro-prod-os-capiro-Com-ApiTaskDefExecutionRoleE6-S9U73lqKaGdt",
  "taskRoleArn": "arn:aws:iam::967807252336:role/Capiro-prod-os-capiro-Compute-ApiTaskRole12FAD4A7-5zhubZnOJ9nz",
  "containerDefinitions": [
    {
      "name": "intel-api",
      "image": "967807252336.dkr.ecr.us-east-1.amazonaws.com/capiro/prod-os-capiro/intel-api:latest",
      "essential": true,
      "command": [
        "serve"
      ],
      "portMappings": [
        {
          "containerPort": 4300,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DB_NAME",
          "value": "capiro"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "CLERK_JWT_ISSUER",
          "value": "https://clerk.capiro.ai"
        },
        {
          "name": "WEB_ORIGIN",
          "value": "https://app.prodos.capiro.ai"
        },
        {
          "name": "INTEL_PORT",
          "value": "4300"
        },
        {
          "name": "INTEL_BIND_HOST",
          "value": "0.0.0.0"
        }
      ],
      "secrets": [
        {
          "name": "CLERK_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/prod-os-capiro/clerk/secret-key-DOnjk4"
        },
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/prod-os-capiro/aurora/master-ZN0KKV:host::"
        },
        {
          "name": "DB_PORT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/prod-os-capiro/aurora/master-ZN0KKV:port::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/prod-os-capiro/aurora/app-50fWe2:username::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/prod-os-capiro/aurora/app-50fWe2:password::"
        },
        {
          "name": "HEARING_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/prod-os-capiro/intel-api/HEARING_ENCRYPTION_KEY-wxgyt9"
        },
        {
          "name": "DEEPGRAM_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/prod-os-capiro/intel-api/DEEPGRAM_API_KEY-yG4MQC"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/capiro/prod-os-capiro",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "intel-api"
        }
      }
    }
  ]
}