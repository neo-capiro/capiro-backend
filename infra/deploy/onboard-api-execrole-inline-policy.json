{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnboardApiEcrPull",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-east-1:967807252336:repository/capiro/dev/onboard-api"
    },
    {
      "Sid": "OnboardApiSecretsRead",
      "Effect": "Allow",
      "Action": ["secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue"],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:967807252336:secret:capiro/dev/onboard/*"
      ]
    },
    {
      "Sid": "OnboardApiLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:967807252336:log-group:/capiro/dev/onboard-api:*"
    }
  ]
}
