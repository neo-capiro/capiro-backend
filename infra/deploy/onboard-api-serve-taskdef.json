{
  "family": "capiro-dev-onboard-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "REPLACE_WITH_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_WITH_TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "onboard-api",
      "image": "REPLACE_WITH_ECR_IMAGE_URI",
      "essential": true,
      "command": ["serve"],
      "portMappings": [{ "containerPort": 4400, "protocol": "tcp" }],
      "environment": [
        { "name": "ONBOARD_PORT", "value": "4400" },
        { "name": "ONBOARD_BIND_HOST", "value": "0.0.0.0" },
        { "name": "CAPIRO_ENV", "value": "dev" },
        { "name": "ONBOARD_APP_BASE_URL", "value": "https://app.capiro.ai" },
        { "name": "ONBOARD_API_PUBLIC_BASE_URL", "value": "https://app.capiro.ai" },
        { "name": "ONBOARD_PUBLIC_BASE_URL", "value": "https://onboarding.capiro.ai" },
        { "name": "ONBOARD_FUNNEL_ENABLED", "value": "false" },
        { "name": "CLERK_JWT_ISSUER", "value": "https://clerk.app.capiro.ai" },
        { "name": "CLERK_PUBLISHABLE_KEY", "value": "REPLACE_WITH_CLERK_PUBLISHABLE_KEY" }
      ],
      "secrets": [
        { "name": "CLERK_SECRET_KEY", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:CLERK_SECRET_KEY::" },
        { "name": "INTERNAL_SERVICE_SECRET", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:INTERNAL_SERVICE_SECRET::" },
        { "name": "OAUTH_STATE_SECRET", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:OAUTH_STATE_SECRET::" },
        { "name": "STRIPE_SECRET_KEY", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:STRIPE_SECRET_KEY::" },
        { "name": "STRIPE_WEBHOOK_SECRET", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:STRIPE_WEBHOOK_SECRET::" },
        { "name": "DB_HOST", "valueFrom": "REPLACE_WITH_AURORA_SECRET_ARN:host::" },
        { "name": "DB_PORT", "valueFrom": "REPLACE_WITH_AURORA_SECRET_ARN:port::" },
        { "name": "DB_USER", "valueFrom": "REPLACE_WITH_AURORA_SECRET_ARN:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "REPLACE_WITH_AURORA_SECRET_ARN:password::" },
        { "name": "DB_NAME", "valueFrom": "REPLACE_WITH_AURORA_SECRET_ARN:dbname::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/capiro/dev/onboard-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "onboard-api"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O /dev/null http://localhost:4400/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
