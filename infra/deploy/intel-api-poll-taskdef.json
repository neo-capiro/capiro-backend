{
  "family": "capiro-dev-intel-api-poll",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::967807252336:role/Capiro-dev-Compute-ApiTaskDefExecutionRoleE6ABB053-YlEDKuUPHjLg",
  "taskRoleArn": "arn:aws:iam::967807252336:role/Capiro-dev-Compute-ApiTaskRole12FAD4A7-szq3QeeZJSCQ",
  "containerDefinitions": [
    {
      "name": "intel-api-poll",
      "image": "967807252336.dkr.ecr.us-east-1.amazonaws.com/capiro/dev/intel-api:latest",
      "essential": true,
      "command": ["task", "poll-hearings", "--dry-run=true"],
      "environment": [
        { "name": "DB_NAME", "value": "capiro" },
        { "name": "AWS_REGION_DEFAULT", "value": "us-east-1" },
        { "name": "CAPIRO_INTERNAL_TENANT_ID", "value": "48b8b988-2f7e-458a-999e-9e476ed70752" },
        { "name": "SENATE_AUTO_CAPTURE", "value": "false" },
        { "name": "MAX_CONCURRENT_CAPTURES", "value": "8" },
        { "name": "CAPTURE_ECS_CLUSTER", "value": "capiro-dev" },
        { "name": "CAPTURE_TASK_DEF", "value": "capiro-dev-intel-api-capture" },
        { "name": "CAPTURE_CONTAINER", "value": "intel-api-capture" },
        { "name": "CAPTURE_SUBNETS", "value": "subnet-0e38bd390f8961fef,subnet-0920665f91c905f01,subnet-06db79cd21239de19" },
        { "name": "CAPTURE_SECURITY_GROUPS", "value": "sg-01def4e5c0fe44d4a" },
        { "name": "CAPTURE_ASSIGN_PUBLIC_IP", "value": "DISABLED" }
      ],
      "secrets": [
        { "name": "CONGRESS_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:capiro/dev/congress-gov-api-key-9Js4q5" },
        { "name": "DB_HOST", "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/dev/aurora/master-P4z1Vo:host::" },
        { "name": "DB_PORT", "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/dev/aurora/master-P4z1Vo:port::" },
        { "name": "DB_USER", "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/dev/aurora/app-zNPtsU:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/dev/aurora/app-zNPtsU:password::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/capiro/dev/api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "intel-api-poll"
        }
      }
    }
  ]
}
