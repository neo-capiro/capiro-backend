{
  "openapi": "3.1.0",
  "info": {
    "title": "Meri Mobile API",
    "version": "1.0.0",
    "description": "Additive mobile facade over the existing Meri Hermes and Engagement services. The capability manifest is informational; every operation performs fresh authorization."
  },
  "servers": [{ "url": "/api/mobile/v1" }],
  "security": [{ "bearerAuth": [] }],
  "x-compatibility": {
    "minimumAppVersionSource": "bootstrap.minimumAppVersion",
    "deprecationNoticeDays": 180,
    "eventSchema": "./meri-display-events.v1.schema.json",
    "writePolicy": "additive; existing web routes remain compatible"
  },
  "paths": {
    "/bootstrap": {
      "get": {
        "operationId": "getMobileBootstrap",
        "responses": {
          "200": {
            "description": "Authenticated principal, authorized client options, versions, and default-off capabilities.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bootstrap" }, "examples": { "enabled": { "value": { "apiVersion": "1.0.0", "displayEventVersion": "1.0.0", "minimumAppVersion": "1.0.0", "user": { "id": "00000000-0000-0000-0000-000000000001", "email": "user@example.invalid", "role": "standard_user" }, "tenant": { "id": "00000000-0000-0000-0000-000000000002", "slug": "pilot", "name": "Pilot" }, "clients": [{ "id": "00000000-0000-0000-0000-000000000003", "name": "Authorized client" }], "features": { "runs": true, "meetings": true, "files": true, "deviceTokens": false }, "manifestIsAuthorization": false } } } } }
          },
          "404": { "$ref": "#/components/responses/FeatureDisabled" }
        }
      }
    },
    "/meri/conversations/{conversationId}/runs": {
      "post": {
        "operationId": "startMeriRun",
        "description": "Acceptance occurs only when the versioned run_accepted frame is received. Retry the same authenticated actor/conversation/key to attach to the same message and run. Setup/rejection frames before acceptance can be unsequenced; after acceptance, consumers apply only versioned frames with a sequence and ignore unsequenced live duplicates.",
        "parameters": [
          { "$ref": "#/components/parameters/ConversationId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartRun" } } } },
        "responses": {
          "200": { "description": "SSE using the separately versioned display-event schema.", "content": { "text/event-stream": { "schema": { "type": "string" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/FeatureDisabled" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/meri/runs/{runId}": {
      "get": {
        "operationId": "getMeriRun",
        "description": "Owner-scoped recovery snapshot. Render outputSnapshot through outputSeq, then request events after outputSeq.",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Run snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Run" } } } }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/meri/runs/{runId}/events": {
      "get": {
        "operationId": "resumeMeriRunEvents",
        "description": "Owner-scoped monotonic replay. Clients de-duplicate by (runId, seq).",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/AfterSeq" }],
        "responses": { "200": { "description": "SSE display events", "content": { "text/event-stream": { "schema": { "type": "string" } } } }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/meri/runs/{runId}/stop": {
      "post": {
        "operationId": "stopMeriRun",
        "description": "Idempotent owner Stop. Remains available for an admitted run during gate rollback.",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "description": "Current run", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Run" } } } }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/meri/runs/{runId}/approval": {
      "post": {
        "operationId": "resolveMeriApproval",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["requestId", "decision"], "properties": { "requestId": { "type": "string" }, "decision": { "enum": ["approve_once", "deny"] } } } } } },
        "responses": { "200": { "description": "Updated run" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    },
    "/meetings": {
      "get": {
        "operationId": "listMeetings",
        "parameters": [
          { "name": "clientId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Bounded authorized page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeetingPage" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "404": { "$ref": "#/components/responses/FeatureDisabled" } }
      }
    },
    "/meetings/{meetingId}": {
      "get": {
        "operationId": "getMeeting",
        "parameters": [{ "$ref": "#/components/parameters/MeetingId" }],
        "responses": { "200": { "description": "Authorized canonical meeting; ETag equals revision.", "headers": { "ETag": { "schema": { "type": "string" } } } }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "patch": {
        "operationId": "updateMeeting",
        "parameters": [{ "$ref": "#/components/parameters/MeetingId" }, { "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeetingPatch" } } } },
        "responses": { "200": { "description": "Updated canonical meeting" }, "409": { "$ref": "#/components/responses/StaleRevision" }, "428": { "$ref": "#/components/responses/PreconditionRequired" } }
      }
    },
    "/meetings/{meetingId}/notes/{noteId}": {
      "patch": {
        "operationId": "updateMeetingNote",
        "parameters": [{ "$ref": "#/components/parameters/MeetingId" }, { "name": "noteId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EncryptedArtifactPatch" } } } },
        "responses": { "200": { "description": "Updated note metadata; existing encrypted-body and author/admin restrictions still apply." }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/StaleRevision" }, "428": { "$ref": "#/components/responses/PreconditionRequired" } }
      }
    },
    "/meetings/{meetingId}/debriefs/{debriefId}": {
      "patch": {
        "operationId": "updateMeetingDebrief",
        "parameters": [{ "$ref": "#/components/parameters/MeetingId" }, { "name": "debriefId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EncryptedArtifactPatch" } } } },
        "responses": { "200": { "description": "Updated debrief metadata; existing encrypted-body and author/admin restrictions still apply." }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/StaleRevision" }, "428": { "$ref": "#/components/responses/PreconditionRequired" } }
      }
    },
    "/meeting-preps/{prepId}": {
      "patch": {
        "operationId": "updateMeetingPrep",
        "parameters": [{ "name": "prepId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "summary": { "type": ["string", "null"] }, "agenda": { "type": "array", "items": { "type": "string" } }, "talkingPoints": { "type": "array", "items": { "type": "string" } }, "risks": { "type": "array", "items": { "type": "string" } }, "followUps": { "type": "array", "items": { "type": "string" } } } } } } },
        "responses": { "200": { "description": "Updated prep" }, "409": { "$ref": "#/components/responses/StaleRevision" }, "428": { "$ref": "#/components/responses/PreconditionRequired" } }
      }
    },
    "/files/upload-url": {
      "post": { "operationId": "createFileUploadUrl", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileUploadRequest" } } } }, "responses": { "201": { "description": "Five-minute authorized upload form" }, "400": { "$ref": "#/components/responses/BadRequest" } } }
    },
    "/files/confirm": {
      "post": { "operationId": "confirmFileUpload", "description": "Exact retries return the existing row; different metadata for the same key returns attachment_confirm_conflict.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileConfirmRequest" } } } }, "responses": { "201": { "description": "Canonical file status" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/files/{fileId}/status": {
      "get": { "operationId": "getFileStatus", "parameters": [{ "name": "fileId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "meetingId", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "name": "clientId", "in": "query", "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Authorized scan/extraction status; download URL is absent while unusable." }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/devices": {
      "post": { "operationId": "registerDeviceToken", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceRegistration" } } } }, "responses": { "201": { "description": "Token registered for authenticated tenant/user/device/environment; token is never echoed." } } },
      "delete": { "operationId": "revokeDeviceToken", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["deviceId", "environment"], "properties": { "deviceId": { "type": "string", "maxLength": 128 }, "environment": { "enum": ["sandbox", "production"] } } } } } }, "responses": { "200": { "description": "Idempotent revocation result" } } }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "Clerk JWT" } },
    "parameters": {
      "ConversationId": { "name": "conversationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "MeetingId": { "name": "meetingId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } },
      "IfMatch": { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string" }, "description": "ETag/ISO revision returned by the prior read." },
      "AfterSeq": { "name": "after", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
    },
    "schemas": {
      "Bootstrap": { "type": "object", "required": ["apiVersion", "displayEventVersion", "minimumAppVersion", "user", "tenant", "clients", "features", "manifestIsAuthorization"], "properties": { "apiVersion": { "const": "1.0.0" }, "displayEventVersion": { "const": "1.0.0" }, "minimumAppVersion": { "type": "string" }, "user": { "type": "object" }, "tenant": { "type": "object" }, "clients": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } } } }, "features": { "type": "object", "additionalProperties": { "type": "boolean" } }, "manifestIsAuthorization": { "const": false } } },
      "StartRun": { "type": "object", "required": ["body"], "properties": { "body": { "type": "string", "maxLength": 24000 }, "mode": { "enum": ["new", "regenerate", "resend"], "default": "new" }, "attachmentIds": { "type": "array", "maxItems": 8, "items": { "type": "string", "format": "uuid" } } } },
      "Run": { "type": "object", "required": ["runId", "status", "lastSeq", "outputSnapshot", "outputSeq"], "properties": { "runId": { "type": "string", "format": "uuid" }, "status": { "enum": ["queued", "provisioning", "running", "waiting_for_approval", "waiting_for_clarification", "cancelling", "completed", "cancelled", "failed", "interrupted", "expired"] }, "lastSeq": { "type": "integer" }, "outputSnapshot": { "type": "string" }, "outputSeq": { "type": "integer" }, "partial": { "type": "boolean" }, "finishReason": { "type": ["string", "null"] } } },
      "MeetingPage": { "type": "object", "required": ["items", "nextCursor"], "properties": { "items": { "type": "array", "items": { "type": "object", "required": ["id", "revision"], "properties": { "id": { "type": "string", "format": "uuid" }, "revision": { "type": "string", "format": "date-time" } } }, "nextCursor": { "type": ["string", "null"] } } },
      "MeetingPatch": { "type": "object", "properties": { "clientId": { "type": ["string", "null"], "format": "uuid" }, "subject": { "type": "string" }, "description": { "type": ["string", "null"] }, "location": { "type": ["string", "null"] }, "startsAt": { "type": "string", "format": "date-time" }, "endsAt": { "type": "string", "format": "date-time" }, "status": { "type": "string" } } },
      "EncryptedArtifactPatch": { "type": "object", "required": ["body"], "properties": { "body": { "type": "string", "minLength": 1 }, "confidential": { "type": "boolean" }, "accessLevel": { "type": "string" } } },
      "FileUploadRequest": { "type": "object", "required": ["fileName", "contentType", "contentLength"], "properties": { "clientId": { "type": "string", "format": "uuid" }, "meetingId": { "type": "string", "format": "uuid" }, "fileName": { "type": "string" }, "contentType": { "type": "string" }, "contentLength": { "type": "integer", "minimum": 1 } } },
      "FileConfirmRequest": { "type": "object", "required": ["fileName", "contentType", "s3Key"], "properties": { "clientId": { "type": "string", "format": "uuid" }, "meetingId": { "type": "string", "format": "uuid" }, "fileName": { "type": "string" }, "contentType": { "type": "string" }, "s3Key": { "type": "string" }, "checksumSha256": { "type": "string", "minLength": 64, "maxLength": 64 } } },
      "DeviceRegistration": { "type": "object", "required": ["deviceId", "environment", "token"], "properties": { "deviceId": { "type": "string", "maxLength": 128 }, "environment": { "enum": ["sandbox", "production"] }, "token": { "type": "string", "minLength": 64, "maxLength": 512, "writeOnly": true }, "appVersion": { "type": "string", "maxLength": 64 } } },
      "Error": { "type": "object", "required": ["statusCode", "code", "message"], "properties": { "statusCode": { "type": "integer" }, "code": { "type": "string" }, "message": { "type": "string" } } }
    },
    "responses": {
      "BadRequest": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Authenticated but not authorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Unknown or not visible to this actor", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "FeatureDisabled": { "description": "Default-closed mobile gate", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "Idempotency, occupancy, or upload conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "StaleRevision": { "description": "The canonical record changed; response contains only non-sensitive current metadata.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "statusCode": 409, "code": "stale_revision", "message": "meeting changed since it was read", "current": { "id": "00000000-0000-0000-0000-000000000004", "revision": "2026-09-23T12:00:00.000Z" } } } } },
      "PreconditionRequired": { "description": "If-Match required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
}
