                    "$ref": "#/definitions/UUID"
                  }
                ]
              }
            }
          },
          "uniqueItems": true
        },
        "strategyType": {
          "enum": [
            "appropriations",
            "authorization",
            "regulatory",
            "coalition",
            "procurement",
            "earmark",
            "amendment"
          ]
