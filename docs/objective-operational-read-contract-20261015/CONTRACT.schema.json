    },
    "Reason": {
      "enum": [
        "association_reader_missing",
        "membership_not_established",
        "owner_unavailable",
        "authorization_limited",
        "pagination_drift",
        "unsupported_question_lifecycle",
        "unsupported_window_metric",
        "unsupported_feasibility_metric",
        "source_unverifiable"
      ]
    },
    "Coverage": {
      "enum": [
        "complete",
        "partial",
        "unbound",
        "unavailable",
        "not_implemented"
      ]
