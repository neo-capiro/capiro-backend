      }
    },
    "DecisionRow": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "task",
            "approval",
            "provenance"
          ],
          "properties": {
            "kind": {
              "const": "planner_approval"
            },
            "task": {
              "allOf": [
                {
                  "$ref": "#/definitions/Resource"
                },
                {
                  "properties": {
                    "selection": {
                      "properties": {
                        "kind": {
                          "const": "planner_task"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "approval": {
              "const": "pending"
            },
            "provenance": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Provenance"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "session",
            "proposalId",
            "state",
            "title",
            "provenance"
          ],
          "properties": {
            "kind": {
              "const": "outreach_proposal"
            },
            "session": {
              "allOf": [
                {
                  "$ref": "#/definitions/Resource"
                },
                {
                  "properties": {
                    "selection": {
                      "properties": {
                        "kind": {
                          "const": "outreach_session"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "proposalId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "state": {
              "const": "pending"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "provenance": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Provenance"
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "StrategySection": {
      "type": "object",
      "additionalProperties": false,
