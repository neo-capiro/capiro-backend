# Funding Opportunities release gate.
#
# WHY THIS EXISTS SEPARATELY FROM ci-pr.yml
# -----------------------------------------
# ci-pr.yml enforces "no new failures versus baseline", which is the right default
# for a repo carrying ~40 pre-existing apps/api failures across 12 suites. It is the
# wrong bar for shipping this feature, for three reasons that all bit this codebase
# in the last week:
#
#  1. A Funding Opportunities regression that lands inside an already-red suite
#     passes "no new failures" untouched.
#  2. ci-pr.yml runs NO apps/web tests at all. FundingOpportunitiesPage.test.tsx
#     was DEAD on main — a `vi.mock` hoisting error killed it at collection, vitest
#     reported `(0 test)`, and 38 assertions had never executed a single time.
#     Nothing in CI noticed for as long as the file has existed.
#  3. apps/api/tsconfig.json EXCLUDES `scripts`, so no typecheck reached the
#     producers, the lifecycle pass, the SAM sync or the enricher. PR #651 shipped
#     an uncompilable producer through a green CI for exactly this reason, and the
#     same PR's migration named the wrong table (`client` vs `clients`), turning
#     main red on 2026-07-28.
#
# Inside Funding Opportunities scope the bar here is ABSOLUTE: zero failures, zero
# skips, and a floor on suite and test counts so the gate cannot shrink quietly.
#
# PATH SCOPING IS DONE INSIDE THE JOB, NOT WITH `paths:`
# ------------------------------------------------------
# A workflow-level `paths:` filter does not skip the job — it skips the whole
# WORKFLOW, so no job in it reports at all. A required check configured on a
# path-filtered workflow therefore blocks every PR that misses the filter, forever,
# waiting for a check that will never run. (A companion `if: false` "skipped" job
# does NOT fix this: a job that never runs reports nothing either.)
#
# legiwatch-ci.yml avoids the problem by not filtering, which is affordable at ~90s.
# This gate provisions Postgres and replays ~190 migrations, so it scopes INSIDE the
# job instead: it always runs and always reports, and the expensive steps are gated
# on a diff check. An out-of-scope PR gets a green check in about a minute.
#
# SCOPE IS ENUMERATED, NOT GLOBBED
# --------------------------------
# Suite lists are explicit so the bar cannot silently shrink, and every test step
# asserts a MINIMUM suite and test count via scripts/assert-test-summary.mjs —
# because an explicit list still degrades quietly if a rename stops a path from
# matching. Raise the floors when you add suites; LOWERING one is indistinguishable
# from the gate shrinking and belongs in a PR description.
name: funding-opportunities-ci

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  funding-opportunities:
    runs-on: ubuntu-latest
    # The serial API suites exceeded the former 45-minute job budget.
    # Keep every suite, count floor, and disposable DB isolation check.
    timeout-minutes: 90
    services:
      postgres:
        # pgvector, not plain postgres: early repository migrations create vector
        # columns, so a clean replay fails on the stock image.
        image: pgvector/pgvector:pg16
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          # Early repository migrations reference database "capiro" by NAME, so a
          # clean replay must use that exact database. Same reason as
          # engagement-trust-boundary.yml.
          POSTGRES_DB: capiro
        ports:
          - 5486:5432
        options: >-
          --health-cmd "pg_isready -U postgres -d capiro"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 10

    env:
      # In-band Jest groups, nest build and the web build (tsc + vite) all run
      # on this heap; 6 GB is the level at which all of them have completed.
      NODE_OPTIONS: --max-old-space-size=6144
      DATABASE_URL: postgresql://fo_test:fo_test_local@127.0.0.1:5486/fo_v2_test?schema=public
      FUNDING_OPPORTUNITIES_TEST_DATABASE_URL: postgresql://fo_test:fo_test_local@127.0.0.1:5486/fo_v2_test?schema=public
      PSQL_DATABASE_URL: postgresql://fo_test:fo_test_local@127.0.0.1:5486/fo_v2_test
      CI_POSTGRES_ADMIN_DATABASE_URL: postgresql://postgres:postgres@127.0.0.1:5486/postgres?schema=public

    steps:
      # fetch-depth 0 so the in-scope diff below can reach the merge base.
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # Decides whether this PR touches Funding Opportunities. On `push` to main and
      # on `workflow_dispatch` the answer is always yes — main must stay green
      # unconditionally, and a manual run is someone asking for the full gate.
      - name: Is this change in scope?
        id: scope
        shell: bash
        run: |
          set -euo pipefail
          if [ "${{ github.event_name }}" != "pull_request" ]; then
            echo "in_scope=true" >> "$GITHUB_OUTPUT"
            echo "Not a pull request — running the full gate."
            exit 0
          fi
          base="${{ github.event.pull_request.base.sha }}"
          changed=$(git diff --name-only "$base"...HEAD)
          echo "$changed" | sed 's/^/  /'
          if echo "$changed" | grep -Eq '^(apps/api/src/funding-opportunities/|apps/api/src/california-grants/|apps/api/src/external/tango/|packages/shared/|apps/api/src/bootstrap/|apps/api/src/config/config\.schema\.(ts|spec\.ts)|apps/api/src/webhooks/tango-webhook|apps/api/src/webhooks/webhooks\.module\.ts|apps/api/src/bootstrap/configure-api-http-app|infra/cdk/lib/config\.ts|infra/cdk/lib/compute-stack\.ts|infra/cdk/test/compute-stack.*\.spec\.ts|apps/api/src/clients/|apps/api/src/intelligence/intelligence\.(manual-mapping|mapping-governance|service|controller)|apps/api/src/meri/(meri-tools\.service\.ts|meri-tools\.registration\.spec\.ts|meri\.module\.ts|meri-mcp\.catalog\.(ts|spec\.ts)|meri-mcp-transport\.(ts|spec\.ts)|meri-mcp\.service\.ts)|apps/api/scripts/(sync-sam-opportunities|sync-grants|enrich-grant-details|process-funding-opportunity-lifecycle|backfill-funding-mapping-review|backfill-sam-opportunity-fields|repair-set-aside-certifications|funding-opportunities-entrypoint|sam-opportunity-matcher|reconcile-tango-webhook-alerts|process-tango-events|diag-funding-opportunities-makegov|diag-tango-webhook-contract|diag-tango-dibbs-sbir-ingestion|sync-tango-dibbs|sync-tango-entities|sync-tango-vehicles)|apps/api/package\.json|apps/api/tsconfig\.funding-opportunities\.json|apps/api/prisma/|apps/web/src/vnext/pages/funding-opportunities/|apps/web/src/vnext/adapters/legacy/|apps/web/src/vnext/pages/client-crm/|apps/web/src/vnext/shell/AppShellUui/|apps/web/src/vnext/foundations/reset\.css|apps/web/src/vnext/testing/visual/(funding-opportunities-v2-fixture-api|funding-opportunities-v2-main|funding-opportunities-v2-pursuit-fixtures|funding-opportunities-v2-reference-data)\.(ts|tsx)|apps/web/public/assets/capiro-reference-logo\.png|apps/web/src/pages/clients/intelligence-v1/sections/FundingOpportunitiesSection|apps/web/src/pages/settings/IntelligenceMappingsPage|apps/web/src/App\.tsx|apps/web/src/App\.funding-opportunities-nav|scripts/ci/(bootstrap-funding-opportunities-test-dbs|verify-funding-opportunity-schema)\.sh|scripts/ci/(intel-feature-flag-test-schema|disposable-capiro-worker-prerequisite|disposable-capiro-worker-role|research-portfolio-append-only-prerequisite)\.sql|scripts/ci/verify-funding-indexes(\.test)?\.mjs|scripts/ci/funding-sql-owned-indexes\.json|\.github/workflows/funding-opportunities-ci\.yml)'; then
            echo "in_scope=true" >> "$GITHUB_OUTPUT"
            echo "In scope — running the full gate."
          else
            echo "in_scope=false" >> "$GITHUB_OUTPUT"
            echo "Out of scope — reporting green without provisioning the database."
          fi

      - uses: pnpm/action-setup@v4
        if: steps.scope.outputs.in_scope == 'true'
      - uses: actions/setup-node@v7
        if: steps.scope.outputs.in_scope == 'true'
        with:
          node-version: 22
          cache: pnpm

      - name: Install with frozen lockfile
        if: steps.scope.outputs.in_scope == 'true'
        run: pnpm install --frozen-lockfile

      # All five clients. A whole-repo typecheck needs every one of them generated:
      # with only apps/api's, every raw query in the ungenerated packages collapses
      # to `{}` and apps/onboard-api fails outright on a missing generated module —
      # 100+ errors in code this gate does not own. Generated clients and
      # typechecked packages must agree.
      - name: Generate Prisma clients
        if: steps.scope.outputs.in_scope == 'true'
        run: |
          pnpm --filter @capiro/api exec prisma generate
          pnpm --filter @capiro/workspace exec prisma generate
          pnpm --filter @capiro/intel-api exec prisma generate
          pnpm --filter @capiro/onboard-api exec prisma generate
          pnpm --filter @capiro/api-strategy exec prisma generate

      # `packages/*` must be BUILT before anything typechecks or builds apps/api or
      # apps/web. `@capiro/shared` resolves to its `dist/`, which does not exist in a
      # fresh checkout — so on the first run of this gate the funding-opportunities
      # typecheck died with three `Cannot find module '@capiro/shared'` errors.
      #
      # legiwatch-ci.yml gets away without this step because it only ever typechecks
      # through `pnpm turbo run typecheck`, and turbo resolves the dependency graph and
      # builds upstream packages itself. This gate additionally invokes `tsc` DIRECTLY
      # for tsconfig.funding-opportunities.json (turbo has no task for a second
      # tsconfig in the same package), which bypasses that graph entirely. Building the
      # packages explicitly makes every later step order-independent.
      - name: Build workspace packages
        if: steps.scope.outputs.in_scope == 'true'
        run: pnpm --filter "./packages/*" build

      - name: Validate the Prisma schema
        if: steps.scope.outputs.in_scope == 'true'
        run: pnpm --filter @capiro/api exec prisma validate

      # A CLEAN replay, not `migrate dev`. This is the step that would have caught
      # PR #651's `ALTER TABLE "client"` (the model is @@map'd to `clients`), which
      # reached main and turned it red because nothing replayed migrations against
      # an empty database.
      - name: Bootstrap isolated Funding Opportunities databases
        if: steps.scope.outputs.in_scope == 'true'
        id: migrate
        env:
          CI_DISPOSABLE_POSTGRES: '1'
        shell: bash
        run: |
          set -o pipefail
          bash --noprofile --norc scripts/ci/bootstrap-funding-opportunities-test-dbs.sh 2>&1 | tee migration-deploy.log

      # `migrate deploy` exits 0 on a no-op, so a migration silently skipped for
      # sorting reasons would pass the step above. Assert the new one actually ran.
      - name: Assert this feature's migrations were applied
        if: steps.scope.outputs.in_scope == 'true'
        shell: bash
        run: |
          set -euo pipefail
          for name in \
            20260810010000_funding_opportunities \
            20260810020000_funding_opportunities_closeout \
            20260810040000_funding_opportunities_lifecycle_truth \
            20260819010000_funding_opportunity_decisions \
            20260820010000_funding_opportunity_generic_source \
            20260821010000_tango_source_substrate \
            20260826010000_tango_opportunity_crosswalk \
            20260827010000_tango_opportunity_notice_history \
            20260828010000_tango_notice_description_hash \
            20260829010000_opportunity_attachments \
            20260830010000_opportunity_document_text \
            20260831010000_opportunity_requirement_artifacts \
            20260901010000_funding_opportunity_pipeline_v2 \
            20260902010000_tango_budget_context \
            20260903010000_tango_procurement_risk \
            20260904010000_outcome_event_funding_opportunity \
            20260905010000_tango_webhook_deliveries \
            20260906010000_tango_event_outbox \
            20260907010000_tango_event_outbox_per_event \
            20260908010000_tango_dibbs \
            20260909010000_tango_sbir_sttr \
            20280211010000_engagement_task_action_source_uniq
          do
            if ! grep -q "$name" migration-deploy.log; then
              echo "::error::migration $name was NOT applied by migrate deploy."
              echo "Most likely it is absent from apps/api/prisma/migrations, or its"
              echo "directory name does not match the name asserted here."
              exit 1
            fi
          done

      # TWO CORRECTIONS TO THE STEP ABOVE, both made in P42 and both measured.
      #
      # 1. 20260908010000_tango_dibbs was missing from the list. P40 shipped a
      #    migration and did not add it here, so the one gate that proves a
      #    migration actually ran did not cover it. Added, along with P42's.
      #
      # 2. The old failure message said "A migration stamped earlier than an
      #    already-applied one is never run." THAT IS NOT TRUE of
      #    `prisma migrate deploy` (5.22.0), and it matters because it would
      #    push someone into renumbering a correct migration.
      #
      #    Measured rather than reasoned about: a clean database was migrated
      #    with 20260909010000_tango_sbir_sttr REMOVED from the directory,
      #    reaching 20261001011000_tango_subaward_reobservation_freshness. The
      #    migration was then restored and `migrate deploy` run again. It
      #    applied, created both tables, and landed in _prisma_migrations with a
      #    finished_at LATER than the 20261001 row. deploy applies whatever is
      #    in the directory and not in the ledger; name order decides sequence
      #    among pending migrations, not eligibility.
      #
      #    The guard is still worth having — `migrate deploy` exits 0 on a
      #    no-op, so a migration missing from the directory entirely would pass
      #    the step above unnoticed. Only the explanation was wrong.

      # Schema-vs-database agreement, SCOPED TO THIS FEATURE'S OBJECTS.
      #
      # The obvious form of this check — `prisma migrate diff --from-url <migrated db>
      # --to-schema-datamodel schema.prisma --exit-code` — is NOT usable in this repo.
      # Measured on this branch's first CI run, it reports large PRE-EXISTING drift
      # that has nothing to do with Funding Opportunities: `lobby_intel` and
      # `lobby_issue_ref` exist in schema.prisma but in no migration, dozens of tables
      # differ on whether `id` carries a `uuid_generate_v4()` DB default, and many
      # foreign keys and indexes were renamed by Prisma convention without a migration.
      # A gate that is red on arrival for reasons the branch does not own teaches
      # nothing and gets ignored — the same mistake as the hardcoded migration-ordering
      # assertion this branch had to un-brittle.
      #
      # Repo-wide drift is a real problem and deserves its own remediation. What this
      # step can honestly enforce is that the objects THIS migration declares actually
      # exist in a freshly migrated database — which is the failure mode that matters
      # here: LegiWatch Gate E was merged, deployed and digest-verified, and still
      # 500'd for every tenant because its migrations never ran.
      - name: Assert this feature's schema objects exist in the migrated database
        if: steps.scope.outputs.in_scope == 'true'
        shell: bash
        run: bash --noprofile --norc -e -o pipefail scripts/ci/verify-funding-opportunity-schema.sh

      # Verify final index definitions, including later DROP/replacement migrations.
      # Prisma owns representable indexes; an explicit SQL contract owns partial
      # and expression indexes. Both are checked against the migrated catalog.
      - name: Verify Funding index contracts
        if: steps.scope.outputs.in_scope == 'true'
        shell: bash
        run: |
          set -euo pipefail
          pnpm --filter @capiro/api exec prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > "$RUNNER_TEMP/funding-schema.sql"
          FUNDING_GENERATED_SCHEMA_SQL="$RUNNER_TEMP/funding-schema.sql" node --test scripts/ci/verify-funding-indexes.test.mjs
          node scripts/ci/verify-funding-indexes.mjs --schema-sql "$RUNNER_TEMP/funding-schema.sql"

      # The Funding Opportunities script typecheck. apps/api/tsconfig.json excludes
      # `scripts`, so this config is the ONLY thing that typechecks the producers,
      # the lifecycle pass, the SAM sync, the enricher and the repair scripts.
      - name: Typecheck — Funding Opportunities scripts
        if: steps.scope.outputs.in_scope == 'true'
        run: pnpm --filter @capiro/api exec tsc -p tsconfig.funding-opportunities.json --noEmit

      # The retired P08 disposable script is intentionally absent. Concurrent
      # transition coverage remains in funding-opportunity-pipeline.spec.ts.
      - name: Typecheck — apps/api and apps/web
        if: steps.scope.outputs.in_scope == 'true'
        # The API typecheck's first program alone now exceeds 4 GB. Run the
        # projects one at a time through pnpm, which passes NODE_OPTIONS to the
        # scripts; every workspace package was built above.
        env:
          NODE_OPTIONS: --max-old-space-size=6144
        run: |
          pnpm --filter @capiro/api typecheck
          pnpm --filter @capiro/web typecheck

      # ---------------------------------------------------------------- api --
      # Every module this feature owns, enumerated. `--runInBand` on the
      # 6 GB job heap: the migration service is shared and parallel workers
      # on one Postgres make failures non-deterministic. A 1 GB idle limit
      # restarts the worker after every suite (~30 s ts-jest reload each).
      - name: Validate isolated API test paths
        if: steps.scope.outputs.in_scope == 'true'
        shell: bash
        run: |
          set -euo pipefail
          for path in \
            src/funding-opportunities/funding-opportunity-v2-search.sql.spec.ts \
            src/funding-opportunities/funding-opportunity-v2-search.http.integration.spec.ts \
            src/funding-opportunities/funding-opportunity-v2-search.integration.spec.ts \
            src/funding-opportunities/funding-opportunity-saved-search.http.integration.spec.ts \
            src/funding-opportunities/funding-opportunity-v2-detail.http.spec.ts \
            src/funding-opportunities/funding-opportunity-v2-workflow.http.integration.spec.ts \
            src/funding-opportunities/funding-opportunity-pipeline.http.integration.spec.ts \
            src/funding-opportunities/funding-opportunity-pipeline-source-access.integration.spec.ts
          do
            test -f "apps/api/$path" || { echo "::error::missing API test path $path"; exit 1; }
          done

      - name: Tests — apps/api Funding Opportunities scope
        if: steps.scope.outputs.in_scope == 'true'
        run: >
          pnpm --filter @capiro/api exec jest --ci --silent --runInBand
          --json --outputFile=$GITHUB_WORKSPACE/api-summary.json
          --testPathIgnorePatterns='src/funding-opportunities/(funding-opportunity-v2-search\.sql|funding-opportunity-v2-search\.http\.integration|funding-opportunity-v2-search\.integration|funding-opportunity-saved-search\.http\.integration|funding-opportunity-v2-detail\.http|funding-opportunity-v2-workflow\.http\.integration|funding-opportunity-pipeline\.http\.integration|funding-opportunity-pipeline-source-access\.integration)\.spec\.ts$'
          --
          src/funding-opportunities/
          src/california-grants/california-grants-ingestion.spec.ts
          src/external/tango/
          src/config/config.schema.spec.ts
          src/webhooks/tango-webhook.spec.ts
          src/intelligence/intelligence.manual-mapping.spec.ts
          src/intelligence/intelligence.mapping-governance.spec.ts
          src/meri/meri-tools.registration.spec.ts
          src/meri/meri-tools.firmdata.spec.ts
          src/meri/meri-mcp.catalog.spec.ts
          src/meri/meri-mcp-transport.spec.ts
          scripts/enrich-grant-details.spec.ts
          scripts/sync-sam-opportunities.spec.ts
          scripts/sync-grants.spec.ts
          scripts/process-funding-opportunity-lifecycle.spec.ts
          scripts/backfill-funding-mapping-review.spec.ts
          scripts/backfill-sam-opportunity-fields.spec.ts
          scripts/repair-set-aside-certifications.spec.ts
          scripts/funding-opportunities-entrypoint.spec.ts
          scripts/sam-opportunity-matcher.spec.ts
          scripts/diag-tango-capabilities.spec.ts
          scripts/diag-tango-health.spec.ts
          scripts/sync-tango-entities.spec.ts
          scripts/generate-tango-enrichment-candidates.spec.ts
          scripts/review-tango-enrichment-candidate.spec.ts
          scripts/diag-federal-business-profile.spec.ts
          scripts/sync-tango-vehicles.spec.ts
          scripts/sync-tango-forecasts.spec.ts
          scripts/sync-tango-opportunity-shadow.spec.ts
          scripts/diag-tango-opportunity-parity.spec.ts
          scripts/sync-tango-opportunity-notices.spec.ts
          scripts/sync-tango-opportunity-attachments.spec.ts
          scripts/sync-tango-opportunity-text.spec.ts
          scripts/reconcile-tango-webhook-alerts.spec.ts
          scripts/process-tango-events.spec.ts
          scripts/diag-funding-opportunities-makegov.spec.ts
          scripts/diag-tango-webhook-contract.spec.ts
          scripts/diag-tango-dibbs-sbir-ingestion.spec.ts
          scripts/sync-tango-dibbs.spec.ts
          scripts/sync-tango-sbir.spec.ts
          scripts/diag-tango-contract-capture.spec.ts

      # Each DB-backed group receives both database variables pointing at its own
      # isolated database. The summary gate rejects any failure, skip, or todo; the
      # nonzero floors below are the current explicit collected-case counts (the
      # DB groups remain execution-blocked when Docker is unavailable).
      - name: Tests — API Search SQL and HTTP (fo_v2_search)
        if: steps.scope.outputs.in_scope == 'true'
        shell: bash
        run: |
          set -uo pipefail
          test_url='postgresql://fo_test:fo_test_local@127.0.0.1:5486/fo_v2_search?schema=public'
          set +e
          DATABASE_URL="$test_url" FUNDING_OPPORTUNITIES_TEST_DATABASE_URL="$test_url" \
            pnpm --filter @capiro/api exec jest --ci --silent --runInBand \
            --json --outputFile="$GITHUB_WORKSPACE/search-summary.json" \
            src/funding-opportunities/funding-opportunity-v2-search.sql.spec.ts \
            src/funding-opportunities/funding-opportunity-v2-search.http.integration.spec.ts \
            src/funding-opportunities/funding-opportunity-v2-search.integration.spec.ts
          status=$?
          node scripts/assert-test-summary.mjs "$GITHUB_WORKSPACE/search-summary.json" apps/api-search 3 12
          gate=$?
          (( status == 0 && gate == 0 )) || exit 1

      - name: Tests — API Saved HTTP (fo_v2_saved)
        if: steps.scope.outputs.in_scope == 'true'
        shell: bash
        run: |
          set -uo pipefail
          test_url='postgresql://fo_test:fo_test_local@127.0.0.1:5486/fo_v2_saved?schema=public'
          set +e
          DATABASE_URL="$test_url" FUNDING_OPPORTUNITIES_TEST_DATABASE_URL="$test_url" \
            pnpm --filter @capiro/api exec jest --ci --silent --runInBand \
            --json --outputFile="$GITHUB_WORKSPACE/saved-summary.json" \
            src/funding-opportunities/funding-opportunity-saved-search.http.integration.spec.ts
          status=$?
          node scripts/assert-test-summary.mjs "$GITHUB_WORKSPACE/saved-summary.json" apps/api-saved 1 2
          gate=$?
          (( status == 0 && gate == 0 )) || exit 1

      - name: Tests — API Detail Workflow Pipeline HTTP (fo_v2_test)
        if: steps.scope.outputs.in_scope == 'true'
        shell: bash
        run: |
          set -uo pipefail
          test_url='postgresql://fo_test:fo_test_local@127.0.0.1:5486/fo_v2_test?schema=public'
          set +e
          DATABASE_URL="$test_url" FUNDING_OPPORTUNITIES_TEST_DATABASE_URL="$test_url" \
            pnpm --filter @capiro/api exec jest --ci --silent --runInBand \
            --json --outputFile="$GITHUB_WORKSPACE/detail-workflow-pipeline-summary.json" \
            src/funding-opportunities/funding-opportunity-v2-detail.http.spec.ts \
            src/funding-opportunities/funding-opportunity-v2-workflow.http.integration.spec.ts \
            src/funding-opportunities/funding-opportunity-pipeline.http.integration.spec.ts \
            src/funding-opportunities/funding-opportunity-pipeline-source-access.integration.spec.ts
          status=$?
          node scripts/assert-test-summary.mjs "$GITHUB_WORKSPACE/detail-workflow-pipeline-summary.json" apps/api-detail-workflow-pipeline 4 48
          gate=$?
          (( status == 0 && gate == 0 )) || exit 1

      # The ordinary group and each isolated DB group must report zero failures,
      # zero skips, and zero todos. Floors are measured current collection counts.
      - name: Assert apps/api scope is clean
        if: always() && steps.scope.outputs.in_scope == 'true'
        run: node scripts/assert-test-summary.mjs "$GITHUB_WORKSPACE/api-summary.json" apps/api-ordinary 94 2538

      # ---------------------------------------------------------------- web --
      # ci-pr.yml runs no web tests at all, so this is the ONLY gate that exercises
      # the standalone Funding Opportunities page or the Intelligence Mappings
      # settings page.
      - name: Tests — apps/web Funding Opportunities scope
        if: steps.scope.outputs.in_scope == 'true'
        run: |
          web_tests=(
          src/vnext/pages/funding-opportunities/FundingOpportunitiesPage.test.tsx
          src/vnext/pages/funding-opportunities/FundingOpportunityPipeline.test.tsx
          src/vnext/pages/funding-opportunities/FundingOpportunityV2Detail.test.tsx
          src/vnext/pages/funding-opportunities/FundingOpportunitiesV2SavedSearches.test.tsx
          src/vnext/pages/funding-opportunities/FundingOpportunityV2ResultCard.test.tsx
          src/vnext/pages/funding-opportunities/funding-opportunities-v2-controls.test.ts
          src/vnext/pages/funding-opportunities/client-profile-keywords.test.ts
          src/vnext/adapters/legacy/useClientFundingOpportunitiesV2.test.ts
          src/vnext/adapters/legacy/useShellClientContext.funding.test.tsx
          src/vnext/adapters/legacy/useClientCrmOverviewModel.test.tsx
          src/vnext/pages/client-crm/tabs/OpportunitiesTab.test.tsx
          src/vnext/testing/visual/funding-opportunities-v2-fixture-api.test.ts
          src/pages/clients/intelligence-v1/sections/FundingOpportunitiesSection.test.tsx
          src/pages/settings/IntelligenceMappingsPage.test.tsx
          src/App.funding-opportunities-nav.test.tsx
          )
          for test_file in "${web_tests[@]}"; do
            test -f "apps/web/$test_file" || { echo "Missing required web test: $test_file" >&2; exit 1; }
          done
          pnpm --filter @capiro/web exec vitest run \
            --pool=threads --poolOptions.threads.singleThread \
            --testTimeout=20000 --hookTimeout=20000 \
            --reporter=json --outputFile="$GITHUB_WORKSPACE/web-summary.json" \
            "${web_tests[@]}"

      # The suite floor drops from 46 on purpose: funding-opportunities-v2-keyword
      # (1 file + 1 describe = 2 vitest suites) was deleted with its module in
      # d0f126146; keyword/phrase coverage lives in the controls and page tests.
      # The test floor rises from 137 to the 146 that now run.
      - name: Assert apps/web scope is clean
        if: always() && steps.scope.outputs.in_scope == 'true'
        run: node scripts/assert-test-summary.mjs "$GITHUB_WORKSPACE/web-summary.json" apps/web 44 146

      # ------------------------------------------------------------- builds --
      # A passing typecheck is not a passing build: the api build runs `nest build`
      # (different module resolution) and the web build runs vite's production
      # transform, and each has caught errors the other did not.
      - name: Build apps/api
        if: steps.scope.outputs.in_scope == 'true'
        run: pnpm --filter @capiro/api build

      - name: Build apps/web
        if: steps.scope.outputs.in_scope == 'true'
        run: pnpm --filter @capiro/web build
