# Build/test publication only. Promotion requires the reviewed digest release procedure.
name: meriv2-orchestrator-image

on:
  push:
    branches: [main]
    paths:
      - 'apps/meriv2-orchestrator/**'
      - 'packages/meriv2-core/**'
      - 'packages/shared/**'
      - 'packages/strategy-verifier/**'
      - 'apps/api/prisma/schema.prisma'
      - 'pnpm-lock.yaml'
      - '.github/workflows/meriv2-orchestrator-image.yml'
  workflow_dispatch:
    inputs:
      env:
        description: 'Target env (dev|staging|prod)'
        required: true
        default: 'dev'
        type: choice
        options: [dev, staging, prod]

permissions:
  id-token: write
  contents: read

env:
  AWS_REGION: us-east-1
  TARGET_ENV: ${{ github.event.inputs.env || 'dev' }}

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4

      - name: Validate Meri orchestrator build-only contract
        run: python3 scripts/validate-meri-orchestrator-build-only.py

      - name: Validate build isolation
        run: python3 scripts/validate-meri-build-isolation.py

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ env.TARGET_ENV == 'prod' && vars.AWS_PROD_GHA_ROLE_ARN || vars.AWS_DEV_GHA_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Login to Amazon ECR
        id: ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build and push (linux/arm64)
        id: build
        uses: docker/build-push-action@v6
        with:
          context: .
          file: apps/meriv2-orchestrator/Dockerfile
          platforms: linux/arm64
          push: true
          provenance: false
          tags: |
            ${{ steps.ecr.outputs.registry }}/capiro/${{ env.TARGET_ENV }}/meriv2-orchestrator:${{ github.sha }}
          no-cache-filters: build
          cache-from: type=gha,scope=meriv2-orchestrator
          cache-to: type=gha,mode=max,scope=meriv2-orchestrator

      - name: Record candidate digest (not promoted)
        env:
          IMAGE_DIGEST: ${{ steps.build.outputs.digest }}
          REGISTRY: ${{ steps.ecr.outputs.registry }}
        run: |
          test -n "$IMAGE_DIGEST"
          echo "Candidate: $REGISTRY/capiro/$TARGET_ENV/meriv2-orchestrator@$IMAGE_DIGEST" >> "$GITHUB_STEP_SUMMARY"
          echo "Source: $GITHUB_SHA — build publication only; qualification and approval still required." >> "$GITHUB_STEP_SUMMARY"
