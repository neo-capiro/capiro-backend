name: Phase 8 Session 8 Live Official-Source Discovery

on:
  push:
    paths:
      - 'apps/api/prisma/migrations/20261127120000_phase8_session8_live_source_discovery/**'
      - 'apps/api/prisma/schema.prisma'
      - 'apps/defense-api/src/budget-lifecycle/**'
      - 'apps/defense-api/scripts/run-live-discovery.mjs'
      - 'apps/defense-api/package.json'
      - 'packages/defense-domain/src/budget-lifecycle/**'
      - 'packages/defense-domain/src/index.ts'
      - 'scripts/*phase8-session8*'
      - 'docs/defense-budget/phase8-session8-*'
      - '.github/workflows/phase8-session8-live-source-discovery.yml'
  pull_request:
    paths:
      - 'apps/api/prisma/migrations/20261127120000_phase8_session8_live_source_discovery/**'
      - 'apps/api/prisma/schema.prisma'
      - 'apps/defense-api/src/budget-lifecycle/**'
      - 'apps/defense-api/scripts/run-live-discovery.mjs'
      - 'apps/defense-api/package.json'
      - 'packages/defense-domain/src/budget-lifecycle/**'
      - 'packages/defense-domain/src/index.ts'
      - 'scripts/*phase8-session8*'
      - 'docs/defense-budget/phase8-session8-*'
      - '.github/workflows/phase8-session8-live-source-discovery.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  live-source-discovery:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Pin pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 9.12.0
      - uses: actions/setup-node@v7
        with:
          node-version: '20'
          cache: pnpm
      - name: Frozen workspace install
        run: pnpm install --frozen-lockfile

      - name: Build shared defense packages
        run: |
          pnpm --filter @capiro/shared build
          pnpm --filter @capiro/auth build
          pnpm --filter @capiro/defense-contracts build
          pnpm --filter @capiro/defense-domain build
          pnpm --filter @capiro/defense-client build

      - name: Discovery domain gate
        run: node scripts/test-phase8-session8-discovery-domain.mjs

      # Publisher-native document kinds: what makes the nine index-page adapters
      # resolvable at all, plus the guards that keep it from being a hole.
      - name: Publisher-native document-kind gate
        run: node scripts/test-phase8-session8-publisher-native-domain.mjs

      - name: defense-api typecheck and build
        run: |
          pnpm --filter @capiro/defense-api typecheck
          pnpm --filter @capiro/defense-api build

      - name: Live discovery control-loop tests
        run: pnpm --filter @capiro/defense-api exec tsx --test src/budget-lifecycle/discovery/live-discovery.spec.ts src/budget-lifecycle/discovery/sasc-downloads.spec.ts

      # Downloads the real DISCOVERY CHANNEL - robots policies, sitemap indexes,
      # year sitemaps and MODS records - from GovInfo, congress.gov and the DoD
      # comptroller, and asserts every claim the corpus makes about them,
      # including the negative ones (the HAC-D title really states no fiscal-year
      # phrase; comptroller.defense.gov really does refuse a plain client).
      - name: Materialise the real discovery-channel corpus
        run: node scripts/prepare-phase8-session8-discovery-corpus.mjs

      - name: Live discovery replay against real sources
        run: |
          node scripts/phase8-session8-discovery-replay.mjs \
            --out docs/defense-budget/phase8-session8-discovery-replay-evidence.json

      # Keep only public publisher responses created by the governed prepare step.
      # These are debugging bytes, not admission or completeness evidence.
      - name: Retain public discovery corpus for failure review
        if: ${{ always() }}
        uses: actions/upload-artifact@v4
        with:
          name: phase8-session8-public-discovery-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            .session8-discovery/prepared-corpus.json
            .session8-discovery/resources/*.bin
          include-hidden-files: true
          retention-days: 7
          if-no-files-found: warn

      - name: Static discovery gate
        run: node scripts/verify-phase8-session8.mjs --enforce-replay

      - name: Authoritative apps/api Prisma validation and generation
        run: |
          pnpm --filter @capiro/api exec prisma validate --schema prisma/schema.prisma
          pnpm --filter @capiro/api exec prisma generate --schema prisma/schema.prisma
        env:
          DATABASE_URL: postgresql://user:pass@localhost:5432/db

      # Session 7 trap: this step shipped without DATABASE_URL in Sessions 6 and 7
      # and could never have passed. It needs one even to validate.
      - name: Defense Prisma validation
        run: pnpm --filter @capiro/defense-api prisma:validate
        env:
          DATABASE_URL: postgresql://user:pass@localhost:5432/db

      - name: Disposable Session 8 database rehearsal
        run: node scripts/verify-phase8-session8-db.mjs

      - name: Preserve accepted Session 2-7 boundaries
        env:
          PHASE8_SESSION4_REPLAY_EVIDENCE: docs/defense-budget/phase8-session4-fy27-replay-evidence.json
        run: |
          node scripts/verify-phase8-session2.mjs
          node scripts/verify-phase8-session3.mjs
          node scripts/verify-phase8-session4.mjs --enforce-replay
          node scripts/verify-phase8-session5.mjs --enforce-provider-decision
          node scripts/verify-phase8-session6.mjs --enforce-corpus
          node scripts/verify-phase8-session7.mjs

      - name: Session 6 and 7 domain gates stay green
        run: |
          node scripts/test-phase8-session6-federal-funding-domain.mjs
          node scripts/test-phase8-session7-lifecycle-domain.mjs

      - name: Session 7 control loop stays green
        run: pnpm --filter @capiro/defense-api exec tsx --test src/budget-lifecycle/lifecycle-watcher.spec.ts

      - name: Diff hygiene
        run: git diff --check origin/${{ github.base_ref || 'main' }}...HEAD
