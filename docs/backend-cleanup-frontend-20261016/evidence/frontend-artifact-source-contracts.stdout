  AssertionError [ERR_ASSERTION]: Expected values to be strictly equal:
  + actual - expected
  
  + '# Opt-in Onboard API + explicitly supplied static SPA artifact.\r\n' +
  +   '# Existing Dockerfile remains the default; this variant is not released.\r\n' +
  +   '# Supply release-artifacts/onboard-spa/{manifest.json,site/**} and all three\r\n' +
  +   '# ONBOARD_SPA_* build args. The byte contract does not qualify browser flows.\r\n' +
  +   '#\r\n' +
  +   '# Build context: REPOSITORY ROOT (not apps/onboard-api).\r\n' +
  +   '#   docker buildx build --platform linux/arm64 -f apps/onboard-api/Dockerfile -t capiro-onboard-api:local .\r\n' +
  +   '#\r\n' +
  +   '# Multi-stage, mirroring apps/intel-api:\r\n' +
  +   '#   1. base    pnpm + corepack on slim node\r\n' +
  +   '#   2. build   install + prisma generate + compile API + build the SPA,\r\n' +
  +   '#              then prune dev deps in place\r\n' +
  +   '#   3. runtime minimal node slim, non-root user, copies the pruned workspace\r\n' +
  +   '#\r\n' +
  +   '# Owns onboard_* tables; the `migrate` mode runs `prisma migrate deploy` at\r\n' +
  +   '# task launch (forward-only), same pattern as apps/api and apps/intel-api.\r\n' +
  +   '\r\n' +
  +   'ARG NODE_VERSION=20.16.0\r\n' +
  +   '\r\n' +
  +   "# Base image is pulled from AWS's ECR Public Docker Hub mirror to avoid Docker\r\n" +
  +   "# Hub's anonymous pull rate limit. Functionally identical to node:<tag>-bookworm-slim.\r\n" +
  +   '\r\n' +
  +   '# -------- base ----------------------------------------------------------------\r\n' +
  +   'FROM public.ecr.aws/docker/library/node:${NODE_VERSION}-bookworm-slim AS base\r\n' +
  +   'ENV PNPM_HOME=/pnpm\r\n' +
  +   'ENV PATH=$PNPM_HOME:$PATH\r\n' +
  +   'RUN corepack enable && corepack prepare pnpm@9.12.0 --activate\r\n' +
  +   'WORKDIR /workspace\r\n' +
  +   '\r\n' +
  +   '# -------- build ---------------------------------------------------------------\r\n' +
  +   'FROM base AS build\r\n' +
  +   'RUN apt-get update \\\r\n' +
  +   ' && apt-get install -y --no-install-recommends openssl ca-certificates \\\r\n' +
  +   ' && rm -rf /var/lib/apt/lists/*\r\n' +
  +   '\r\n' +
  +   '# No default artifact or source pin. Validate before workspace installation.\r\n' +
  +   'COPY release-artifacts/onboard-spa /workspace/release-artifacts/onboard-spa\r\n' +
  +   'COPY scripts/lib/onboard-spa-artifact-contract.mjs /workspace/scripts/lib/onboard-spa-artifact-contract.mjs\r\n' +
  +   'ARG ONBOARD_SPA_MANIFEST_SHA256\r\n' +
  +   'ARG ONBOARD_SPA_SOURCE_REPOSITORY\r\n' +
  +   'ARG ONBOARD_SPA_SOURCE_COMMIT\r\n' +
  +   'RUN node scripts/lib/onboard-spa-artifact-contract.mjs \\\r\n' +
  +   '      --artifact-dir /workspace/release-artifacts/onboard-spa \\\r\n' +
  +   '      --manifest-sha256 "$ONBOARD_SPA_MANIFEST_SHA256" \\\r\n' +
  +   '      --source-repository "$ONBOARD_SPA_SOURCE_REPOSITORY" \\\r\n' +
  +   '      --source-commit "$ONBOARD_SPA_SOURCE_COMMIT"\r\n' +
  +   '\r\n' +
  +   'COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* tsconfig.base.json ./\r\n' +
  +   'COPY apps/onboard-api/package.json apps/onboard-api/package.json\r\n' +
  +   'COPY packages/shared/package.json packages/shared/package.json\r\n' +
  +   'COPY packages/auth/package.json packages/auth/package.json\r\n' +
  +   'RUN --mount=type=cache,id=pnpm,target=/pnpm/store \\\r\n' +
  +   '    pnpm install --frozen-lockfile \\\r\n' +
  +   '      --filter=@capiro/onboard-api... --filter=@capiro/onboard-web... \\\r\n' +
  +   '      --filter=@capiro/shared... --filter=@capiro/auth...\r\n' +
  +   '\r\n' +
  +   'COPY packages/shared/src packages/shared/src\r\n' +
  +   'COPY packages/shared/tsconfig.json packages/shared/tsconfig.json\r\n' +
  +   'COPY packages/auth/src packages/auth/src\r\n' +
  +   'COPY packages/auth/tsconfig.json packages/auth/tsconfig.json\r\n' +
  +   'COPY apps/onboard-api/src apps/onboard-api/src\r\n' +
  +   'COPY apps/onboard-api/prisma apps/onboard-api/prisma\r\n' +
  +   'COPY apps/onboard-api/tsconfig.json apps/onboard-api/tsconfig.build.json apps/onboard-api/nest-cli.json apps/onboard-api/\r\n' +
  +   '\r\n' +
  +   'RUN pnpm --filter @capiro/shared build\r\n' +
  +   'RUN pnpm --filter @capiro/auth build\r\n' +
  +   '# Generate the Prisma client (outputs to apps/onboard-api/generated/prisma-client)\r\n' +
  +   '# BEFORE the Nest build, since src imports the generated client.\r\n' +
  +   'RUN cd apps/onboard-api && pnpm exec prisma generate\r\n' +
  +   'RUN pnpm --filter @capiro/onboard-api build\r\n' +
  +   '\r\n' +
  +   '# Prune dev dependencies in place (keeps the .pnpm store intact for the\r\n' +
  +   '# generated Prisma client).\r\n' +
  +   'RUN --mount=type=cache,id=pnpm,target=/pnpm/store \\\r\n' +
  +   '    pnpm install --frozen-lockfile --prod \\\r\n' +
  +   '      --filter=@capiro/onboard-api... --filter=@capiro/shared... --filter=@capiro/auth...\r\n' +
  +   '\r\n' +
  +   '# -------- runtime -------------------------------------------------------------\r\n' +
  +   'FROM public.ecr.aws/docker/library/node:${NODE_VERSION}-bookworm-slim AS runtime\r\n' +
  +   'ENV NODE_ENV=production\r\n' +
  +   'ENV NODE_OPTIONS=--enable-source-maps\r\n' +
  +   'RUN groupadd --system --gid 1001 capiro \\\r\n' +
  +   ' && useradd --system --uid 1001 --gid capiro --shell /usr/sbin/nologin capiro \\\r\n' +
  +   ' && apt-get update \\\r\n' +
  +   ' && apt-get install -y --no-install-recommends wget ca-certificates dumb-init openssl \\\r\n' +
  +   ' && rm -rf /var/lib/apt/lists/*\r\n' +
  +   'RUN mkdir -p /app/tmp /tmp \\\r\n' +
  +   ' && chmod 1777 /tmp \\\r\n' +
  +   ' && chown capiro:capiro /app/tmp\r\n' +
  +   'ENV TMPDIR=/app/tmp\r\n' +
  +   'WORKDIR /app\r\n' +
  +   '\r\n' +
  +   'COPY --chown=capiro:capiro --from=build /workspace/node_modules /app/node_modules\r\n' +
  +   'COPY --chown=capiro:capiro --from=build /workspace/packages/shared/dist /app/packages/shared/dist\r\n' +
  +   'COPY --chown=capiro:capiro --from=build /workspace/packages/shared/package.json /app/packages/shared/package.json\r\n' +
  +   'COPY --chown=capiro:capiro --from=build /workspace/packages/auth/dist /app/packages/auth/dist\r\n' +
  +   'COPY --chown=capiro:capiro --from=build /workspace/packages/auth/package.json /app/packages/auth/package.json\r\n' +
  +   "# @capiro/auth is consumed UNBUNDLED (nest build, not the orchestrator's\r\n" +
  +   '# webpack) ΓÇö its dist resolves @nestjs/*+@clerk/backend through its own pnpm\r\n' +
  +   '# symlink dir, which must ship or the service dies at boot (MODULE_NOT_FOUND).\r\n' +
  +   'COPY --chown=capiro:capiro --from=build /workspace/packages/auth/node_modules /app/packages/auth/node_modules\r\n' +
  +   'COPY --chown=capiro:capiro --from=build /workspace/apps/onboard-api/dist /app/apps/onboard-api/dist\r\n' +
  +   'COPY --chown=capiro:capiro --from=build /workspace/apps/onboard-api/node_modules /app/apps/onboard-api/node_modules\r\n' +
  +   'COPY --chown=capiro:capiro --from=build /workspace/apps/onboard-api/package.json /app/apps/onboard-api/package.json\r\n' +
