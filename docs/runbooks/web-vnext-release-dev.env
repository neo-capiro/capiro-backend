# os.capiro.ai web-vNext release context (env=dev).
#
# Every value below was recovered from the already-deployed Capiro-dev-WebVNext
# stack and its running service, not guessed. Source it before running the
# synth/diff/deploy commands in web-vnext-os-capiro-ai.md.
#
#   set -a; . docs/runbooks/web-vnext-release-dev.env; set +a
#
# RELEASE_SHA and WEB_VNEXT_IMAGE_DIGEST change every release; everything else is
# infrastructure that already exists and is imported, never created, by this stack.

export AWS_PROFILE=capiro-dev
export AWS_REGION=us-east-1

# --- Release identity (update per release) ------------------------------------
RELEASE_SHA=0f0f8f9be752831ed3ea9b8bf8b5f9088f8d4cd5
WEB_VNEXT_IMAGE_DIGEST=sha256:350424f37858d68559cac7ce1ea3a7263e372c3b995ea233aa1458538e977e21

# --- Imported infrastructure --------------------------------------------------
EXISTING_VPC_ID=vpc-0ac26cfac7ed972be
# Order matters: existingPrivateSubnetAzs lists one AZ per subnet, in order.
EXISTING_PRIVATE_SUBNET_IDS=subnet-0e38bd390f8961fef,subnet-0920665f91c905f01,subnet-06db79cd21239de19
EXISTING_PRIVATE_SUBNET_AZS=us-east-1b,us-east-1a,us-east-1c
EXISTING_SERVICE_SG_ID=sg-01def4e5c0fe44d4a

# Shared capiro-prod-alb. Backend path rules hold priorities 6-15 and the
# marketing host rule holds 20, so they keep precedence over our host rule at 50.
# app.capiro.ai is served by the listener's DEFAULT action and is not touched.
EXISTING_HTTPS_LISTENER_ARN=arn:aws:elasticloadbalancing:us-east-1:967807252336:listener/app/capiro-prod-alb/7a4acb332b261724/e2d19b3dd47fc440
WEB_VNEXT_LISTENER_PRIORITY=50

# ACM cert whose only SAN is os.capiro.ai.
WEB_VNEXT_CERTIFICATE_ARN=arn:aws:acm:us-east-1:967807252336:certificate/09147f9f-3aba-4c41-a427-dc6dabe0e744

EXISTING_CLERK_PUBLISHABLE_KEY_ARN=arn:aws:secretsmanager:us-east-1:967807252336:secret:/capiro/dev/clerk/publishable-key-rAfesC
EXISTING_SECRETS_KEY_ARN=arn:aws:kms:us-east-1:967807252336:key/f47b4c53-b9c0-4d91-ad57-4d882f87767e

# --- Image -------------------------------------------------------------------
# ARM64, per the running task definition's runtimePlatform.
WEB_VNEXT_ECR_REPO=967807252336.dkr.ecr.us-east-1.amazonaws.com/capiro/dev/web-vnext

# --- Rollback ----------------------------------------------------------------
# Roll back by REDEPLOYING the stack with the prior SHA + digest below.
#
# Do not plan on re-pointing the service at the previous task-definition
# revision: CloudFormation deregisters the old revision as part of the update
# (the deploy log shows DELETE_COMPLETE on WebVNextTaskDef), so only the current
# revision is ACTIVE afterwards. The immutable ECR image is what makes rollback
# possible, and it is retained and tagged with its release SHA.
# Read back from the live service, not from this file's own history: this
# program's handoff docs have named the wrong deployed SHA more than once.
ROLLBACK_RELEASE_SHA=a3dbce1da601cc48ead094a652d612d09c386157
ROLLBACK_IMAGE_DIGEST=sha256:ff710394973de7096292f5f062a72e5636eda0efd167187268e6cb3bf6fd027a

# Release history (newest last), so any of these can be redeployed directly:
#   e8532946... sha256:169d29c5...  foundation shell
#   d765409a... sha256:3efee6a7...  Phase 1 shell + Phase 2 Dashboard
#   9d863037... sha256:b2631016...  Dashboard modules rebuilt from node code (never deployed)
#   19a5c7d7... sha256:083188a8...  header/due/week-chip fixes (never deployed)
#   d6644a89... sha256:db1a80cd...  Strategies + LegiWatch on their own shell (was live)
#   06a9d936... sha256:19675247...  merged: shell + Dashboard + Strategies + LegiWatch
#   5422d719... sha256:9cf355e8...  + mobile brand scaling
#   928970ce... sha256:bc652f00...  + /strategies routing and compact-density relevance fixes
#   a3dbce1d... sha256:ff710394...  + sidebar viewport-pin, Meri pill radius, dashboard context-row collapse
#   0f0f8f9b... sha256:350424f3...  + dark nav, Unicode glyphs, Meri->Button/Main, Dashboard
#                                    grid geometry, Settings vector, radius/thumbnail/attention fixes
#                                    (task def :8 is CURRENT; verified live 2026-08-11, ECS
#                                    rollout COMPLETED, image digest and HTTP 200 confirmed)
