      "id": "wrong_canonical_item_join",
      "priority": "P1",
      "file": "C:/dev/main/outputs/meri-c2-20261003/case12-live-discovery-inner-v1.mjs",
      "line": 37,
      "summary": "Candidate-to-item join uses clio projection ID instead of the canonical item ID.",
      "evidence": [
        "schema.prisma identifies committed_memory_id as clio_memory and committed_memory_item_id as the MemoryCandidateCommittedItem FK to memory_items.",
        "synthetic-approved-memory.helpers.ts joins canonical item using committed_memory_item_id and uses committed_memory_id separately as clioId."
      ],
      "impact": "Matching approved candidates can have false-null canonical item metadata despite an existing item. Candidate key counts would still match, so existing count-completeness assertions do not catch this.",
      "requiredChange": "Use mi.id=mc.committed_memory_item_id and rebind the outer script to the new inner bytes."
    }
  ],
