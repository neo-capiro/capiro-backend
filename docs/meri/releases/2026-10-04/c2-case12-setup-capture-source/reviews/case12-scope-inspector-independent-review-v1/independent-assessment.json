    "originalV1AndV2BothPassed": true,
    "cases": [
      "capture ports/recipe and same transaction",
      "foreign recipe/definitions/plan rejected before SQL",
      "tenant slug, synthetic identity, reviewer Clerk/role",
      "archived client, client wall, native approval denial",
      "missing native functions before recipe resolution"
    ]
  },
  "limits": [
    "The inspector is a private current-scope port, not a standalone complete setup-plan validator. Owner snapshot/admitted-plan checks must retain full plan/actor/count/request and genuine native admission bindings. The test deliberately uses minimal self-hashed plan fields; this does not mint authority.",
    "Supplied transaction/native functions are trusted private composition ports; caller JSON or test doubles cannot stand in for production DB authority. Real factory composition/defaults/RLS/locking qualification remains separate.",
    "Existing currentScope tenant FOR UPDATE and user/client share locks are reused; this unit test does not prove global lock order or terminal phantom exclusion.",
    "No spend/capture capability, readiness flag or acceptance promotion is produced. Owner reservation timing correction remains separately pending."
  ],
