+
+test('ordinary budgeted fetch preserves custom endpoint, premium tier and multimodal body', async () => {
+  const a = accounting();
+  const fetcher = jest.fn(async (..._args: Parameters<typeof fetch>) => response());
+  const init = {
+    method: 'POST',
