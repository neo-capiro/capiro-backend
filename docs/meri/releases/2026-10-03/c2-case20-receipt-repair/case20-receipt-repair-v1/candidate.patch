+    attempt.sourceClientId === null &&
+    attempt.fullRead === true &&
+    attempt.sourceVersion === source.currentVersion.value &&
+    attempt.contentSha256 === source.byteSha256.value &&
+    attempt.passageSha256 === source.passageSha256.value &&
