{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capiro.invalid/schemas/meri-capability-routing-eval-v1.json",
  "title": "Meri capability routing evaluation dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "status", "source", "contextFixtures", "cases"],
  "properties": {
    "schemaVersion": { "const": "meri-capability-routing-eval.v1" },
    "datasetId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["seed", "development", "calibration", "locked_holdout"] },
    "source": { "enum": ["manual_synthetic", "reviewed_traffic", "authoritative_fixture"] },
    "contextFixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "kind", "content"],
        "properties": {
          "id": { "type": "string", "pattern": "^CTX-[a-z0-9-]+$" },
          "version": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["synthetic_context", "synthetic_untrusted_content", "synthetic_permission_state", "synthetic_source_state"] },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "candidateIds", "acceptableOutcomes", "acceptableSequences", "contextState", "contextFixtureRefs", "riskTags", "split"],
        "properties": {
          "id": { "type": "string", "pattern": "^MRE-[0-9]{3}$" },
          "prompt": { "type": "string", "minLength": 1 },
          "candidateIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "acceptableOutcomes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "acceptableSequences": { "type": "array", "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } },
          "contextState": { "enum": ["sufficient", "missing", "ambiguous", "stale", "partial", "permission_limited", "unavailable", "synthetic_untrusted_instruction"] },
          "contextFixtureRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CTX-[a-z0-9-]+$" } },
          "riskTags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "split": { "enum": ["unassigned", "development", "calibration", "locked_holdout"] }
        }
      }
    }
  }
}
