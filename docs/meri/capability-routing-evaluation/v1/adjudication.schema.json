{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capiro.invalid/schemas/meri-capability-routing-adjudication-v1.json",
  "title": "Meri capability evaluation adjudication and scorecard v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "datasetSha256", "catalogVersion", "splitPlan", "cases", "runs"],
  "properties": {
    "schemaVersion": { "const": "meri-capability-routing-adjudication.v1" },
    "datasetId": { "type": "string", "minLength": 1 },
    "datasetSha256": { "$ref": "#/$defs/sha256" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "splitPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "frozenAt", "membershipSha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "frozenAt": { "type": "string", "format": "date-time" },
        "membershipSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "naturalLanguage", "familyIds", "split", "source", "annotations", "adjudication", "oracles"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "naturalLanguage": { "type": "boolean", "const": true },
        "familyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "split": { "enum": ["development", "calibration", "locked_holdout"] },
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "reference", "contentSha256", "reviewerId"],
          "properties": {
            "kind": { "enum": ["reviewed_traffic", "authoritative_fixture"] },
            "reference": { "type": "string", "minLength": 1 },
            "contentSha256": { "$ref": "#/$defs/sha256" },
            "reviewerId": { "type": "string", "minLength": 1 }
          }
        },
        "annotations": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/annotation" } },
        "adjudication": {
          "type": "object", "additionalProperties": false,
          "required": ["reviewerId", "resolution", "acceptableRoutes", "acceptableSequences"],
          "properties": {
            "reviewerId": { "type": "string", "minLength": 1 },
            "resolution": { "enum": ["agreement", "resolved_disagreement"] },
            "acceptableRoutes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "acceptableSequences": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
          }
        },
        "oracles": {
          "type": "object", "additionalProperties": false,
          "required": ["execution", "factual"],
          "properties": {
            "execution": { "$ref": "#/$defs/oracle" },
            "factual": { "$ref": "#/$defs/oracle" }
          }
        }
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["annotatorId", "independent", "acceptableRoutes", "acceptableSequences", "notes"],
      "properties": {
        "annotatorId": { "type": "string", "minLength": 1 },
        "independent": { "const": true },
        "acceptableRoutes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "acceptableSequences": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } },
        "notes": { "type": "string" }
      }
    },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reference", "version", "sha256"],
      "properties": {
        "status": { "enum": ["available", "not_applicable"] },
        "reference": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "split", "scores"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "split": { "enum": ["development", "calibration", "locked_holdout"] },
        "scores": {
          "type": "object", "additionalProperties": false,
          "required": ["routing", "execution", "answer", "accuracy", "coverage", "cost", "latency"],
          "properties": {
            "routing": { "enum": ["correct", "incorrect", "acceptable_alternative", "clarification_required", "unverified"] },
            "execution": { "enum": ["usable_evidence", "empty_result", "failed", "not_exercised", "unverified"] },
            "answer": { "enum": ["supported", "unsupported", "appropriately_limited", "unverified"] },
            "accuracy": { "enum": ["reference_verified", "contradicted", "unverified"] },
            "coverage": { "enum": ["complete_for_declared_scope", "partial", "unknown"] },
            "cost": { "type": "number", "minimum": 0 },
            "latency": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
