{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capiro.invalid/schemas/meri-route-decision-receipts-v1.json",
  "title": "Meri dormant route-decision evaluation receipts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "datasetSha256", "catalogVersion", "catalogSha256", "splitMembershipSha256", "familyFreezeSha256", "candidateManifestVersion", "candidateManifestSha256", "evaluationBatchId", "mode", "decisions"],
  "properties": {
    "schemaVersion": { "const": "meri-route-decision-receipts.v1" },
    "datasetId": { "$ref": "#/$defs/nonEmpty" },
    "datasetSha256": { "$ref": "#/$defs/sha256" },
    "catalogVersion": { "$ref": "#/$defs/nonEmpty" },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "splitMembershipSha256": { "$ref": "#/$defs/sha256" },
    "familyFreezeSha256": { "$ref": "#/$defs/sha256" },
    "candidateManifestVersion": { "$ref": "#/$defs/nonEmpty" },
    "candidateManifestSha256": { "$ref": "#/$defs/sha256" },
    "evaluationBatchId": { "$ref": "#/$defs/nonEmpty" },
    "mode": { "const": "locked_holdout" },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "requiredCapabilityOracles": { "type": "array", "items": { "$ref": "#/$defs/requiredCapabilityOracle" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "sequence"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmpty" },
        "sequence": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "split", "producerId", "reference", "contentSha256", "capturedAt", "candidateManifestVersion", "candidateManifestSha256", "evaluationBatchId", "disposition", "proposal", "selection", "candidateExposedToolIds", "fallbackReason"],
      "properties": {
        "caseId": { "$ref": "#/$defs/nonEmpty" },
        "split": { "const": "locked_holdout" },
        "producerId": { "$ref": "#/$defs/nonEmpty" },
        "reference": { "$ref": "#/$defs/nonEmpty" },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "candidateManifestVersion": { "$ref": "#/$defs/nonEmpty" },
        "candidateManifestSha256": { "$ref": "#/$defs/sha256" },
        "evaluationBatchId": { "$ref": "#/$defs/nonEmpty" },
        "disposition": { "enum": ["accepted", "fallback"] },
        "proposal": { "oneOf": [{ "$ref": "#/$defs/route" }, { "type": "null" }] },
        "selection": { "oneOf": [{ "$ref": "#/$defs/route" }, { "type": "null" }] },
        "candidateExposedToolIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "fallbackReason": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "disposition": { "const": "accepted" } } }, "then": { "properties": { "proposal": { "$ref": "#/$defs/route" }, "selection": { "$ref": "#/$defs/route" }, "fallbackReason": { "type": "null" } } } },
        { "if": { "properties": { "disposition": { "const": "fallback" } } }, "then": { "properties": { "proposal": { "type": "null" }, "selection": { "type": "null" }, "candidateExposedToolIds": { "maxItems": 0 }, "fallbackReason": { "$ref": "#/$defs/nonEmpty" } } } }
      ]
    },
    "requiredCapabilityOracle": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "reviewerId", "reference", "version", "contentSha256", "requiredToolIds"],
      "properties": {
        "caseId": { "$ref": "#/$defs/nonEmpty" },
        "reviewerId": { "$ref": "#/$defs/nonEmpty" },
        "reference": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "requiredToolIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    }
  }
}
