new file mode 100644
--- /dev/null
+++ b/apps/api/src/meri/task-links-final-probes.spec.ts
@@ -0,0 +1,501 @@
+/**
+ * Task/action final-await owner authority probes — bounded fresh evidence for 57b51a81b.
+ *
+ * Scope:
+ * - (1) Final-await client/membership withdrawal after linked meeting read: deny and unchanged legitimate positive
+ * - (2) Private alternate-field source alias/note case
+ * - (3) Released action semantic-field mutation with unchanged timestamp rejects replay
+ * - (4) Canceled/all filter remains actual-row parity
+ *
+ * Constraints:
+ * - No global atomicity promises; documents current authority at named final awaits
+ * - Uses actual dependencies read-only; no source edits, installs, npx, builds
+ * - Exit 0 signals bounded PASS; separate live acceptance NOT_RUN
+ */
+
+import type { TenantContext } from '@capiro/shared';
+import { EngagementService } from '../engagement/engagement.service.js';
+import { ActionRecommendationReadService } from '../intelligence/actions/action-recommendation-read.service.js';
+import { EngagementTaskStatus } from '@prisma/client';
+import {
+  buildMeriActionItemReadResult,
+  parseMeriActionItemReadInput,
+} from './meri-action-item-read.helpers.js';
+import { currentOwnerResultAuthorizesReplay } from './meri-research-replay-authorization.js';
+
+const ctx = { tenantId: 'tenant-1', userId: 'user-1' } as TenantContext;
+
+function taskRow(
+  updatedAt = new Date('2026-09-21T00:00:00.000Z'),
+  overrides: Record<string, unknown> = {},
+) {
+  return {
+    id: 'task-1',
+    tenantId: 'tenant-1',
+    clientId: 'client-1',
+    meetingId: null,
+    contactId: null,
+    mailThreadId: null,
+    title: 'Demo follow-up',
+    description: 'Send demo',
+    ownerUserId: null,
+    dueDate: null,
+    status: 'todo',
+    sourceType: 'meeting',
+    sourceId: 'm-1',
+    createdByUserId: 'user-1',
+    createdAt: new Date('2026-09-20T00:00:00.000Z'),
+    updatedAt,
+    client: { id: 'client-1', name: 'Aster' },
+    meeting: null,
+    ...overrides,
+  };
+}
+
+function actionRow(
+  updatedAt = new Date('2026-09-21T00:00:00.000Z'),
+  overrides: Record<string, unknown> = {},
+) {
+  return {
+    id: 'action-1',
+    districtKey: null,
+    clientId: 'client-1',
+    peCode: null,
+    programId: null,
+    deltaId: null,
+    actionType: 'monitor',
+    issueTitle: 'Review change',
+    whatChanged: 'Changed',
+    whyItMatters: 'Impact',
+    recommendedAction: 'Review',
+    targetAudience: [],
+    suggestedArtifactType: null,
+    deadline: null,
+    deadlineSource: null,
+    ownerUserId: null,
+    priority: 1,
+    confidence: {},
+    uncertainty: null,
+    evidence: [] as Array<Record<string, unknown>>,
+    status: 'new',
+    dismissalReason: null,
+    outcome: null,
+    createdAt: new Date('2026-09-20T00:00:00.000Z'),
+    updatedAt,
+    client: { name: 'Aster' },
+    ...overrides,
+  };
+}
+
+function meetingRow(
+  overrides: Record<string, unknown> = {},
+) {
+  return {
+    id: 'meeting-1',
+    clientId: 'client-1',
+    subject: 'Aster review',
+    isInternal: false,
+    visibility: 'private',
+    status: 'scheduled',
+    updatedAt: new Date('2026-09-21T00:00:00.000Z'),
+    ...overrides,
+  };
+}
+
+function sourceDocumentRow(
+  overrides: Record<string, unknown> = {},
+) {
+  return {
+    id: 'document-1',
+    sourceKey: 'public-r2',
+    fiscalYear: 2027,
+    budgetCycle: 'pb',
+    component: 'AF',
+    documentType: 'r2',
+    title: 'Public R-2',
+    sourceUrl: 'https://example.gov/r2.pdf',
+    sha256: 'a'.repeat(64),
+    extractionMethod: 'deterministic_pdf',
+    extractionToolVersion: '1',
+    ingestedAt: new Date('2026-09-20T00:00:00.000Z'),
+    supersededByDocumentId: null,
+    ...overrides,
+  };
+}
+
+describe('final-await authority probes (57b51a81b)', () => {
+  /**
+   * Probe 1a: Final-await client read denies after linked meeting previously authorized
+   * Documents that clientMemoryAllowed is checked AFTER initial task/meeting reads
+   */
+  it('denies when client membership is revoked after linked meeting initially authorized', async () => {
+    const row = taskRow(undefined, { meetingId: 'meeting-1', sourceId: 'meeting-1' });
+    let allowAfterInitial = true;
+    let allowAfterFinal = false;
+
+    const tx = {
+      client: { findFirst: jest.fn().mockResolvedValue({ id: 'client-1' }) },
+      $queryRawUnsafe: jest.fn().mockImplementation(async () => {
+        const allowed = allowAfterFinal;
+        return [{ allowed }];
+      }),
+      engagementTask: {
+        findMany: jest.fn().mockResolvedValue([row]),
+        findFirst: jest.fn().mockResolvedValue(row),
+        count: jest.fn().mockResolvedValue(1),
+      },
+      meeting: {
+        findFirst: jest.fn().mockImplementation(async () => {
+          return meetingRow();
+        }),
+      },
+    };
+
+    // First authorize call (before task read) returns true
+    // Second authorize call (after meeting read) returns false
+    let authorizeCallCount = 0;
+    const service = Object.assign(Object.create(EngagementService.prototype), {
+      prisma: {
+        withTenant: jest.fn(async (_tenant: string, fn: (arg: typeof tx) => unknown) => {
+          // Simulate the authorize() behavior inline
+          authorizeCallCount++;
+          if (authorizeCallCount === 1) {
+            allowAfterFinal = true; // First call passes
+          } else {
+            allowAfterFinal = false; // Final call fails
+          }
+          return fn(tx);
+        }),
+      },
+    }) as EngagementService;
+
+    const query = {
+      clientId: 'client-1',
+      taskId: null,
+      status: null,
+      openOnly: false,
+      dueBefore: null,
+      offset: 0,
+      limit: 20,
+    } as any;
+
+    // Mock the authorize function behavior
+    tx.$queryRawUnsafe.mockResolvedValueOnce([{ allowed: true }]); // initial
+    tx.$queryRawUnsafe.mockResolvedValueOnce([{ allowed: true }]); // meeting candidate
+    tx.$queryRawUnsafe.mockResolvedValueOnce([{ allowed: false }]); // final - revoked
+
+    await expect(service.readMeriTasksExact(ctx, query)).rejects.toThrow('Client not found');
+  });
+
+  /**
+   * Probe 1b: Unchanged legitimate positive — membership passes final await
+   * Documents that normal flow succeeds when all auth checks pass
+   */
+  it('accepts legitimate positive when client membership verified at final await', async () => {
+    const row = taskRow(undefined, { meetingId: 'meeting-1', sourceId: 'meeting-1' });
+    const meeting = meetingRow();
+
+    const tx = {
+      client: { findFirst: jest.fn().mockResolvedValue({ id: 'client-1' }) },
+      $queryRawUnsafe: jest.fn().mockResolvedValue([{ allowed: true }]),
+      engagementTask: {
+        findMany: jest.fn().mockResolvedValue([row]),
+        findFirst: jest.fn().mockResolvedValue(row),
+        count: jest.fn().mockResolvedValue(1),
+      },
+      meeting: { findFirst: jest.fn().mockResolvedValue(meeting) },
+    };
+
+    const service = Object.assign(Object.create(EngagementService.prototype), {
+      prisma: {
+        withTenant: jest.fn(async (_tenant: string, fn: (arg: typeof tx) => unknown) => fn(tx)),
+      },
+    }) as EngagementService;
+
+    const query = {
+      clientId: 'client-1',
+      taskId: null,
+      status: null,
+      openOnly: false,
+      dueBefore: null,
+      offset: 0,
+      limit: 20,
+    } as any;
+
+    const result = await service.readMeriTasksExact(ctx, query);
+    expect(result.sourceStatus).toBe('healthy');
+    expect(result.rows[0]?.linkedSourceProofs).toHaveLength(1);
+    expect(result.rows[0]?.linkedSourceProofs[0]).toMatchObject({
+      owner: 'meetings',
+      sourceRecordId: 'meeting-1',
+    });
+  });
+
+  /**
+   * Probe 2: Private alternate-field source alias/note — note field causes degradation
+   * Documents that note field on source evidence makes coverage degraded
+   * BUT canonical fields (kind, sourceDocumentId, page) are preserved in serialized result
+   * and private fields (note) are stripped.
+   */
+  it('degrades coverage when private note field attached to source evidence', async () => {
+    // Evidence with private note attached - coverage should be degraded
+    const row = actionRow(undefined, { 
+      evidence: [{ kind: 'source', sourceDocumentId: 'document-1', note: 'private note', page: 5 }],
+      // linkedSourceProofs is required for canonical proof generation
+      linkedSourceProofs: [{ owner: 'source_document', sourceRecordId: 'document-1', sourceVersion: '2026-09-20T00:00:00.000Z', contentSha256: 'a'.repeat(64) }]
+    });
+    const doc = sourceDocumentRow();
+
+    const tx = {
+      client: { findFirst: jest.fn().mockResolvedValue({ id: 'client-1' }) },
+      $queryRawUnsafe: jest.fn().mockResolvedValue([{ allowed: true }]),
+      actionRecommendation: {
+        findMany: jest.fn().mockResolvedValue([row]),
+        findFirst: jest.fn().mockResolvedValue(row),
+        count: jest.fn().mockResolvedValue(1),
+      },
+      sourceDocument: { findMany: jest.fn().mockResolvedValue([doc]) },
+    };
+
+    const service = new ActionRecommendationReadService({
+      withTenant: jest.fn(async (_tenant: string, fn: (arg: typeof tx) => unknown) => fn(tx)),
+    } as never);
+
+    const result = await service.readMeriActionItemsExact(ctx, {
+      clientId: 'client-1',
+      actionItemId: null,
+      page: 1,
+      limit: 20,
+    });
+
+    // Note field makes coverage degraded
+    expect(result.sourceStatus).toBe('degraded');
+    
+    // The serialized evidence should contain the canonical fields (kind, sourceDocumentId, page)
+    // but NOT the private note
+    const serializedEvidence = result.data[0]?.evidence;
+    expect(serializedEvidence).toHaveLength(1);
+    expect(serializedEvidence[0]).toMatchObject({
+      kind: 'source',
+      sourceDocumentId: 'document-1',
+      page: 5,
+    });
+    // Private note should not be present in serialized result
+    expect(serializedEvidence[0]).not.toHaveProperty('note');
+  });
+
+  /**
+   * Probe 3: Released action semantic-field mutation with unchanged timestamp rejects replay
+   * Documents that digest comparison catches semantic changes even if timestamp unchanged.
+   * 
+   * Strategy:
+   * 1. Build a saved result from candidate action with proper canonical structure
+   * 2. Create a mutated current action with same timestamp but changed semantic field
+   * 3. Invoke currentOwnerResultAuthorizesReplay to prove rejection
+   * 4. Assert result: unchanged positive authorizes, mutated semantic does not
+   * 
+   * NOTE: The action row must include linkedSourceProofs for canonical proof generation.
+   */
+  it('rejects replay when semantic fields mutated but timestamp unchanged', () => {
+    const baseUpdatedAt = '2026-09-21T00:00:00.000Z';
+    
+    // Build actions with proper structure including linkedSourceProofs
+    const baseAction = {
+      id: 'action-test',
+      clientId: 'client-1',
+      clientName: 'Aster',
+      districtKey: null,
+      peCode: null,
+      programId: null,
+      deltaId: null,
+      actionType: 'monitor',
+      issueTitle: 'Original Title',
+      whatChanged: 'Original description',
+      whyItMatters: 'Impact',
+      recommendedAction: 'Review',
+      targetAudience: [],
+      suggestedArtifactType: null,
+      deadline: null,
+      deadlineSource: null,
+      ownerUserId: null,
+      priority: 1,
+      confidence: {},
+      uncertainty: null,
+      evidence: [] as any[],
+      status: 'new',
+      dismissalReason: null,
+      outcome: null,
+      createdAt: '2026-09-20T00:00:00.000Z',
+      updatedAt: baseUpdatedAt,
+      // linkedSourceProofs required for canonical proof generation
+      linkedSourceProofs: [{ owner: 'source_document', sourceRecordId: 'document-1', sourceVersion: '2026-09-20T00:00:00.000Z', contentSha256: 'a'.repeat(64) }]
+    };
+
+    // Build the canonical result using the actual helper
+    const selection = parseMeriActionItemReadInput(ctx, { clientId: 'client-1' }, 'client-1');
+    const savedResult = buildMeriActionItemReadResult(ctx, selection, {
+      data: [baseAction as any],
+      total: 1,
+      page: 1,
+      limit: 20,
+      sourceStatus: 'healthy',
+      sourceReason: null,
+    });
+
+    // Same action content should authorize replay (positive control)
+    const identicalResult = buildMeriActionItemReadResult(ctx, selection, {
+      data: [baseAction as any],
+      total: 1,
+      page: 1,
+      limit: 20,
+      sourceStatus: 'healthy',
+      sourceReason: null,
+    });
+    
+    // Positive control: identical results should authorize replay
+    const unchangedAuthorizes = currentOwnerResultAuthorizesReplay('query_action_items', savedResult, identicalResult);
+    expect(unchangedAuthorizes).toBe(true);
+
+    // Create mutated action with SAME timestamp but changed semantic field
+    const mutatedAction = {
+      ...baseAction,
+      issueTitle: 'CHANGED TITLE', // Semantic mutation
+    };
+
+    // Build current result with mutated semantic content
+    const currentResult = buildMeriActionItemReadResult(ctx, selection, {
+      data: [mutatedAction as any],
+      total: 1,
+      page: 1,
+      limit: 20,
+      sourceStatus: 'healthy',
+      sourceReason: null,
+    });
+
+    // Semantic change should reject replay even with unchanged timestamp
+    const changedRejects = currentOwnerResultAuthorizesReplay('query_action_items', savedResult, currentResult);
+    expect(changedRejects).toBe(false);
+  });
+
+  /**
+   * Probe 4: Canceled/all filter remains actual-row parity
+   * Documents canceled tasks appear in unfiltered queries but not openOnly queries
+   */
+  it('maintains actual row parity for canceled/all status filters', async () => {
+    const todoRow = taskRow(undefined, { id: 'task-todo', status: 'todo' });
+    const doneRow = taskRow(undefined, { id: 'task-done', status: 'done' });
+    const canceledRow = taskRow(undefined, { id: 'task-canceled', status: 'canceled' });
+
+    const tx = {
+      client: { findFirst: jest.fn().mockResolvedValue({ id: 'client-1' }) },
+      $queryRawUnsafe: jest.fn().mockResolvedValue([{ allowed: true }]),
+      engagementTask: {
+        findMany: jest.fn().mockImplementation(({ where }) => {
+          // Simulate filtering behavior
+          if (where.status?.in) {
+            return [todoRow, canceledRow].filter(r =>
+              ['todo', 'in_progress', 'blocked'].includes(r.status)
+            );
+          }
+          if (where.status === 'todo') {
+            return [todoRow];
+          }
+          // Unfiltered returns all including canceled
+          return [todoRow, doneRow, canceledRow];
+        }),
+        findFirst: jest.fn().mockImplementation(({ where }) => {
+          const id = where.id;
+          if (id === 'task-todo') return Promise.resolve(todoRow);
+          if (id === 'task-done') return Promise.resolve(doneRow);
+          if (id === 'task-canceled') return Promise.resolve(canceledRow);
+          return Promise.resolve(null);
+        }),
+        count: jest.fn().mockResolvedValue(3),
+      },
+      meeting: { findFirst: jest.fn() },
+    };
+
+    const service = Object.assign(Object.create(EngagementService.prototype), {
+      prisma: {
+        withTenant: jest.fn(async (_tenant: string, fn: (arg: typeof tx) => unknown) => fn(tx)),
+      },
+    }) as EngagementService;
+
+    // Query 1: openOnly=true should exclude canceled
+    const openResult = await service.readMeriTasksExact(ctx, {
+      clientId: 'client-1',
+      taskId: null,
+      status: null,
+      openOnly: true,
+      dueBefore: null,
+      offset: 0,
+      limit: 20,
+    });
+
+    // Query 2: status=null, openOnly=false should include canceled
+    const allResult = await service.readMeriTasksExact(ctx, {
+      clientId: 'client-1',
+      taskId: null,
+      status: null,
+      openOnly: false,
+      dueBefore: null,
+      offset: 0,
+      limit: 20,
+    });
+
+    // Both should succeed
+    expect(openResult.sourceStatus).toBe('healthy');
+    expect(allResult.sourceStatus).toBe('healthy');
+
+    // Total parity: all should include canceled tasks
+    expect(allResult.total).toBe(3);
+
+    // Verify canceled status flows through correctly in all-filter
+    const returnedIds = allResult.rows.map((r: { id: string }) => r.id);
+    expect(returnedIds).toContain('task-canceled');
+  });
+
+  /**
+   * Additional probe 4b: Exact status filter parity
+   * Documents that exact status queries include canceled when explicitly requested
+   */
+  it('includes canceled tasks when status filter explicitly requests them', async () => {
+    const canceledRow = taskRow(undefined, { id: 'task-canceled', status: 'canceled' });
+
+    const tx = {
+      client: { findFirst: jest.fn().mockResolvedValue({ id: 'client-1' }) },
+      $queryRawUnsafe: jest.fn().mockResolvedValue([{ allowed: true }]),
+      engagementTask: {
+        findMany: jest.fn().mockImplementation(({ where }) => {
+          if (where.status === 'canceled') {
+            return [canceledRow];
+          }
+          return [];
+        }),
+        findFirst: jest.fn().mockResolvedValue(canceledRow),
+        count: jest.fn().mockResolvedValue(1),
+      },
+      meeting: { findFirst: jest.fn() },
+    };
+
+    const service = Object.assign(Object.create(EngagementService.prototype), {
+      prisma: {
+        withTenant: jest.fn(async (_tenant: string, fn: (arg: typeof tx) => unknown) => fn(tx)),
+      },
+    }) as EngagementService;
+
+    const result = await service.readMeriTasksExact(ctx, {
+      clientId: 'client-1',
+      taskId: null,
+      status: 'canceled' as EngagementTaskStatus,
+      openOnly: false,
+      dueBefore: null,
+      offset: 0,
+      limit: 20,
+    });
+
+    expect(result.sourceStatus).toBe('healthy');
+    expect(result.total).toBe(1);
+    expect(result.rows[0]?.status).toBe('canceled');
+  });
+});
