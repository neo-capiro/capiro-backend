flowchart LR
    subgraph client ["Product experience"]
        meriUi["Meri UI: private chat and workspace rooms<br/>(+ reconnect cursor, stop, approval/clarify cards)"]
    end
    subgraph gateway ["Application ingress"]
        ingress["Authenticated HTTPS ingress"]
    end
    subgraph service ["Meri API (apps/api)"]
        runtimeProxy["Runtime proxy: pilot gate → Hermes | V3 | legacy"]
        adapter["MeriHermesRuntimeAdapter<br/>envelope · run store · event translation<br/>detach ≠ stop · reconnect replay"]
        broker["MeriAgentToolBroker<br/>scope token + run binding · re-authorize every call<br/>memory recall/propose · attachments · artifacts · clarification"]
        gatewayData["Comprehensive data gateway (Phase 2A)<br/>discover/describe/query/read/related/export<br/>policy-annotated catalog · query compiler"]
        lifecycle["Worker lifecycle + scheduler (Phase 1/5)<br/>provision · lease · wake · park · teardown<br/>Postgres outbox + SKIP LOCKED"]
    end
    subgraph workers ["Isolated execution (one task per execution scope)"]
        hermes["Hermes worker (pinned v2026.9.14 image)<br/>/v1/runs · events · stop · approval · steer<br/>native tools · SOUL.md · skills + background review"]
        plugins["Meri plugins in worker<br/>meri_memory provider · meri_tools"]
        scopeVolume[("Scope home volume<br/>SOUL.md · skills/ · state.db sessions · workspace/")]
    end
    subgraph datastore ["Durable application state (Meri-owned)"]
        meriDb["Postgres: conversations, messages,<br/>run records + events + interactions (P1 tables),<br/>governed memory (memory_items / candidates)"]
        businessData["All authorized business data (549 models / 12 schemas)"]
        artifactStore["Artifacts (ClioArtifact / S3), skill registry (P1)"]
        secretsStore["Connector credentials, worker API keys, signing key"]
    end
    subgraph external ["External providers"]
        modelProvider["Model provider (OpenAI via custom endpoint · Anthropic alternate)"]
        appProviders["Email and MCP applications"]
    end
    meriUi <-->|"SSE frames · reconnect after=seq"| ingress
    ingress --> runtimeProxy
    runtimeProxy --> adapter
    adapter <-->|"POST /v1/runs · GET events · stop · approval · steer"| hermes
    hermes --- plugins
    hermes --- scopeVolume
    plugins -->|"worker token + run id"| broker
    broker -->|"withTenantUser · wall · governed predicates"| meriDb
    broker -.->|"Phase 2A"| gatewayData
    gatewayData --> businessData
    broker --> artifactStore
    adapter --> meriDb
    broker -->|"resolve delegated credentials"| secretsStore
    broker -.->|"authorized calls"| appProviders
    hermes -.->|"scoped model credential"| modelProvider
    lifecycle -->|"RunTask / stop · attach volume · mint scope token"| hermes
    lifecycle -->|"claim job · reauthorize · deliver"| meriDb
