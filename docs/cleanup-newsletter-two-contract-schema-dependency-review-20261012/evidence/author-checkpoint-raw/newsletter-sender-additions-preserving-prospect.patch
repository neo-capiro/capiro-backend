 /** v2, v2.1, v3… pass; v1 does not. Prefix-safe, not a string compare. */
+/** A separate, server-authored format; it never claims AI prompt provenance. */
+export function isWorkspaceNewsletterVersion(v: {
+  contentFormat?: string;
+  newsletterStageId?: string | null;
+  generationStatus?: string;
+}): boolean {
+  return (
+    v.contentFormat === 'workspace_newsletter' &&
+    Boolean(v.newsletterStageId) &&
+    v.generationStatus === 'manually_authored'
+  );
+}
