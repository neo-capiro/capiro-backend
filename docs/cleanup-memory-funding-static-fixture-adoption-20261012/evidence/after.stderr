      const itemQuery = useQuery<ItemSectionsResp>({
        queryKey: ['memory-item', fileType, slug],
        queryFn: async () =>
          (await api.get<ItemSectionsResp>(`/api/memory/items/${fileType}/${slug}/sections`)).data,
        enabled: ready && !!fileType && !!slug,
