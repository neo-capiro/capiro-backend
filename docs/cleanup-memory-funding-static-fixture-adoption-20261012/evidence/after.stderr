                            <Text type=\"secondary\" italic>
                              e.g. “{section.example}”
                            </Text>
                          )}
                        </Paragraph>
                        <Input.TextArea
                          value={bodyFor(section)}
                          autoSize={{ minRows: section.key === 'samples' ? 6 : 2, maxRows: 16 }}
                          readOnly={section.owner === 'engine' || !canEdit}
                          onChange={(event) =>
                            setDrafts((current) => ({
                              ...current,
                              [section.key]: event.target.value,
                            }))
