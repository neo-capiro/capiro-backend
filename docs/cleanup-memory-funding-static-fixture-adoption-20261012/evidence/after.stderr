                          style={section.owner === 'engine' ? { background: '#f5f5f5' } : undefined}
                        />
                      </div>
                    ))}
                  </Space>
                  <div style={{ display: 'flex', justifyContent: 'flex-end' }}>{saveButton}</div>
                </>
              )}
            </>
          )}
        </Space>
      );
    }
