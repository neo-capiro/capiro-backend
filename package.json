{
  "name": "capiro",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@nestjs/core"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @capiro/api prisma:migrate:dev",
    "db:reset": "pnpm --filter @capiro/api prisma:reset",
    "verify:pe-phase-9": "pnpm -C apps/api run verify:pe-phase-9",
    "verify:pe-phase-9:full": "pnpm -C apps/api run verify:pe-phase-9:full",
    "verify:pe-phase-10": "pnpm -C apps/api run verify:pe-phase-10",
    "verify:meriv2-scripts": "node scripts/verify-meriv2-release-scripts.mjs",
    "verify:meriv2-development": "pnpm verify:meriv2-scripts && node scripts/verify-meriv2-release.mjs --mode=development",
    "verify:meriv2-release": "pnpm verify:meriv2-scripts && node scripts/verify-meriv2-release.mjs --mode=release",
    "verify:engagement-phase-0": "pnpm --filter @capiro/api verify:engagement-phase-0",
    "verify:engagement-phase-0:browser": "node scripts/run-engagement-phase0-local.mjs",
    "verify:engagement-phase-1": "pnpm --filter @capiro/api exec tsx scripts/verify-engagement-phase1-runtime.ts && node --check scripts/run-engagement-phase1-local.mjs && node --check scripts/verify-engagement-phase1-local.mjs && node --check scripts/run-engagement-phase1-post-acceptance.mjs && node --check scripts/verify-engagement-phase1-background-final.mjs && node --check apps/web/scripts/engagement-phase1-browser-parity.mjs && node --check apps/web/scripts/engagement-phase1-post-acceptance.mjs",
    "verify:engagement-phase-1:local": "node scripts/verify-engagement-phase1-local.mjs",
    "verify:engagement-phase-2": "bash scripts/verify-engagement-phase2-code.sh",
    "verify:engagement-phase-3": "node scripts/verify-engagement-phase3-code.mjs",
    "verify:engagement-phase-3:local": "node scripts/run-engagement-phase3-local.mjs",
    "verify:outreach-v3-phase-1": "node scripts/verify-outreach-v3-phase1-code.mjs",
    "verify:outreach-v3-phase-1:local": "node scripts/run-outreach-v3-phase1-local.mjs",
    "verify:outreach-v3-phase-2": "node scripts/verify-outreach-v3-phase2-code.mjs",
    "verify:outreach-v3-phase-2:db": "node scripts/verify-outreach-v3-phase2-db.mjs",
    "verify:outreach-v3-phase-2:local": "node scripts/run-outreach-v3-phase2-local.mjs",
    "verify:outreach-v3-phase-3": "node scripts/verify-outreach-v3-phase3-code.mjs",
    "verify:outreach-v3-phase-3:db": "node scripts/verify-outreach-v3-phase3-db.mjs",
    "verify:outreach-v3-phase-3:eval": "pnpm -C apps/api exec tsx scripts/outreach-v3-phase3-live-eval.ts",
    "verify:outreach-v3-phase-4": "node scripts/verify-outreach-v3-phase4-code.mjs",
    "verify:outreach-v3-phase-4:local": "node scripts/run-outreach-v3-phase4-local.mjs",
    "verify:outreach-v3-phase-5": "node scripts/verify-outreach-v3-phase5-code.mjs",
    "verify:outreach-v3-phase-5:local": "node scripts/run-outreach-v3-phase5-local.mjs",
    "verify:outreach-v3-phase-6": "node scripts/verify-outreach-v3-phase6-code.mjs",
    "verify:outreach-v3-templates": "node scripts/verify-outreach-v3-templates-code.mjs",
    "verify:outreach-v3-templates:db": "node scripts/verify-outreach-v3-templates-db.mjs",
    "verify:phase8-session2": "node scripts/verify-phase8-session2.mjs",
    "verify:phase8-session2:db": "node scripts/verify-phase8-session2-db.mjs",
    "verify:phase8-session3": "node scripts/verify-phase8-session3.mjs",
    "verify:phase8-session3:admin": "node scripts/verify-phase8-session3-admin-boundary.mjs",
    "verify:phase8-session3:parity": "pnpm --filter @capiro/defense-api exec tsx --test ../../tests/phase8-session3-parity/*.spec.ts",
    "verify:phase8-session3:db": "node scripts/verify-phase8-session3-db.mjs",
    "verify:meriv2-browser": "node scripts/run-meriv2-phase19-local.mjs",
    "collect:meriv2-aws-context": "node scripts/collect-meriv2-aws-context.mjs",
    "prepare:meriv2-ecs-release": "node scripts/prepare-meriv2-ecs-release.mjs",
    "ship:meriv2-ecs-release": "node scripts/execute-meriv2-ecs-release.mjs",
    "deploy:meriv2-operations-dark": "node scripts/deploy-meriv2-operations-dark.mjs",
    "verify:phase8-session4": "node scripts/verify-phase8-session4.mjs",
    "verify:phase8-session4:replay": "node scripts/phase8-session4-fy27-replay.mjs --out docs/defense-budget/phase8-session4-fy27-replay-evidence.json",
    "verify:phase8-session4:enforce": "node scripts/verify-phase8-session4.mjs --enforce-replay",
    "verify:phase8-session4:image": "bash scripts/verify-phase8-session4-image.sh",
    "verify:phase8-session5": "node scripts/verify-phase8-session5.mjs",
    "verify:phase8-session5:corpus": "node scripts/verify-phase8-session5-corpus.mjs",
    "verify:phase8-session5:provider-decision": "node scripts/verify-phase8-session5.mjs --enforce-provider-decision",
    "verify:phase8-session6": "node scripts/verify-phase8-session6.mjs --enforce-corpus",
    "verify:phase8-session6:db": "node scripts/verify-phase8-session6-db.mjs",
    "verify:phase8-session6:domain": "pnpm --filter @capiro/defense-domain build && node scripts/test-phase8-session6-federal-funding-domain.mjs",
    "prepare:phase8-session6:corpus": "node scripts/prepare-phase8-session6-federal-funding-corpus.mjs",
    "verify:phase8-session7": "node scripts/verify-phase8-session7.mjs",
    "verify:phase8-session7:enforce": "node scripts/verify-phase8-session7.mjs --enforce-replay",
    "verify:phase8-session7:db": "node scripts/verify-phase8-session7-db.mjs",
    "verify:phase8-session7:domain": "pnpm --filter @capiro/defense-domain build && node scripts/test-phase8-session7-lifecycle-domain.mjs",
    "verify:phase8-session7:replay": "node scripts/phase8-session7-lifecycle-replay.mjs --out docs/defense-budget/phase8-session7-lifecycle-replay-evidence.json",
    "prepare:phase8-session7:corpus": "node scripts/prepare-phase8-session7-lifecycle-corpus.mjs",
    "validate:knowledge-plane:phase26": "node scripts/validate-knowledge-plane-phase26.mjs",
    "validate:knowledge-plane:phase26:fast": "node scripts/validate-knowledge-plane-phase26.mjs --skip-tests",
    "validate:knowledge-plane:phase27": "node scripts/validate-knowledge-plane-phase27.mjs",
    "validate:knowledge-plane:phase27:fast": "node scripts/validate-knowledge-plane-phase27.mjs --skip-tests",
    "validate:knowledge-plane:phase27e": "node scripts/validate-knowledge-plane-phase27e.mjs",
    "validate:knowledge-plane:phase27e:fast": "node scripts/validate-knowledge-plane-phase27e.mjs --skip-tests",
    "validate:knowledge-plane:phase27f": "node scripts/validate-knowledge-plane-phase27f.mjs",
    "validate:knowledge-plane:phase27f:fast": "node scripts/validate-knowledge-plane-phase27f.mjs --skip-tests",
    "verify:phase8-session8": "node scripts/verify-phase8-session8.mjs",
    "verify:phase8-session8:enforce": "node scripts/verify-phase8-session8.mjs --enforce-replay",
    "verify:phase8-session8:db": "node scripts/verify-phase8-session8-db.mjs",
    "verify:phase8-session8:domain": "pnpm --filter @capiro/defense-domain build && node scripts/test-phase8-session8-discovery-domain.mjs",
    "verify:phase8-session8:native": "pnpm --filter @capiro/defense-domain build && node scripts/test-phase8-session8-publisher-native-domain.mjs",
    "verify:phase8-session8:replay": "node scripts/phase8-session8-discovery-replay.mjs --out docs/defense-budget/phase8-session8-discovery-replay-evidence.json",
    "prepare:phase8-session8:corpus": "node scripts/prepare-phase8-session8-discovery-corpus.mjs",
    "verify:phase8-session9": "node scripts/verify-phase8-session9.mjs",
    "verify:phase8-session9:db": "node scripts/verify-phase8-session9-db.mjs",
    "verify:phase8-session9:domain": "pnpm --filter @capiro/defense-domain build && node scripts/test-phase8-session9-provider-domain.mjs",
    "verify:phase8-session9:runtime": "pnpm --filter @capiro/defense-api exec tsx --test src/program-elements/cross-domain/provider-runtime.spec.ts",
    "verify:phase8-session10": "node scripts/verify-phase8-session10.mjs",
    "verify:phase8-session10:db": "node scripts/verify-phase8-session10-db.mjs",
    "verify:phase8-session10:domain": "pnpm --filter @capiro/defense-domain build && node scripts/test-phase8-session10-schedule-domain.mjs",
    "verify:phase8-session10:runtime": "pnpm --filter @capiro/defense-api exec tsx --test src/budget-lifecycle/schedule/schedule-coordinator.spec.ts",
    "verify:phase8-session11": "node scripts/verify-phase8-session11.mjs",
    "verify:phase8-session11:db": "node scripts/verify-phase8-session11-db.mjs",
    "verify:phase8-session11:domain": "pnpm --filter @capiro/defense-domain build && node scripts/test-phase8-session11-domain.mjs",
    "verify:phase8-session11:runtime": "pnpm --filter @capiro/defense-api exec tsx --test src/budget-lifecycle-product/budget-lifecycle-query.service.spec.ts",
    "verify:phase8-session12": "node scripts/verify-phase8-session12.mjs",
    "verify:phase8-session12:e2e": "node scripts/verify-phase8-session12-e2e.mjs",
    "verify:phase8-session12:e2e:db": "node scripts/verify-phase8-session12-e2e-db.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3"
  }
}
