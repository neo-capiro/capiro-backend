{
  "name": "capiro",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@nestjs/core"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @capiro/api prisma:migrate:dev",
    "db:reset": "pnpm --filter @capiro/api prisma:reset",
    "verify:pe-phase-9": "pnpm -C apps/api run verify:pe-phase-9",
    "verify:pe-phase-9:full": "pnpm -C apps/api run verify:pe-phase-9:full",
    "verify:pe-phase-10": "pnpm -C apps/api run verify:pe-phase-10",
    "verify:meriv2-scripts": "node scripts/verify-meriv2-release-scripts.mjs",
    "verify:meriv2-development": "pnpm verify:meriv2-scripts && node scripts/verify-meriv2-release.mjs --mode=development",
    "verify:meriv2-release": "pnpm verify:meriv2-scripts && node scripts/verify-meriv2-release.mjs --mode=release",
    "verify:engagement-phase-0": "pnpm --filter @capiro/api verify:engagement-phase-0",
    "verify:engagement-phase-0:browser": "node scripts/run-engagement-phase0-local.mjs",
    "verify:engagement-phase-1": "pnpm --filter @capiro/api exec tsx scripts/verify-engagement-phase1-runtime.ts && node --check scripts/run-engagement-phase1-local.mjs && node --check scripts/verify-engagement-phase1-local.mjs && node --check scripts/run-engagement-phase1-post-acceptance.mjs && node --check scripts/verify-engagement-phase1-background-final.mjs && node --check apps/web/scripts/engagement-phase1-browser-parity.mjs && node --check apps/web/scripts/engagement-phase1-post-acceptance.mjs",
    "verify:engagement-phase-1:local": "node scripts/verify-engagement-phase1-local.mjs",
    "verify:engagement-phase-2": "bash scripts/verify-engagement-phase2-code.sh",
    "verify:engagement-phase-3": "node scripts/verify-engagement-phase3-code.mjs",
    "verify:engagement-phase-3:local": "node scripts/run-engagement-phase3-local.mjs",
    "verify:outreach-v3-phase-1": "node scripts/verify-outreach-v3-phase1-code.mjs",
    "verify:outreach-v3-phase-1:local": "node scripts/run-outreach-v3-phase1-local.mjs",
    "verify:outreach-v3-phase-2": "node scripts/verify-outreach-v3-phase2-code.mjs",
    "verify:outreach-v3-phase-2:db": "node scripts/verify-outreach-v3-phase2-db.mjs",
    "verify:outreach-v3-phase-2:local": "node scripts/run-outreach-v3-phase2-local.mjs",
    "verify:outreach-v3-phase-3": "node scripts/verify-outreach-v3-phase3-code.mjs",
    "verify:outreach-v3-phase-3:db": "node scripts/verify-outreach-v3-phase3-db.mjs",
    "verify:outreach-v3-phase-3:eval": "pnpm -C apps/api exec tsx scripts/outreach-v3-phase3-live-eval.ts",
    "verify:outreach-v3-phase-4": "node scripts/verify-outreach-v3-phase4-code.mjs",
    "verify:outreach-v3-phase-4:local": "node scripts/run-outreach-v3-phase4-local.mjs",
    "verify:outreach-v3-phase-5": "node scripts/verify-outreach-v3-phase5-code.mjs",
    "verify:outreach-v3-phase-5:local": "node scripts/run-outreach-v3-phase5-local.mjs",
    "verify:outreach-v3-phase-6": "node scripts/verify-outreach-v3-phase6-code.mjs",
    "verify:meriv2-browser": "node scripts/run-meriv2-phase19-local.mjs",
    "collect:meriv2-aws-context": "node scripts/collect-meriv2-aws-context.mjs",
    "prepare:meriv2-ecs-release": "node scripts/prepare-meriv2-ecs-release.mjs",
    "ship:meriv2-ecs-release": "node scripts/execute-meriv2-ecs-release.mjs",
    "deploy:meriv2-operations-dark": "node scripts/deploy-meriv2-operations-dark.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3"
  }
}
